  ],
  "task.513012FCD56E217D.title": "1 × Sword of the Cosmos — без вилучення",
  "quest.51301114CA58ED57.title": "Longbow of the Heavens · Кошторис переміг гравітацію",
  "quest.51301114CA58ED57.quest_subtitle": "Етап 6 · Повернення компонента · Додаткова гілка",
