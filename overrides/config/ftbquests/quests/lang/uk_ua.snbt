  ],
  "task.5130124C18C80741.title": "1 × Broom Part — без вилучення",
  "quest.513011CB5D00E40B.title": "Exalted Crafter",
  "quest.513011CB5D00E40B.quest_subtitle": "Переміщення та крафт",
  "quest.513011CB5D00E40B.quest_desc": [
    "Exalted Crafter відкриває ручну сітку крафту просто з інвентарю та дає доступ до внутрішнього сховища. Він зручний у походах, коли потрібно переробити ресурси без установлення верстака.",
    "Це переносний інтерфейс для твоїх крафтів: він не виконує виробничі замовлення самостійно. Для безперервного виробництва компонентів бази все одно потрібна окрема система автокрафту."
  ],
  "task.51301230F65C621D.title": "1 × Exalted Crafter — без вилучення",
  "quest.513011A9DC3370F8.title": "Empowered Exalted Crafter",
  "quest.513011A9DC3370F8.quest_subtitle": "Переміщення та крафт",
  "quest.513011A9DC3370F8.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему."
  ],
