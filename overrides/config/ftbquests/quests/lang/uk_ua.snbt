  ],
  "task.513012382E41EFAB.title": "1 × Японська гвардійська кіраса — без вилучення",
  "quest.513011ED9350E182.title": "Мапа всіх культур",
  "quest.513011ED9350E182.quest_subtitle": "Дослідження культур",
  "quest.513011ED9350E182.quest_desc": [
    "Відвідай поселення всіх культур, які враховує Millénaire. Це добровільний довгий маршрут."
  ],
  "task.51301298631F952B.title": "Нативна перевірка: Мапа всіх культур",
  "quest.5130113F5F4A6E4A.title": "Будівля у власному поселенні",
  "quest.5130113F5F4A6E4A.quest_subtitle": "Власне поселення",
  "quest.5130113F5F4A6E4A.quest_desc": [
    "Після отримання права керування заверши будівлю, яку зводять блок за блоком."
  ],
  "task.513012D7BB920F3F.title": "Нативна перевірка: Будівля у власному поселенні",
  "quest.513011A04C5185E6.title": "Норманський собор",
  "quest.513011A04C5185E6.quest_subtitle": "Нормани",
  "quest.513011A04C5185E6.quest_desc": [
    "Допоможи норманам звести собор. Потрібні реальні поставки та розвиток поселення."
  ],
  "task.513012029A76E971.title": "Нативна перевірка: Норманський собор",
  "quest.5130119418D33F34.title": "Місто зі ста жителів",
  "quest.5130119418D33F34.quest_subtitle": "Власне поселення",
  "quest.5130119418D33F34.quest_desc": [
    "Доведи підконтрольне поселення до нативної умови 100 мешканців. Це добровільний проект великого міста."
  ],
  "task.5130126E921724BE.title": "Нативна перевірка: Місто зі ста жителів",
  "quest.513011DFAD9E49FC.title": "Історія Алхіміка",
  "quest.513011DFAD9E49FC.quest_subtitle": "Нормани",
  "quest.513011DFAD9E49FC.quest_desc": [
    "Заверши норманську главу Creation Quest. Це окрема довга сюжетна лінія Millénaire."
  ],
  "task.5130127B71C0870D.title": "Нативна перевірка: Історія Алхіміка",
  "quest.5130115923BCBF5D.title": "Історія Sadhu",
  "quest.5130115923BCBF5D.quest_subtitle": "Індійці, інуїти, сельджуки",
  "quest.5130115923BCBF5D.quest_desc": [
    "Заверши індійську главу Creation Quest, виконуючи її нативні умови."
  ],
  "task.513012632713D736.title": "Нативна перевірка: Історія Sadhu",
  "quest.513011725B5E9D77.title": "Історія Fallen King",
  "quest.513011725B5E9D77.quest_subtitle": "Майя",
  "quest.513011725B5E9D77.quest_desc": [
    "Заверши майянську главу Creation Quest за її нативними умовами."
  ],
  "task.5130122ED3BA9641.title": "Нативна перевірка: Історія Fallen King",
  "chapter.514D101C6F684087.title": "23 · Руїни, поселення та несподіванки",
  "chapter.514D101C6F684087.chapter_subtitle": [
    "80 квестів · 11 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.514D1112BAB39A83.title": "Кілька блоків одним прийомом",
  "quest.514D1112BAB39A83.quest_subtitle": "Підготовка та маршрути",
  "quest.514D1112BAB39A83.quest_desc": [
    "Візьми залізну кирку й випробуй FTB Ultimine на невеликій ділянці каменю. Для автоматичного зарахування режим має успішно зламати хоча б два різні блоки одним груповим проходом.",
    "Підготуй спорядження, їжу, ремонт і маршрут повернення, а потім обирай споруди за місцевістю та силою противників. Перший контейнер Lootr пояснює персональну здобич; далі книга відстежує власне дослідження.",
    "Спільні матеріальні пороги позначають готовність до дорожчих експедицій. Додані у 0.4.5 структури й моби існують у світі без окремих квестів цієї глави.",
    "Предметні завдання окремо перевіряють кирку та 64 кругляки в інвентарі без вилучення. Подію Ultimine книга тепер отримує від самого мода; звичайне копання не підміняє цю дію.",
    "Міцність та голод витрачаються за налаштуваннями збірки. Перед ламанням перевір межі виділення: стеля не зобов’язана поважати твій оптимізм.",
    "Ultimine: типово затисни клавішу ` / ~ (ліворуч від 1) і ламай блок ЛКМ. Для зміни форми тримай цю клавішу та Shift і крути коліщатко; також є стрілки ↑/↓. У Керуванні шукай FTB Ultimine і дії зміни форми."
  ],
  "task.514D12E7860BFD7C.title": "1 × Iron Pickaxe — без вилучення",
  "task.514D12A9343213CE.title": "64 × Cobblestone — без вилучення",
  "task.514D123334C1CCAE.title": "Автоматично: Ultimine успішно зламав групу блоків",
  "quest.514D111AFD4E2789.title": "Невеликий запас у дорогу",
  "quest.514D111AFD4E2789.quest_subtitle": "Підготовка та маршрути",
  "quest.514D111AFD4E2789.quest_desc": [
    "Підготуй компас, 32 смолоскипи та відро води. Візьми звичайну їжу, запас міцності інструментів і познач шлях назад до бази.",
    "Компас показує свою ванільну ціль, а не автоматично знаходить додані структури. Мости та села потрібно відкривати під час досліджень."
  ],
  "task.514D12B9DA52CDAC.title": "1 × Compass — без вилучення",
  "task.514D127036EA7091.title": "32 × Torch — без вилучення",
  "task.514D12C47F898EDA.title": "1 × Water Bucket — без вилучення",
  "quest.514D11628A7DD0E1.title": "Старий міст Abridged",
  "quest.514D11628A7DD0E1.quest_subtitle": "Підготовка та маршрути",
  "quest.514D11628A7DD0E1.quest_desc": [
    "Знайди згенерований міст Abridged і пройди всередину його структури. Саморобний міст зі схожих блоків не виконає завдання.",
    "Коли ти стоїш у межах частини справжньої структури, перевірка спрацьовує автоматично. У старому дослідженому світі шукай нові чанки після додавання мода."
  ],
  "task.514D128D457BEC0E.title": "Відвідати: abridged:bridge",
  "quest.514D11CDA1129F03.title": "Сусіди під землею",
  "quest.514D11CDA1129F03.quest_subtitle": "Підготовка та маршрути",
  "quest.514D11CDA1129F03.quest_desc": [
    "Знайди справжнє Underground Village та зайди до частини згенерованої структури. Це окремий тип поселення, який не замінює міста Millénaire.",
    "Підготуй освітлений шлях нагору. Квест перевіряє відвідування структури автоматично; ламати її блоки або переносити мешканців не потрібно."
  ],
  "task.514D1204E5B8A0D2.title": "Відвідати: underground_villages:underground_village",
  "quest.514D11E0ED42C1FF.title": "Обмін без полів",
  "quest.514D11E0ED42C1FF.quest_subtitle": "Підготовка та маршрути",
  "quest.514D11E0ED42C1FF.quest_desc": [
    "Здійсни будь-яку успішну торгівлю з ванільним селянином. Обирай доступного ремісника та потрібний обмін: книга не вимагає аграрних поставок.",
    "Можна торгувати в підземному або поверхневому селі. Цей квест використовує ванільне досягнення й не підміняє окремий вступний квест Millénaire.",
    "Торгівля: натисни ПКМ по ванільному селянину без присідання, обери доступний обмін і забери його результат. Для досягнення потрібна завершена операція."
  ],
  "task.514D126CD02069A0.title": "Нативна перевірка: Обмін без полів",
  "quest.51301187E13DE6F8.title": "Твоя перша скриня Lootr",
  "quest.51301187E13DE6F8.quest_subtitle": "Lootr: особиста здобич",
  "quest.51301187E13DE6F8.quest_desc": [
    "Відкрий згенеровану Lootr-скриню. Її вміст обліковується для окремого гравця; цей квест фіксує саме відкриття.",
    "Lootr: підійди до згенерованого контейнера й натисни ПКМ по скрині, бочці, шалкеру або вагонетці без присідання. Відкривається твій особистий вміст; його отримання не потребує руйнування контейнера."
  ],
  "task.513012C7650C5C6E.title": "Нативна перевірка: Твоя перша скриня Lootr",
  "quest.51301171CFEAFCA1.title": "Здобич у бочці",
  "quest.51301171CFEAFCA1.quest_subtitle": "Lootr: особиста здобич",
  "quest.51301171CFEAFCA1.quest_desc": [
    "Відкрий згенеровану бочку Lootr під час дослідження."
  ],
  "task.513012BE7B2FCD42.title": "Нативна перевірка: Здобич у бочці",
  "quest.513011847267347F.title": "Таверна на шляху",
  "quest.513011847267347F.quest_subtitle": "Поселення й руїни",
  "quest.513011847267347F.quest_desc": [
    "Знайди одну з таверн Dungeons and Taverns. Вона може стати проміжною точкою далекої експедиції."
  ],
  "task.5130122D9FD1ACBE.title": "Нативна перевірка: Таверна на шляху",
  "quest.513011632A3488C8.title": "Узбережжя Ecologics",
  "quest.513011632A3488C8.quest_subtitle": "Ecologics та кобольди",
  "quest.513011632A3488C8.quest_desc": [
    "Збери кокос і мушлю під час природної експедиції узбережжям. Садити або автоматизувати плантацію не потрібно."
  ],
  "task.513012D09FD255FE.title": "1 × Coconut — без вилучення",
  "task.5130120458A77BAA.title": "1 × Seashell — без вилучення",
  "quest.513011D50C42C34D.title": "Човен прибережного маршруту",
  "quest.513011D50C42C34D.quest_subtitle": "Ecologics та кобольди",
  "quest.513011D50C42C34D.quest_desc": [
    "Створи човен зі скринею з кокосової деревини для перевезення експедиційних запасів."
  ],
  "task.51301218DC754589.title": "1 × Coconut Boat with Chest — без вилучення",
  "quest.513011C2A3830FC2.title": "Замок на піску",
  "quest.513011C2A3830FC2.quest_subtitle": "Ecologics та кобольди",
  "quest.513011C2A3830FC2.quest_desc": [
    "Постав Sandcastle за умовами нативного досягнення Ecologics. Це коротка будівельна ціль узбережжя."
  ],
  "task.513012818A3F23BA.title": "Нативна перевірка: Замок на піску",
  "quest.514D11A7ED9AA3BB.title": "Відомий шлях між точками",
  "quest.514D11A7ED9AA3BB.quest_subtitle": "Підготовка та маршрути",
  "quest.514D11A7ED9AA3BB.quest_desc": [
    "Відвідай міст і підземне село з попередніх квестів та підготуй Industrial Chassis для спорядженої майстерні.",
    "Підсумок зараховується автоматично за цими трьома виконаними залежностями. Познач маршрут на карті, щоб потім повернутися; будівництво дороги та дорожні знаки залишаються твоїм зручним проектом."
  ],
  "task.514D12480266404E.title": "Автоматично: міст, підземне село та майстерня відкриті",
  "quest.514D113C4B748351.title": "Лакі — це ще не обіцянка",
  "quest.514D113C4B748351.quest_subtitle": "Випадкові події й підсумок подорожі",
  "quest.514D113C4B748351.quest_desc": [
    "Ти побачив куб із сюрпризом і вирішив, що слово «сюрприз» означає щось приємне. Куб цінує такий оптимізм.",
    "У світі трапляються звичайні Chance Cubes. Існує сім рівнів Mayhem Cube з окремими пулами предметів, споруд і подій. Вибрані рубежі дають куби як особисті нагороди.",
    "Звичайний Chance Cube не має крафту. Перший квест цього маршруту все ще перевіряє саме знайдений нативний куб; наступний — його справжнє відкриття.",
    "Для обох видів кубів підготуй окремий майданчик і шлях відступу. Випадкова невдача є частиною задуму, а не поломкою завдання."
  ],
  "task.514D1275BFA9D311.title": "1 × Chance Cube — без вилучення",
  "quest.514D1118E4523B29.title": "Випадок прийняв запрошення",
  "quest.514D1118E4523B29.quest_subtitle": "Випадкові події й підсумок подорожі",
  "quest.514D1118E4523B29.quest_desc": [
    "Ти відкрив Chance Cube. Тепер у будь-якого результату є бездоганне пояснення: саме цього ти й попросив.",
    "Відкрий звичайний Chance Cube або квестовий Mayhem Cube. Квест автоматично читає спільний нативний лічильник chancecubes:opened_chance_cube; достатньо одного успішного відкриття.",
    "Постав куб у світі й зламай ЛКМ у режимі виживання. Для Mayhem Cube спочатку відкрий потрібний матеріальний етап; відмова у відкритті залишає куб цілим і не збільшує лічильник.",
    "Після дозволеного ламання Mayhem Cube сервер запускає подію та додає одне відкриття до лічильника. Самого отримання куба в нагороду недостатньо."
  ],
  "task.514D12A4E479FDFB.title": "Нативний лічильник Chance Cubes",
  "quest.514D118E5C7AB43A.title": "Мандрівник, інженер, шукач",
  "quest.514D118E5C7AB43A.quest_subtitle": "Випадкові події й підсумок подорожі",
  "quest.514D118E5C7AB43A.quest_desc": [
    "Заверши практику Ultimine, відвідай обидві нові структури, поторгуй із селянином і пройди першу випадкову подію.",
    "Цей завершальний вузол перевіряє готовність дорожнього набору; попередні залежності зберігають фактичні відвідування та торгівлю. Добровільні походи в інші виміри не блокують завершення."
  ],
  "task.514D123777356CD5.title": "1 × Compass — без вилучення",
  "quest.5130116C5420BD02.title": "Покинутий вантаж",
  "quest.5130116C5420BD02.quest_subtitle": "Lootr: особиста здобич",
  "quest.5130116C5420BD02.quest_desc": [
    "Відкрий вагонетку зі здобиччю Lootr."
  ],
  "task.513012471FFBD2DE.title": "Нативна перевірка: Покинутий вантаж",
  "quest.51301130E9666817.title": "Скарб у вазі",
  "quest.51301130E9666817.quest_subtitle": "Lootr: особиста здобич",
  "quest.51301130E9666817.quest_desc": [
    "Відкрий контейнер Lootr у вигляді оздобленої вази.",
    "Оздоблена ваза Lootr: натисни ПКМ по згенерованій вазі. Вона видає персональну здобич прямо у світ; окреме меню скрині для цього типу контейнера не відкривається."
  ],
  "task.513012A44DD1C166.title": "Нативна перевірка: Скарб у вазі",
  "quest.5130113F2D7C608A.title": "Десять знахідок",
  "quest.5130113F2D7C608A.quest_subtitle": "Lootr: особиста здобич",
  "quest.5130113F2D7C608A.quest_desc": [
    "Доведи нативний рахунок Lootr до 10. Рахунок визначає мод; повторна видача нагороди цим квестом вимкнена."
  ],
  "task.51301217E8C6CA1A.title": "Нативна перевірка: Десять знахідок",
  "quest.51301137773D35DA.title": "Пастка серед скринь",
  "quest.51301137773D35DA.quest_subtitle": "Lootr: особиста здобич",
  "quest.51301137773D35DA.quest_desc": [
    "Відкрий згенеровану trapped chest, яку обробляє Lootr. Підготуй відступ і не перенось цінності без потреби."
  ],
  "task.513012C389C13646.title": "Нативна перевірка: Пастка серед скринь",
  "quest.51301137ADA94BB4.title": "Вежа інженера",
  "quest.51301137ADA94BB4.quest_subtitle": "Вежі: початкові експедиції",
  "quest.51301137ADA94BB4.quest_desc": [
    "Досліди цю окрему споруду та оглянь її оточення. Залиш орієнтир або маршрут, щоб повернутися до бази."
  ],
  "task.51301207167C44F3.title": "Відвідати: structory_towers:engineer_tower",
  "quest.513011E27E20CABD.title": "Маяк на узбережжі",
  "quest.513011E27E20CABD.quest_subtitle": "Вежі: початкові експедиції",
  "quest.513011E27E20CABD.quest_desc": [
    "Досліди цю окрему споруду та оглянь її оточення. Залиш орієнтир або маршрут, щоб повернутися до бази."
