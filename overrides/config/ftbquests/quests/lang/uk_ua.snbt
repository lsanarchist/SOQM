  "quest.513011FEFCD336E1.title": "Полум'яний кулон",
  "quest.513011FEFCD336E1.quest_subtitle": "Бойові знахідки",
  "quest.513011FEFCD336E1.quest_desc": [
    "Знайди цей артефакт у звичайній пригоді та перевір його опис. Встановлюй його лише у дозволений слот Curios; властивості розвиваються через Reliquified Artifacts. Це добровільна колекційна ціль."
  ],
  "task.513012206B4CEA86.title": "1 × Полум'яний кулон — без вилучення",
  "quest.513011A145F95C06.title": "Шоковий кулон",
  "quest.513011A145F95C06.quest_subtitle": "Бойові знахідки",
  "quest.513011A145F95C06.quest_desc": [
    "Знайди цей артефакт у звичайній пригоді та перевір його опис. Встановлюй його лише у дозволений слот Curios; властивості розвиваються через Reliquified Artifacts. Це добровільна колекційна ціль."
  ],
  "task.513012395E8057F6.title": "1 × Шоковий кулон — без вилучення",
  "quest.51301109B4A01D11.title": "Обсидіановий череп",
  "quest.51301109B4A01D11.quest_subtitle": "Захист і витривалість",
  "quest.51301109B4A01D11.quest_desc": [
    "Знайди цей артефакт у звичайній пригоді та перевір його опис. Встановлюй його лише у дозволений слот Curios; властивості розвиваються через Reliquified Artifacts. Це добровільна колекційна ціль."
  ],
  "task.513012D805A388B1.title": "1 × Обсидіановий череп — без вилучення",
  "quest.513011A5B02EB801.title": "Посудина протиотрути",
  "quest.513011A5B02EB801.quest_subtitle": "Захист і витривалість",
  "quest.513011A5B02EB801.quest_desc": [
    "Знайди цей артефакт у звичайній пригоді та перевір його опис. Встановлюй його лише у дозволений слот Curios; властивості розвиваються через Reliquified Artifacts. Це добровільна колекційна ціль."
  ],
