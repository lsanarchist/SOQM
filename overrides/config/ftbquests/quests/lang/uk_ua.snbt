  ],
  "task.513012910E602EC7.title": "1 × Knowledge Holder — без вилучення",
  "quest.513011555532A97D.title": "Biome Absorber",
  "quest.513011555532A97D.quest_subtitle": "Дослідження й поглиначі",
  "quest.513011555532A97D.quest_desc": [
    "Компонент створення власного виміру. Вартість світу залежить від його параметрів; забезпеч постійне живлення й засіб повернення до першого входу. Довільні ресурсні світи належать пізній кампанії."
  ],
  "task.513012C2A630C3AE.title": "1 × Biome Absorber — без вилучення",
  "quest.513011ABB7B23B90.title": "Block Absorber",
  "quest.513011ABB7B23B90.quest_subtitle": "Дослідження й поглиначі",
  "quest.513011ABB7B23B90.quest_desc": [
    "Компонент створення власного виміру. Вартість світу залежить від його параметрів; забезпеч постійне живлення й засіб повернення до першого входу. Довільні ресурсні світи належать пізній кампанії."
  ],
  "task.513012E0BE212C09.title": "1 × Block Absorber — без вилучення",
  "quest.5130114BB60D0ED7.title": "Fluid Absorber",
  "quest.5130114BB60D0ED7.quest_subtitle": "Дослідження й поглиначі",
  "quest.5130114BB60D0ED7.quest_desc": [
    "Компонент створення власного виміру. Вартість світу залежить від його параметрів; забезпеч постійне живлення й засіб повернення до першого входу. Довільні ресурсні світи належать пізній кампанії."
  ],
  "task.51301274F5B920C5.title": "1 × Fluid Absorber — без вилучення",
  "chapter.513010A2BB1D25A2.title": "14 · Extreme Reactors",
  "chapter.513010A2BB1D25A2.chapter_subtitle": [
    "Збери паливну частину та керування, підключи обраний вихід FE, а потім переходь до посиленого реактора й парової турбіни. Активні та пасивні порти показано як варіанти.",
    "25 квестів · 4 послідовних виробничих секцій.",
    "Читай зверху вниз · наведи на квест, щоб побачити всі зв’язки",
    "Відкрий квест, щоб перевірити всі передумови, зокрема переходи до інших глав. Предметна задача перевіряє речі в інвентарі; опис пояснює складання й пробний запуск."
  ],
  "quest.513011F0C626AD17.title": "Extreme Wrench",
  "quest.513011F0C626AD17.quest_subtitle": "Графіт, паливо та інструмент",
  "quest.513011F0C626AD17.quest_desc": [
    "Збери базовий реактор під реальне споживання фабрики, організуй паливо й відхід. Потім вирішуй, чи потрібні більша конструкція, посилений рівень або турбіна.",
    "Extreme Reactors допомагає з електрикою. Матеріали ядерної прогресії Mekanism — окрема лінія глави 08; для ядра EMC знадобиться її антиматерія.",
    "Збери елемент Extreme Reactors. Розрізняй паливний стрижень і керувальний блок; перед завантаженням палива перевір сформованість реактора та вихід енергії."
  ],
  "task.513012EB7D8F6B10.title": "1 × Extreme Wrench — без вилучення",
  "quest.513011BFCD6008D7.title": "Графіт: матеріал реакторної гілки",
  "quest.513011BFCD6008D7.quest_subtitle": "Графіт, паливо та інструмент",
  "quest.513011BFCD6008D7.quest_desc": [
    "Підготуй Graphite для компонентів реактора. Центральна гілка проходить через корпус, паливні елементи й керування до готового комплекту; Yellorium збоку є одним із паливних матеріалів, а доступні уранові альтернативи дивись у JEI."
  ],
  "task.5130128F1054DBE1.title": "1 × Graphite Bar — без вилучення",
  "quest.5130110704EB117A.title": "Yellorium Ingot",
  "quest.5130110704EB117A.quest_subtitle": "Графіт, паливо та інструмент",
  "quest.5130110704EB117A.quest_desc": [
    "Збери елемент Extreme Reactors. Розрізняй паливний стрижень і керувальний блок; перед завантаженням палива перевір сформованість реактора та вихід енергії."
  ],
  "task.5130125E5A0EEB51.title": "1 × Yellorium Ingot — без вилучення",
  "quest.5130114528E50D7E.title": "Basic Reactor: почни з оболонки",
  "quest.5130114528E50D7E.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.5130114528E50D7E.quest_desc": [
    "Збери оболонку Basic Reactor з сумісних блоків і залиш місця для контролера, доступу до палива та потрібних виходів. Кількість у предметному завданні не є кресленням споруди — перевір вимоги розміру й складання в рідному посібнику Extreme Reactors."
  ],
  "task.5130120A6F892972.title": "1 × Reactor Casing (Basic) — без вилучення",
  "quest.513011862E2A45CA.title": "Паливні стовпці всередині корпуса",
  "quest.513011862E2A45CA.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.513011862E2A45CA.quest_desc": [
    "Fuel Rods формують внутрішні паливні стовпці. Розмісти їх відповідно до схеми реактора та підготуй Control Rod для кожного потрібного стовпця. Придатні варіанти матеріалів рецепта показані в JEI."
  ],
  "task.513012F83E09B99E.title": "1 × Reactor Fuel Rod (Basic) — без вилучення",
  "quest.5130118ED1242B42.title": "Керування паливними стовпцями",
  "quest.5130118ED1242B42.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.5130118ED1242B42.quest_desc": [
    "Control Rod керує відповідним паливним стовпцем. Перед першим запуском перевір, що всі елементи утворили правильну споруду й доступне керування реактором, а паливний порт має шлях для подачі та виведення."
  ],
  "task.513012676AF27FE2.title": "1 × Reactor Control Rod (Basic) — без вилучення",
  "quest.51301145D1657839.title": "Подача палива та виведення залишку",
  "quest.51301145D1657839.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.51301145D1657839.quest_desc": [
    "Solid Access Port з'єднує реактор із запасом палива та виведенням твердих відходів. Налаштуй відповідні режими й окремі інвентарі, щоб результат роботи не блокував наступні порції палива."
  ],
  "task.513012F336ED61DC.title": "1 × Reactor Solid Access Port (Basic) — без вилучення",
  "quest.5130114F4058570C.title": "Активний FE-вихід: один із варіантів",
  "quest.5130114F4058570C.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.5130114F4058570C.quest_desc": [
    "Цей Power Tap є варіантом підключення енергетичного виходу. Обери активний або пасивний спосіб відповідно до своєї мережі; для першої робочої установки не треба проходити обидві бічні гілки."
  ],
  "task.5130120FC14B809F.title": "1 × Reactor Active Forge Energy Power Tap (Basic) — без вилучення",
  "quest.51301145F95C79CF.title": "Пасивний FE-вихід: інший варіант",
  "quest.51301145F95C79CF.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.51301145F95C79CF.quest_desc": [
    "Пасивний Power Tap — альтернативне з'єднання з енергетичною мережею. Перевір режим суміжного кабелю чи споживача та переконайся, що енергія виходить із реактора."
  ],
  "task.51301225761E39D0.title": "1 × Reactor Passive Forge Energy Power Tap (Basic) — без вилучення",
  "quest.513011AB19DDDE4C.title": "Basic Reactor: комплект 3×3×3",
  "quest.513011AB19DDDE4C.quest_subtitle": "Базовий реактор і вихід FE",
  "quest.513011AB19DDDE4C.quest_desc": [
    "Мінімальний реактор 3×3×3: 22 Casing, Controller, Fuel Rod, Control Rod, Solid Access Port і Active FE Power Tap. Fuel Rod стоїть у єдиному внутрішньому блоці, Control Rod — у даху над ним.",
    "Це схема прямого виробництва FE. Через Access Port завантаж паливо; за потреби перемикай той самий порт для вилучення відходів. Скло — необов’язкова заміна корпусів на гранях.",
    "Після складання відкрий контролер і перевір формування. Завдання перевіряють матеріали, тому самі по собі не засвідчують справність або виробництво енергії.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.513012EB5434F4AA.title": "1 × Reactor Controller (Basic) — без вилучення",
  "quest.5130116F060F9DEC.title": "Reinforced Reactor: наступна конструкція",
  "quest.5130116F060F9DEC.quest_subtitle": "Посилений корпус та охолодження",
  "quest.5130116F060F9DEC.quest_desc": [
    "Після базового реактора ця гілка навчає посиленої конструкції та підготовки парового циклу. Рецепти корпусів можуть мати прямий крафт і переробку попередньої версії — обери доступний варіант у JEI, зберігаючи сумісність блоків однієї споруди."
  ],
  "task.513012E4850A7756.title": "1 × Reactor Casing (Reinforced) — без вилучення",
  "quest.51301107E386EFB8.title": "Reactor Fuel Rod (Reinforced)",
  "quest.51301107E386EFB8.quest_subtitle": "Посилений корпус та охолодження",
  "quest.51301107E386EFB8.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.513012601A827B5A.title": "1 × Reactor Fuel Rod (Reinforced) — без вилучення",
  "quest.513011FE729B76A7.title": "Reactor Control Rod (Reinforced)",
  "quest.513011FE729B76A7.quest_subtitle": "Посилений корпус та охолодження",
  "quest.513011FE729B76A7.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.51301232A6FF292B.title": "1 × Reactor Control Rod (Reinforced) — без вилучення",
  "quest.5130119494D319D8.title": "Reactor Active Forge Fluid Port (Reinforced)",
  "quest.5130119494D319D8.quest_subtitle": "Посилений корпус та охолодження",
  "quest.5130119494D319D8.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.5130124A4D200CD5.title": "1 × Reactor Active Forge Fluid Port (Reinforced) — без вилучення",
  "quest.513011E66B511C8A.title": "Reactor Passive Forge Fluid Port (Reinforced)",
  "quest.513011E66B511C8A.quest_subtitle": "Посилений корпус та охолодження",
  "quest.513011E66B511C8A.quest_desc": [
    "Ти порахував вихід енергії. Паливо ввічливо просить тепер порахувати й його.",
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.5130128DBA7C7DAA.title": "1 × Reactor Passive Forge Fluid Port (Reinforced) — без вилучення",
  "quest.51301107B8137F21.title": "Reactor Solid Access Port (Reinforced)",
  "quest.51301107B8137F21.quest_subtitle": "Посилений корпус та охолодження",
  "quest.51301107B8137F21.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.513012669070C58D.title": "1 × Reactor Solid Access Port (Reinforced) — без вилучення",
  "quest.5130110C4EA8DEFA.title": "Reactor Active Forge Energy Power Tap (Reinforced)",
  "quest.5130110C4EA8DEFA.quest_subtitle": "Посилений корпус та охолодження",
  "quest.5130110C4EA8DEFA.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.5130127DD81854F0.title": "1 × Reactor Active Forge Energy Power Tap (Reinforced) — без вилучення",
  "quest.51301193487DECA3.title": "Турбіна для парового циклу",
  "quest.51301193487DECA3.quest_subtitle": "Пара → ротор → електрика",
  "quest.51301193487DECA3.quest_desc": [
    "Turbine Casing використовує Cyanite з реакторної гілки та формує окрему споруду для пари. Reinforced Reactor не є інгредієнтом її рецепта: підготуй сумісне джерело пари, ротор, підшипник та індукційні котушки за рідним посібником. Предметні квести не перелічують усі блоки кожного можливого розміру."
  ],
  "task.5130129CB4CCDB25.title": "1 × Turbine Housing (Reinforced) — без вилучення",
  "quest.51301182A048FC8B.title": "Турбіна Extreme Reactors: комплект",
  "quest.51301182A048FC8B.quest_subtitle": "Пара → ротор → електрика",
  "quest.51301182A048FC8B.quest_desc": [
    "Найменша перевірена схема з окремими рівнями лопаті й котушки — асиметричний корпус 3×4×4 (X×Y×Z). У ньому 44 блоки оболонки: 39 Casing, Controller, Rotor Bearing, 2 Fluid Port і FE Power Tap.",
    "Від нижнього кута (0,0,0): Bearing постав у (1,3,1) спрямованим униз. Shaft — у (1,2,1) і (1,1,1). Єдина Blade — у (1,2,2), залізний блок котушки — у (1,1,2); у (1,0,1) залишається Casing. Так лопать і котушка займають різні рівні вздовж осі.",
    "Контролер і порти розмісти на інших гранях без заміни ребер. Один Fluid Port приймає пару, другий повертає воду. Увімкни котушку в контролері та подай малий потік пари. Цей компактний стенд придатний для першого виробництва; для промислової потужності потрібне розширення.",
    "Квест перевіряє повний комплект. Перевір формування та приріст FE у контролері після складання.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.5130128B78D56FBD.title": "1 × Turbine Controller (Reinforced) — без вилучення",
  "quest.5130117DD8F75308.title": "Вісь перед лопатями",
  "quest.5130117DD8F75308.quest_subtitle": "Пара → ротор → електрика",
  "quest.5130117DD8F75308.quest_desc": [
    "Rotor Shaft задає вісь турбіни. Розташуй вал, лопаті та підшипник як одну коректну конструкцію, а індукційні котушки — за правилами посібника. Далі контролер об'єднує цей комплект."
  ],
  "task.513012A46E88916C.title": "1 × Turbine Rotor Shaft (Reinforced) — без вилучення",
  "quest.5130112AA6480CE8.title": "Turbine Rotor Blade (Reinforced)",
  "quest.5130112AA6480CE8.quest_subtitle": "Пара → ротор → електрика",
  "quest.5130112AA6480CE8.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.513012BD52952E61.title": "1 × Turbine Rotor Blade (Reinforced) — без вилучення",
  "quest.513011EA1BEE4329.title": "Turbine Rotor Bearing (Reinforced)",
  "quest.513011EA1BEE4329.quest_subtitle": "Пара → ротор → електрика",
  "quest.513011EA1BEE4329.quest_desc": [
    "Паливні елементи стоять рівно. Твій розрахунок бюджету все ще трохи хитається.",
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.513012CC33D55381.title": "1 × Turbine Rotor Bearing (Reinforced) — без вилучення",
  "quest.5130116A01924E20.title": "Turbine Active Forge Fluid Port (Reinforced)",
  "quest.5130116A01924E20.quest_subtitle": "Пара → ротор → електрика",
  "quest.5130116A01924E20.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.513012C6B1664021.title": "1 × Turbine Active Forge Fluid Port (Reinforced) — без вилучення",
  "quest.5130110D2A82691E.title": "Turbine Active Forge Energy Power Tap (Reinforced)",
  "quest.5130110D2A82691E.quest_subtitle": "Пара → ротор → електрика",
  "quest.5130110D2A82691E.quest_desc": [
    "Підготуй вузол розширеної реакторної системи. Визнач режим реактора й маршрут тепла або пари до турбіни; окремий блок у руках не доводить правильність мультиблока."
  ],
  "task.5130125491F6D6DD.title": "1 × Turbine Active Forge Energy Power Tap (Reinforced) — без вилучення",
  "quest.513011FE8D522CBB.title": "Reinforced Reactor: комплект 3×3×3",
  "quest.513011FE8D522CBB.quest_subtitle": "Посилений корпус та охолодження",
  "quest.513011FE8D522CBB.quest_desc": [
    "Мінімальний реактор 3×3×3: 22 Casing, Controller, Fuel Rod, Control Rod, Solid Access Port і Active FE Power Tap. Fuel Rod стоїть у єдиному внутрішньому блоці, Control Rod — у даху над ним.",
    "Це схема прямого виробництва FE. Через Access Port завантаж паливо; за потреби перемикай той самий порт для вилучення відходів. Скло — необов’язкова заміна корпусів на гранях.",
    "Після складання відкрий контролер і перевір формування. Завдання перевіряють матеріали, тому самі по собі не засвідчують справність або виробництво енергії.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.51301262D9124DDE.title": "1 × Reactor Controller (Reinforced) — без вилучення",
  "chapter.513010F3A21BB8B2.title": "15 · Мана, руни й ельфійська інженерія",
  "chapter.513010F3A21BB8B2.chapter_subtitle": [
    "75 квестів · 10 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.513011DEB02F16A6.title": "Книга відповідає на блок",
  "quest.513011DEB02F16A6.quest_subtitle": "Початок і живі матеріали",
  "quest.513011DEB02F16A6.quest_desc": [
    "Скористайся Lexica Botania для контекстного вивчення підтримуваного предмета чи блока.",
    "Lexica Botania: візьми книгу в руку й натисни ПКМ у повітря. Шукай розділ потрібного блока, квітки або ритуалу; басейн і рунічний вівтар показують стан у світі, а не у звичайному вікні скрині."
  ],
  "task.51301213667D6446.title": "Нативна перевірка: Книга відповідає на блок",
  "quest.513011BD49DF9AAC.title": "Лексика Botania",
  "quest.513011BD49DF9AAC.quest_subtitle": "Початок і живі матеріали",
  "quest.513011BD49DF9AAC.quest_desc": [
    "Почни з Pure Daisy, матеріалів майстерні та передачі мани в басейн. Після цього освоюй Runic Altar й терасталь: саме вона є першим великим внеском Botania у вимірну матрицю «Головний маршрут».",
    "Пізній маршрут веде через ельфійський обмін і Guardian of Gaia до Gaia Ingot. Цей злиток потрібний міфічній схемі та ядру EMC.",
    "Скористайся Lexica Botania для прив’язування квітів і передавання мани. Квітка тут є магічним пристроєм; кампанія не вимагає селекції ресурсних культур чи великих полів.",
    "Lexica Botania: візьми книгу в руку й натисни ПКМ у повітря. Шукай розділ потрібного блока, квітки або ритуалу; басейн і рунічний вівтар показують стан у світі, а не у звичайному вікні скрині."
  ],
  "task.5130122DA69C06FC.title": "1 × Лексика Botania — без вилучення",
  "quest.513011FFAB5983EB.title": "Пелюстковий аптекар",
  "quest.513011FFAB5983EB.quest_subtitle": "Початок і живі матеріали",
  "quest.513011FFAB5983EB.quest_desc": [
    "Наповни Petal Apothecary водою, кинь усередину потрібні Mystical Petals, а останнім додай насіння: воно завершує створення квітки. Вода витрачається на операцію, тому перед наступною квіткою наповни чашу знову.",
    "Помилковий останній інгредієнт можна вийняти порожньою рукою. Лава перетворює чашу на спалювач предметів; для квітів потрібна саме вода."
  ],
  "task.5130129CD4FBF5ED.title": "1 × Пелюстковий аптекар — без вилучення",
  "quest.51301143DCC22642.title": "Чиста ромашка",
  "quest.51301143DCC22642.quest_subtitle": "Початок і живі матеріали",
  "quest.51301143DCC22642.quest_desc": [
    "Pure Daisy виготовляється з чотирьох білих Mystical Petals у наповненій водою Petal Apothecary; заверши рецепт насінням.",
    "Посади квітку й розмісти навколо неї на тому самому рівні камінь або колоди. Приблизно за хвилину вони стануть Livingrock або Livingwood. Це перетворення встановлених блоків, а не предметів, кинутих на землю."
  ],
  "task.5130122C92775F0E.title": "1 × Чиста ромашка — без вилучення",
  "quest.513011646F4E0BF3.title": "Живокамінь",
  "quest.513011646F4E0BF3.quest_subtitle": "Початок і живі матеріали",
  "quest.513011646F4E0BF3.quest_desc": [
    "Для Livingrock постав звичайний Stone у сусідні клітинки навколо Pure Daisy й дочекайся перетворення. Cobblestone спочатку переплав у Stone.",
    "Відклади Livingrock для Mana Pool та Runic Altar. Під час виготовлення рун один Livingrock також додається наприкінці операції, тому не витрачай весь запас на будівництво."
  ],
  "task.51301294E41BBD8B.title": "1 × Живокамінь — без вилучення",
  "quest.51301142CC660B14.title": "Життєдрево",
  "quest.51301142CC660B14.quest_subtitle": "Початок і живі матеріали",
  "quest.51301142CC660B14.quest_desc": [
    "Livingwood починається зі звичайних колод, поставлених навколо Pure Daisy. Квітка перетворює блоки у світі; купка дощок поряд із нею не є заміною.",
    "Збережи частину цілих блоків для Mana Spreader і майбутнього ельфійського порталу. Іншу частину перероби на Livingwood Twigs для Wand of the Forest."
  ],
  "task.513012CE3446BB4F.title": "1 × Життєдрево — без вилучення",
  "quest.513011302BF63D2D.title": "Гілка життєдрева",
  "quest.513011302BF63D2D.quest_subtitle": "Початок і живі матеріали",
  "quest.513011302BF63D2D.quest_desc": [
    "Скористайся Lexica Botania для прив’язування квітів і передавання мани. Квітка тут є магічним пристроєм; кампанія не вимагає селекції ресурсних культур чи великих полів."
  ],
  "task.5130124525CDA456.title": "1 × Гілка життєдрева — без вилучення",
  "quest.513011B73289AB0C.title": "Жезл лісу",
  "quest.513011B73289AB0C.quest_subtitle": "Початок і живі матеріали",
  "quest.513011B73289AB0C.quest_desc": [
    "Wand of the Forest потрібна для зв’язування квітів, спрямування Mana Spreader і перевірки запасу мани. У Bind Mode вибери джерело через Shift+ПКМ, потім так само вибери його ціль.",
    "Режими Bind і Function перемикаються через Shift+ПКМ у повітрі. Якщо зв’язок не створюється, спочатку перевір режим; у Function Mode ця дія має інше призначення."
  ],
  "task.51301297B1C0E153.title": "1 × Жезл лісу — без вилучення",
  "quest.513011FB47984BCA.title": "Жаржина",
  "quest.513011FB47984BCA.quest_subtitle": "Генерація та зберігання мани",
  "quest.513011FB47984BCA.quest_desc": [
    "Endoflame спалює придатне паливо, кинуте біля квітки, та виробляє ману. Зв’яжи її з Mana Spreader і спрямуй розповсюджувач на Mana Pool; сама скриня з вугіллям поряд квітку не годує.",
    "Для першої автоматизації подавай вугілля через Open Crate малими порціями з обмежувачем подачі. Lava Bucket не підходить: Endoflame не спалює паливо, яке залишає порожню тару."
  ],
  "task.51301235C9C65EE3.title": "1 × Жаржина — без вилучення",
  "quest.513011A3EFF0DCA5.title": "Розбавлений басейн мани",
  "quest.513011A3EFF0DCA5.quest_subtitle": "Генерація та зберігання мани",
  "quest.513011A3EFF0DCA5.quest_desc": [
    "Diluted Mana Pool — маленький початковий резервуар. Спрямуй у нього Mana Spreader і перевір заповнення Wand of the Forest.",
    "Звичайний Mana Pool уміщує у сто разів більше мани. Перед дорогими ритуалами переходь на повний басейн: зовні схожий малий резервуар не дає такого запасу."
  ],
  "task.513012F9B6E0A62F.title": "1 × Розбавлений басейн мани — без вилучення",
  "quest.513011DB110983FB.title": "Басейн мани",
  "quest.513011DB110983FB.quest_subtitle": "Генерація та зберігання мани",
  "quest.513011DB110983FB.quest_desc": [
    "Mana Pool накопичує ману від розповсюджувача та витрачає її на перетворення предметів. Для проби кинь у достатньо наповнений басейн залізний злиток і забери Manasteel.",
    "Басейн не виробляє ману сам. Якщо перетворення не починається, перевір генераторну квітку, її зв’язок, напрямок Mana Spreader і реальний запас у басейні."
  ],
  "task.513012B7B053A7F8.title": "1 × Басейн мани — без вилучення",
  "quest.513011EAB08A97F7.title": "Рунічний вівтар",
  "quest.513011EAB08A97F7.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.513011EAB08A97F7.quest_desc": [
    "У SOQM Runic Altar потребує Precision Mechanism, Arcane Conduit і Control Assembly. Після його виготовлення поклади інгредієнти руни на вівтар і спрямуй на нього Mana Spreader із джерелом мани.",
    "Коли вівтар набере потрібну ману, додай Livingrock і застосуй Wand of the Forest. Саме цей завершальний крок видає руну; заповнена шкала ще не означає отриманий предмет.",
    "Гарантоване повернення витрачених компонентів: 1 × Арканний провідник.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Рунічний вівтар» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.51301290B2693E91.title": "1 × Рунічний вівтар — без вилучення",
  "quest.51301124D2008767.title": "Руна води",
  "quest.51301124D2008767.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.51301124D2008767.quest_desc": [
    "Для двох Rune of Water поклади на Runic Altar Mana Powder, Manasteel Ingot, Bone Meal, Sugar Cane та Fishing Rod. Подай ману, а наприкінці додай Livingrock і застосуй Wand of the Forest.",
    "Одна з рун води потрібна для Terrestrial Agglomeration Plate. Другу зручно залишити для наступних рун: руни, використані в інших рецептах самого Runic Altar, повертаються після операції."
  ],
  "task.5130128C502C3758.title": "1 × Руна води — без вилучення",
  "quest.5130110CA84E744C.title": "Руна вогню",
  "quest.5130110CA84E744C.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.5130110CA84E744C.quest_desc": [
    "Rune of Fire робиться на Runic Altar із Mana Powder, Manasteel Ingot, Nether Brick, Gunpowder та Nether Wart. Потрібна одна окрема незерська цеглина, а не блок Nether Bricks.",
    "Після подачі мани заверши операцію Livingrock і Wand of the Forest. Партія дає дві руни; одна входить до Terrestrial Agglomeration Plate."
  ],
  "task.513012F3A09D914B.title": "1 × Руна вогню — без вилучення",
  "quest.51301159DE8C0561.title": "Руна землі",
  "quest.51301159DE8C0561.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.51301159DE8C0561.quest_desc": [
    "Rune of Earth потребує Mana Powder, Manasteel Ingot, звичайний Stone, Block of Coal і червоний або коричневий гриб. Це рецепт Runic Altar із виходом дві руни.",
    "Для завершення потрібні мана, Livingrock та Wand of the Forest. Відклади одну руну землі для плити виробництва Terrasteel."
  ],
  "task.5130129F899A3D13.title": "1 × Руна землі — без вилучення",
  "quest.513011C8F223AF42.title": "Руна повітря",
  "quest.513011C8F223AF42.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.513011C8F223AF42.quest_desc": [
    "Rune of Air створюється на Runic Altar з Mana Powder, Manasteel Ingot, вовняного килима, пера й нитки. Після подачі мани заверши операцію Livingrock та Wand of the Forest.",
    "Партія дає дві руни повітря. Вони потрібні складнішим рунам, а одна також входить до Terrestrial Agglomeration Plate."
  ],
  "task.51301276BBFA77B7.title": "1 × Руна повітря — без вилучення",
  "quest.513011EE2F57F8CC.title": "Руна мани",
  "quest.513011EE2F57F8CC.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.513011EE2F57F8CC.quest_desc": [
    "Rune of Mana має окремий рецепт: п’ять Manasteel Ingots і одна Mana Pearl у Runic Altar. Він дає одну руну та потребує більше мани, ніж базові стихійні руни.",
    "Заверши операцію Livingrock і Wand of the Forest. Разом із чотирма стихійними рунами ця руна відкриває виготовлення Terrestrial Agglomeration Plate."
  ],
  "task.51301218C7E617DE.title": "1 × Руна мани — без вилучення",
  "quest.513011856E55B526.title": "Руна весни",
  "quest.513011856E55B526.quest_subtitle": "Сезонні руни",
  "quest.513011856E55B526.quest_desc": [
    "Зроби цю руну на Runic Altar. Перед початком підготуй всі інгредієнти, джерело мани та завершальний крок із Livingrock; руни попередніх рівнів беруть участь у складніших формулах."
  ],
  "task.513012FEA8B890F1.title": "1 × Руна весни — без вилучення",
  "quest.513011D93FA8E783.title": "Руна літа",
  "quest.513011D93FA8E783.quest_subtitle": "Сезонні руни",
  "quest.513011D93FA8E783.quest_desc": [
    "Зроби цю руну на Runic Altar. Перед початком підготуй всі інгредієнти, джерело мани та завершальний крок із Livingrock; руни попередніх рівнів беруть участь у складніших формулах."
  ],
  "task.51301217B79E02C8.title": "1 × Руна літа — без вилучення",
  "quest.51301148936871B2.title": "Руна осені",
  "quest.51301148936871B2.quest_subtitle": "Сезонні руни",
  "quest.51301148936871B2.quest_desc": [
    "Зроби цю руну на Runic Altar. Перед початком підготуй всі інгредієнти, джерело мани та завершальний крок із Livingrock; руни попередніх рівнів беруть участь у складніших формулах."
  ],
  "task.5130122021B036AA.title": "1 × Руна осені — без вилучення",
  "quest.513011A9E7BFB8CE.title": "Руна зими",
  "quest.513011A9E7BFB8CE.quest_subtitle": "Сезонні руни",
  "quest.513011A9E7BFB8CE.quest_desc": [
    "Зроби цю руну на Runic Altar. Перед початком підготуй всі інгредієнти, джерело мани та завершальний крок із Livingrock; руни попередніх рівнів беруть участь у складніших формулах."
  ],
  "task.5130121418E9EDEC.title": "1 × Руна зими — без вилучення",
  "quest.513011B5525C0FAB.title": "Руна хтивості",
  "quest.513011B5525C0FAB.quest_subtitle": "Сезонні руни",
  "quest.513011B5525C0FAB.quest_desc": [
    "Зроби цю руну на Runic Altar. Перед початком підготуй всі інгредієнти, джерело мани та завершальний крок із Livingrock; руни попередніх рівнів беруть участь у складніших формулах."
  ],
  "task.51301226D26EFE90.title": "1 × Руна хтивості — без вилучення",
  "quest.5130118499B8884C.title": "Відкритий ящик",
  "quest.5130118499B8884C.quest_subtitle": "Генерація та зберігання мани",
  "quest.5130118499B8884C.quest_desc": [
    "Open Crate викидає отримані предмети точно під собою. Подай їх зверху лійкою або іншою транспортною системою; це зручний спосіб годувати Endoflame без ручного кидання.",
    "Обмежуй саме подачу предметів таймером або датчиком. Редстоун на самій Open Crate змінює затримку підбирання предметів деякими квітами, тому не вважай його універсальною кнопкою зупинки."
  ],
  "task.51301272E1CD72CE.title": "1 × Відкритий ящик — без вилучення",
  "quest.5130115F50002513.title": "Воронкальва",
  "quest.5130115F50002513.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.5130115F50002513.quest_desc": [
    "Hopperhock підбирає предмети із землі й складає їх у сусідні інвентарі. Постав поруч скриню та кинь тестовий предмет; мана для базової роботи не потрібна, але збільшує радіус.",
    "Рамки з предметами на приймачах задають сортування. Біля ритуальної плити або Endoflame підбирай фільтр і розташування так, щоб квітка не забирала ще не використані інгредієнти чи паливо."
  ],
  "task.513012DF990E8158.title": "1 × Воронкальва — без вилучення",
  "quest.513011F58C65D660.title": "Ранункарпус",
  "quest.513011F58C65D660.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.513011F58C65D660.quest_desc": [
    "Rannuncarpus ставить знайдені поряд предмети як блоки. Зразок поверхні поклади під блок ґрунту, на якому росте квітка: вона шукатиме саме такі опорні блоки.",
    "Спочатку випробуй установлення кількох дешевих блоків на окремій ділянці. Мана збільшує радіус, але не скасовує звичайні правила розміщення, наприклад потребу очерету у воді."
  ],
  "task.513012FF293D4751.title": "1 × Ранункарпус — без вилучення",
  "quest.513011320C984713.title": "Пісочний годинник",
  "quest.513011320C984713.quest_subtitle": "Генерація та зберігання мани",
  "quest.513011320C984713.quest_desc": [
    "Hovering Hourglass видає повторний редстоун-імпульс, коли пересиплеться весь пісок. Один звичайний Sand задає секунду, Red Sand — десять секунд, Soul Sand — хвилину; кількість предметів множить інтервал.",
    "Використай таймер для дозованої подачі палива або предметів. Перевір інтервал Wand of the Forest і фактичний рух одного предмета, перш ніж запускати повний запас."
  ],
  "task.5130125B41D665B5.title": "1 × Пісочний годинник — без вилучення",
  "quest.513011D5B7ED0426.title": "Мана-детектор",
  "quest.513011D5B7ED0426.quest_subtitle": "Генерація та зберігання мани",
  "quest.513011D5B7ED0426.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.513012698B40F4C0.title": "1 × Мана-детектор — без вилучення",
  "quest.5130115554DD128F.title": "Розділювач мани",
  "quest.5130115554DD128F.quest_subtitle": "Генерація та зберігання мани",
  "quest.5130115554DD128F.quest_desc": [
    "Mana Splitter приймає Mana Bursts та ділить отриману ману між Mana Pools, поставленими з його боків. Спрямуй розповсюджувач на сам розподільник.",
    "Цей блок розподіляє нову подачу, а не створює додаткову ману. Порівняй заповнення сусідніх басейнів після кількох імпульсів."
  ],
  "task.51301232773A738D.title": "1 × Розділювач мани — без вилучення",
  "quest.513011D3AA93F16F.title": "Мана-порожнина",
  "quest.513011D3AA93F16F.quest_subtitle": "Генерація та зберігання мани",
  "quest.513011D3AA93F16F.quest_desc": [
    "Mana Void безповоротно знищує ману, яку отримує. Під Mana Pool він дозволяє приймати подальшу подачу навіть після заповнення басейну, але надлишок зникає.",
    "Застосовуй його лише там, де свідомо потрібне скидання надлишку. Для збереження енергії спочатку збільшуй місткість басейнів або обмежуй генерацію."
  ],
  "task.513012399A7F96DB.title": "1 × Мана-порожнина — без вилучення",
  "quest.51301160448F0207.title": "Імпульсовий розсіювач мани",
  "quest.51301160448F0207.quest_subtitle": "Генерація та зберігання мани",
  "quest.51301160448F0207.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.51301237996B8C10.title": "1 × Імпульсовий розсіювач мани — без вилучення",
  "quest.51301144C02BB91C.title": "Міхи мани",
  "quest.51301144C02BB91C.quest_subtitle": "Стихійні руни й автоматизація",
  "quest.51301144C02BB91C.quest_desc": [
    "Manatide Bellows, спрямовані на Mana Pool, прискорюють передавання мани з басейну в Mana Tablets та інші предмети. Постав міхи збоку й зорієнтуй їх до басейну.",
    "Вони не підвищують виробництво квітів. Перевір ефект на заряджанні одного предмета, щоб не переплутати швидкість передавання із запасом або генерацією мани."
  ],
  "task.5130120E227B2EF8.title": "1 × Міхи мани — без вилучення",
  "quest.51301151FAB0C0E1.title": "Мана-лінза",
  "quest.51301151FAB0C0E1.quest_subtitle": "Лінзи",
  "quest.51301151FAB0C0E1.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.51301239430CDE71.title": "1 × Мана-лінза — без вилучення",
  "quest.513011B19F1F98A5.title": "Мана-лінза: Швидкість",
  "quest.513011B19F1F98A5.quest_subtitle": "Лінзи",
  "quest.513011B19F1F98A5.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.513012513DA9FEE9.title": "1 × Мана-лінза: Швидкість — без вилучення",
  "quest.513011CCCC7AED86.title": "Мана-лінза: Потенція",
  "quest.513011CCCC7AED86.quest_subtitle": "Лінзи",
  "quest.513011CCCC7AED86.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.513012F8896532A4.title": "1 × Мана-лінза: Потенція — без вилучення",
  "quest.513011A84A267B2A.title": "Мана-лінза: Ефективність",
  "quest.513011A84A267B2A.quest_subtitle": "Лінзи",
  "quest.513011A84A267B2A.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.513012A9BF4F5A85.title": "1 × Мана-лінза: Ефективність — без вилучення",
  "quest.51301105B3645AB0.title": "Мана-лінза: Відскок",
  "quest.51301105B3645AB0.quest_subtitle": "Лінзи",
  "quest.51301105B3645AB0.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.513012F99D5A6F4D.title": "1 × Мана-лінза: Відскок — без вилучення",
  "quest.513011B3EC48A328.title": "Мана-лінза: Магнетизм",
  "quest.513011B3EC48A328.quest_subtitle": "Лінзи",
  "quest.513011B3EC48A328.quest_desc": [
    "Налаштуй конкретний елемент магічної автоматизації. Перевір шлях імпульсу або предмета на маленькій схемі; іскри й розповсюджувачі передають ману різними способами."
  ],
  "task.5130126CA892BBC4.title": "1 × Мана-лінза: Магнетизм — без вилучення",
  "quest.5130118142869DDE.title": "Злиток терасталі",
  "quest.5130118142869DDE.quest_subtitle": "Терасталь та Alfheim",
  "quest.5130118142869DDE.quest_desc": [
    "Для Terrasteel потрібна Terrestrial Agglomeration Plate на основі з Livingrock і Lapis Lazuli Blocks за схемою Lexica. Забезпеч запас приблизно половини звичайного Mana Pool; Sparks над басейном і плитою зручно передають цю ману.",
    "Кинь на готову плиту по одному Manasteel Ingot, Mana Diamond та Mana Pearl. Не підбирай їх до завершення й вимкни поряд магніти або збирачі: вилучення інгредієнта перериває процес із втратою вже переданої мани.",
    "Для партії двох Dimensional Matrices відклади два Terrasteel Ingots. Спорядження з терасталі можна робити після цього запасу."
  ],
  "task.51301253FE05AAAA.title": "1 × Злиток терасталі — без вилучення",
  "quest.5130115FFF875380.title": "Пилок феї",
  "quest.5130115FFF875380.quest_subtitle": "Терасталь та Alfheim",
  "quest.5130115FFF875380.quest_desc": [
    "Pixie Dust отримують через ельфійський портал: одна Mana Pearl обмінюється на одну порцію пилу. Спочатку перетвори звичайну Ender Pearl у Mana Pool.",
    "Підтримуй ману в портальних басейнах і подавай саме Mana Pearl. Звичайна перлина Краю не є входом цього ельфійського рецепта."
  ],
  "task.513012C3E9B4ABA9.title": "1 × Пилок феї — без вилучення",
  "quest.5130112EF6C53689.title": "Ядро ельфійських воріт",
  "quest.5130112EF6C53689.quest_subtitle": "Терасталь та Alfheim",
  "quest.5130112EF6C53689.quest_desc": [
    "Elven Gateway Core у SOQM потребує Dimensional Matrix. Для робочого порталу додатково підготуй Livingwood, Glimmering Livingwood і щонайменше два Mana Pools із Natura Pylons над ними.",
    "Це шлюз обміну предметами з ельфами. Побудуй його за об’ємною схемою Lexica; заходити крізь нього для переходу в інший вимір не потрібно й неможливо."
  ],
  "task.51301288F9A0896E.title": "1 × Ядро ельфійських воріт — без вилучення",
  "quest.5130119992BFAE06.title": "Портал ельфів відкрито",
  "quest.5130119992BFAE06.quest_subtitle": "Терасталь та Alfheim",
  "quest.5130119992BFAE06.quest_desc": [
    "Портал Alfheim: 8 Livingwood, 3 Glimmering Livingwood та Portal Core утворюють рамку; поруч постав 2 Mana Pool з Natura Pylon над кожним. Наповни обидва басейни маною й активуй ядро Wand of the Forest.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Наповни обидва басейни ельфійського порталу й активуй його ядро Wand of the Forest. Natura Pylons мають стояти безпосередньо над басейнами поблизу ядра; мана витрачається на відкриття та обмін.",
    "Нативне досягнення перевіряє відкриття порталу. Після цього кинь у нього Lexica Botania, щоб отримати доповнені ельфійські знання, або випробуй один відомий рецепт обміну. Якщо один із потрібних басейнів спорожніє, зв’язок закриється."
  ],
  "task.51301293F80F9722.title": "Нативна перевірка: Портал ельфів відкрито",
  "quest.51301132DB8080C3.title": "Імпульс мани з рук",
  "quest.51301132DB8080C3.quest_subtitle": "Зброя та жезли",
  "quest.51301132DB8080C3.quest_desc": [
    "Вистріли Mana Blaster через штатну дію предмета. Підготуй сумісне джерело мани."
  ],
  "task.513012187EED3C2E.title": "Нативна перевірка: Імпульс мани з рук",
  "quest.51301173A1581288.title": "Плита агломерації: повний майданчик",
  "quest.51301173A1581288.quest_subtitle": "Терасталь та Alfheim",
  "quest.51301173A1581288.quest_desc": [
    "Плита Terra: підготуй основу 3×3 з 5 Livingrock і 4 Lapis Blocks; Terra Plate ставиться над центральним Livingrock. Ману підведи окремо через сумісний Spreader або Sparks.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Terrestrial Agglomeration Plate — пристрій для Terrasteel. Її рецепт у SOQM поєднує Rune of Water, Fire, Earth, Air і Mana, блок Manasteel, лазурит та Precision Mechanism.",
    "Після крафту побудуй під плитою основу зі схеми Lexica й підведи ману. Окремий блок плити у світі ще не є готовою установкою для сплаву."
  ],
  "task.513012DCB3FCD521.title": "1 × Terrestrial Agglomeration Plate — без вилучення",
  "quest.513011C18D8A2E63.title": "Природний пілон",
  "quest.513011C18D8A2E63.quest_subtitle": "Терасталь та Alfheim",
  "quest.513011C18D8A2E63.quest_desc": [
    "Natura Pylon обслуговує ельфійський портал разом із Mana Pool безпосередньо під ним. Для першого шлюзу потрібні щонайменше дві такі пари поблизу Elven Gateway Core.",
    "Пілон сам не містить запасу мани. Перевір заповнення кожного басейну: один повний резервуар не компенсує порожній басейн іншої пари."
  ],
  "task.513012ADD88D1767.title": "1 × Природний пілон — без вилучення",
  "quest.513011DB791EB2AB.title": "Мрійдрево",
  "quest.513011DB791EB2AB.quest_subtitle": "Терасталь та Alfheim",
  "quest.513011DB791EB2AB.quest_desc": [
    "Dreamwood для цього квесту отримують ельфійським обміном із блока Livingwood: один на один. Підготуй сировину через Pure Daisy, потім передай її у працюючий портал.",
    "У мода є також окремі варіанти колод. Якщо квест просить саме Dreamwood, збережи відповідний звичайний блок до розпилювання на дошки або витрати в пристроях."
  ],
  "task.5130123532ED8E3C.title": "1 × Мрійдрево — без вилучення",
  "quest.513011FCFC519460.title": "Злиток елементія",
  "quest.513011FCFC519460.quest_subtitle": "Терасталь та Alfheim",
  "quest.513011FCFC519460.quest_desc": [
    "Два Manasteel Ingots у працюючому ельфійському порталі дають один Elementium Ingot. Підготуй виробництво Manasteel і запас мани для обміну.",
    "Elementium потрібний ельфійським інструментам і складнішим пристроям. Плануй подачу з урахуванням співвідношення 2:1, а не як просте перейменування одного злитка."
  ],
  "task.51301282F1DE6FC2.title": "1 × Злиток елементія — без вилучення",
  "quest.513011A5E3EF8710.title": "Дракон-камінь",
  "quest.513011A5E3EF8710.quest_subtitle": "Терасталь та Alfheim",
  "quest.513011A5E3EF8710.quest_desc": [
    "Dragonstone отримують ельфійським обміном із Mana Diamond у співвідношенні 1:1. Спершу насить звичайний діамант маною в басейні.",
    "Це ботанічний матеріал: для цього рецепта не потрібне вбивство дракона. Перевір роботу порталу однією Mana Diamond перед великою партією."
  ],
  "task.513012975F1FCA64.title": "1 × Дракон-камінь — без вилучення",
  "quest.513011E3EC40F79D.title": "Ельфійське скло",
  "quest.513011E3EC40F79D.quest_subtitle": "Терасталь та Alfheim",
  "quest.513011E3EC40F79D.quest_desc": [
    "Отримай компонент ельфійського або террасталевого рівня. Terrasteel потребує запасу мани; ельфійський портал і ритуал Gaia мають окремі вимоги до споруди та ресурсів."
  ],
  "task.5130124AC0BC4B0C.title": "1 × Ельфійське скло — без вилучення",
  "quest.5130114C6314ADFB.title": "Ельфійський розсіювач мани",
  "quest.5130114C6314ADFB.quest_subtitle": "Терасталь та Alfheim",
  "quest.5130114C6314ADFB.quest_desc": [
    "Отримай компонент ельфійського або террасталевого рівня. Terrasteel потребує запасу мани; ельфійський портал і ритуал Gaia мають окремі вимоги до споруди та ресурсів."
  ],
  "task.51301282A6C8AB7F.title": "1 × Ельфійський розсіювач мани — без вилучення",
  "quest.5130112A2549A2A2.title": "Кало з манасталі",
  "quest.5130112A2549A2A2.quest_subtitle": "Манасталеве спорядження",
  "quest.5130112A2549A2A2.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.5130124B87AB4C96.title": "1 × Кало з манасталі — без вилучення",
  "quest.5130110E417B9279.title": "Меч з манасталі",
  "quest.5130110E417B9279.quest_subtitle": "Манасталеве спорядження",
  "quest.5130110E417B9279.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.513012D59B63D97B.title": "1 × Меч з манасталі — без вилучення",
  "quest.51301161699ED361.title": "Ножиці з манасталі",
  "quest.51301161699ED361.quest_subtitle": "Манасталеве спорядження",
  "quest.51301161699ED361.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.5130124F4A0D555C.title": "1 × Ножиці з манасталі — без вилучення",
  "quest.51301188861C21A4.title": "Тканина з мана-мережива",
  "quest.51301188861C21A4.quest_subtitle": "Манасталеве спорядження",
  "quest.51301188861C21A4.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.513012D7A432A157.title": "1 × Тканина з мана-мережива — без вилучення",
  "quest.5130116BBA1515FF.title": "Комплект: Капюшон з мана-мережива",
  "quest.5130116BBA1515FF.quest_subtitle": "Манасталеве спорядження",
  "quest.5130116BBA1515FF.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти.",
    "Для Капюшон з мана-мережива: Тканина з мана-мережива. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Для Верх роби з мана-мережива: Тканина з мана-мережива. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Для Низ роби з мана-мережива: Тканина з мана-мережива. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Для Чоботи з мана-мережива: Тканина з мана-мережива. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Завдання автоматично виявляє повний комплект в інвентарі та не вилучає його. Установлену машину за потреби підбери до перевірки; для модульних предметів приймається будь-яка коректна конфігурація."
  ],
  "task.513012E2976CF9AF.title": "1 × Капюшон з мана-мережива — без вилучення",
  "task.51301267A0BD8EF2.title": "1 × Верх роби з мана-мережива — без вилучення",
  "task.513012B753410B59.title": "1 × Низ роби з мана-мережива — без вилучення",
  "task.513012DA9F975D08.title": "1 × Чоботи з мана-мережива — без вилучення",
  "quest.513011004936B5B8.title": "Комплект: з терасталі",
  "quest.513011004936B5B8.quest_subtitle": "Терасталь та елементій у бою",
  "quest.513011004936B5B8.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти.",
    "Для Шолом з терасталі: Шолом з манасталі, Руна весни, тег botania:terrasteel_ingots, Гілка життєдрева. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Для Нагрудник з терасталі: Нагрудник з манасталі, Руна літа, тег botania:terrasteel_ingots, Гілка життєдрева. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Для Наголінники з терасталі: Наголінники з манасталі, Руна осені, тег botania:terrasteel_ingots, Гілка життєдрева. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Для Чоботи з терасталі: Чоботи з манасталі, Руна зими, тег botania:terrasteel_ingots, Гілка життєдрева. Повну кількість, форму рецепта та допустимі заміни перевір у JEI.",
    "Завдання автоматично виявляє повний комплект в інвентарі та не вилучає його. Установлену машину за потреби підбери до перевірки; для модульних предметів приймається будь-яка коректна конфігурація."
  ],
  "task.51301283DE771DC2.title": "1 × Шолом з терасталі — без вилучення",
  "task.5130122162EC6EB9.title": "1 × Нагрудник з терасталі — без вилучення",
  "task.513012A8F72FD0DF.title": "1 × Наголінники з терасталі — без вилучення",
  "task.51301288B6493108.title": "1 × Чоботи з терасталі — без вилучення",
  "quest.51301141DFD6C1D8.title": "Терарозколювач",
  "quest.51301141DFD6C1D8.quest_subtitle": "Терасталь та елементій у бою",
  "quest.51301141DFD6C1D8.quest_desc": [
