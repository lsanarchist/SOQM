  ],
  "task.5130124A460852F9.title": "1 × Розширений резервуар для рідини — без вилучення",
  "quest.513011EFCFF5F40C.title": "Елітний резервуар для рідини",
  "quest.513011EFCFF5F40C.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011EFCFF5F40C.quest_desc": [
    "Додай потрібний резерв або засіб обслуговування. Розмір контейнера, тип речовини та сторона доступу мають відповідати виробничій лінії."
  ],
  "task.5130126A678011EA.title": "1 × Елітний резервуар для рідини — без вилучення",
  "quest.51301167B744DDDA.title": "Сонячний генератор",
  "quest.51301167B744DDDA.quest_subtitle": "Паралельні операції",
  "quest.51301167B744DDDA.quest_desc": [
    "Вибери джерело під реальний попит фабрики. Газове паливо виробляється окремим хімічним контуром; сонячна панель залежить від умов світу."
  ],
  "task.51301247E65EEFA7.title": "1 × Сонячний генератор — без вилучення",
  "quest.514D110A613D8197.title": "Хлорид водню для інжекції",
  "quest.514D110A613D8197.quest_subtitle": "Повна хімічна переробка",
  "quest.514D110A613D8197.quest_desc": [
    "Chemical Infuser готує потрібну хімію для Chemical Injection Chamber. Для рудної лінії організуй виробництво хлориду водню, після інжекції веди матеріал через очищення, дроблення, збагачення та випал. Рідинні й хімічні входи попередніх машин залишаються окремими.",
    "Гарантоване повернення витрачених компонентів: 1 × Базовий хімічний бак.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Хімічний інфузор» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.514D12A85AD34F67.title": "1 × Хімічний наповнювач — без вилучення",
  "task.514D126B737F8A8A.title": "1 × Камера для введення хімічних речовин — без вилучення",
  "quest.5130113316FAEC33.title": "Елітна cхема управління",
  "quest.5130113316FAEC33.quest_subtitle": "Повна хімічна переробка",
  "quest.5130113316FAEC33.quest_desc": [
    "Матеріал керування наступного рівня. Концентровані речовини й сплави виготовляються окремими технологічними маршрутами; рецепт у JEI показує кількість насичення, а не лише один предмет.",
    "Elite Control Circuit потрібна для «Зоряний композит» («Головний маршрут»). Наступні відсутні матеріали шукай у главі 21 на Місяці та в главі 18 у Eden."
  ],
  "task.5130121F5E3B725F.title": "1 × Елітна cхема управління — без вилучення",
  "quest.514D11AB5959BBF5.title": "Digital Miner: фільтр і виведення",
  "quest.514D11AB5959BBF5.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.514D11AB5959BBF5.quest_desc": [
    "Налаштуй зону та фільтр Digital Miner, перевір вартість FE і виділи вільний вихід для добутого. Крафт споживає свої компоненти за JEI; бічне досягнення виклику Robit не є додатковою вимогою для виготовлення шахтаря.",
    "Гарантоване повернення витрачених компонентів: 1 × Ядро телепортації.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Цифровий шахтар» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.514D1230C9D2FD28.title": "1 × Цифровий видобувач — без вилучення",
  "quest.5130114EF06D538C.title": "Robit: виклич помічника",
  "quest.5130114EF06D538C.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.5130114EF06D538C.quest_desc": [
    "Це рідне досягнення перевіряє появу Robit у світі, а не лише предмет в інвентарі. Скористайся його способом розміщення; це окрема допоміжна гілка майстерні."
  ],
  "task.513012C88FFBC84F.title": "Нативна перевірка: Robit вийшов у світ",
  "quest.513011C9A6E69BED.title": "Побачити вібрації",
  "quest.513011C9A6E69BED.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011C9A6E69BED.quest_desc": [
    "Виконай умови досягнення Seismic Vibrations за допомогою вібратора й зчитувача."
  ],
  "task.513012D1BF905A59.title": "Нативна перевірка: Побачити вібрації",
  "quest.513011C1277D6FAE.title": "Працюючий телепорт",
  "quest.513011C1277D6FAE.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011C1277D6FAE.quest_desc": [
    "Один телепорт: Teleporter унизу по центру та 9 Teleporter Frame навколо вертикального отвору 1×2. Зовнішній розмір рамки — 3×4.",
    "Це комплект для одного кінця. Для переходу між двома стаціонарними точками потрібна друга така рамка, живлення та спільна частота; переносний телепорт може бути альтернативним другим кінцем. Нативна перевірка використання телепорту збережена.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Гарантоване повернення витрачених компонентів: 1 × Сталевий корпус.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Телепортер» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.51301212E190FDF4.title": "Нативна перевірка: Телепорт справді працює",
  "quest.513011A31908F578.title": "Змішувач",
  "quest.513011A31908F578.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011A31908F578.quest_desc": [
    "Вбудуй цей вузол у фабрику відповідно до його рецепту. Налаштуй сторони для головного входу, додаткових речовин та виходу; колір сторони має збігатися з фактичним каналом."
  ],
  "task.513012382205502A.title": "1 × Змішувач — без вилучення",
  "quest.51301187E5D1F22E.title": "Базова фабрика об'єднання",
  "quest.51301187E5D1F22E.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.51301187E5D1F22E.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.51301224BC4F62C7.title": "1 × Базова фабрика об'єднання — без вилучення",
  "quest.513011E2F7F7383A.title": "Базова фабрика ін'єкцій",
  "quest.513011E2F7F7383A.quest_subtitle": "Повна хімічна переробка",
  "quest.513011E2F7F7383A.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.5130122731D5821C.title": "1 × Базова фабрика ін'єкцій — без вилучення",
  "quest.513011FC2150E9F6.title": "Остаточний універсальний кабель",
  "quest.513011FC2150E9F6.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011FC2150E9F6.quest_desc": [
    "Підвищи пропускну здатність конкретного каналу. Швидша труба не збільшує продуктивність машини, якщо їй бракує ресурсу; перевір заповнення обох кінців лінії."
  ],
  "task.51301252C3CBE461.title": "4 × Остаточний універсальний кабель — без вилучення",
  "quest.5130110429A8D512.title": "Майстерня: Остаточний логістичний транспортер",
  "quest.5130110429A8D512.quest_subtitle": "Пропускна здатність і місткість",
  "quest.5130110429A8D512.quest_desc": [
    "Підвищи пропускну здатність конкретного каналу. Швидша труба не збільшує продуктивність машини, якщо їй бракує ресурсу; перевір заповнення обох кінців лінії."
  ],
  "task.513012E8585AC0E7.title": "4 × Остаточний логістичний транспортер — без вилучення",
  "quest.513011D2DC7B4947.title": "Остаточний енергетичний куб",
  "quest.513011D2DC7B4947.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011D2DC7B4947.quest_desc": [
    "Додай потрібний резерв або засіб обслуговування. Розмір контейнера, тип речовини та сторона доступу мають відповідати виробничій лінії.",
    "Гарантоване повернення витрачених компонентів: 1 × Діамантовий блок.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Найвищий енергетичний куб» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.5130124EFD9EDD08.title": "1 × Остаточний енергетичний куб — без вилучення",
  "quest.513011CEBED48ECD.title": "Елітний кошик",
  "quest.513011CEBED48ECD.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011CEBED48ECD.quest_desc": [
    "Додай потрібний резерв або засіб обслуговування. Розмір контейнера, тип речовини та сторона доступу мають відповідати виробничій лінії."
  ],
  "task.51301244631B824E.title": "1 × Елітний кошик — без вилучення",
  "quest.5130115863865D83.title": "Остаточний резервуар для рідини",
  "quest.5130115863865D83.quest_subtitle": "Пропускна здатність і місткість",
  "quest.5130115863865D83.quest_desc": [
    "Додай потрібний резерв або засіб обслуговування. Розмір контейнера, тип речовини та сторона доступу мають відповідати виробничій лінії."
  ],
  "task.513012B06A49E124.title": "1 × Остаточний резервуар для рідини — без вилучення",
  "quest.513011AB8B3C455F.title": "Атомний дизасемблер",
  "quest.513011AB8B3C455F.quest_subtitle": "Особисте спорядження",
  "quest.513011AB8B3C455F.quest_desc": [
    "Atomic Disassembler — електричний багатофункціональний інструмент. Заряди його в сумісному енергетичному слоті та почни зі звичайного режиму; швидші режими витрачають більше енергії.",
    "Перед ремонтом бази перевір поточний режим у підказці. Якщо доступне Vein Mining, воно працює з групами придатної руди й деревини, а не є універсальним руйнуванням будь-якої конструкції; для точних робіт вибирай поодинокі блоки."
  ],
  "task.513012689B7BF418.title": "1 × Атомний дизасемблер — без вилучення",
  "quest.5130110E6A8F75F8.title": "Реактивний ранець",
  "quest.5130110E6A8F75F8.quest_subtitle": "Особисте спорядження",
  "quest.5130110E6A8F75F8.quest_desc": [
    "Jetpack працює на водні, а не від електричного кабелю. Підготуй Hydrogen із хімічної лінії, заповни ним ранець через сумісний слот заправки та надягни його замість нагрудника.",
    "Перевір кількість палива й режим польоту низько над землею. Порожній ранець не утримує персонажа в повітрі, тому перед дальнім польотом залиш запас водню на повернення й посадку."
  ],
  "task.5130126854C1D0E9.title": "1 × Реактивний ранець — без вилучення",
  "quest.51301145216814C2.title": "Броньований ракетний ранець",
  "quest.51301145216814C2.quest_subtitle": "Особисте спорядження",
  "quest.51301145216814C2.quest_desc": [
    "Armored Jetpack поєднує водневий ранець із бронюванням. Після модернізації перевір його заправку й надягни в нагрудний слот; матеріали броні не замінюють Hydrogen.",
    "Зроби короткий тест керування біля бази та звір режим у підказці. Бронювання не робить політ безкоштовним і не прибирає потребу контролювати паливо перед перельотом над проваллям."
  ],
  "task.5130120082E03BA0.title": "1 × Броньований ракетний ранець — без вилучення",
  "quest.513011A01B082BDB.title": "Водолазна маска",
  "quest.513011A01B082BDB.quest_subtitle": "Особисте спорядження",
  "quest.513011A01B082BDB.quest_desc": [
    "Scuba Mask — головна частина водолазного комплекту. Для дихання під водою вона працює разом із заправленим киснем Scuba Tank; одна маска не створює запас повітря.",
    "Надягни маску на голову, балон — у нагрудний слот, увімкни подачу балона й перевір комплект на мілководді. Перед зануренням звір Oxygen у балоні, а не заряд енергетичного куба."
  ],
  "task.51301265756BF9D8.title": "1 × Водолазна маска — без вилучення",
  "quest.51301180C64BE565.title": "Водолазний резервуар",
  "quest.51301180C64BE565.quest_subtitle": "Особисте спорядження",
  "quest.51301180C64BE565.quest_desc": [
    "Scuba Tank зберігає Oxygen для роботи з Scuba Mask. Заправ його киснем із хімічної лінії; водень, який підходить Jetpack, сюди не замінює потрібну речовину.",
    "Надягни обидві частини, увімкни балон і перевір дихання на невеликій глибині. Сам балон без маски не є повним комплектом; запас кисню має покривати повернення до поверхні."
  ],
  "task.513012A7F1E1A986.title": "1 × Водолазний резервуар — без вилучення",
  "quest.513011083EFED984.title": "Free runner-и",
  "quest.513011083EFED984.quest_subtitle": "Особисте спорядження",
  "quest.513011083EFED984.quest_desc": [
    "Free Runners — електричне спорядження для пересування й зменшення шкоди від падіння. Заряди їх, надягни у слот чобіт і перевір активний режим на низькій сходинці.",
    "Захист залежить від запасу енергії та режиму. Не сприймай виконаний предметний квест як постійну невразливість до падінь: перед спуском із висоти перевір саме надягнену пару."
  ],
  "task.513012B0DDE39FA3.title": "1 × Free runner-и — без вилучення",
  "quest.513011076C9C7A8F.title": "Броньовані Free Runner-и",
  "quest.513011076C9C7A8F.quest_subtitle": "Особисте спорядження",
  "quest.513011076C9C7A8F.quest_desc": [
    "Armored Free Runners додають бронювання до функцій Free Runners. Після модернізації перевір заряд, надягни їх замість чобіт і переконайся, що ввімкнений потрібний режим.",
    "Броня та енергозалежні можливості пересування — різні властивості. Якщо запас енергії вичерпався, дорожчий матеріал не гарантує колишній захист від падіння; спочатку поповни заряд."
  ],
  "task.51301211DF72890E.title": "1 × Броньовані Free Runner-и — без вилучення",
  "quest.513011A34E3014FA.title": "Електричний лук",
  "quest.513011A34E3014FA.quest_subtitle": "Особисте спорядження",
  "quest.513011A34E3014FA.quest_desc": [
    "Зроби фабричну технологію корисною поза базою. Заряди предмет, перевір режими й підготуй спосіб повернення перед експедицією."
  ],
  "task.513012D3EAD7A491.title": "1 × Електричний лук — без вилучення",
  "quest.51301124380E82AF.title": "Вогнемет",
  "quest.51301124380E82AF.quest_subtitle": "Особисте спорядження",
  "quest.51301124380E82AF.quest_desc": [
    "Flamethrower використовує Hydrogen як паливо. Заправ його через сумісний хімічний слот і перевір режим, перш ніж застосовувати на цілі; FE-кабель сам по собі його не заправить.",
    "Пробний постріл зроби подалі від складу, конвеєрів і розсипаного дропу. Режим полум’я впливає на взаємодію з цілями, а предмети в зоні дії можуть бути втрачені; для інженерних перевірок краще окремий майданчик."
  ],
  "task.5130121C4B1E2455.title": "1 × Вогнемет — без вилучення",
  "quest.51301151F34C43A4.title": "Етилен повертається в FE",
  "quest.51301151F34C43A4.quest_subtitle": "Стиснення та побічні продукти",
  "quest.51301151F34C43A4.quest_desc": [
    "Gas-Burning Generator споживає придатне хімічне паливо. Підведи етилен із PRC, залиш буфер і порівняй генерацію з витратами всього виробничого ланцюга. Якщо зупинилася подача водню або вихід субстрату, зупиниться й паливна лінія.",
    "Гарантоване повернення витрачених компонентів: 1 × Сталевий корпус.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Газовий генератор» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.5130128BCAB208D9.title": "1 × Генератор газового спалювання — без вилучення",
  "quest.514D117ECEE7DB61.title": "Розчинення перед промиванням",
  "quest.514D117ECEE7DB61.quest_subtitle": "Повна хімічна переробка",
  "quest.514D117ECEE7DB61.quest_desc": [
    "Chemical Dissolution Chamber починає повну хімічну переробку. Подавай відповідну рудну сировину та сірчану кислоту за JEI; dirty slurry передавай у Chemical Washer, а не в звичайну предметну трубу."
  ],
  "task.514D1287693A94AB.title": "1 × Камера хімічного розчинення — без вилучення",
  "quest.514D115314DFB698.title": "Slurry → кристали → наявна лінія",
  "quest.514D115314DFB698.quest_subtitle": "Повна хімічна переробка",
  "quest.514D115314DFB698.quest_desc": [
    "Chemical Washer використовує воду для очищення slurry, а Chemical Crystallizer повертає результат у предметну форму. Далі кристали проходять Chemical Injection Chamber та вже зібрану лінію очищення, дроблення, збагачення й випалу.",
    "Гарантоване повернення витрачених компонентів: 1 × Герметична камера.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Хімічний кристалізатор» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.514D12DC5B0D7AAA.title": "1 × Хімічний промивач — без вилучення",
  "task.514D1251E4D57E0E.title": "1 × Хімічний кристалізатор — без вилучення",
  "quest.514D113A135370A8.title": "Перевір наскрізний випуск",
  "quest.514D113A135370A8.quest_subtitle": "Повна хімічна переробка",
  "quest.514D113A135370A8.quest_desc": [
    "Простеж одну партію від входу Chemical Dissolution Chamber до готових злитків і перевір кожен побічний вихід та реагент. Завдання зберігає предметну перевірку й ручне підтвердження: познач його після власної перевірки, автоматичної перевірки всього цеху тут немає."
  ],
  "task.514D120A586B0922.title": "32 × Iron Ingot — без вилучення",
  "task.514D12BDB225F47F.title": "Ручне підтвердження: 32 зливки пройшли повну автоматичну хімічну лінію",
  "quest.513011F824400CB9.title": "Остаточна cхема управління",
  "quest.513011F824400CB9.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011F824400CB9.quest_desc": [
    "Матеріал керування наступного рівня. Концентровані речовини й сплави виготовляються окремими технологічними маршрутами; рецепт у JEI показує кількість насичення, а не лише один предмет.",
    "Ultimate Control Circuit входить у «Міфічна схема» («Головний маршрут»). Ця схема поєднує твою електроніку з Mortum Chunk із DivineRPG і Gaia Ingot із Botania."
  ],
  "task.5130128CDE3780B3.title": "1 × Остаточна cхема управління — без вилучення",
  "quest.513011FD8F59F801.title": "Остаточний кошик",
  "quest.513011FD8F59F801.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011FD8F59F801.quest_desc": [
    "Додай потрібний резерв або засіб обслуговування. Розмір контейнера, тип речовини та сторона доступу мають відповідати виробничій лінії."
  ],
  "task.5130126C025A51B3.title": "1 × Остаточний кошик — без вилучення",
  "quest.51301114CBAD1F77.title": "Квантове з'єднання віддалених ліній",
  "quest.51301114CBAD1F77.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.51301114CBAD1F77.quest_desc": [
    "Quantum Entangloporter переносить підтримувані ресурси через спільну частоту. Налаштуй права доступу, частоту та сторони обох блоків. Це розширення логістики; Digital Miner не є обов'язковим попередником його рецепта."
  ],
  "task.5130120D1FDA9C8B.title": "1 × Квантовий ентанглопортер — без вилучення",
  "quest.5130116A8EF3B812.title": "QIO: частота і сховище",
  "quest.5130116A8EF3B812.quest_subtitle": "QIO: місткість кінцевої бази",
  "quest.5130116A8EF3B812.quest_desc": [
    "QIO Drive Array тримає диски сховища на вибраній частоті. Додай накопичувач, налаштуй доступ і використовуй відповідний QIO Dashboard для роботи з речами. Рецепт не потребує Quantum Entangloporter, тому ця місткість відкривається окремою гілкою.",
    "Гарантоване повернення витрачених компонентів: 1 × Ядро телепортації.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Масив QIO-накопичувачів» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012FDDB40B4D6.title": "1 × Масив КСП-дисків — без вилучення",
  "quest.513011835D892AF4.title": "QIO: перший диск",
  "quest.513011835D892AF4.quest_subtitle": "QIO: місткість кінцевої бази",
  "quest.513011835D892AF4.quest_desc": [
    "Встанови базовий диск у QIO Drive Array й перевір доступний обсяг та кількість типів. Наступні три вузли збільшують місткість цього ж сховища; вони не замінюють налаштування частоти або доступу.",
    "Гарантоване повернення витрачених компонентів: 1 × Найвища керувальна схема.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Базовий QIO-накопичувач» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.51301228B026D0F3.title": "1 × Диск КСП — без вилучення",
  "quest.5130112203442BAE.title": "Гіперщільний диск КСП",
  "quest.5130112203442BAE.quest_subtitle": "QIO: місткість кінцевої бази",
  "quest.5130112203442BAE.quest_desc": [
    "Побудуй окрему QIO-мережу для великих запасів. Перед імпортом перевір частоту, права доступу та кількість предметів, яку вміщує встановлений диск.",
    "Гарантоване повернення витрачених компонентів: 1 × Базовий QIO-накопичувач.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Надщільний QIO-накопичувач» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012BEC17311FC.title": "1 × Гіперщільний диск КСП — без вилучення",
  "quest.513011C1C75B6080.title": "Позачасовий КСП диск",
  "quest.513011C1C75B6080.quest_subtitle": "QIO: місткість кінцевої бази",
  "quest.513011C1C75B6080.quest_desc": [
    "Побудуй окрему QIO-мережу для великих запасів. Перед імпортом перевір частоту, права доступу та кількість предметів, яку вміщує встановлений диск.",
    "Гарантоване повернення витрачених компонентів: 1 × Надщільний QIO-накопичувач.",
    "Отримайте компенсацію після справжнього виготовлення предмета «QIO-накопичувач із розширенням часу» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012286E384494.title": "1 × Позачасовий КСП диск — без вилучення",
  "quest.5130119895187FB1.title": "Надвеликий диск КСП",
  "quest.5130119895187FB1.quest_subtitle": "QIO: місткість кінцевої бази",
  "quest.5130119895187FB1.quest_desc": [
    "Побудуй окрему QIO-мережу для великих запасів. Перед імпортом перевір частоту, права доступу та кількість предметів, яку вміщує встановлений диск.",
    "Гарантоване повернення витрачених компонентів: 1 × QIO-накопичувач із розширенням часу.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Надмасивний QIO-накопичувач» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012A94756104D.title": "1 × Надвеликий диск КСП — без вилучення",
  "chapter.514D10F9D35D4377.title": "07 · Спорядження Mekanism",
  "chapter.514D10F9D35D4377.chapter_subtitle": [
    "7 квестів · 3 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.514D11ABE082674B.title": "Paxel у рюкзак",
  "quest.514D11ABE082674B.quest_subtitle": "Метали для інструмента",
  "quest.514D11ABE082674B.quest_desc": [
    "Тепер у тебе професійний інструмент. Інструмент сподівається, що професіонал з'явиться трохи пізніше.",
    "Вибери інструмент і захист під свою експедицію. Ці квести знайомлять із матеріалами Mekanism Tools та побутовими можливостями Mekanism Additions; усі варіанти комплекту одночасно не потрібні.",
    "Для енергетичного MekaSuit, Meka-Tool і модулів потрібна пізня ядерна гілка глави 08. Звичайний броньований комплект цієї глави корисний значно раніше.",
    "Створи Osmium Paxel з Mekanism Tools. Він об’єднує кілька робочих дій в одному інструменті та зручний для перших експедицій.",
    "Модульні інструменти Modern Foundry залишаються доступним паралельним шляхом. Ця гілка знайомить саме з доданим Mekanism Tools."
  ],
  "task.514D12078631F023.title": "1 × Осмієвий паксель — без вилучення",
  "quest.514D11BFE1742CD9.title": "Сталь для інструмента й щита",
  "quest.514D11BFE1742CD9.quest_subtitle": "Метали для інструмента",
  "quest.514D11BFE1742CD9.quest_desc": [
    "Підготуй Steel Paxel та Steel Shield. Порівняй характеристики зі своїм попереднім спорядженням і обери комплект для дослідження структур.",
    "Квест не вимагає викидати попередні знахідки або збирати всі варіанти інструментів із мода."
  ],
  "task.514D120EB68CB372.title": "1 × Сталевий паксель — без вилучення",
  "task.514D1297AE71802D.title": "1 × Сталевий щит — без вилучення",
  "quest.514D11D6D44E1120.title": "Канал експедиції",
  "quest.514D11D6D44E1120.quest_subtitle": "Зв’язок у дорозі",
  "quest.514D11D6D44E1120.quest_desc": [
    "Створи Walkie-Talkie. У командній грі узгодь канал із супутниками та перевір підтримуваний режим зв’язку встановленої версії.",
    "Для одиночної гри вистачає предмета в інвентарі: квест не вимагає другого гравця, мікрофона чи зовнішнього сервера."
  ],
  "task.514D12D6F9D8640B.title": "1 × Рація — без вилучення",
  "quest.514D110144C01D44.title": "Очищений обсидіан",
  "quest.514D110144C01D44.quest_subtitle": "Метали для інструмента",
  "quest.514D110144C01D44.quest_desc": [
    "Виготов Refined Obsidian Paxel. Потрібний матеріал проходить через обробку Mekanism; це вже спільний результат інструментальної та промислової гілок.",
    "Refined Obsidian Dust перетворюється на зливок в Osmium Compressor з додатковим осмієм. Для самого компресора підготуй Advanced Control Circuit; рецепти пилу та сплавів показує JEI.",
    "Після цього доступні й інші предмети з очищеного обсидіану. Повний обов’язковий комплект броні книга не вимагає."
  ],
  "task.514D12EAD2C1D38E.title": "1 × Очищений обсидіановий паксель — без вилучення",
  "quest.514D11E17AB94DF9.title": "Пластик для технічної бази",
  "quest.514D11E17AB94DF9.quest_subtitle": "Технічне оснащення бази",
  "quest.514D11E17AB94DF9.quest_desc": [
    "Отримай 8 HDPE Sheet для будівельних деталей Mekanism Additions. Лінія використовує хімічні машини Mekanism; повний рецепт дивись у JEI.",
    "Це добровільна декоративна гілка. Для її невеликої партії вистачає доступної рослинної сировини з досліджень: обов’язкової ферми, селекції або каталогу страв немає."
  ],
  "task.514D12C432071059.title": "8 × ПВЩ лист — без вилучення",
  "quest.514D11197CE0EDFE.title": "Освітлена майстерня",
  "quest.514D11197CE0EDFE.quest_subtitle": "Технічне оснащення бази",
  "quest.514D11197CE0EDFE.quest_desc": [
    "Створи Glow Panel будь-якого кольору з Mekanism Additions. Власне досягнення мода розпізнає всі кольори, тому книга не прив’язує оформлення до білого.",
    "Розмісти освітлення в проходах і робочих зонах. За потреби додай кольорові пластикові блоки, дорожнє покриття або прозорі секції."
  ],
  "task.514D12F8D3219508.title": "Нативна перевірка: Освітлена майстерня",
  "quest.514D11517133D536.title": "Повітряний орієнтир",
  "quest.514D11517133D536.quest_subtitle": "Технічне оснащення бази",
  "quest.514D11517133D536.quest_desc": [
    "Три інструменти в одному — чудова економія слотів. Для тридцяти блоків «раптом знадобиться» місце все одно знайдеться.",
    "Створи Balloon будь-якого кольору. Ним можна позначити частину бази або облаштувати місце зустрічі для команди.",
    "Квест використовує досягнення Mekanism Additions за створення кульки. Він не вимагає знищувати кульки або спеціально шукати посилених маленьких мобів."
  ],
  "task.514D12EC130B4C72.title": "Нативна перевірка: Повітряний орієнтир",
  "chapter.514D10901AD244ED.title": "08 · Атом, синтез і високі енергії",
  "chapter.514D10901AD244ED.chapter_subtitle": [
    "Підготуй майданчик, відходи й паливну лінію до першого циклу. Окремі гілки ведуть до турбіни, матриці енергії, синтезу та SPS; рідкі хімічні зразки залишаються додатковими.",
    "60 квестів · 9 послідовних виробничих секцій.",
    "Читай зверху вниз · наведи на квест, щоб побачити всі зв’язки",
    "Відкрий квест, щоб перевірити всі передумови, зокрема переходи до інших глав. Предметна задача перевіряє речі в інвентарі; опис пояснює складання й пробний запуск."
  ],
  "quest.514D11FDEEB7D32B.title": "Підготуй ядерний майданчик",
  "quest.514D11FDEEB7D32B.quest_subtitle": "Майданчик і вимірювання",
  "quest.514D11FDEEB7D32B.quest_desc": [
    "Ця гілка веде від захисного спорядження й вимірювань до охолодженого реактора поділу, відведення пари та переробки відходів. Підготуй Dosimeter і Geiger Counter, а потім відразу плануй вихід відходів. Бічні досягнення опромінення не потрібні для запуску."
  ],
  "task.514D12BA1F51A522.title": "Нативна перевірка: До ядерного майданчика",
  "task.514D12B4090E19E6.title": "1 × Дозиметр — без вилучення",
  "task.514D12010AA0C57A.title": "1 × Лічильник Гейгера — без вилучення",
  "quest.514D1138F546A4D2.title": "Окремий вихід радіоактивних відходів",
  "quest.514D1138F546A4D2.quest_subtitle": "Майданчик і вимірювання",
  "quest.514D1138F546A4D2.quest_desc": [
    "Під'єднай Radioactive Waste Barrels до виходу відходів реактора й залиш запас місткості. Перевір напрямок портів і хімічного транспорту до подачі палива; переповнений вихід не повинен залишатися непоміченим."
  ],
  "task.514D12AB1097E194.title": "4 × Бочка для радіоактивних відходів — без вилучення",
  "quest.514D11CD9798EC9F.title": "Fission Reactor: корпус і паливна збірка",
  "quest.514D11CD9798EC9F.quest_subtitle": "Корпус → охолодження → цикл",
  "quest.514D11CD9798EC9F.quest_desc": [
    "Мінімальний реактор поділу: 3×4×3. Оболонка має 34 позиції: 30 Fission Reactor Casing і 4 порти. Усередині постав 1 Fuel Assembly та 1 Control Rod Assembly безпосередньо над нею.",
    "Окремі порти: паливо, вода, пара й відходи. Налаштуй виходи Configurator. У наступному квесті один корпус можна замінити Logic Adapter для керування зупинкою.",
    "Цей квест збирає будівельний комплект. Робочий цикл зараховується окремо після підготовки охолодження, палива та відведення відходів.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.514D12993A901080.title": "30 × Fission Reactor Casing — без вилучення",
  "task.514D12CC105A6C1B.title": "4 × Fission Reactor Port — без вилучення",
  "task.514D12DF5AAE9F26.title": "1 × Fission Fuel Assembly — без вилучення",
  "task.514D129CF4D28851.title": "1 × Control Rod Assembly — без вилучення",
  "quest.514D1144187ECDB7.title": "Спочатку охолодження та зупинка",
  "quest.514D1144187ECDB7.quest_subtitle": "Корпус → охолодження → цикл",
  "quest.514D1144187ECDB7.quest_desc": [
    "Підведи достатню воду, забезпеч шлях виходу пари й налаштуй Fission Reactor Logic Adapter. Перевір охолодження й спосіб зупинки, перш ніж підтверджувати ручну частину завдання. Наявність насоса та труб сама по собі не доводить, що схема працює."
  ],
  "task.514D122B1B1155E6.title": "2 × Електричний насос — без вилучення",
  "task.514D126191337D7E.title": "8 × Елітна механічна труба — без вилучення",
  "task.514D12FD3660093C.title": "1 × Адаптер логіки ядерного реактора — без вилучення",
  "task.514D124717B8D25F.title": "Ручне підтвердження: охолодження заповнене, відвід працює, аварійна зупинка налаштована",
  "quest.514D1193C52093DB.title": "Уран → хімічна лінія → паливо",
  "quest.514D1193C52093DB.quest_subtitle": "Подільне паливо та зразки",
  "quest.514D1193C52093DB.quest_desc": [
    "Yellow Cake Uranium проходить через окиснення та подальшу хімію до Uranium Hexafluoride, який Isotopic Centrifuge переробляє на Fissile Fuel. Підготуй флюоритову й сірчану лінії для реагентів та перевір послідовність у JEI. Рідкі відра збоку — необов'язкові зразки, а не вимога для транспортування палива."
  ],
  "task.514D12A42566D693.title": "1 × Хімічний окислювач — без вилучення",
  "task.514D1269E71BD6DD.title": "1 × Ізотопна центрифуга — без вилучення",
  "task.514D12915E27C6EA.title": "8 × Урановий пил — без вилучення",
  "quest.514D11FF5A4363E6.title": "Контрольований перший цикл",
  "quest.514D11FF5A4363E6.quest_subtitle": "Корпус → охолодження → цикл",
  "quest.514D11FF5A4363E6.quest_desc": [
    "Підготуй охолодження, відведення пари й відходів та надійне вимкнення Fission Reactor. Для запуску автоматичної перевірки натисни ПКМ основною рукою без Shift по Fission Reactor Casing сформованого реактора.",
    "Залишайся в тому самому вимірі не далі 16 блоків від блока, по якому натиснув. Підтримуй щонайменше 10 секунд роботи (200 серверних тиків): реактор активний і спалює паливо, температура нижча за 1200 K, пошкодження нульові, а бак рідкого або хімічного охолоджувача не порожній.",
    "Після цього вимкни реактор і дочекайся припинення спалювання палива, зберігаючи охолодження, температуру нижче 1200 K та нульові пошкодження. Квест зараховується після цієї штатної зупинки; при звичайній швидкості сервера перевірка відбувається раз на секунду.",
    "Відхід за межі 16 блоків, зміна виміру, вихід зі світу або розбирання реактора переривають спостереження. Після повернення знову натисни ПКМ по сформованому корпусу та виконай повний цикл."
  ],
  "task.514D122A765B9623.title": "Автоматично: безпечні 10 с роботи та штатна зупинка",
  "quest.514D111250CFCDBB.title": "Турбіна Mekanism: мінімальний комплект",
  "quest.514D111250CFCDBB.quest_subtitle": "Пара, ротор і повернення води",
  "quest.514D111250CFCDBB.quest_desc": [
    "Найменша працююча турбіна Mekanism: 5×5×5. Ребра корпуса — 44 Turbine Casing; решту оболонки заповнюють 51 Structural Glass, 2 Valve та 1 Vent. Vent має бути на рівні Rotational Complex або вище.",
    "У центрі над дном: 1 Rotor з 1 Blade; над ним Rotational Complex, навколо якого заповни весь внутрішній шар вісьмома Pressure Disperser. Над Complex постав 1 Electromagnetic Coil.",
    "Один Valve приймає пару, другий віддає FE. Це малий стартовий стенд; Saturating Condenser для повернення води та додаткові лопаті можна встановити після складання. Не підвищуй виробництво пари, поки вихід турбіни його не приймає.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.514D12AF3D607032.title": "44 × Turbine Casing — без вилучення",
  "task.514D12E69CE54212.title": "2 × Turbine Valve — без вилучення",
  "task.514D120323B4B81B.title": "1 × Turbine Rotor — без вилучення",
  "task.514D12C6792999DA.title": "1 × Rotational Complex — без вилучення",
  "task.514D1286E7C55331.title": "1 × Electromagnetic Coil — без вилучення",
  "quest.514D1127DFAD1A15.title": "Відходи → полоній",
  "quest.514D1127DFAD1A15.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.514D1127DFAD1A15.quest_desc": [
    "Solar Neutron Activator переробляє ядерні відходи на полоній, а Pressurized Reaction Chamber завершує рецепт гранули з потрібними додатковими входами. Збережи окремі лінії та буфери для радіоактивних речовин; цей матеріал веде до пізніх систем."
  ],
  "task.514D12CB89E7E7C9.title": "1 × Сонячний нейтронний активатор — без вилучення",
  "task.514D12C878F5C52C.title": "1 × Реакційна камера під тиском — без вилучення",
  "task.514D12056A2F6A8C.title": "1 × Полонієва таблетка — без вилучення",
  "quest.514D11E025B689EF.title": "Інша переробка відходів: плутоній",
  "quest.514D11E025B689EF.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.514D11E025B689EF.quest_desc": [
    "Плутоній використовує іншу гілку переробки ядерних відходів. Перевір хімічну послідовність і рецепт гранули в JEI, а потім відведи частину потоку в потрібні пізні компоненти. Це не заміна виходу відходів або охолодження реактора."
  ],
  "task.514D129127C145B1.title": "1 × Плутонієва таблетка — без вилучення",
  "quest.513011A0BAABFFBE.title": "Показник довкілля",
  "quest.513011A0BAABFFBE.quest_subtitle": "Майданчик і вимірювання",
  "quest.513011A0BAABFFBE.quest_desc": [
    "Використай прилад для вимірювання радіації навколо себе. Квест не вимагає навмисно забруднювати територію."
  ],
  "task.513012FA6DF56D43.title": "Нативна перевірка: Показник довкілля",
  "quest.51301124BDF694DA.title": "Особистий дозиметр",
  "quest.51301124BDF694DA.quest_subtitle": "Майданчик і вимірювання",
  "quest.51301124BDF694DA.quest_desc": [
    "Виміряй отриману дозу належним приладом. Для виконання достатньо перевірки; опромінення не є умовою."
  ],
  "task.5130120959A3A950.title": "Нативна перевірка: Особистий дозиметр",
  "quest.51301157139AE054.title": "Лазер і захист",
  "quest.51301157139AE054.quest_subtitle": "Підготовка й запалювання синтезу",
  "quest.51301157139AE054.quest_desc": [
    "Ти навчився робити речовину, назва якої звучить дорожче за базу. Її енергоспоживання цю думку підтримує.",
    "Виконай нативне досягнення за блокування лазера відповідним захистом. Проводь випробування на окремому стенді."
  ],
  "task.51301255A307FD2C.title": "Нативна перевірка: Лазер і захист",
  "quest.51301107BADF6BB8.title": "Флюорит",
  "quest.51301107BADF6BB8.quest_subtitle": "Подільне паливо та зразки",
  "quest.51301107BADF6BB8.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо."
  ],
  "task.513012D37D5DD4F2.title": "1 × Флюорит — без вилучення",
  "quest.513011EB896B6EFC.title": "Сірчаний пил",
  "quest.513011EB896B6EFC.quest_subtitle": "Подільне паливо та зразки",
  "quest.513011EB896B6EFC.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо."
  ],
  "task.5130121C51D0EB31.title": "1 × Сірчаний пил — без вилучення",
  "quest.513011490AD4077D.title": "Відро рідкого оксиду урану",
  "quest.513011490AD4077D.quest_subtitle": "Подільне паливо та зразки",
  "quest.513011490AD4077D.quest_desc": [
    "Наука потребує зразків. У твоїй експедиції це зазвичай означає ще один заповнений слот і питання, куди подіти відро.",
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.5130122B9E86D5BD.title": "1 × Відро рідкого оксиду урану — без вилучення",
  "quest.51301153341D377A.title": "Відро рідкого гексафториду урану",
  "quest.51301153341D377A.quest_subtitle": "Подільне паливо та зразки",
  "quest.51301153341D377A.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.513012C992C71983.title": "1 × Відро рідкого гексафториду урану — без вилучення",
  "quest.5130113CC2B78731.title": "Відро рідкої плавикової кислоти",
  "quest.5130113CC2B78731.quest_subtitle": "Подільне паливо та зразки",
  "quest.5130113CC2B78731.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.513012E22A2B693F.title": "1 × Відро рідкої плавикової кислоти — без вилучення",
  "quest.5130118AFFA97B98.title": "Відро для рідкої сірчаної кислоти",
  "quest.5130118AFFA97B98.quest_subtitle": "Подільне паливо та зразки",
  "quest.5130118AFFA97B98.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.513012ABB7244009.title": "1 × Відро для рідкої сірчаної кислоти — без вилучення",
  "quest.513011E76CA4FC3F.title": "Відро важкої води",
  "quest.513011E76CA4FC3F.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.513011E76CA4FC3F.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Важку воду отримай насосом Mekanism із відповідним фільтрувальним покращенням. Збери рідину у відро через резервуар; звичайне відро води не виконує це завдання."
  ],
  "task.51301287C939D2BA.title": "1 × Відро важкої води — без вилучення",
  "quest.5130114F36192ADA.title": "Відро рідкого натрію",
  "quest.5130114F36192ADA.quest_subtitle": "Пара, ротор і повернення води",
  "quest.5130114F36192ADA.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.51301273E4C76D14.title": "1 × Відро рідкого натрію — без вилучення",
  "quest.51301151883EDF84.title": "Відро рідкого перегрітого натрію",
  "quest.51301151883EDF84.quest_subtitle": "Пара, ротор і повернення води",
  "quest.51301151883EDF84.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.513012D708EAE21C.title": "1 × Відро рідкого перегрітого натрію — без вилучення",
  "quest.513011798878701B.title": "Відро рідкого літію",
  "quest.513011798878701B.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.513011798878701B.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.5130120C21164D4E.title": "1 × Відро рідкого літію — без вилучення",
  "quest.5130117F428479BE.title": "Перегріваючий елемент",
  "quest.5130117F428479BE.quest_subtitle": "Пара, ротор і повернення води",
  "quest.5130117F428479BE.quest_desc": [
    "Частина ядерного або теплового контуру. Перевір речовину, місткість та напрямок подачі; спочатку збери охолодження і шлях відходів, потім подавай паливо."
  ],
  "task.5130128D49D90F72.title": "1 × Перегріваючий елемент — без вилучення",
  "quest.513011377FFCE327.title": "Лопаті до ротора",
  "quest.513011377FFCE327.quest_subtitle": "Пара, ротор і повернення води",
  "quest.513011377FFCE327.quest_desc": [
    "Turbine Blade встановлюється на ротор і впливає на роботу зібраної турбіни. Підготуй потрібну кількість для свого розміру споруди; кількість у квесті є предметним орієнтиром, а не готовим кресленням."
  ],
  "task.513012938D4643A4.title": "1 × Лопатка турбіни — без вилучення",
  "quest.513011FBA0F4DD87.title": "Вентиляційний отвір турбіни",
  "quest.513011FBA0F4DD87.quest_subtitle": "Пара, ротор і повернення води",
  "quest.513011FBA0F4DD87.quest_desc": [
    "Підготуй елемент багатоблочної системи. Установлення окремої деталі ще не гарантує правильної конструкції: після збирання перевір її стан в інтерфейсі."
  ],
  "task.5130121137A1C651.title": "1 × Вентиляційний отвір турбіни — без вилучення",
  "quest.51301109189D95BA.title": "Насичуючий конденсатор",
  "quest.51301109189D95BA.quest_subtitle": "Пара, ротор і повернення води",
  "quest.51301109189D95BA.quest_desc": [
    "Охолодження мало бути простим. Потім ти згадав, що в цьому пакеті слово «достатньо» потребує розрахунку.",
    "Підготуй елемент багатоблочної системи. Установлення окремої деталі ще не гарантує правильної конструкції: після збирання перевір її стан в інтерфейсі."
  ],
  "task.5130124158C87384.title": "1 × Насичуючий конденсатор — без вилучення",
  "quest.513011C58554CEB8.title": "Відро з рідким дейтерієм",
  "quest.513011C58554CEB8.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.513011C58554CEB8.quest_desc": [
    "Підготуй елемент багатоблочної системи. Установлення окремої деталі ще не гарантує правильної конструкції: після збирання перевір її стан в інтерфейсі.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.5130128D905DD1DB.title": "1 × Відро з рідким дейтерієм — без вилучення",
  "quest.5130119923220370.title": "Відро з рідким тритієм",
  "quest.5130119923220370.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.5130119923220370.quest_desc": [
    "Підготуй елемент багатоблочної системи. Установлення окремої деталі ще не гарантує правильної конструкції: після збирання перевір її стан в інтерфейсі.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.513012F2C7158C4A.title": "1 × Відро з рідким тритієм — без вилучення",
  "quest.51301108144F2004.title": "Знахідка: Відро палива з рідким дейтерієм та тритієм",
  "quest.51301108144F2004.quest_subtitle": "Відходи й паливо для синтезу",
  "quest.51301108144F2004.quest_desc": [
    "Підготуй елемент багатоблочної системи. Установлення окремої деталі ще не гарантує правильної конструкції: після збирання перевір її стан в інтерфейсі.",
    "Це зразок рідкої форми речовини. Після її виробництва подай хімікат у Rotary Condensentrator у режимі конденсації, накопич 1000 mB рідини в сумісному резервуарі та наповни відро. Рецепт зворотного перетворення є в JEI; порожній Chemical Tank не є цим зразком."
  ],
  "task.513012C57162DF08.title": "1 × Відро палива з рідким дейтерієм та тритієм — без вилучення",
  "quest.514D114E75256187.title": "Два потоки палива синтезу",
  "quest.514D114E75256187.quest_subtitle": "Підготовка й запалювання синтезу",
  "quest.514D114E75256187.quest_desc": [
    "Організуй дейтерій з важкої води та тритій з літієвої лінії через Solar Neutron Activator. Підготуй Hohlraum і потрібну форму D-T Fuel для запуску. Розведи потоки та перевір безперервність їх подачі до реактора."
  ],
  "task.514D125B809C8ABC.title": "1 × Роторний конденсентратор — без вилучення",
  "task.514D124EF2AC0D44.title": "1 × Електролітичний сепаратор — без вилучення",
  "task.514D12FFF07FFC19.title": "1 × Голраум — без вилучення",
  "quest.514D113E1E8CF8B1.title": "Синтез: паливо, лазер, робочий цикл",
  "quest.514D113E1E8CF8B1.quest_subtitle": "Підготовка й запалювання синтезу",
  "quest.514D113E1E8CF8B1.quest_desc": [
    "Реактор синтезу має фіксовану округлену схему 5×5×5: 36 Frame, Controller, Laser Focus Matrix, 3 Port і 25 Reactor Glass. Не заповнюй кути як у звичайного куба; орієнтуйся на ромбоподібні грані схеми Mekanism.",
    "Controller стоїть у центрі верхньої грані. Два порти приймають окремо дейтерій і тритій; третій віддає FE. Спрямуй лазер через Laser Focus Matrix.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Збери Fusion Reactor, підведи підготовлене паливо та систему лазерного запалювання до Laser Focus Matrix. Для запуску автоматичної перевірки натисни ПКМ основною рукою без Shift по Fusion Reactor Controller сформованого реактора.",
    "Залишайся в тому самому вимірі не далі 16 блоків від контролера, по якому натиснув. Підтримуй щонайменше 10 секунд роботи (200 серверних тиків): паливна реакція триває, а поточна генерація енергії більша за нуль. Енергію можна одразу віддавати споживачам.",
    "Квест зараховується під час роботи після повного інтервалу спостереження. Відхід за межі 16 блоків, зміна виміру, вихід зі світу або розбирання реактора переривають спостереження; після повернення знову натисни ПКМ по контролеру. Комплект деталей перевіряється окремими предметними завданнями.",
    "Гарантоване повернення витрачених компонентів: 1 × Каркас термоядерного реактора.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Контролер термоядерного реактора» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.514D12400E1E7B56.title": "1 × Fusion Reactor Controller — без вилучення",
  "task.514D1287B291997E.title": "36 × Fusion Reactor Frame — без вилучення",
  "task.514D12BAD610257C.title": "3 × Fusion Reactor Port — без вилучення",
  "task.514D126FF91F6686.title": "1 × Laser Focus Matrix — без вилучення",
  "task.514D122185675E38.title": "Автоматично: 10 с генерації Fusion Reactor",
  "quest.514D114878C1E1BB.title": "SPS: комплект для антиматерії",
  "quest.514D114878C1E1BB.quest_subtitle": "SPS та антиматерія",
  "quest.514D114878C1E1BB.quest_desc": [
    "SPS має фіксовану округлену схему 7×7×7: 60 установлених SPS Casing, 123 Structural Glass, 3 SPS Port і 1 Supercharged Coil. Це кількості готових будівельних блоків; корпуси, витрачені на крафт портів, сюди повторно не додаються.",
    "Порти обслуговують вхід полонію, вихід антиматерії та живлення. Coil ставиться всередині безпосередньо за портом живлення. Залиш решту внутрішнього простору порожньою.",
    "Предметні завдання підтверджують комплект. Після формування подай полоній і достатньо FE; фактичний результат перевіряється наступним квестом на Antimatter Pellet.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.514D126EA5AE4763.title": "60 × SPS Casing — без вилучення",
  "task.514D123CCCB66CA5.title": "3 × SPS Port — без вилучення",
  "task.514D120AC974EEB7.title": "1 × Supercharged Coil — без вилучення",
  "quest.5130116A61A85895.title": "Induction Matrix: корпус буфера",
  "quest.5130116A61A85895.quest_subtitle": "Матриця: місткість та потік",
  "quest.5130116A61A85895.quest_desc": [
    "Збери оболонку Induction Matrix, додай порти та встанови всередині Cells і Providers. Cells задають запас енергії, Providers — можливість передавати її; ці дві гілки оновлень мають різні функції."
  ],
  "task.513012FCE57931D2.title": "1 × Індукційний корпус — без вилучення",
  "quest.513011AE27F5BA38.title": "Порти входу та виходу",
  "quest.513011AE27F5BA38.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011AE27F5BA38.quest_desc": [
    "Induction Ports з'єднують Matrix з генераторами та споживачами. Налаштуй потрібний режим кожного порту й перевір заряд та розряд на невеликому навантаженні перед підключенням усього цеху."
  ],
  "task.51301216D0651BC2.title": "1 × Індукційний порт — без вилучення",
  "quest.513011E2552BA5EA.title": "Cell: запас енергії",
  "quest.513011E2552BA5EA.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011E2552BA5EA.quest_desc": [
    "Basic Induction Cell додає місткість Induction Matrix. Збільшення місткості допомагає переживати піки або паузи генерації, але не підвищує допустимий потік без відповідних Providers.",
    "Гарантоване повернення витрачених компонентів: 1 × Енергетична пластина.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Базова індукційна комірка» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012DCD1614BAD.title": "1 × Базовий індукційний елемент — без вилучення",
  "quest.513011ED63C6B222.title": "Induction Matrix: зібрати буфер",
  "quest.513011ED63C6B222.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011ED63C6B222.quest_desc": [
    "Мінімальний корисний Induction Matrix має розмір 3×4×3: усередині потрібні і Cell, і Provider, тому камери 1×1×1 недостатньо. Каркас — 24 Induction Casing, грані — 8 Structural Glass і 2 Port.",
    "Постав 1 Basic Induction Cell і 1 Basic Induction Provider усередині, налаштуй один порт на вхід, другий на вихід. Cell визначає місткість, Provider — швидкість передачі.",
    "Квест перевіряє комплект, а роботу перевір зарядами: під’єднай джерело до входу та споживача до виходу, відкрий інтерфейс і переконайся, що запас FE змінюється.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.5130123BD9C1906D.title": "1 × Basic Induction Provider — без вилучення",
  "quest.513011EDFD5496EF.title": "Розширений індукційний елемент",
  "quest.513011EDFD5496EF.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011EDFD5496EF.quest_desc": [
    "Побудуй резерв або споживач для енергоємних процесів. Індукційна комірка задає місткість, провайдер — обмін енергією; потрібні обидві частини."
  ],
  "task.513012CE419446F4.title": "1 × Розширений індукційний елемент — без вилучення",
  "quest.5130114D0E92FBF2.title": "Розширений постачальник індукції",
  "quest.5130114D0E92FBF2.quest_subtitle": "Матриця: місткість та потік",
  "quest.5130114D0E92FBF2.quest_desc": [
    "Побудуй резерв або споживач для енергоємних процесів. Індукційна комірка задає місткість, провайдер — обмін енергією; потрібні обидві частини."
  ],
  "task.513012A5C3F31597.title": "1 × Розширений постачальник індукції — без вилучення",
  "quest.513011B17B84E2DB.title": "Елітний індукційний елемент",
  "quest.513011B17B84E2DB.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011B17B84E2DB.quest_desc": [
    "Побудуй резерв або споживач для енергоємних процесів. Індукційна комірка задає місткість, провайдер — обмін енергією; потрібні обидві частини."
  ],
  "task.513012FDE95E3BC5.title": "1 × Елітний індукційний елемент — без вилучення",
  "quest.513011E1F3FBDA00.title": "Елітний постачальник індукції",
  "quest.513011E1F3FBDA00.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011E1F3FBDA00.quest_desc": [
    "Побудуй резерв або споживач для енергоємних процесів. Індукційна комірка задає місткість, провайдер — обмін енергією; потрібні обидві частини."
  ],
  "task.513012C9415547AC.title": "1 × Елітний постачальник індукції — без вилучення",
  "quest.513011D934444F8B.title": "Остаточний індукційний елемент",
  "quest.513011D934444F8B.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011D934444F8B.quest_desc": [
    "Побудуй резерв або споживач для енергоємних процесів. Індукційна комірка задає місткість, провайдер — обмін енергією; потрібні обидві частини."
  ],
  "task.513012203D3B65D0.title": "1 × Остаточний індукційний елемент — без вилучення",
  "quest.513011BDCE53EB09.title": "Остаточний постачальник індукції",
  "quest.513011BDCE53EB09.quest_subtitle": "Матриця: місткість та потік",
  "quest.513011BDCE53EB09.quest_desc": [
    "Побудуй резерв або споживач для енергоємних процесів. Індукційна комірка задає місткість, провайдер — обмін енергією; потрібні обидві частини."
  ],
  "task.513012DD2BB6C68F.title": "1 × Остаточний постачальник індукції — без вилучення",
  "quest.513011F6F0D21BC6.title": "Лазерна лінія запалювання",
  "quest.513011F6F0D21BC6.quest_subtitle": "Підготовка й запалювання синтезу",
  "quest.513011F6F0D21BC6.quest_desc": [
    "Laser у цій збірці потребує Quantum Processor та Dimensional Matrix, тому його можна підготувати до пізнього термоядерного реактора. Окремо збери систему накопичення та спрямування імпульсу для Laser Focus Matrix. Бічне досягнення блокування лазера є окремим експериментом.",
    "Гарантоване повернення витрачених компонентів: 1 × Енергетична пластина.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Лазер Mekanism» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.51301248BB145ADE.title": "1 × Лазер — без вилучення",
  "quest.513011CDE1D10A76.title": "Мека-костюм шолом",
  "quest.513011CDE1D10A76.quest_subtitle": "Meka-комплект і модулі",
  "quest.513011CDE1D10A76.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма.",
    "Модулі: установлений Modification Station відкривається ПКМ без присідання. Налаштування спорядженого костюма — типово клавіша \\; у Керуванні це Mekanism → Module Tweaker."
  ],
  "task.5130121517369569.title": "1 × Мека-костюм шолом — без вилучення",
  "quest.51301111493CFC21.title": "Мека-костюм бронежилет",
  "quest.51301111493CFC21.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301111493CFC21.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.513012CDA8C4C1FC.title": "1 × Мека-костюм бронежилет — без вилучення",
  "quest.51301181BF058BAE.title": "Мека-костюм штани",
  "quest.51301181BF058BAE.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301181BF058BAE.quest_desc": [
