  "task.51301205D6F62CD5.title": "1 × Тропічні уламки — без вилучення",
  "quest.513011E1E6BAFA5A.title": "Земляні уламки",
  "quest.513011E1E6BAFA5A.quest_subtitle": "Руди та матеріали Overworld",
