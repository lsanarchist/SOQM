  ],
  "task.513012AC599F1194.title": "1 × Efficiency Addon Tier 2 — без вилучення",
  "quest.5130111A5BD14B53.title": "Processing Addon Tier 1",
  "quest.5130111A5BD14B53.quest_subtitle": "Ether Gas та масштабування",
  "quest.5130111A5BD14B53.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.513012D036ED14D7.title": "1 × Processing Addon Tier 1 — без вилучення",
  "quest.51301109BDC10F3A.title": "Processing Addon Tier 2",
  "quest.51301109BDC10F3A.quest_subtitle": "Ether Gas та масштабування",
  "quest.51301109BDC10F3A.quest_desc": [
