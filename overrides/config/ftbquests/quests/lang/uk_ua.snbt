  "task.513012C9CE284E20.title": "1 × Infinity Boots — без вилучення",
  "quest.513011D673A634F6.title": "World Breaker",
  "quest.513011D673A634F6.quest_subtitle": "Космічна зброя",
  "quest.513011D673A634F6.quest_desc": [
    "Це добровільна нагорода за фінальну промисловість. Виготов конкретний предмет через повний рецепт; квест видає лакіблок, а не сам кінцевий інструмент."
  ],
  "task.513012F00322A8E0.title": "1 × World Breaker — без вилучення",
  "quest.51301150A4E4DACB.title": "Sword of the Cosmos",
  "quest.51301150A4E4DACB.quest_subtitle": "Космічна зброя",
  "quest.51301150A4E4DACB.quest_desc": [
    "Коли дев'ять слотів стало замало, ти не переглянув амбіції. Ти збільшив верстак.",
    "Це добровільна нагорода за фінальну промисловість. Виготов конкретний предмет через повний рецепт; квест видає лакіблок, а не сам кінцевий інструмент."
  ],
  "task.513012FCD56E217D.title": "1 × Sword of the Cosmos — без вилучення",
  "quest.51301114CA58ED57.title": "Longbow of the Heavens",
  "quest.51301114CA58ED57.quest_subtitle": "Космічна зброя",
  "quest.51301114CA58ED57.quest_desc": [
    "Це добровільна нагорода за фінальну промисловість. Виготов конкретний предмет через повний рецепт; квест видає лакіблок, а не сам кінцевий інструмент."
  ],
  "task.513012A1B22FD38C.title": "1 × Longbow of the Heavens — без вилучення",
  "quest.51301198971E6A0E.title": "Crossbow of the Inferno",
  "quest.51301198971E6A0E.quest_subtitle": "Космічна зброя",
  "quest.51301198971E6A0E.quest_desc": [
