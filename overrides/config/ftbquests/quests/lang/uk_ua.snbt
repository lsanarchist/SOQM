  "task.5130120B53300796.title": "Нативна перевірка: Raglok Gog’dure",
  "quest.5130116A0AE0BA27.title": "Dr. Karos",
  "quest.5130116A0AE0BA27.quest_subtitle": "Vethea: боси",
  "quest.5130116A0AE0BA27.quest_desc": [
