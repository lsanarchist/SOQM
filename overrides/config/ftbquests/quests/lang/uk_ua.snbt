  ],
  "task.5130124B02BC5B78.title": "1 × Дрімотна глибополиця — без вилучення",
  "quest.513011230C7B3A12.title": "Глибополиця",
  "quest.513011230C7B3A12.quest_subtitle": "Полиці Енду й глибин",
  "quest.513011230C7B3A12.quest_desc": [
    "Ця полиця або бібліотека змінює конкретну частину майстерні зачарувань. Перевір поточні Eterna, Quanta й Arcana в інтерфейсі; просто більша кількість полиць не гарантує потрібного результату."
  ],
  "task.513012D2B30A72D3.title": "1 × Глибополиця — без вилучення",
  "quest.513011575F40F062.title": "Бібліотека чар",
  "quest.513011575F40F062.quest_subtitle": "Полиці Енду й глибин",
  "quest.513011575F40F062.quest_desc": [
    "Enchantment Library приймає зачаровані книги й зберігає їхні зачарування як запас очок. Із цього запасу можна створювати вихідні книги або додавати зачарування до книги у вихідному слоті.",
    "Для кожного зачарування бібліотека пам’ятає найвищий рівень, який ти вже вклав. Багато книг першого рівня накопичать очки, але не відкриють видачу вищого рівня, доки ти не внесеш його зразок.",
    "Стеж за місткістю бібліотеки до масового завантаження: надлишкові зачарування можуть втрачатися. У SOQM її крафт також потребує Arcane Conduit, Control Assembly та Infused Shelves."
  ],
  "task.513012732751D356.title": "1 × Бібліотека чар — без вилучення",
  "quest.513011587F62519C.title": "Сигіл інкрустації",
  "quest.513011587F62519C.quest_subtitle": "Самоцвіти та сигіли",
  "quest.513011587F62519C.quest_desc": [
    "Sigil of Socketing додає один сокет сумісному предмету. Самоцвіт для цього сокета готуй окремо й перевіряй його бонус саме для свого типу спорядження.",
    "У SOQM один крафт дає три сигіли та витрачає Quantum Processor, Dimensional Matrix, три Gem-Fused Slates, два Gem Dust, Gunpowder і Amethyst Shard. Плануй одразу партію спорядження, щоб використати отримані сигіли."
  ],
  "task.513012D2C5312DE0.title": "1 × Сигіл інкрустації — без вилучення",
  "quest.513011758EB23EF2.title": "Сигіл вдосконалення",
  "quest.513011758EB23EF2.quest_subtitle": "Самоцвіти та сигіли",
  "quest.513011758EB23EF2.quest_desc": [
    "Sigil of Enhancement — витратний матеріал Augmenting Table. Поклади спорядження з афіксами у верхній слот, сигіли в нижній і вибери потрібний афікс у списку.",
    "Стіл може поліпшити або перекинути один афікс, зберігаючи решту. До підтвердження перевір дію та витрату досвіду: перекидання замінює вибраний афікс, а не просто підвищує його числовий бонус."
  ],
  "task.51301206BDF0D279.title": "1 × Сигіл вдосконалення — без вилучення",
  "quest.513011DDE81BE33E.title": "Сигіл перевершення",
  "quest.513011DDE81BE33E.quest_subtitle": "Самоцвіти та сигіли",
  "quest.513011DDE81BE33E.quest_desc": [
    "Прочитай опис конкретного сигілу або пристрою перед використанням на цінному предметі. Операції із сокетами, каменями та іменами мають різні результати."
  ],
  "task.5130124ABFD64C5E.title": "1 × Сигіл перевершення — без вилучення",
  "quest.51301141D70F43A0.title": "Сигіл зняття",
  "quest.51301141D70F43A0.quest_subtitle": "Самоцвіти та сигіли",
  "quest.51301141D70F43A0.quest_desc": [
    "Поєднай предмет із установленими самоцвітами та Sigil of Withdrawal у Smithing Table. Операція виймає всі самоцвіти й повертає як їх, так і саме спорядження.",
    "Підготуй сигіл перед перенесенням дорогих самоцвітів на новий комплект. Після вилучення вибери нові сокети за сумісністю й бонусами самоцвітів для відповідного спорядження."
  ],
  "task.513012C2EC39E81A.title": "1 × Сигіл зняття — без вилучення",
  "quest.513011C769D75E3D.title": "Сигіл відродження",
  "quest.513011C769D75E3D.quest_subtitle": "Самоцвіти та сигіли",
  "quest.513011C769D75E3D.quest_desc": [
    "Sigil of Rebirth витрачається під час роботи Simple Reforging Table і повного Reforging Table. Завантажуй його в нижній правий слот, а матеріал бажаної рідкості — у верхній лівий.",
    "Запас лише Gem Dust не запускає перековування: пил є компонентом інших операцій і рецептів, а цій станції потрібен готовий сигіл. Підготуй їх партію разом із матеріалами рідкості та досвідом."
  ],
  "task.51301263A1AFE983.title": "1 × Сигіл відродження — без вилучення",
  "quest.513011C4DCF3129F.title": "Сигіл позбавлення імені",
  "quest.513011C4DCF3129F.quest_subtitle": "Самоцвіти та сигіли",
  "quest.513011C4DCF3129F.quest_desc": [
    "Прочитай опис конкретного сигілу або пристрою перед використанням на цінному предметі. Операції із сокетами, каменями та іменами мають різні результати."
  ],
  "task.513012145B6F45BB.title": "1 × Сигіл позбавлення імені — без вилучення",
  "quest.5130112D1DCE5C8D.title": "Сигіл злоби",
  "quest.5130112D1DCE5C8D.quest_subtitle": "Самоцвіти та сигіли",
  "quest.5130112D1DCE5C8D.quest_desc": [
    "Прочитай опис конкретного сигілу або пристрою перед використанням на цінному предметі. Операції із сокетами, каменями та іменами мають різні результати."
  ],
  "task.5130125B0F7F3704.title": "1 × Сигіл злоби — без вилучення",
  "quest.5130113431CBCC5B.title": "Самоцвітно-злитий сланець",
  "quest.5130113431CBCC5B.quest_subtitle": "Самоцвіти та сигіли",
  "quest.5130113431CBCC5B.quest_desc": [
    "Прочитай опис конкретного сигілу або пристрою перед використанням на цінному предметі. Операції із сокетами, каменями та іменами мають різні результати."
  ],
  "task.513012CFC1CCE84A.title": "1 × Самоцвітно-злитий сланець — без вилучення",
  "quest.513011BB818F4911.title": "Том утилізації",
  "quest.513011BB818F4911.quest_subtitle": "Томи для роботи з чарами",
  "quest.513011BB818F4911.quest_desc": [
    "Поєднай Tome of Scrapping із зачарованим спорядженням у ковадлі. Спорядження знищується, а книга отримує випадково вибрану половину його зачарувань з округленням угору.",
    "Використовуй том на зайвому дропі. Якщо потрібно гарантовано зберегти всі зачарування, підготуй Tome of Superior Scrapping; якщо треба зберегти й сам предмет, потрібен Tome of Extraction."
  ],
  "task.5130126AE8D440CF.title": "1 × Том утилізації — без вилучення",
  "quest.5130111FDCC2B0DC.title": "Том відмінної утилізації",
  "quest.5130111FDCC2B0DC.quest_subtitle": "Томи для роботи з чарами",
  "quest.5130111FDCC2B0DC.quest_desc": [
    "Tome of Superior Scrapping отримують інфузійним зачаруванням звичайного Tome of Scrapping. Рецепт потребує щонайменше 45 Eterna та 35 Arcana, а Quanta має бути в діапазоні 25–50.",
    "У ковадлі цей том переносить усі зачарування, але знищує спорядження. Поліпшення гарантує повне перенесення чарів; для збереження самого предмета наступним кроком є Tome of Extraction."
  ],
  "task.51301281D9669FB6.title": "1 × Том відмінної утилізації — без вилучення",
  "quest.5130113C950B4B1B.title": "Том вилучення",
  "quest.5130113C950B4B1B.quest_subtitle": "Томи для роботи з чарами",
  "quest.5130113C950B4B1B.quest_desc": [
    "Tome of Extraction створюється інфузійним зачаруванням Tome of Superior Scrapping. Налаштуй стіл на щонайменше 60 Eterna і 45 Arcana та тримай Quanta в межах 25–75; занадто висока Quanta також порушує рецепт.",
    "Поєднання з зачарованим предметом у ковадлі переносить усі зачарування та зберігає сам предмет. Це спосіб перебудувати зачарування цінного комплекту без втрати його основи."
  ],
  "task.51301216AA6D7DEE.title": "1 × Том вилучення — без вилучення",
  "quest.513011124C2200C6.title": "Том: Зброя",
  "quest.513011124C2200C6.quest_subtitle": "Томи для роботи з чарами",
  "quest.513011124C2200C6.quest_desc": [
    "Томи та реагенти дають окремі способи зберегти чи застосувати чари. Перевір підтримуваний тип предмета та очікуваний результат до роботи з основним спорядженням."
  ],
  "task.5130123F15412052.title": "1 × Том: Зброя — без вилучення",
  "quest.513011F4DA8543FE.title": "Том: Гірництво",
  "quest.513011F4DA8543FE.quest_subtitle": "Томи для роботи з чарами",
  "quest.513011F4DA8543FE.quest_desc": [
    "Томи та реагенти дають окремі способи зберегти чи застосувати чари. Перевір підтримуваний тип предмета та очікуваний результат до роботи з основним спорядженням."
  ],
  "task.5130129D8CFF4056.title": "1 × Том: Гірництво — без вилучення",
  "quest.513011CCB13A7726.title": "Том: Лучник",
  "quest.513011CCB13A7726.quest_subtitle": "Томи для роботи з чарами",
  "quest.513011CCB13A7726.quest_desc": [
    "Томи та реагенти дають окремі способи зберегти чи застосувати чари. Перевір підтримуваний тип предмета та очікуваний результат до роботи з основним спорядженням."
  ],
  "task.513012AEB4400B15.title": "1 × Том: Лучник — без вилучення",
  "quest.5130110448F846EA.title": "Колекція: Том: Чоботи",
  "quest.5130110448F846EA.quest_subtitle": "Томи для роботи з чарами",
  "quest.5130110448F846EA.quest_desc": [
    "Томи та реагенти дають окремі способи зберегти чи застосувати чари. Перевір підтримуваний тип предмета та очікуваний результат до роботи з основним спорядженням."
  ],
  "task.51301204A7F51CC0.title": "1 × Том: Чоботи — без вилучення",
  "quest.51301169EC644453.title": "Том: Шоломи",
  "quest.51301169EC644453.quest_subtitle": "Томи для роботи з чарами",
  "quest.51301169EC644453.quest_desc": [
    "Томи та реагенти дають окремі способи зберегти чи застосувати чари. Перевір підтримуваний тип предмета та очікуваний результат до роботи з основним спорядженням."
  ],
  "task.51301226C7F6F7C7.title": "1 × Том: Шоломи — без вилучення",
  "quest.513011C5F74E3978.title": "Том: Нагрудники",
  "quest.513011C5F74E3978.quest_subtitle": "Томи для роботи з чарами",
  "quest.513011C5F74E3978.quest_desc": [
    "Томи та реагенти дають окремі способи зберегти чи застосувати чари. Перевір підтримуваний тип предмета та очікуваний результат до роботи з основним спорядженням."
  ],
  "task.513012445F8B4F00.title": "1 × Том: Нагрудники — без вилучення",
  "quest.514D11D2CD85AD9D.title": "Майстерня високих рівнів",
  "quest.514D11D2CD85AD9D.quest_subtitle": "Полиці Енду й глибин",
  "quest.514D11D2CD85AD9D.quest_desc": [
    "Розблокуй наступні полиці, керуй стабільністю та виконай зачарування рівня 100 або вище. Шлях можна будувати через дослідження Nether, глибин і End за рецептами Apothic Enchanting.",
    "Це добровільна вершина гілки зачарувань. Нагорода повертає лише невелику частину витратних матеріалів і не дає готової книги з максимальними чарами."
  ],
  "task.514D1201D204E1E0.title": "Нативна перевірка: Майстерня високих рівнів",
  "quest.514D11362B44E731.title": "Summit — виклик Wither",
  "quest.514D11362B44E731.quest_subtitle": "Перша здобич і ранги шукача",
  "quest.514D11362B44E731.quest_desc": [
    "Виконай рідне досягнення Summit: споряди предмети якості Rare або вище та переможи Wither.",
    "Підготуй місце бою й резервне спорядження. Нагорода квесту не містить Nether Star, матеріалів для наступного стола чи готового афіксного комплекту."
  ],
  "task.514D12D93ADF90CD.title": "Нативна перевірка: Summit — виклик Wither",
  "quest.514D11ECA99D525F.title": "Pinnacle — вершина рангу",
  "quest.514D11ECA99D525F.quest_subtitle": "Перша здобич і ранги шукача",
  "quest.514D11ECA99D525F.quest_desc": [
    "Виконай рідне досягнення Pinnacle: споряди предмети якості Epic або вище та переможи Ender Dragon.",
    "Це завершення основної гілки World Tiers. Подальший пошук ідеальних афіксів та каменів залишається власною метою, без нескінченного повторення квестів за винагороду.",
    "World Tier Apotheosis: типово Ctrl+T — Open World Tier Select. У меню прочитай поточний ранг і доступні переходи; якщо комбінація зайнята, перепризнач дію Apotheosis у Керуванні."
  ],
  "task.514D12EBE69FA485.title": "Нативна перевірка: Pinnacle — вершина рангу",
  "quest.514D118B985ECC64.title": "Точніше налаштування афіксів",
  "quest.514D118B985ECC64.quest_subtitle": "Розбір і перекування",
  "quest.514D118B985ECC64.quest_desc": [
    "Створи Augmenting Table. До його звичайних дорогих складників додано Terrasteel Ingot із Botania, Eden Chunk із DivineRPG та Refined Obsidian Ingot із Mekanism.",
    "Таким чином покращення афіксів спирається на магію, експедиції та індустрію. Власну високу вартість операцій досвідом збережено; запас XP підготуй до підтвердження."
  ],
  "task.514D12C268B063E8.title": "1 × Стіл доповнення — без вилучення",
  "chapter.513010D1A7719C65.title": "18 · DivineRPG: велика експедиція",
  "chapter.513010D1A7719C65.chapter_subtitle": [
    "140 квестів · 15 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.51301114856DF778.title": "Реалмітовий злиток",
  "quest.51301114856DF778.quest_subtitle": "Руди та матеріали Overworld",
  "quest.51301114856DF778.quest_desc": [
    "Для спільної кампанії тримай у фокусі дві цілі: Eden Chunk для зоряного сплаву, а пізніше Mortum Chunk для міфічної схеми у «Головний маршрут». Між ними проходить послідовність світів Eden → Wildwood → Apalachia → Skythern → Mortum.",
    "У кожному світі спочатку знайди ресурс для наступного порталу та відклади потрібні фрагменти/самоцвіти. Комплекти зброї й броні вибирай за потребою. Iceika, Arcana й Vethea мають власні пригоди; їхні колекції не є передумовами цих двох спільних компонентних квестів.",
    "Матеріал або інструмент раннього DivineRPG. Зістав джерело ресурсу з виміром і противником у довідці/JEI; спорядження з іншого мода можна використати для самого полювання."
  ],
  "task.513012A69D7D99E4.title": "1 × Реалмітовий злиток — без вилучення",
  "quest.513011C022334C8F.title": "Арлемітовий злиток",
  "quest.513011C022334C8F.quest_subtitle": "Руди та матеріали Overworld",
  "quest.513011C022334C8F.quest_desc": [
    "Матеріал або інструмент раннього DivineRPG. Зістав джерело ресурсу з виміром і противником у довідці/JEI; спорядження з іншого мода можна використати для самого полювання."
  ],
