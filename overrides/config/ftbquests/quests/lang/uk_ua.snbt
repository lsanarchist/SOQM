  "task.513012F3977544C0.title": "1 × Священнокам'яне кайло — без вилучення",
  "quest.5130119F9D03462A.title": "Священнокам'яний меч",
  "quest.5130119F9D03462A.quest_subtitle": "Портал і небесні інструменти",
  "quest.5130119F9D03462A.quest_desc": [
    "Почни з доступних ресурсів Aether і джерела світла. Подорож проходить над порожнечею: заздалегідь підготуй парашут або інший спосіб зупинити падіння."
  ],
  "task.513012B340627D00.title": "1 × Священнокам'яний меч — без вилучення",
  "quest.513011BE0B81B33E.title": "Амброзієвий уламок",
  "quest.513011BE0B81B33E.quest_subtitle": "Портал і небесні інструменти",
  "quest.513011BE0B81B33E.quest_desc": [
    "Ambrosium Shards є паливом Altar. Збережи частину першого запасу для зачарування Gravitite Ore: без нього зупиниться отримання Enchanted Gravitite для Dimensional Matrix.",
    "Уламки також можна використовувати для освітлення або з’їдати заради невеликого лікування. Розділи запас за призначенням до тривалої експедиції, щоб витратні потреби не залишили Altar без палива."
  ],
  "task.513012AC74FE651E.title": "1 × Амброзієвий уламок — без вилучення",
  "quest.51301113EB45CA6C.title": "Амброзієвий смолоскип",
  "quest.51301113EB45CA6C.quest_subtitle": "Портал і небесні інструменти",
  "quest.51301113EB45CA6C.quest_desc": [
    "Почни з доступних ресурсів Aether і джерела світла. Подорож проходить над порожнечею: заздалегідь підготуй парашут або інший спосіб зупинити падіння."
  ],
  "task.513012A277293496.title": "1 × Амброзієвий смолоскип — без вилучення",
  "quest.5130119E04316FD9.title": "Занітовий самоцвіт",
  "quest.5130119E04316FD9.quest_subtitle": "Портал і небесні інструменти",
  "quest.5130119E04316FD9.quest_desc": [
    "Почни з доступних ресурсів Aether і джерела світла. Подорож проходить над порожнечею: заздалегідь підготуй парашут або інший спосіб зупинити падіння."
  ],
  "task.513012D746F46A4B.title": "1 × Занітовий самоцвіт — без вилучення",
  "quest.513011482492F3B8.title": "Холодна хмара",
  "quest.513011482492F3B8.quest_subtitle": "Пересування та Moa",
  "quest.513011482492F3B8.quest_desc": [
    "Збери елемент небесного комплекту. Enchanted Gravitite потрібний Dimensional Matrix; залиш ресурс для цього спільного рецепта перед повним комплектом броні."
  ],
  "task.51301292789A327F.title": "1 × Холодна хмара — без вилучення",
  "quest.5130113516A2F6B6.title": "Холодний парашут",
  "quest.5130113516A2F6B6.quest_subtitle": "Пересування та Moa",
  "quest.5130113516A2F6B6.quest_desc": [
    "Cold Parachute створюється з чотирьох Cold Aerclouds у квадраті 2×2. Він має лише одне використання, тому після застосування потрібен новий парашут.",
    "Тримай його доступним перед переходами між островами Aether. Володіння предметом зараховує цей квест, але не випробовує його за тебе; заздалегідь розберися з використанням на невеликій висоті."
  ],
  "task.51301252EEBA47BA.title": "1 × Холодний парашут — без вилучення",
  "quest.513011A1E01F01C2.title": "Золота хмара",
  "quest.513011A1E01F01C2.quest_subtitle": "Пересування та Moa",
  "quest.513011A1E01F01C2.quest_desc": [
    "Збери елемент небесного комплекту. Enchanted Gravitite потрібний Dimensional Matrix; залиш ресурс для цього спільного рецепта перед повним комплектом броні."
  ],
  "task.513012D0EFE374A8.title": "1 × Золота хмара — без вилучення",
  "quest.5130119FB3C70221.title": "Золотий парашут",
  "quest.5130119FB3C70221.quest_subtitle": "Пересування та Moa",
  "quest.5130119FB3C70221.quest_desc": [
    "Golden Parachute створюється з чотирьох Golden Aerclouds у квадраті 2×2 і має двадцять використань. Це більший запас спусків для дослідження Aether, але кількість застосувань обмежена.",
    "Перевір залишок перед довгою експедицією та відклади матеріал для заміни. Парашут допомагає зі спуском; окремо плануй шлях назад на високий острів."
  ],
  "task.513012C50C8C1DFD.title": "1 × Золотий парашут — без вилучення",
  "quest.513011E47BD9C066.title": "Гравітитове кайло",
  "quest.513011E47BD9C066.quest_subtitle": "Гравітит",
  "quest.513011E47BD9C066.quest_desc": [
