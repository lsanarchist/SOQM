  "task.5130124D5FC13FBE.title": "1 × Основа кристала заклику — без вилучення",
  "quest.51301115487D09F6.title": "Вхід до Eden",
  "quest.51301115487D09F6.quest_subtitle": "Eden",
  "quest.51301115487D09F6.quest_desc": [
    "Уперше зайди до Eden через справжній портал DivineRPG. Залиш біля виходу запас для повернення.",
    "Найближча ресурсна ціль тут — «Шматок Едему» (глава 18): Eden Chunk потрібний зоряному сплаву. Для продовження DivineRPG збирай також матеріали наступного порталу в Wildwood."
  ],
  "task.5130126B6E73FD17.title": "Нативна перевірка: Вхід до Eden",
  "quest.51301129236C7E9E.title": "Фрагменти Едему",
  "quest.51301129236C7E9E.quest_subtitle": "Eden",
  "quest.51301129236C7E9E.quest_desc": [
    "Ціль експедиції до Eden. Ресурс із цього світу є матеріальним доказом просування; відокремлюй запас для наступного порталу та Stellar Alloy від колекції зброї."
  ],
  "task.513012690B951AF8.title": "1 × Фрагменти Едему — без вилучення",
  "quest.51301114FD69794B.title": "Самоцвіт Едему",
  "quest.51301114FD69794B.quest_subtitle": "Eden",
  "quest.51301114FD69794B.quest_desc": [
    "Ціль експедиції до Eden. Ресурс із цього світу є матеріальним доказом просування; відокремлюй запас для наступного порталу та Stellar Alloy від колекції зброї."
  ],
  "task.5130125DD7DA4683.title": "1 × Самоцвіт Едему — без вилучення",
  "quest.51301162D2C3B8F7.title": "Шматок Едему",
  "quest.51301162D2C3B8F7.quest_subtitle": "Eden",
  "quest.51301162D2C3B8F7.quest_desc": [
    "Лінія Eden має два кроки крафту: три Eden Fragments у ряд дають один Eden Gem, а три Eden Gems у ряд — один Eden Chunk. Отже, за цим маршрутом один Chunk потребує дев’ять Fragments.",
    "Для партії з чотирьох Stellar Alloys потрібні два Eden Chunks: підготуй шість Gems, або вісімнадцять Fragments до переробки. Gem і Chunk — різні предмети; рецепт сплаву приймає саме Chunk."
  ],
  "task.5130122EA31FB061.title": "1 × Шматок Едему — без вилучення",
  "quest.5130111375CD52A0.title": "Вхід до Wildwood",
  "quest.5130111375CD52A0.quest_subtitle": "Wildwood",
  "quest.5130111375CD52A0.quest_desc": [
    "Продовж послідовність світів і зайди до Wildwood."
  ],
  "task.513012767FCCF2A1.title": "Нативна перевірка: Вхід до Wildwood",
  "quest.513011BB6996E76A.title": "Вхід до Apalachia",
