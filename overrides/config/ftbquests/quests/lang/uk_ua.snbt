  "task.513012BAA556EB65.title": "1 × Blueprint — без вилучення",
  "quest.513011B3504FA0C8.title": "Architect Table",
  "quest.513011B3504FA0C8.quest_subtitle": "Будівництво та креслення",
  "quest.513011B3504FA0C8.quest_desc": [
    "Підготуй машину або креслення для роботи з великим обсягом. Спочатку перевір межі, інвентар виходу та живлення на невеликій ділянці."
  ],
  "task.513012182593FBDB.title": "1 × Architect Table — без вилучення",
  "quest.513011C1C22AD699.title": "Template",
  "quest.513011C1C22AD699.quest_subtitle": "Будівництво та креслення",
  "quest.513011C1C22AD699.quest_desc": [
    "Підготуй машину або креслення для роботи з великим обсягом. Спочатку перевір межі, інвентар виходу та живлення на невеликій ділянці."
  ],
  "task.5130121E2079E2F4.title": "1 × Template — без вилучення",
  "quest.5130112E6226E0BE.title": "Electronic Library",
  "quest.5130112E6226E0BE.quest_subtitle": "Будівництво та креслення",
  "quest.5130112E6226E0BE.quest_desc": [
    "Підготуй машину або креслення для роботи з великим обсягом. Спочатку перевір межі, інвентар виходу та живлення на невеликій ділянці."
  ],
  "task.513012D8E422E892.title": "1 × Electronic Library — без вилучення",
  "quest.513011275870D7CE.title": "Tank",
  "quest.513011275870D7CE.quest_subtitle": "Рідини та паливо",
  "quest.513011275870D7CE.quest_desc": [
    "Збери частину рідинної або видобувної лінії BuildCraft. Відділи подачу від продукту, підготуй резервуари й місце для побічних результатів."
  ],
  "task.513012E09D50266F.title": "1 × Tank — без вилучення",
  "quest.51301168BF025126.title": "Pump",
  "quest.51301168BF025126.quest_subtitle": "Рідини та паливо",
  "quest.51301168BF025126.quest_desc": [
    "BuildCraft Pump збирає рідину під собою та передає її сусіднім резервуарам або трубам. Постав насос над водоймою, підведи MJ й перевір, що приймач має місце.",
    "У SOQM його рецепт уже потребує Precision Mechanism. Сигнал редстоуну ставить насос на паузу. Не роби висновок про поломку тільки з того, що вода не зникає: поведінка відновлюваних водних джерел залежить від налаштування насоса."
  ],
  "task.5130125F78A1C69F.title": "1 × Pump — без вилучення",
  "quest.513011BC32A0EF47.title": "Mining Well",
  "quest.513011BC32A0EF47.quest_subtitle": "Видобуток і автокрафт",
  "quest.513011BC32A0EF47.quest_desc": [
    "Збери частину рідинної або видобувної лінії BuildCraft. Відділи подачу від продукту, підготуй резервуари й місце для побічних результатів."
  ],
  "task.5130126DA306FB4D.title": "1 × Mining Well — без вилучення",
  "quest.51301128435B885E.title": "Distiller",
  "quest.51301128435B885E.quest_subtitle": "Рідини та паливо",
  "quest.51301128435B885E.quest_desc": [
    "Збери частину рідинної або видобувної лінії BuildCraft. Відділи подачу від продукту, підготуй резервуари й місце для побічних результатів."
  ],
  "task.5130124749877BB2.title": "1 × Distiller — без вилучення",
  "quest.513011D73BA114A4.title": "Heat Exchanger",
  "quest.513011D73BA114A4.quest_subtitle": "Рідини та паливо",
  "quest.513011D73BA114A4.quest_desc": [
    "Збери частину рідинної або видобувної лінії BuildCraft. Відділи подачу від продукту, підготуй резервуари й місце для побічних результатів."
  ],
  "task.5130124B7DD84947.title": "1 × Heat Exchanger — без вилучення",
  "quest.513011B509AE9A20.title": "Auto Workbench",
  "quest.513011B509AE9A20.quest_subtitle": "Видобуток і автокрафт",
  "quest.513011B509AE9A20.quest_desc": [
    "Auto Workbench запам’ятовує крафт і повторює його з матеріалів у власному інвентарі. Задай зразок у сітці рецепта, потім подай справжні інгредієнти й організуй виведення результату.",
    "У цій версії він може працювати повільно самостійно; зовнішнє MJ прискорює роботу. Спочатку забезпеч стабільні входи: додане живлення не усуне нестачу одного компонента або забитий вихід."
  ],
  "task.513012027E7B17FC.title": "1 × Auto Workbench — без вилучення",
  "quest.513011732D8F780E.title": "Quarry",
  "quest.513011732D8F780E.quest_subtitle": "Видобуток і автокрафт",
  "quest.513011732D8F780E.quest_desc": [
    "Quarry розмічає каркас і добуває блоки у вибраній площі. Перед запуском з’єднай Land Marks для потрібної ділянки, постав кар’єр поруч і перевір, де проходитиме його рамка; без коректної розмітки він вибере типову область.",
    "Забери цінні блоки з майбутньої рамки: її розчищення може знищити перешкоди без дропу. Підведи MJ та великий буфер із відведенням ресурсів. Переповнений вихід не зупиняє видобуток — неприйняті предмети випадають біля кар’єру."
  ],
  "task.51301254B111856D.title": "1 × Quarry — без вилучення",
  "quest.5130111A90908B6C.title": "Laser",
  "quest.5130111A90908B6C.quest_subtitle": "Лазери та чипсети",
  "quest.5130111A90908B6C.quest_desc": [
    "Laser перетворює MJ на енергію для сумісних столів BuildCraft. Постав його не далі шести блоків від Assembly Table чи іншого підтримуваного стола та підведи MJ до самого лазера.",
    "Промінь з’являється, коли стіл запитує енергію для вибраного рецепта. Якщо лазер не працює, спочатку перевір рецепт, матеріали й живлення; додаткові лазери корисні тільки тоді, коли стіл справді потребує більшого потоку.",
    "Гарантоване повернення витрачених компонентів: 1 × Діамант.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Лазер BuildCraft» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012719F5D764B.title": "1 × Laser — без вилучення",
  "quest.513011A7C9201F3C.title": "Assembly Table",
  "quest.513011A7C9201F3C.quest_subtitle": "Лазери та чипсети",
  "quest.513011A7C9201F3C.quest_desc": [
    "Assembly Table виготовляє чипсети та інші компоненти BuildCraft за допомогою лазерної енергії. Поклади матеріали в стіл, вибери потрібний доступний рецепт і живи сусідній Laser.",
    "Для першого випуску активуй тільки один рецепт. Кілька дозволених рецептів можуть почергово споживати спільні матеріали; подбай також про місце для результату в столі або сусідньому приймачі."
  ],
  "task.5130127AE71D7D9A.title": "1 × Assembly Table — без вилучення",
  "quest.513011D8A723B6B2.title": "Redstone Chipset Red",
  "quest.513011D8A723B6B2.quest_subtitle": "Лазери та чипсети",
  "quest.513011D8A723B6B2.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.5130125B60087D84.title": "1 × Redstone Chipset Red — без вилучення",
  "quest.5130118CF1B4F800.title": "Redstone Chipset Iron",
  "quest.5130118CF1B4F800.quest_subtitle": "Лазери та чипсети",
  "quest.5130118CF1B4F800.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.5130122B7BF0084E.title": "1 × Redstone Chipset Iron — без вилучення",
  "quest.51301136B51AB77B.title": "Redstone Chipset Gold",
  "quest.51301136B51AB77B.quest_subtitle": "Лазери та чипсети",
  "quest.51301136B51AB77B.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.5130127E1DEA7E5A.title": "1 × Redstone Chipset Gold — без вилучення",
  "quest.513011C902E72C7C.title": "Redstone Chipset Diamond",
  "quest.513011C902E72C7C.quest_subtitle": "Лазери та чипсети",
  "quest.513011C902E72C7C.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.5130120B8E6B285D.title": "1 × Redstone Chipset Diamond — без вилучення",
  "quest.51301167E5695C8F.title": "Integration Table",
  "quest.51301167E5695C8F.quest_subtitle": "Лазери та чипсети",
  "quest.51301167E5695C8F.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.513012EF49E1C22B.title": "1 × Integration Table — без вилучення",
  "quest.513011D9F8659F00.title": "Programming Table",
  "quest.513011D9F8659F00.quest_subtitle": "Лазери та чипсети",
  "quest.513011D9F8659F00.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.513012C8FD7259E0.title": "1 × Programming Table — без вилучення",
  "quest.5130113654970E2B.title": "Advanced Crafting Table",
  "quest.5130113654970E2B.quest_subtitle": "Лазери та чипсети",
  "quest.5130113654970E2B.quest_desc": [
    "Вироби елемент лазерної збірки. Assembly Table працює разом із лазерами; виділи для неї стабільне живлення та запас базових чипсетів."
  ],
  "task.51301220F70B5340.title": "1 × Advanced Crafting Table — без вилучення",
  "chapter.513010C227ED8B09.title": "05 · Залізниця працює на фабрику",
  "chapter.513010C227ED8B09.chapter_subtitle": [
    "40 квестів · 6 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.513011FDD667DD02.title": "Колія отримала функцію",
  "quest.513011FDD667DD02.quest_subtitle": "Колія та стрілки",
  "quest.513011FDD667DD02.quest_desc": [
    "Почни з короткого шляху між двома робочими точками. Потім додай завантаження, розвантаження й лише після цього локомотив та сигнали: так легше зрозуміти, який вузол уже працює.",
    "Кокс і сталь підтримують металургію, а автоматичний прокат та потяги потребують розвиненої майстерні. Відокремлюй матеріальні деталі рецепта від добровільного розширення залізничної мережі.",
    "Застосуй комплект колії до сумісної ділянки рейок. Для перевірки використовуй коротку тестову ділянку."
  ],
  "task.5130129160C96678.title": "Нативна перевірка: Колія отримала функцію",
  "quest.5130118DB31A46A1.title": "Залізничний кокс",
  "quest.5130118DB31A46A1.quest_subtitle": "Сталь та прокат",
  "quest.5130118DB31A46A1.quest_desc": [
    "Railcraft Coke Oven: 26 блоків, зовнішній розмір 3×3×3. Залиш внутрішню камеру порожньою; це інша конструкція, ніж піч Immersive Engineering.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Коксова піч Railcraft — куб 3×3×3 із порожнім центром, тобто 26 Coke Oven Bricks. Використовуй саме блоки Railcraft і залиш проміжок між сусідніми печами; завдання реагує на нативне формування цієї конструкції.",
    "Після складання завантаж вугілля та забирай кокс і крезот. Не перенось сюди суцільну 27-блокову схему печі Immersive Engineering: у цих модів різні мультиблоки."
  ],
  "task.513012DD904815FD.title": "Нативна перевірка: Залізничний кокс",
  "quest.5130110CBEF3D218.title": "Залізнична домна",
  "quest.5130110CBEF3D218.quest_subtitle": "Сталь та прокат",
  "quest.5130110CBEF3D218.quest_desc": [
    "Railcraft Blast Furnace: 34 блоків, зовнішній розмір 3×4×3. Залиш внутрішню камеру порожньою; це інша конструкція, ніж піч Immersive Engineering.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Blast Furnace Railcraft — конструкція 3×3×4 із порожниною всередині, для якої потрібно 34 Blast Furnace Bricks. Звір шари зі схемою Railcraft і не з’єднуй її впритул з іншою такою піччю.",
    "Квест зараховує формування доменної печі. Далі перевір сталевий рецепт із залізом і придатним паливом у її інтерфейсі; сама наявність цегли чи піч іншого мода не задовольняє цей нативний тригер."
  ],
  "task.51301250FF7786A4.title": "Нативна перевірка: Залізнична домна",
  "quest.5130114354CF7719.title": "Сталевий лом",
  "quest.5130114354CF7719.quest_subtitle": "Сталь та прокат",
  "quest.5130114354CF7719.quest_desc": [
    "Steel Crowbar — основний інструмент для колій і вагонеток Railcraft. ПКМ по підтримуваній рейці змінює її напрям або відкриває налаштування; на локомотиві інструмент може змінити напрям руху.",
    "Для зчеплення вагонеток використовується Shift+ПКМ по кожній із пари. Перевір дію на короткій тестовій колії: звичайний ПКМ та натискання з присіданням виконують різні операції."
  ],
  "task.513012240039DC2D.title": "1 × Сталевий лом — без вилучення",
  "quest.513011E68E6D4690.title": "Ручний прокатний верстат",
  "quest.513011E68E6D4690.quest_subtitle": "Сталь та прокат",
  "quest.513011E68E6D4690.quest_desc": [
    "Manual Rolling Machine виготовляє рейкові та інші металеві заготовки за власними рецептами. Розклади потрібні матеріали в її сітці й перевір, який виріб показано на виході.",
    "Якщо матеріалів залишилося лише на один цикл, натисни на зображення результату, щоб примусово виконати крафт. Для постійного потоку заготовок наступний крок — Powered Rolling Machine з автоматичною подачею."
  ],
  "task.5130123556581A20.title": "1 × Ручний прокатний верстат — без вилучення",
  "quest.513011B3B6161380.title": "Вогнетривка цегла",
  "quest.513011B3B6161380.quest_subtitle": "Сталь та прокат",
  "quest.513011B3B6161380.quest_desc": [
    "Залізниця починається з інструмента, прокату та основи колії. Для спеціальної ділянки спочатку потрібні відповідні базова колія і комплект."
  ],
  "task.513012406B3820BC.title": "1 × Вогнетривка цегла — без вилучення",
  "quest.513011C3CAE2637F.title": "Вогнетривка цеглина",
  "quest.513011C3CAE2637F.quest_subtitle": "Сталь та прокат",
  "quest.513011C3CAE2637F.quest_desc": [
    "Залізниця починається з інструмента, прокату та основи колії. Для спеціальної ділянки спочатку потрібні відповідні базова колія і комплект."
  ],
  "task.513012307ED2B124.title": "1 × Вогнетривка цеглина — без вилучення",
  "quest.513011D45FA1F900.title": "Сталевий злиток",
  "quest.513011D45FA1F900.quest_subtitle": "Сталь та прокат",
  "quest.513011D45FA1F900.quest_desc": [
    "Залізниця починається з інструмента, прокату та основи колії. Для спеціальної ділянки спочатку потрібні відповідні базова колія і комплект."
  ],
  "task.513012B695D599B6.title": "1 × Сталевий злиток — без вилучення",
  "quest.513011F78377F278.title": "Сталева пластина",
  "quest.513011F78377F278.quest_subtitle": "Сталь та прокат",
  "quest.513011F78377F278.quest_desc": [
    "Залізниця починається з інструмента, прокату та основи колії. Для спеціальної ділянки спочатку потрібні відповідні базова колія і комплект."
  ],
  "task.513012874B3757C2.title": "1 × Сталева пластина — без вилучення",
  "quest.51301164E3EDD85C.title": "Стандартна рейка",
  "quest.51301164E3EDD85C.quest_subtitle": "Колія та стрілки",
  "quest.51301164E3EDD85C.quest_desc": [
    "Залізниця починається з інструмента, прокату та основи колії. Для спеціальної ділянки спочатку потрібні відповідні базова колія і комплект."
  ],
  "task.513012B4842E129B.title": "1 × Стандартна рейка — без вилучення",
  "quest.51301189A2B4AEAF.title": "Wooden Tie",
  "quest.51301189A2B4AEAF.quest_subtitle": "Колія та стрілки",
  "quest.51301189A2B4AEAF.quest_desc": [
    "Залізниця починається з інструмента, прокату та основи колії. Для спеціальної ділянки спочатку потрібні відповідні базова колія і комплект."
  ],
  "task.513012586DF695E4.title": "1 × Wooden Tie — без вилучення",
  "quest.513011F655EF052F.title": "Склад із кількох вагонів",
  "quest.513011F655EF052F.quest_subtitle": "Локомотиви та вагони",
  "quest.513011F655EF052F.quest_desc": [
    "Щоб утворити поїзд, постав дві сумісні вагонетки поряд на колії та натисни Shift+ПКМ Steel Crowbar спочатку по одній, потім по іншій. Квест перевіряє справжнє зчеплення.",
    "Перевір пару на короткій прямій ділянці, перш ніж додавати вагони. Зчеплення не є двигуном: для руху складу ще потрібні тяга й правильно налаштована колія."
  ],
  "task.51301241B0A4AE12.title": "Нативна перевірка: Склад із кількох вагонів",
  "quest.5130114C6BBFCCCD.title": "Стрілка під контролем",
  "quest.5130114C6BBFCCCD.quest_subtitle": "Колія та стрілки",
  "quest.5130114C6BBFCCCD.quest_desc": [
    "Використай Spike Maul для відповідної операції на рейковому з’єднанні."
  ],
  "task.513012A58E50F59C.title": "Нативна перевірка: Стрілка під контролем",
  "quest.513011CCFE17F1FB.title": "Нічліг на рейках",
  "quest.513011CCFE17F1FB.quest_subtitle": "Локомотиви та вагони",
  "quest.513011CCFE17F1FB.quest_desc": [
    "Скористайся вагоном-ліжком за правилами нативного досягнення. Це додаткова можливість далекого маршруту."
  ],
  "task.51301252EE03981D.title": "Нативна перевірка: Нічліг на рейках",
  "quest.5130116FB1CF442C.title": "Автоматичний прокатний верстат",
  "quest.5130116FB1CF442C.quest_subtitle": "Сталь та прокат",
  "quest.5130116FB1CF442C.quest_desc": [
    "Powered Rolling Machine розвиває ручну прокатку до машинного виготовлення металевих деталей. У SOQM рецепт уже потребує Precision Mechanism; після встановлення забезпеч її живлення та матеріали.",
    "Спершу виконай один потрібний рецепт, потім підключай труби для входів і виходу. Машина підтримує автоматизацію, але неправильний залишок у сітці або відсутній інгредієнт зупинить її незалежно від запасу енергії."
  ],
  "task.513012519D271A47.title": "1 × Автоматичний прокатний верстат — без вилучення",
  "quest.513011CFD1B179B3.title": "Набір для блокування маршрутів",
  "quest.513011CFD1B179B3.quest_subtitle": "Колія та стрілки",
  "quest.513011CFD1B179B3.quest_desc": [
    "Locking Track утримує вагонетку на зупинці без сигналу редстоуну. Сигнал звільняє її, а вибраний режим визначає, чи буде додатковий поштовх і в якому напрямку.",
    "Crowbar перемикає режими зупинки, посадки та роботи з поїздом. Перевір стрілку й режим одним вагоном: звільнення колії та запуск вагона — різні дії."
  ],
  "task.5130124D674AF00C.title": "1 × Набір для блокування маршрутів — без вилучення",
  "quest.513011863D5B3F64.title": "Coupler Track Kit",
  "quest.513011863D5B3F64.quest_subtitle": "Посадка й вантажні станції",
  "quest.513011863D5B3F64.quest_desc": [
    "Coupler Track автоматизує зчеплення або розчеплення вагонеток. Для дії колії потрібний сигнал редстоуну; інструментом перемкни потрібний режим перед подачею вагонів.",
    "Спочатку перевір дві порожні вагонетки й оглянь результат зчеплення. Не пропускай повний вантажний склад, поки не переконався, що колія з’єднує, а не роз’єднує його."
  ],
  "task.513012E4F7B98EAC.title": "1 × Coupler Track Kit — без вилучення",
  "quest.513011406992DBD8.title": "Disembarking Track Kit",
  "quest.513011406992DBD8.quest_subtitle": "Посадка й вантажні станції",
  "quest.513011406992DBD8.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.5130121A210487B6.title": "1 × Disembarking Track Kit — без вилучення",
  "quest.5130116856E9A48A.title": "Embarking Track Kit",
  "quest.5130116856E9A48A.quest_subtitle": "Посадка й вантажні станції",
  "quest.5130116856E9A48A.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.513012004647C1F2.title": "1 × Embarking Track Kit — без вилучення",
  "quest.5130117DB13773F0.title": "Dumping Track Kit",
  "quest.5130117DB13773F0.quest_subtitle": "Посадка й вантажні станції",
  "quest.5130117DB13773F0.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.5130129803C8B65E.title": "1 × Dumping Track Kit — без вилучення",
  "quest.5130110A9D04BEBF.title": "Gated Track Kit",
  "quest.5130110A9D04BEBF.quest_subtitle": "Колія та стрілки",
  "quest.5130110A9D04BEBF.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.513012879BB225A6.title": "1 × Gated Track Kit — без вилучення",
  "quest.5130118593FC506A.title": "Набір для одношляхового маршруту",
  "quest.5130118593FC506A.quest_subtitle": "Колія та стрілки",
  "quest.5130118593FC506A.quest_desc": [
    "One-Way Track обмежує напрям руху, коли отримує сигнал редстоуну. Під живленням вона відштовхує вагонетку, яка рухається проти стрілки; без сигналу поводиться як звичайна колія.",
    "Налаштуй стрілку Crowbar і перевір обидва напрямки. Стрілка сама собою не є постійною забороною руху: якщо живлення зникне, напрям більше не контролюється."
  ],
  "task.51301200ECBA41B3.title": "1 × Набір для одношляхового маршруту — без вилучення",
  "quest.5130115614499BD1.title": "Набір для маршрутизації",
  "quest.5130115614499BD1.quest_subtitle": "Колія та стрілки",
  "quest.5130115614499BD1.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.513012500F0104A3.title": "1 × Набір для маршрутизації — без вилучення",
  "quest.5130114429000ED1.title": "Комплект регулювальних рейок",
  "quest.5130114429000ED1.quest_subtitle": "Колія та стрілки",
  "quest.5130114429000ED1.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.51301233975B9183.title": "1 × Комплект регулювальних рейок — без вилучення",
  "quest.513011E714093DA5.title": "Комплект свистячих рейок",
  "quest.513011E714093DA5.quest_subtitle": "Колія та стрілки",
  "quest.513011E714093DA5.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.5130121334B5E71D.title": "1 × Комплект свистячих рейок — без вилучення",
  "quest.5130114A9F283D85.title": "Набір для локомотива",
  "quest.5130114A9F283D85.quest_subtitle": "Посадка й вантажні станції",
  "quest.5130114A9F283D85.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.51301276853CE1B7.title": "1 × Набір для локомотива — без вилучення",
  "quest.51301100456EE266.title": "Майстерня: Detector Track Kit",
  "quest.51301100456EE266.quest_subtitle": "Колія та стрілки",
  "quest.51301100456EE266.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.51301241EABFE6B5.title": "1 × Detector Track Kit — без вилучення",
  "quest.513011124D27668E.title": "Switch Track Lever",
  "quest.513011124D27668E.quest_subtitle": "Колія та стрілки",
  "quest.513011124D27668E.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.51301283845F20F9.title": "1 × Switch Track Lever — без вилучення",
  "quest.513011A057097DC5.title": "Switch Track Motor",
  "quest.513011A057097DC5.quest_subtitle": "Колія та стрілки",
  "quest.513011A057097DC5.quest_desc": [
    "Кожен пристрій вирішує конкретну задачу станції. Випробуй його на одному вагоні: зупинка, напрямок, висадка та зчеплення мають різні умови сигналу."
  ],
  "task.5130127E978B04C3.title": "1 × Switch Track Motor — без вилучення",
  "quest.5130117E9E9098CC.title": "Паротяг",
  "quest.5130117E9E9098CC.quest_subtitle": "Локомотиви та вагони",
  "quest.5130117E9E9098CC.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.5130121DD71D3F7E.title": "1 × Паротяг — без вилучення",
  "quest.513011CE9C9EAA15.title": "Вагонетка з резервуаром",
  "quest.513011CE9C9EAA15.quest_subtitle": "Локомотиви та вагони",
  "quest.513011CE9C9EAA15.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.51301234B9D91F17.title": "1 × Вагонетка з резервуаром — без вилучення",
  "quest.513011F525778A9B.title": "Прохідницький щит",
  "quest.513011F525778A9B.quest_subtitle": "Колійна техніка",
  "quest.513011F525778A9B.quest_desc": [
    "Паровоз уже гуде. Ти теж, коли згадуєш, скільки сталі пішло на цей короткий шлях до сусіднього цеху.",
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.51301298AB92ED7E.title": "1 × Прохідницький щит — без вилучення",
  "quest.5130110B3D4461DB.title": "Track Layer Cart",
  "quest.5130110B3D4461DB.quest_subtitle": "Колійна техніка",
  "quest.5130110B3D4461DB.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.513012A7C3D884E7.title": "1 × Track Layer Cart — без вилучення",
  "quest.51301109ABB1FFFB.title": "Track Relayer Cart",
  "quest.51301109ABB1FFFB.quest_subtitle": "Колійна техніка",
  "quest.51301109ABB1FFFB.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.5130129A2246CE64.title": "1 × Track Relayer Cart — без вилучення",
  "quest.513011C066BA1FAA.title": "Track Remover Cart",
  "quest.513011C066BA1FAA.quest_subtitle": "Колійна техніка",
  "quest.513011C066BA1FAA.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.5130127486E623C3.title": "1 × Track Remover Cart — без вилучення",
  "quest.513011BD824E31D8.title": "Track Undercutter Cart",
  "quest.513011BD824E31D8.quest_subtitle": "Колійна техніка",
  "quest.513011BD824E31D8.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.51301264202024A7.title": "1 × Track Undercutter Cart — без вилучення",
  "quest.513011E7C9C7CC29.title": "Train Dispenser",
  "quest.513011E7C9C7CC29.quest_subtitle": "Посадка й вантажні станції",
  "quest.513011E7C9C7CC29.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.513012D170ECBD0C.title": "1 × Train Dispenser — без вилучення",
  "quest.513011845CE58B27.title": "Твердопаливна топка",
  "quest.513011845CE58B27.quest_subtitle": "Парові котли",
  "quest.513011845CE58B27.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.5130120DFF15B00E.title": "1 × Твердопаливна топка — без вилучення",
  "quest.513011850E37C95F.title": "Рідиннопаливна топка",
  "quest.513011850E37C95F.quest_subtitle": "Парові котли",
  "quest.513011850E37C95F.quest_desc": [
    "Підготуй транспорт або енергетичний вузол станції. Вода, паливо й вантаж мають надходити без ручного перенесення; ручне випробування виконуй до запуску довгого складу."
  ],
  "task.513012246A38A35B.title": "1 × Рідиннопаливна топка — без вилучення",
  "quest.513011C793F4D2F0.title": "Паровий котел: мінімальний комплект",
  "quest.513011C793F4D2F0.quest_subtitle": "Парові котли",
  "quest.513011C793F4D2F0.quest_desc": [
    "Мінімальний котел Railcraft: 1 Solid Fueled Firebox і 1 Low Pressure Steam Boiler Tank безпосередньо над ним. Вода та тверде паливо подаються в Firebox.",
    "Завдання перевіряють комплект із двох блоків, а не температуру чи виробництво пари. Для бази 2×2 або 3×3 знадобиться більше топок і баків.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті."
  ],
  "task.5130124DB2CD826E.title": "1 × Low Pressure Steam Boiler Tank — без вилучення",
  "chapter.514D10BB504C8924.title": "06 · Фабрика Mekanism",
  "chapter.514D10BB504C8924.chapter_subtitle": [
    "Почни з живлення й насичення металів; далі розділи фабрику на рудну хімію, логістику, видобуток і QIO. Фабрики збільшують паралельність уже знайомої операції.",
    "89 квестів · 10 послідовних виробничих секцій.",
    "Читай зверху вниз · наведи на квест, щоб побачити всі зв’язки",
    "Відкрий квест, щоб перевірити всі передумови, зокрема переходи до інших глав. Предметна задача перевіряє речі в інвентарі; опис пояснює складання й пробний запуск."
  ],
  "quest.514D118227E562E7.title": "Осмій: початок машинної лінії",
  "quest.514D118227E562E7.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.514D118227E562E7.quest_desc": [
    "Осмій потрібен для перших корпусів і керування. Підготуй запас, після чого з'єднай джерело FE з Metallurgic Infuser. Далі центральна гілка веде до сталі, корпусів та переробки, а бічні — до місткості й спорядження."
  ],
  "task.514D1298117735DA.title": "8 × Осмієвий злиток — без вилучення",
  "quest.514D11B512FA3533.title": "FE: генератор → кабель → машина",
  "quest.514D11B512FA3533.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.514D11B512FA3533.quest_desc": [
    "Постав Heat Generator, з'єднай його Basic Universal Cable з входом живлення машини й перевір, що її внутрішній буфер заряджається. Energy Cube з наступної гілки згладить перерви живлення. Наявність цих предметів завершує завдання, але саму мережу треба зібрати у світі."
  ],
  "task.514D12443397184B.title": "1 × Теплогенератор — без вилучення",
  "task.514D123CADB1A9FE.title": "4 × Базовий універсальний кабель — без вилучення",
  "quest.514D11B65A3EE8C0.title": "Infuser: дві лінії матеріалів",
  "quest.514D11B65A3EE8C0.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.514D11B65A3EE8C0.quest_desc": [
    "Metallurgic Infuser має окремі входи для предмета й інфузійного матеріалу. Залізо з вуглецем веде до сталі; залізо з редстоуном — до Infused Alloy. Для різних інфузій зручно тримати окремі машини, щоб не втрачати залишок матеріалу при перемиканні."
  ],
  "task.514D120BC0C162BB.title": "1 × Металургійний наповнювач — без вилучення",
  "quest.514D110FDA1C7CF6.title": "Сталь і сплав для корпусів",
  "quest.514D110FDA1C7CF6.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.514D110FDA1C7CF6.quest_desc": [
    "Виведи зі сталевої лінії злитки, а з редстоунової — Infused Alloy. Зберігай їх окремими запасами: корпуси, кабелі й наступні схеми споживатимуть обидва матеріали."
  ],
  "task.514D123B28AB849A.title": "8 × Сталевий злиток — без вилучення",
  "task.514D1272918DA606.title": "8 × Влитий сплав — без вилучення",
  "quest.514D11EFB7B6F506.title": "Корпуси та базове керування",
  "quest.514D11EFB7B6F506.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.514D11EFB7B6F506.quest_desc": [
    "Steel Casing та Basic Control Circuit — повторювані компоненти більшості ранніх машин. Після них розділи майстерню на переробку руди, живлення й транспортування: кожну лінію можна нарощувати окремо."
  ],
  "task.514D124489CA95EB.title": "4 × Базова схема управління — без вилучення",
  "task.514D12338DA47ADF.title": "2 × Сталевий корпус — без вилучення",
  "quest.514D1147E2CB985B.title": "Налаштуй сторони машин",
  "quest.514D1147E2CB985B.quest_subtitle": "Подача, переробка й буфер",
  "quest.514D1147E2CB985B.quest_desc": [
    "Configurator допомагає налаштовувати з'єднання та режими транспорту. У вікні самої машини признач сторони для входу, виходу й енергії та ввімкни потрібне автоматичне вивантаження. Починай з короткого маршруту між двома машинами."
  ],
  "task.514D126C25DD9231.title": "1 × Конфігуратор — без вилучення",
  "quest.514D1154FFE3DABB.title": "Руда → збагачення → випал",
  "quest.514D1154FFE3DABB.quest_subtitle": "Подача, переробка й буфер",
  "quest.514D1154FFE3DABB.quest_desc": [
    "Подавай придатну сировину в Enrichment Chamber, а її результат — в Energized Smelter. Перевір конкретний рецепт у JEI: руда, сира руда та інші форми мають різні співвідношення, тож ця гілка не обіцяє однаковий множник для всіх входів."
  ],
  "task.514D124463C7F80D.title": "1 × Камера збагачення — без вилучення",
  "task.514D12198F623502.title": "1 × Енергетична плавильня — без вилучення",
  "quest.514D1178A4D44AFB.title": "Буфер між генератором і цехом",
  "quest.514D1178A4D44AFB.quest_subtitle": "Подача, переробка й буфер",
  "quest.514D1178A4D44AFB.quest_desc": [
    "Постав Basic Energy Cube між джерелом FE та споживачами й налаштуй його вхід і вихід. Накопичувач додає запас енергії, але не виробляє її: стабільна робота все одно потребує достатнього генератора."
  ],
  "task.514D12D5C5A62FB5.title": "1 × Базовий енергетичний куб — без вилучення",
  "quest.514D118EBA5C411D.title": "Три окремі потоки",
  "quest.514D118EBA5C411D.quest_subtitle": "Подача, переробка й буфер",
  "quest.514D118EBA5C411D.quest_desc": [
    "Logistical Transporter переносить предмети, Mechanical Pipe — рідини, Pressurized Tube — хімічні речовини. Не підмінюй труби одна одною: вода й кисень виходять із різних систем. Спершу перевір кожен потік між однією парою блоків."
  ],
  "task.514D121815A3555D.title": "8 × Базовий логістичний транспортер — без вилучення",
  "task.514D12C0523DF70D.title": "8 × Базова механічна труба — без вилучення",
  "task.514D127B4BD9414E.title": "8 × Базова труба під тиском — без вилучення",
  "quest.514D116574C816F4.title": "Концентроване живлення Infuser",
  "quest.514D116574C816F4.quest_subtitle": "Подача, переробка й буфер",
  "quest.514D116574C816F4.quest_desc": [
    "Enrichment Chamber перетворює редстоун і вуглецеву сировину на збагачені матеріали для Infuser. Подай їх у правильний інфузійний вхід і порівняй витрати в JEI, перш ніж масштабувати виробництво схем."
  ],
  "task.514D12C16685AB75.title": "4 × Збагачений редстоун — без вилучення",
  "task.514D12F0163F5913.title": "4 × Збагачений вуглець — без вилучення",
  "quest.5130111B9CDAD323.title": "Енергетичний планшет",
  "quest.5130111B9CDAD323.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.5130111B9CDAD323.quest_desc": [
    "Матеріал керування наступного рівня. Концентровані речовини й сплави виготовляються окремими технологічними маршрутами; рецепт у JEI показує кількість насичення, а не лише один предмет."
  ],
  "task.513012C0FDE33AE9.title": "1 × Енергетичний планшет — без вилучення",
  "quest.513011C1D784F1C8.title": "Перший прохід вуглецю",
  "quest.513011C1D784F1C8.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.513011C1D784F1C8.quest_desc": [
    "Подай залізо та джерело вуглецю в Metallurgic Infuser: отримаєш Enriched Iron. Це проміжний матеріал для другого проходу, а не готова сталь."
  ],
  "task.513012F1393769E2.title": "1 × Збагачене залізо — без вилучення",
  "quest.513011A22D5322FD.title": "Другий прохід → сталевий пил",
  "quest.513011A22D5322FD.quest_subtitle": "Осмій, FE та перша сталь",
  "quest.513011A22D5322FD.quest_desc": [
    "Ще раз оброби Enriched Iron вуглецем в Infuser. Steel Dust переплав у злиток; так замикається початкова лінія сталі без вимоги спершу будувати пізні фабрики."
  ],
  "task.513012469791ED3D.title": "1 × Сталевий пил — без вилучення",
  "quest.513011F2453E9C69.title": "Злиток очищеного світлокаменю",
  "quest.513011F2453E9C69.quest_subtitle": "Стиснення та побічні продукти",
  "quest.513011F2453E9C69.quest_desc": [
    "Матеріал керування наступного рівня. Концентровані речовини й сплави виготовляються окремими технологічними маршрутами; рецепт у JEI показує кількість насичення, а не лише один предмет."
  ],
  "task.513012D009A996EC.title": "1 × Злиток очищеного світлокаменю — без вилучення",
  "quest.514D114A28816D5D.title": "Фабрика: паралельна обробка",
  "quest.514D114A28816D5D.quest_subtitle": "Паралельні операції",
  "quest.514D114A28816D5D.quest_desc": [
    "Фабрика додає паралельні слоти конкретній операції. Обери вузьке місце своєї лінії й онови саме його; окремі квести нижче показують доступні спеціалізації. Це завдання використовує рідне досягнення Mekanism: придбання фабрики або застосування Tier Installer."
  ],
  "task.514D1233E0E84475.title": "Нативна перевірка: Кілька операцій одночасно",
  "quest.514D1121D23494BB.title": "Вітер для постійного навантаження",
  "quest.514D1121D23494BB.quest_subtitle": "Паралельні операції",
  "quest.514D1121D23494BB.quest_desc": [
    "Підключи Wind Generator до енергетичного буфера й оцінюй баланс FE при працюючих машинах. Розширення цеху починай з фактичного споживання: кількість генераторів і пропускна здатність кабелю мають відповідати навантаженню.",
    "Гарантоване повернення витрачених компонентів: 1 × Енергетична пластина.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Вітрогенератор» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.514D12FE53FC3B26.title": "1 × Вітряк — без вилучення",
  "quest.514D118CA784C98D.title": "Вода → водень і кисень",
  "quest.514D118CA784C98D.quest_subtitle": "Вода, гази й очищення",
  "quest.514D118CA784C98D.quest_desc": [
    "Electric Pump подає воду в Electrolytic Separator. Розведи водень і кисень окремими Pressurized Tubes або хімічними резервуарами; переповнений непотрібний вихід може зупинити поділ. Кисень потрібен наступній лінії очищення."
  ],
  "task.514D125F4CE8E47E.title": "1 × Електролітичний сепаратор — без вилучення",
  "task.514D1291BA263170.title": "1 × Електричний насос — без вилучення",
  "quest.514D1118901F8AB4.title": "Кисень додає етап очищення",
  "quest.514D1118901F8AB4.quest_subtitle": "Вода, гази й очищення",
  "quest.514D1118901F8AB4.quest_desc": [
    "Подай сировину й кисень у Purification Chamber, потім передавай результат через Crusher, Enrichment Chamber та Energized Smelter. Усі виходи мають залишатися вільними. Конкретні кількості для вибраної форми руди перевір у JEI."
  ],
  "task.514D1283D5567C5D.title": "1 × Камера очищення — без вилучення",
  "task.514D12B1B528858E.title": "1 × Дробарка — без вилучення",
  "quest.514D11F90042E7F4.title": "Випарювальна установка: комплект",
  "quest.514D11F90042E7F4.quest_subtitle": "Вода, гази й очищення",
  "quest.514D11F90042E7F4.quest_desc": [
    "Мінімальна випарювальна установка: 4×3×4. Суцільне дно має 16 блоків; наступне кільце — 12; верхнє — 8, без чотирьох кутів. Дах над центром не закривай.",
    "Із 36 позицій 1 займає Controller, 2 — Valve для входу та виходу, решту 33 — Thermal Evaporation Blocks. Сонячні генератори й зовнішній нагрівач не потрібні для формування; їх можна додати для швидкості.",
    "Комплект розраховано на одну установку: вода → розсіл. Для безперервного отримання літію постав другу таку установку та подавай у неї розсіл.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Гарантоване повернення витрачених компонентів: 1 × Блок термічного випаровувача.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Контролер термічного випаровувача» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.514D12DB1BE225B7.title": "1 × Thermal Evaporation Controller — без вилучення",
  "task.514D12252C003D7F.title": "2 × Thermal Evaporation Valve — без вилучення",
  "task.514D126A59C9DD80.title": "33 × Thermal Evaporation Block — без вилучення",
  "quest.513011936DDEBB0E.title": "Розширена cхема управління",
  "quest.513011936DDEBB0E.quest_subtitle": "Паралельні операції",
  "quest.513011936DDEBB0E.quest_desc": [
    "Матеріал керування наступного рівня. Концентровані речовини й сплави виготовляються окремими технологічними маршрутами; рецепт у JEI показує кількість насичення, а не лише один предмет."
  ],
  "task.513012A8296F5CE0.title": "1 × Розширена cхема управління — без вилучення",
  "quest.513011D8991C51E1.title": "Оновлення мережі сплавом",
  "quest.513011D8991C51E1.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011D8991C51E1.quest_desc": [
    "Застосуй відповідний сплав до мережі передавачів для підвищення її рівня; нативний тригер фіксує операцію."
  ],
  "task.513012063758285D.title": "Нативна перевірка: Оновлення мережі сплавом",
  "quest.513011E0DB7DE79B.title": "Контроль вмісту резервуара",
  "quest.513011E0DB7DE79B.quest_subtitle": "Вода, гази й очищення",
  "quest.513011E0DB7DE79B.quest_desc": [
    "Використай Gauge Dropper для роботи з вмістом шкали машини. Потрібна справжня дія, а не просто інструмент у руках.",
    "Вікно машини Mekanism: натисни ПКМ по встановленому блоку порожньою рукою без присідання. Бічні вкладки відкривають доступні налаштування сторін, транспорту та поліпшень; склад вкладок залежить від машини."
  ],
  "task.51301252C1A99365.title": "Нативна перевірка: Контроль вмісту резервуара",
  "quest.513011D0BECE02CE.title": "Налаштування, які можна повторити",
  "quest.513011D0BECE02CE.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011D0BECE02CE.quest_desc": [
    "Скопіюй конфігурацію за допомогою Configuration Card і скористайся нею на сумісному пристрої."
  ],
  "task.513012B7CC099CF3.title": "Нативна перевірка: Налаштування, які можна повторити",
  "quest.5130112244309BDE.title": "Осмій для стиснення матеріалів",
  "quest.5130112244309BDE.quest_subtitle": "Стиснення та побічні продукти",
  "quest.5130112244309BDE.quest_desc": [
    "Osmium Compressor додає осмій до придатних матеріалів. Це окрема лінія сплавів, зокрема для Refined Glowstone; її фабрична версія масштабує ту саму операцію."
  ],
  "task.51301250B1E128C5.title": "1 × Осмієвий компресор — без вилучення",
  "quest.513011B3BB1DF1D9.title": "Деревина та тирса",
  "quest.513011B3BB1DF1D9.quest_subtitle": "Стиснення та побічні продукти",
  "quest.513011B3BB1DF1D9.quest_desc": [
    "Precision Sawmill розпилює деревину. Колода дає дошки та має 25% шанс додаткової тирси; дерев’яна палиця гарантовано перетворюється на одну тирсу. Тирса потрібна для паперу та картонної коробки. Для субстрату й етилену в PRC використовуй Bio Fuel з рослинної сировини, подрібненої в Crusher."
  ],
  "task.5130121ECF245907.title": "1 × Точна пилорама — без вилучення",
  "quest.513011FD1111D1BA.title": "Резервуар саме для хімії",
  "quest.513011FD1111D1BA.quest_subtitle": "Вода, гази й очищення",
  "quest.513011FD1111D1BA.quest_desc": [
    "Basic Chemical Tank буферизує водень, кисень та інші хімічні речовини. Підключай Pressurized Tubes і перевіряй призначені входи та виходи; звичайний Fluid Tank для цієї форми речовини не підходить."
  ],
  "task.5130128A5F213974.title": "1 × Базовий хімічний резервуар — без вилучення",
  "quest.513011C1717043EB.title": "Тверда сировина → хімічна речовина",
  "quest.513011C1717043EB.quest_subtitle": "Вода, гази й очищення",
  "quest.513011C1717043EB.quest_desc": [
    "Chemical Oxidizer переводить підтримувані тверді матеріали в хімічну форму. Під'єднай живлення, предметний вхід і Pressurized Tube до відповідного виходу. Це також одна з машин майбутньої уранової лінії."
  ],
  "task.51301204FB969FF2.title": "1 × Хімічний окислювач — без вилучення",
  "quest.513011933F7B17EE.title": "Рідинний буфер",
  "quest.513011933F7B17EE.quest_subtitle": "Вода, гази й очищення",
  "quest.513011933F7B17EE.quest_desc": [
    "Basic Fluid Tank зберігає воду та інші рідини. Постав його між насосом і споживачем, щоб бачити, чи встигає подача за витратою; хімічні речовини зберігай в окремих Chemical Tanks."
  ],
  "task.513012BE74BAB4F7.title": "1 × Базовий резервуар для рідини — без вилучення",
  "quest.5130113C675F054B.title": "Зміна форми в Rotary",
  "quest.5130113C675F054B.quest_subtitle": "Стиснення та побічні продукти",
  "quest.5130113C675F054B.quest_desc": [
    "Rotary Condensentrator перетворює сумісну речовину між рідкою та хімічною формами. Вибери правильний режим, а кожну сторону підключи до відповідного типу труби. Рідкі зразки в ядерній гілці є окремими демонстраціями цієї операції."
  ],
  "task.513012D492637D63.title": "1 × Роторний конденсентратор — без вилучення",
  "quest.513011156F29CC4E.title": "PRC: предмет + рідина + хімія",
  "quest.513011156F29CC4E.quest_subtitle": "Стиснення та побічні продукти",
  "quest.513011156F29CC4E.quest_desc": [
    "Pressurized Reaction Chamber має три різні входи. Для початкового рецепта підготуй 2 Bio Fuel, 10 mB води та 100 mB водню: отримаєш 1 Substrate і 100 mB етилену. Bio Fuel виготовляється з рослинної сировини в Crusher; тирса з лісопилки сюди не підходить. Налаштуй відведення і хімічного, і твердого результату, інакше машина зупиниться. Наступні рецепти PRC ведуть до HDPE.",
    "Гарантоване повернення витрачених компонентів: 1 × Базовий хімічний бак.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Камера реакцій під тиском» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012A091605D75.title": "1 × Реакційна камера під тиском — без вилучення",
  "quest.513011740CB95726.title": "Локальний крафт за формулою",
  "quest.513011740CB95726.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011740CB95726.quest_desc": [
    "Formulaic Assemblicator виконує записаний Crafting Formula. Подавай тільки потрібні інгредієнти, забезпеч FE та окреме виведення результату. Це готовий вузол повторюваного крафту для локальної лінії."
  ],
  "task.5130124ACE1024C5.title": "1 × Формульний ассемблікатор — без вилучення",
  "quest.513011447E582F7D.title": "Сортування перед розгалуженням",
  "quest.513011447E582F7D.quest_subtitle": "Крафт, сортування та видобуток",
  "quest.513011447E582F7D.quest_desc": [
    "Logistical Sorter забирає предмети з під'єднаного інвентарю й розподіляє їх за фільтрами та кольорами. Спершу перевір один вхід і два призначення, а потім додавай решту ліній, щоб небажані предмети не забивали машини."
  ],
  "task.513012C9F9E483BA.title": "1 × Логістичний сортувальник — без вилучення",
  "quest.513011C68B70B3F3.title": "Базова плавильна фабрика",
  "quest.513011C68B70B3F3.quest_subtitle": "Паралельні операції",
  "quest.513011C68B70B3F3.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.5130129D0DF8B1E3.title": "1 × Базова плавильна фабрика — без вилучення",
  "quest.51301147649F4943.title": "Базова фабрика збагачення",
  "quest.51301147649F4943.quest_subtitle": "Паралельні операції",
  "quest.51301147649F4943.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.5130128A09FE85EC.title": "1 × Базова фабрика збагачення — без вилучення",
  "quest.5130117ADB85508F.title": "Базова дробильна фабрика",
  "quest.5130117ADB85508F.quest_subtitle": "Вода, гази й очищення",
  "quest.5130117ADB85508F.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.513012088B2DE577.title": "1 × Базова дробильна фабрика — без вилучення",
  "quest.513011ADC7A6AF6B.title": "Базова фабрика стиснення",
  "quest.513011ADC7A6AF6B.quest_subtitle": "Стиснення та побічні продукти",
  "quest.513011ADC7A6AF6B.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.5130122CBF60E453.title": "1 × Базова фабрика стиснення — без вилучення",
  "quest.51301189138B989B.title": "Базова фабрика очищення",
  "quest.51301189138B989B.quest_subtitle": "Вода, гази й очищення",
  "quest.51301189138B989B.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.513012709DD505E3.title": "1 × Базова фабрика очищення — без вилучення",
  "quest.513011472102F0D8.title": "Базова фабрика наповнення",
  "quest.513011472102F0D8.quest_subtitle": "Паралельні операції",
  "quest.513011472102F0D8.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.5130124F6FCB081D.title": "1 × Базова фабрика наповнення — без вилучення",
  "quest.513011FCD72A741B.title": "Базова розпилювальна фабрика",
  "quest.513011FCD72A741B.quest_subtitle": "Стиснення та побічні продукти",
  "quest.513011FCD72A741B.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.51301213F192B1A6.title": "1 × Базова розпилювальна фабрика — без вилучення",
  "quest.51301190143553CA.title": "Розширена плавильна фабрика",
  "quest.51301190143553CA.quest_subtitle": "Паралельні операції",
  "quest.51301190143553CA.quest_desc": [
    "Масштабуй саме цю операцію. Більше паралельних слотів потребує достатньої подачі матеріалу й енергії; спочатку прибери вузьке місце, а потім підвищуй рівень наступної машини."
  ],
  "task.513012B18B801099.title": "1 × Розширена плавильна фабрика — без вилучення",
  "quest.51301174E90C0139.title": "Розширений універсальний кабель",
  "quest.51301174E90C0139.quest_subtitle": "Пропускна здатність і місткість",
  "quest.51301174E90C0139.quest_desc": [
    "Підвищи пропускну здатність конкретного каналу. Швидша труба не збільшує продуктивність машини, якщо їй бракує ресурсу; перевір заповнення обох кінців лінії."
  ],
  "task.5130128D20D88D3E.title": "4 × Розширений універсальний кабель — без вилучення",
  "quest.513011854F694FFF.title": "Елітний універсальний кабель",
  "quest.513011854F694FFF.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011854F694FFF.quest_desc": [
    "Підвищи пропускну здатність конкретного каналу. Швидша труба не збільшує продуктивність машини, якщо їй бракує ресурсу; перевір заповнення обох кінців лінії."
  ],
  "task.513012FFF9CA1987.title": "4 × Елітний універсальний кабель — без вилучення",
  "quest.5130116E42F14F4E.title": "Розширений логістичний транспортер",
  "quest.5130116E42F14F4E.quest_subtitle": "Пропускна здатність і місткість",
  "quest.5130116E42F14F4E.quest_desc": [
    "Підвищи пропускну здатність конкретного каналу. Швидша труба не збільшує продуктивність машини, якщо їй бракує ресурсу; перевір заповнення обох кінців лінії."
  ],
  "task.5130129CE0FFBF5C.title": "4 × Розширений логістичний транспортер — без вилучення",
  "quest.513011C357A6C847.title": "Елітний логістичний транспортер",
  "quest.513011C357A6C847.quest_subtitle": "Пропускна здатність і місткість",
  "quest.513011C357A6C847.quest_desc": [
