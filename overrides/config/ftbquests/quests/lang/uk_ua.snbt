  "task.5130122AB8A18636.title": "Відвідати: ecologics:desert_ruin",
  "quest.51301113971C0E7D.title": "Доручення з таверни",
  "quest.51301113971C0E7D.quest_subtitle": "Поселення й руїни",
  "quest.51301113971C0E7D.quest_desc": [
    "Проведи саме той обмін із жителем таверни, який передбачає нативне досягнення."
  ],
  "task.51301292B5B21BD4.title": "Нативна перевірка: Доручення з таверни",
  "quest.513011CD5B806156.title": "Поселення серед боліт",
  "quest.513011CD5B806156.quest_subtitle": "Поселення й руїни",
  "quest.513011CD5B806156.quest_desc": [
    "Знайди болотне поселення Dungeons and Taverns."
  ],
  "task.51301281CC756FBD.title": "Нативна перевірка: Поселення серед боліт",
  "quest.51301194C75CDD89.title": "Покинутий бункер",
  "quest.51301194C75CDD89.quest_subtitle": "Поселення й руїни",
  "quest.51301194C75CDD89.quest_desc": [
    "Досліди цю окрему небезпечну або покинуту локацію Dungeons and Taverns; підготуйся до її оточення."
  ],
  "task.51301209CB41DB00.title": "Відвідати: nova_structures:bunker",
  "quest.513011F036245C03.title": "Табір у глибинному сланці",
  "quest.513011F036245C03.quest_subtitle": "Поселення й руїни",
  "quest.513011F036245C03.quest_desc": [
    "Досліди цю окрему небезпечну або покинуту локацію Dungeons and Taverns; підготуйся до її оточення."
  ],
  "task.513012FDF8969FC8.title": "Відвідати: nova_structures:deepslate_camp",
  "quest.5130112F2F33CBEF.title": "Місто, що стало руїною",
  "quest.5130112F2F33CBEF.quest_subtitle": "Поселення й руїни",
