  "task.513012535FCCE4B9.title": "1 × Кристальний лук — без вилучення",
  "quest.513011A1CAF96497.title": "Терновий чакрам",
  "quest.513011A1CAF96497.quest_subtitle": "Зброя та жезли",
  "quest.513011A1CAF96497.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.513012315308B058.title": "1 × Терновий чакрам — без вилучення",
  "quest.5130110DEF4C6613.title": "Палючий чакрам",
  "quest.5130110DEF4C6613.quest_subtitle": "Зброя та жезли",
  "quest.5130110DEF4C6613.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.51301244CCB5E9BD.title": "1 × Палючий чакрам — без вилучення",
  "quest.5130112919942EFB.title": "Зореклич",
  "quest.5130112919942EFB.quest_subtitle": "Зброя та жезли",
