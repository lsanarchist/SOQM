  "task.51301261ECE6BE52.title": "Відвідати: kobolds:kobold_den",
  "quest.513011D718E88823.title": "Пустельна руїна Ecologics",
  "quest.513011D718E88823.quest_subtitle": "Ecologics та кобольди",
  "quest.513011D718E88823.quest_desc": [
