  ],
  "task.513012C231402633.title": "1 × Trident of the Sea Abyss — без вилучення",
  "quest.513011417ED6EDBA.title": "Shield of the Earth Core",
  "quest.513011417ED6EDBA.quest_subtitle": "Космічна зброя",
  "quest.513011417ED6EDBA.quest_desc": [
