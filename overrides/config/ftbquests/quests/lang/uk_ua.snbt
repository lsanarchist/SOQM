  "quest.5130114E301B4F16.title": "Wooden Exalted Crafter",
  "quest.5130114E301B4F16.quest_subtitle": "Переміщення та крафт",
  "quest.5130114E301B4F16.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему."
  ],
  "task.5130126421621FE0.title": "1 × Wooden Exalted Crafter — без вилучення",
  "quest.513011D77FC77768.title": "Vengeance Pickaxe",
  "quest.513011D77FC77768.quest_subtitle": "Темне спорядження",
  "quest.513011D77FC77768.quest_desc": [
    "Отримай інструмент або захисну здібність EvilCraft. Для предметів із ресурсом дії стеж за запасом; його наявність в інвентарі не гарантує активної здібності."
  ],
  "task.513012217AA5721B.title": "1 × Vengeance Pickaxe — без вилучення",
  "quest.5130112CB01A2EF9.title": "Vein Sword",
  "quest.5130112CB01A2EF9.quest_subtitle": "Темне спорядження",
