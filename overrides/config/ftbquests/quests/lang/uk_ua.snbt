  "task.5130122EFEF45736.title": "4 × Networked Storage Pipe — без вилучення",
  "quest.513011F06AEBF446.title": "Networked Routing Pipe",
  "quest.513011F06AEBF446.quest_subtitle": "Мережева маршрутизація",
  "quest.513011F06AEBF446.quest_desc": [
    "Збери канал класичної логістики. Перевір тип ресурсу та налаштуй витягування на джерелі; форма труби не замінює правильний фільтр."
  ],
  "task.5130128C353D961A.title": "4 × Networked Routing Pipe — без вилучення",
  "quest.51301104CFA9A015.title": "Майстерня: Ender Chest",
  "quest.51301104CFA9A015.quest_subtitle": "Міжвимірний склад і резервуари",
  "quest.51301104CFA9A015.quest_desc": [
    "EnderStorage Ender Chest дає предметний канал між віддаленими точками. На обох скринях задай однакову комбінацію трьох кольорів і перевір спільний вміст одним недорогим предметом.",
    "Для безперервного потоку додай витягування на стороні приймання. Спільний канал має скінченний інвентар: без вивантаження з другої скрині він заповниться. Перед передаванням цінних речей також перевір, хто ще користується цим каналом."
  ],
  "task.513012F68C8B6E9D.title": "1 × Ender Chest — без вилучення",
  "quest.5130114BF0614A92.title": "Ender Tank",
  "quest.5130114BF0614A92.quest_subtitle": "Міжвимірний склад і резервуари",
  "quest.5130114BF0614A92.quest_desc": [
    "Ender Tank переносить рідину між резервуарами з однаковим кольоровим каналом. Налаштуй пару, подай малу порцію потрібної рідини й перевір її появу на іншій стороні.",
    "Під’єднуй саме рідинні труби й забезпеч відведення з приймача. Один зайнятий канал не є змішувачем для незалежних рідин: розділяй воду, паливо та інші лінії різними каналами."
  ],
  "task.51301213275BD204.title": "1 × Ender Tank — без вилучення",
  "quest.51301111F4AEB3F2.title": "Trash Can",
  "quest.51301111F4AEB3F2.quest_subtitle": "Автоматизація та утилізація",
  "quest.51301111F4AEB3F2.quest_desc": [
    "Trash Can призначений для остаточного видалення непотрібних предметів. Використовуй його наприкінці окремої гілки відходів, після відбору ресурсів, які потрібно зберегти.",
    "Спочатку перевір фільтрацію недорогим зразком і залиш корисним предметам власний шлях на склад. Trash Can не є переповненим буфером, із якого потім можна забрати вміст."
  ],
  "task.5130124EA06CC13F.title": "1 × Trash Can — без вилучення",
  "quest.5130113EBB472FCC.title": "Fluid Trash Can",
  "quest.5130113EBB472FCC.quest_subtitle": "Автоматизація та утилізація",
  "quest.5130113EBB472FCC.quest_desc": [
    "Цей пристрій додає окрему функцію базі: перенесення, переробку, фільтрацію, будівництво чи керування. Перевір результат на малій кількості перед постійним підключенням."
  ],
  "task.513012B9482BB243.title": "1 × Fluid Trash Can — без вилучення",
  "quest.51301168D7903A04.title": "Energy Trash Can",
  "quest.51301168D7903A04.quest_subtitle": "Автоматизація та утилізація",
  "quest.51301168D7903A04.quest_desc": [
    "Цей пристрій додає окрему функцію базі: перенесення, переробку, фільтрацію, будівництво чи керування. Перевір результат на малій кількості перед постійним підключенням."
  ],
