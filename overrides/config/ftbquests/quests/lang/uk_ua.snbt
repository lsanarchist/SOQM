  "task.5130127FEC18BF52.title": "Нативна перевірка: Свій серед сельджуків",
  "quest.513011217B2014E3.title": "Візантійська кирка",
  "quest.513011217B2014E3.quest_subtitle": "Візантійці",
  "quest.513011217B2014E3.quest_desc": [
    "Отримай ремісничий товар візантійської культури. Торговий асортимент залежить від конкретного поселення та його розвитку; цей напрям є додатковим шляхом, а не випадковим замком основної кампанії."
  ],
  "task.51301203BCEC2E47.title": "1 × Візантійська кирка — без вилучення",
  "quest.51301122EF158ED0.title": "Візантійська сокира",
  "quest.51301122EF158ED0.quest_subtitle": "Візантійці",
  "quest.51301122EF158ED0.quest_desc": [
    "Отримай ремісничий товар візантійської культури. Торговий асортимент залежить від конкретного поселення та його розвитку; цей напрям є додатковим шляхом, а не випадковим замком основної кампанії."
