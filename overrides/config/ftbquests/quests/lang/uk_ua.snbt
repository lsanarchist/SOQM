  ],
  "task.513012520431ED43.title": "1 × Громоклич — без вилучення",
  "quest.51301171892A045E.title": "Мана-бластер",
  "quest.51301171892A045E.quest_subtitle": "Зброя та жезли",
  "quest.51301171892A045E.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.513012FBB696FBB5.title": "1 × Мана-бластер — без вилучення",
  "quest.513011A450B42F4E.title": "Жезл глибин",
  "quest.513011A450B42F4E.quest_subtitle": "Зброя та жезли",
  "quest.513011A450B42F4E.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.5130124693E3E919.title": "1 × Жезл глибин — без вилучення",
  "quest.51301170FB317C97.title": "Жезл земель",
  "quest.51301170FB317C97.quest_subtitle": "Зброя та жезли",
  "quest.51301170FB317C97.quest_desc": [
    "Використай ману для конкретного інструмента, захисту або руху. Тримай сумісне джерело мани та перевір вартість здібності; усі аксесуари повинні поміщатися в дозволені слоти."
  ],
  "task.5130125CC2D95FDF.title": "1 × Жезл земель — без вилучення",
  "quest.513011EC3D07F9A3.title": "Ритуал Ґаї: комплект майданчика",
  "quest.513011EC3D07F9A3.quest_subtitle": "Gaia та майстерність",
  "quest.513011EC3D07F9A3.quest_desc": [
    "Майданчик ритуалу Gaia: 9 залізних блоків утворюють основу маяка 3×3; Beacon стоїть у центрі над ними. Розстав 4 Gaia Pylon за схемою Lexica Botania та очисть місце для бою. Це будівельний комплект; потрібну жертву для виклику готуй окремо.",
    "Завдання перевіряють кожен блок і його кількість без вилучення. Потримай комплект в інвентарі до встановлення; після цього виконай окрему перевірку складання або роботи, якщо вона є в цьому квесті.",
    "Gaia Pylons належать до арени Ritual of Gaia. Побудуй конструкцію з активним Beacon за схемою Lexica та залиш навколо достатньо вільного місця для бою.",
    "Для звичайного виклику потрібен Terrasteel Ingot як жертва. Пілон у рецепті та готова арена — різні кроки; спочатку склади всі частини й підготуй спорядження."
  ],
  "task.51301235AF147D14.title": "4 × Gaia Pylon — без вилучення",
  "quest.5130119F6CDCBAEA.title": "Перший Guardian of Gaia",
  "quest.5130119F6CDCBAEA.quest_subtitle": "Gaia та майстерність",
  "quest.5130119F6CDCBAEA.quest_desc": [
    "На готовій арені застосуй Terrasteel Ingot до активного Beacon через Shift+ПКМ, щоб розпочати Ritual of Gaia. Після перемоги забери Gaia Spirits: вони потрібні для Gaia Ingots і далі для Mythic Circuit.",
    "Цей квест читає нативне досягнення перемоги, а не перевіряє інвентар. Не розраховуй на бафи маяка в бою: ритуал їх вимикає; кількість присутніх учасників також впливає на складність."
  ],
  "task.513012B2C0CF8345.title": "Нативна перевірка: Перший Guardian of Gaia",
  "quest.513011A8AE758F43.title": "Злиток духа Ґаї",
  "quest.513011A8AE758F43.quest_subtitle": "Gaia та майстерність",
  "quest.513011A8AE758F43.quest_desc": [
    "Gaia Ingot створюється з одного Terrasteel Ingot і чотирьох Gaia Spirits, розміщених навколо нього хрестом. Духи отримують після перемоги над Guardian of Gaia.",
    "Відклади два Gaia Ingots для партії Mythic Circuits. Такий злиток також викликає посиленого Guardian, але витрачати його на повторний бій для першої міфічної схеми не потрібно."
  ],
  "task.5130123207A25F3E.title": "1 × Злиток духа Ґаї — без вилучення",
  "quest.513011241BDCE00F.title": "Повернення до ритуалу Gaia",
  "quest.513011241BDCE00F.quest_subtitle": "Gaia та майстерність",
  "quest.513011241BDCE00F.quest_desc": [
    "Для посиленого Ritual of Gaia використовуй Gaia Ingot замість Terrasteel Ingot на тій самій правильно збудованій арені. Підготуй лікування, запас міцності та місце для руху до виклику.",
    "Завдання перевіряє нативну перемогу у складному ритуалі. Це окремий бойовий виклик після доступу до Gaia Ingots; отримання злитка саме по собі не зарахує його."
  ],
  "task.513012D0AD82B0F5.title": "Нативна перевірка: Повернення до ритуалу Gaia",
  "quest.5130117ABA3F4F64.title": "Велике замовлення Corporea",
  "quest.5130117ABA3F4F64.quest_subtitle": "Gaia та майстерність",
  "quest.5130117ABA3F4F64.quest_desc": [
    "Виконай нативну умову великого замовлення Corporea. Підготуй доступні сховища й перевір, що запит не забере резервні ресурси."
  ],
  "task.5130127DE756E4E6.title": "Нативна перевірка: Велике замовлення Corporea",
  "quest.513011FA714B4E58.title": "Розсіювач мани Ґаї",
  "quest.513011FA714B4E58.quest_subtitle": "Gaia та майстерність",
  "quest.513011FA714B4E58.quest_desc": [
    "Отримай компонент ельфійського або террасталевого рівня. Terrasteel потребує запасу мани; ельфійський портал і ритуал Gaia мають окремі вимоги до споруди та ресурсів."
  ],
  "task.5130121F52CB1149.title": "1 × Розсіювач мани Ґаї — без вилучення",
  "chapter.5130105668AE29F0.title": "16 · EvilCraft: кров, духи й погода",
  "chapter.5130105668AE29F0.chapter_subtitle": [
    "45 квестів · 7 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.513011C91AAAFAA7.title": "Origins of Darkness",
  "quest.513011C91AAAFAA7.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011C91AAAFAA7.quest_desc": [
    "Візьми Origins of Darkness як довідник окремих дослідів. Почни з Dark Gem і крові, потім збери Blood Infuser та потрібну операцію.",
    "Далі можна розвивати роботу з духами, погодою чи допоміжними предметами. Обирай ціль за її ефектом; якщо рецепт потребує спільного компонента, його маршрут знайдеш у «Головний маршрут».",
    "Відкрий відповідний розділ Origins of Darkness. Збір крові, її зберігання та інфузія — різні кроки; перед дослідом підготуй вихід для продукту та запас потрібної речовини.",
    "Origins of Darkness: візьми книгу EvilCraft у руку й натисни ПКМ у повітря, потім відкрий відповідний розділ досліду. Книгу відкривають предметом; універсальна клавіша для цього не потрібна."
  ],
  "task.513012F39127555C.title": "1 × Origins of Darkness — без вилучення",
  "quest.5130115ECA129D7B.title": "Dark Gem",
  "quest.5130115ECA129D7B.quest_subtitle": "Темні самоцвіти та кров",
  "quest.5130115ECA129D7B.quest_desc": [
    "Відкрий відповідний розділ Origins of Darkness. Збір крові, її зберігання та інфузія — різні кроки; перед дослідом підготуй вихід для продукту та запас потрібної речовини."
  ],
  "task.513012EF7FE79398.title": "1 × Dark Gem — без вилучення",
  "quest.513011851FF1F267.title": "Crushed Dark Gem",
  "quest.513011851FF1F267.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011851FF1F267.quest_desc": [
    "Відкрий відповідний розділ Origins of Darkness. Збір крові, її зберігання та інфузія — різні кроки; перед дослідом підготуй вихід для продукту та запас потрібної речовини."
  ],
  "task.51301230DC308F38.title": "1 × Crushed Dark Gem — без вилучення",
  "quest.513011C82B7ED775.title": "Darkened Apple",
  "quest.513011C82B7ED775.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011C82B7ED775.quest_desc": [
    "Відкрий відповідний розділ Origins of Darkness. Збір крові, її зберігання та інфузія — різні кроки; перед дослідом підготуй вихід для продукту та запас потрібної речовини."
  ],
  "task.513012B0ADA4CD77.title": "1 × Darkened Apple — без вилучення",
  "quest.513011BE85999FCD.title": "Blood Extractor",
  "quest.513011BE85999FCD.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011BE85999FCD.quest_desc": [
    "Тримай Blood Extractor в інвентарі під час убивства мобів, із яких EvilCraft дозволяє збирати кров. Він наповнюється від таких убивств; саме виготовлення екстрактора ще не дає запасу Blood для машин.",
    "Криваві плями на землі теж можна збирати: використай екстрактор по плямі, присівши. Кілька екстракторів або екстрактор із Dark Tank поєднуються в сітці крафту для збільшення місткості."
  ],
  "task.513012E2DAD093FB.title": "1 × Blood Extractor — без вилучення",
  "quest.513011106E68DB50.title": "Hardened Blood Shard",
  "quest.513011106E68DB50.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011106E68DB50.quest_desc": [
    "Blood, розлита в сухому місці, із часом перетворюється на Hardened Blood. Розбий затверділу кров за допомогою Flint and Steel, щоб отримати Hardened Blood Shards. Звичайна кирка або рука поверне її до рідкого стану.",
    "Якщо добудеш сам блок Hardened Blood за допомогою Silk Touch, його можна переплавити на дев’ять уламків. Для одного Blood Infusion Core потрібні вісім уламків, тож збирай їх партією."
  ],
  "task.513012E1D83983A0.title": "1 × Hardened Blood Shard — без вилучення",
  "quest.513011BB268203F6.title": "Blood Infusion Core",
  "quest.513011BB268203F6.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011BB268203F6.quest_desc": [
    "Розмісти Dark Power Gem у центрі верстака й оточи його вісьмома Hardened Blood Shards. Потрібен саме Dark Power Gem; звичайний Dark Gem у цей рецепт не підходить.",
    "Blood Infusion Core є компонентом Blood Infuser. Підготуй також Industrial Chassis, Arcane Conduit і Control Assembly: ядро саме по собі не завершує технологічні вимоги інфузора SOQM."
  ],
  "task.513012E5A42B9889.title": "1 × Blood Infusion Core — без вилучення",
  "quest.513011F6BBEDC253.title": "Blood Infuser",
  "quest.513011F6BBEDC253.quest_subtitle": "Темні самоцвіти та кров",
  "quest.513011F6BBEDC253.quest_desc": [
    "Blood Infuser використовує Blood для інфузії предметів і наповнення сумісних із кров’ю місткостей. Перед першою обробкою подай кров у машину й поклади предмет, для якого існує рецепт Blood Infusion.",
    "Якщо інфузор наповнений, але не працює, перевір сигнал редстоуну: він призупиняє процес. Для рецептів вищого рівня потрібні Promises of Tenacity; додаткова кров не замінює потрібний рівень машини."
  ],
  "task.5130120640D3EC5A.title": "1 × Blood Infuser — без вилучення",
  "quest.513011F5469C1A38.title": "Дух у вічному ув’язненні",
  "quest.513011F5469C1A38.quest_subtitle": "Духи й некромантія",
  "quest.513011F5469C1A38.quest_desc": [
    "Спіймай духа в Box of Eternal Closure через нативний механізм EvilCraft."
  ],
  "task.513012F67DBD9745.title": "Нативна перевірка: Дух у вічному ув’язненні",
  "quest.513011BB3FBFDB27.title": "Vengeance Essence",
  "quest.513011BB3FBFDB27.quest_subtitle": "Духи й некромантія",
  "quest.513011BB3FBFDB27.quest_desc": [
    "Побудуй вузол роботи з духами або підвищення ефективності. Захищені істоти не обходять обмеження через інший механізм; користуйся описаними в книзі допустимими цілями."
  ],
  "task.5130121E335AA4E3.title": "1 × Vengeance Essence — без вилучення",
  "quest.5130117775EC76EE.title": "Spectral Glasses",
  "quest.5130117775EC76EE.quest_subtitle": "Духи й некромантія",
  "quest.5130117775EC76EE.quest_desc": [
    "Spectral Glasses дають змогу бачити Vengeance Spirits, не привертаючи їхньої уваги. Це зручний спосіб знайти духа для захоплення після смерті потрібного моба.",
    "Окуляри не заспокоюють духа, який уже переслідує тебе. Підготуй Vengeance Focus і порожній Box of Eternal Closure до пошуку: саме спостереження духа ще не наповнює скриньку."
  ],
  "task.5130121BCC4589A9.title": "1 × Spectral Glasses — без вилучення",
  "quest.513011BFD1508F3E.title": "Vengeance Focus",
  "quest.513011BFD1508F3E.quest_subtitle": "Духи й некромантія",
  "quest.513011BFD1508F3E.quest_desc": [
    "Vengeance Focus дає змогу націлитися на Vengeance Spirit і зупинити його для захоплення в Box of Eternal Closure. Для пошуку духів підготуй також Spectral Glasses або інший засіб, який дозволяє їх бачити.",
    "Обирай духа того моба, чиї дропи або яйце появи тобі потрібні. Focus є інструментом захоплення, а збережений дух міститься у скриньці — саме її далі використовують машини."
  ],
  "task.513012B7F27273D3.title": "1 × Vengeance Focus — без вилучення",
  "quest.51301120ED3388D8.title": "Box of Eternal Closure",
  "quest.51301120ED3388D8.quest_subtitle": "Духи й некромантія",
  "quest.51301120ED3388D8.quest_desc": [
    "Порожній Box of Eternal Closure — лише контейнер. Щоб підготувати його до Spirit Furnace або Spirit Reanimator, знайди Vengeance Spirit потрібного моба й захопи його за допомогою Vengeance Focus.",
    "Цей предметний квест зараховує й порожню скриньку. Перед установленням у машину перевір, який дух у ній збережений: порожня скринька не є готовим джерелом дропів."
  ],
  "task.51301270B7BA84F3.title": "1 × Box of Eternal Closure — без вилучення",
  "quest.513011A6B4765CC7.title": "Spirit Furnace",
  "quest.513011A6B4765CC7.quest_subtitle": "Духи й некромантія",
  "quest.513011A6B4765CC7.quest_desc": [
    "Збудуй порожнисту оболонку з Dark Blood Bricks і постав один Spirit Furnace у її стіну. Внутрішнього простору має вистачати для моба, чий дух ти використовуєш; правильна структура отримує червоне світіння.",
    "Подай Blood, встав Box of Eternal Closure зі спійманим духом і забезпеч місце для дропів. Піч повторно отримує дропи цього моба, витрачаючи кров; дух у скриньці при цьому зберігається для наступних циклів."
  ],
  "task.51301272E0AAC94B.title": "1 × Spirit Furnace — без вилучення",
  "quest.513011C4979876E2.title": "Spirit Reanimator",
  "quest.513011C4979876E2.quest_subtitle": "Духи й некромантія",
  "quest.513011C4979876E2.quest_desc": [
    "Spirit Reanimator поєднує захопленого духа, Blood і звичайне Egg, щоб створити яйце появи відповідного моба. До крафту машини SOQM також входять Quantum Processor і Dimensional Matrix.",
    "Реанімація витрачає духа: одна спіймана сутність дає одне яйце. Підготуй окремий захват, якщо хочеш залишити постійне джерело дропів у Spirit Furnace; не всі духи підтримують створення яйця."
  ],
  "task.513012437FA5CDB0.title": "1 × Spirit Reanimator — без вилучення",
  "quest.5130115B8812662A.title": "Necromancer Staff",
  "quest.5130115B8812662A.quest_subtitle": "Духи й некромантія",
  "quest.5130115B8812662A.quest_desc": [
    "Побудуй вузол роботи з духами або підвищення ефективності. Захищені істоти не обходять обмеження через інший механізм; користуйся описаними в книзі допустимими цілями."
  ],
  "task.513012844FF78CC7.title": "1 × Necromancer Staff — без вилучення",
  "quest.513011B5B29600A9.title": "Promise of Tenacity I",
  "quest.513011B5B29600A9.quest_subtitle": "Покращення та очищення",
  "quest.513011B5B29600A9.quest_desc": [
    "Promise of Tenacity I створюється з Bowl of Promises, Iron Promise Acceptor і Spider Eye. Чашу обіцянок готують через кровну інфузію; звичайна порожня миска не замінює готову Bowl of Promises.",
    "Установи обіцянку в сумісну машину: Tenacity збільшує її рівень, місткість крові й простір для поліпшень та відкриває відповідні рецепти. Для прискорення існують окремі Promises of Velocity."
  ],
  "task.513012BD7EE5153E.title": "1 × Promise of Tenacity I — без вилучення",
  "quest.51301114D956AFA2.title": "Promise of Tenacity II",
  "quest.51301114D956AFA2.quest_subtitle": "Покращення та очищення",
  "quest.51301114D956AFA2.quest_desc": [
    "Для Promise of Tenacity II поєднай Bowl of Promises рівня I або вище, Gold Promise Acceptor та Ender Pearl. Чаша нульового рівня, придатна для першої обіцянки, у цьому рецепті вже не підходить.",
    "Установлення Tenacity II відкриває рецепти відповідного рівня машини. Перевір потрібний рівень конкретної інфузії до підготовки великої партії інгредієнтів."
  ],
  "task.5130128AC24061CA.title": "1 × Promise of Tenacity II — без вилучення",
  "quest.513011942BD9B748.title": "Promise of Tenacity III",
  "quest.513011942BD9B748.quest_subtitle": "Покращення та очищення",
  "quest.513011942BD9B748.quest_desc": [
    "Для Promise of Tenacity III потрібні Bowl of Promises рівня II або III, Diamond Promise Acceptor та Eye of Ender. Це окремий крафт; додавання кількох обіцянок першого рівня не замінює ці компоненти.",
    "Після встановлення найвищого Tenacity забезпеч машині достатній приплив Blood. Promise of Productivity окремо зменшує витрату крові, а Promise of Velocity окремо прискорює процес."
  ],
  "task.5130125703E7BC3A.title": "1 × Promise of Tenacity III — без вилучення",
  "quest.513011735E047323.title": "Purifier",
  "quest.513011735E047323.quest_subtitle": "Покращення та очищення",
  "quest.513011735E047323.quest_desc": [
    "Purifier очищає спорядження від негативних ефектів, зокрема побічних наслідків ремонту в Blood Chest. Для такого очищення встав проблемний предмет і подай щонайменше відро Blood.",
    "Для перенесення зачарування потрібен інший набір: зачарований предмет, Blook і повний запас крові. Blook — це книга після кровної інфузії; процес переносить одне випадкове зачарування та витрачає три відра Blood."
  ],
  "task.513012A90CA6376C.title": "1 × Purifier — без вилучення",
  "quest.51301122EA899791.title": "Керована деформація",
  "quest.51301122EA899791.quest_subtitle": "Деформація та виклики",
  "quest.51301122EA899791.quest_desc": [
    "Виконай нативну дію Distort. Дотримуйся умов книги Origins of Darkness для предмета та цілі."
  ],
  "task.5130124F87281BCD.title": "Нативна перевірка: Керована деформація",
  "quest.51301123305026D9.title": "Практика некроманта",
  "quest.51301123305026D9.quest_subtitle": "Деформація та виклики",
  "quest.51301123305026D9.quest_desc": [
    "Виконай нативну дію Necromance. Ціль та умови визначає EvilCraft; міміки й захищені боси не обходять загальні правила."
  ],
  "task.513012BACB46AE0A.title": "Нативна перевірка: Практика некроманта",
  "quest.5130111CE1F0B46F.title": "Weather Container",
  "quest.5130111CE1F0B46F.quest_subtitle": "Довкілля й погода",
  "quest.5130111CE1F0B46F.quest_desc": [
    "Weather Container зберігає конкретну погоду. Кинь порожній контейнер у ядро Dark Temple, щоб увібрати поточну погоду; для Eternal Water Bucket потрібно робити це саме під час дощу.",
    "Наповнений контейнер можна витратити в рецепті або розбити кидком, щоб повернути збережену погоду. Для запланованого крафту відклади його й перевір збережений тип погоди."
  ],
  "task.513012BA733CCB79.title": "1 × Weather Container — без вилучення",
  "quest.5130116CCBBB36D8.title": "Environmental Accumulation Core",
  "quest.5130116CCBBB36D8.quest_subtitle": "Довкілля й погода",
  "quest.5130116CCBBB36D8.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему.",
    "Знайди Dark Temple мода EvilCraft і добудь ядро з установленого Environmental Accumulator: його нативна таблиця випадіння дає саме це ядро. Воно потрібне для Sanguinary Environmental Accumulator; вимагати підняти цілий храмовий блок цей квест не буде."
  ],
  "task.51301262E229B615.title": "1 × Environmental Accumulation Core — без вилучення",
  "quest.5130118186C88013.title": "Sanguinary Environmental Acc.",
  "quest.5130118186C88013.quest_subtitle": "Довкілля й погода",
  "quest.5130118186C88013.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему."
  ],
  "task.51301283527F2DAC.title": "1 × Sanguinary Environmental Acc. — без вилучення",
  "quest.5130113109FB623B.title": "Biome Extract",
  "quest.5130113109FB623B.quest_subtitle": "Довкілля й погода",
  "quest.5130113109FB623B.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему."
  ],
  "task.513012690265A19D.title": "1 × Biome Extract — без вилучення",
  "quest.51301131C5916096.title": "Eternal Water Bucket",
  "quest.51301131C5916096.quest_subtitle": "Довкілля й погода",
  "quest.51301131C5916096.quest_desc": [
    "Рецепт Eternal Water Bucket потребує Weather Container, наповненого дощем, і трьох Dark Gems. Розмісти контейнер між двома каменями, а третій поклади під ним: отримаєш чотири відра.",
    "Порожній контейнер або контейнер з іншою погодою не підходить, навіть якщо його іконка схожа. Спершу збережи дощ у Dark Temple, потім використовуй саме цей контейнер у крафті."
  ],
  "task.513012AC18954F66.title": "1 × Eternal Water Bucket — без вилучення",
  "quest.513011350799F98E.title": "Entangled Chalice",
  "quest.513011350799F98E.quest_subtitle": "Довкілля й погода",
  "quest.513011350799F98E.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему."
  ],
  "task.5130121541AAAD4B.title": "1 × Entangled Chalice — без вилучення",
  "quest.513011EBF2C174B4.title": "Blood Pearl of Teleportation",
  "quest.513011EBF2C174B4.quest_subtitle": "Переміщення та крафт",
  "quest.513011EBF2C174B4.quest_desc": [
    "Цей предмет додає окрему темну технологію базі. Підготуй умови активації з книги та випробуй її в контрольованому місці, перш ніж будувати постійну систему."
