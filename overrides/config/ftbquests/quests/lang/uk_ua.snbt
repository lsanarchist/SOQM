  "task.513012589DC1B4FB.title": "1 × Processing Addon Tier 2 — без вилучення",
  "quest.5130118C29E5449C.title": "Range Addon Tier 2",
  "quest.5130118C29E5449C.quest_subtitle": "Ether Gas та масштабування",
  "quest.5130118C29E5449C.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.5130120BA958EC8F.title": "1 × Range Addon Tier 2 — без вилучення",
  "quest.5130111D6C11FBB1.title": "Range Addon Tier 5",
  "quest.5130111D6C11FBB1.quest_subtitle": "Ether Gas та масштабування",
  "quest.5130111D6C11FBB1.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.5130128F12F5D212.title": "1 × Range Addon Tier 5 — без вилучення",
  "quest.513011A514A41277.title": "Range Addon Tier 8",
  "quest.513011A514A41277.quest_subtitle": "Ether Gas та масштабування",
  "quest.513011A514A41277.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.51301204F98CB9F1.title": "1 × Range Addon Tier 8 — без вилучення",
  "quest.513011B20346E7E1.title": "Range Addon Tier 11",
  "quest.513011B20346E7E1.quest_subtitle": "Ether Gas та масштабування",
  "quest.513011B20346E7E1.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.513012A9B7E94207.title": "1 × Range Addon Tier 11 — без вилучення",
  "quest.513011162F45B0CF.title": "Infinity Drill після Supreme Frame",
  "quest.513011162F45B0CF.quest_subtitle": "Ether Gas та масштабування",
  "quest.513011162F45B0CF.quest_desc": [
    "Infinity Drill використовує фінальну рамку цієї гілки. Перевір рецепт, накопичення заряду та режими самого інструмента. Його виготовлення є окремим кінцевим застосуванням промислової лінії, а не умовою роботи попередніх машин."
  ],
  "task.5130127A21909AC5.title": "1 × Infinity Drill — без вилучення",
  "chapter.513010224298B082.title": "11 · Склади, логістика й корисні пристрої",
  "chapter.513010224298B082.chapter_subtitle": [
    "Скрині Sophisticated Storage мають одну послідовну лінію: залізо → золото → діамант → незерит. Мідь і Stack Upgrade — додаткові ранні можливості; функціональні модулі та Controller продовжуються у главі 37.",
    "45 квестів · 7 тематичних секцій.",
    "Короткі лінії: послідовність · наведи на квест: інші передумови",
    "Відкрий квест, щоб перевірити всі передумови. Роль на карті не змінює його умови."
  ],
  "quest.5130115C2448F78F.title": "Мідна скриня Sophisticated Storage",
  "quest.5130115C2448F78F.quest_subtitle": "Скрині Sophisticated Storage",
  "quest.5130115C2448F78F.quest_desc": [
    "Почни з дерев’яної скрині Sophisticated Storage у главі 37. Мідний варіант — доступне раннє розширення; це додаткова гілка, бо залізну скриню можна зробити відразу з дерев’яної.",
    "Звір рецепт Copper Chest або відповідного Tier Upgrade у JEI. Для встановленої скрині застосуй комплект покращення правою кнопкою; кількість комплектів для подвійної скрині перевір у підказці мода.",
    "Завдання перевіряє одну мідну скриню в інвентарі без вилучення, незалежно від деревини чи кольору. Зарахуй її перед установленням. Функціональні модулі та Controller продовжуються у главі 37."
  ],
  "task.513012FE3E185048.title": "Отримай 1 × Мідна скриня Sophisticated Storage",
  "quest.5130111C4CD728C6.title": "Залізна скриня: основа складу",
  "quest.5130111C4CD728C6.quest_subtitle": "Скрині Sophisticated Storage",
  "quest.5130111C4CD728C6.quest_desc": [
    "Це Iron Chest саме з Sophisticated Storage. Виготов її з дерев’яної скрині або покращ мідну: обидва варіанти показані у JEI, проходити мідну гілку не обов’язково.",
    "Звичайна скриня збільшує кількість комірок, а функціональні модулі додають окремі можливості. Візьми одну скриню до інвентарю перед установленням; завдання її не забирає й не вимагає конкретної деревини.",
    "Наступне дороге розширення — Gold Chest після точного механізму. Комплекти Tier Upgrade і мережа Controller описані в главі 37; не плутай покращення рівня скрині зі Stack Upgrade для місткості комірки."
  ],
  "task.513012886D0DAE09.title": "Отримай 1 × Залізна скриня",
  "quest.513011C482A87300.title": "Золота скриня: перший великий склад",
  "quest.513011C482A87300.quest_subtitle": "Скрині Sophisticated Storage",
  "quest.513011C482A87300.quest_desc": [
    "Покращ залізну скриню Sophisticated Storage до золотої. Рецепт збірки потребує точного механізму та керувального вузла, тому спочатку заверши ці матеріальні цілі.",
    "У JEI порівняй рецепт скрині й Iron to Gold Tier Upgrade. Рідні рецепти покращення зберігають властивості контейнера; для вже встановленої скрині використовуй відповідний комплект.",
    "Зарахуй золоту скриню в інвентарі без вилучення. ME Drive використовує окремий порожній комплект Iron to Gold Tier Upgrade, а не твою заповнену скриню: склад не потрібно витрачати на ME-мережу."
  ],
  "task.5130128B3B305624.title": "Отримай 1 × Золота скриня",
  "quest.5130113706F7FC90.title": "Діамантова скриня: більше комірок",
  "quest.5130113706F7FC90.quest_subtitle": "Скрині Sophisticated Storage",
  "quest.5130113706F7FC90.quest_desc": [
    "Наступний рівень Sophisticated Storage починається із золотої скрині. Квантовий процесор у рецепті потребує вимірної матриці; ранній склад не повинен блокуватися цим пізнім покращенням.",
    "Виготов Diamond Chest або застосуй Gold to Diamond Tier Upgrade до готового контейнера. Перевір саме рецепт для одинарної чи подвійної скрині; варіанти мають різну вартість.",
    "Предметна умова зараховує одну діамантову скриню без вилучення. Для Matter Condenser потрібен окремий Gold to Diamond Tier Upgrade. Далі можна збільшувати місткість комірок Stack Upgrade або перейти до незериту після експедиції на Місяць."
  ],
  "task.513012DB2041EE06.title": "Отримай 1 × Діамантова скриня",
  "quest.5130113B8DF6EC22.title": "Stack Upgrade: місткість однієї комірки",
  "quest.5130113B8DF6EC22.quest_subtitle": "Скрині Sophisticated Storage",
  "quest.5130113B8DF6EC22.quest_desc": [
    "Для великої кількості одного ресурсу спробуй Stack Upgrade Tier 1 саме з Sophisticated Storage. Цей модуль збільшує місткість комірок; це окреме раннє покращення, а не наступний рівень після діамантової скрині.",
    "Виготов модуль за JEI, потримай його в інвентарі для завдання й постав у слот покращень контейнера. Звір доступну місткість і допустимі поєднання модулів у підказці поточної збірки.",
    "Перед зняттям модуля розвантаж контейнер до його звичайної місткості. За вищими рівнями, сортуванням і Controller переходь до глави 37. Модулі Sophisticated Backpacks мають власні рецепти й не є автоматично взаємозамінними."
  ],
  "task.51301243DF5E5914.title": "Отримай 1 × Stack Upgrade",
  "quest.51301185B7779201.title": "Незеритова скриня: завершення лінії",
  "quest.51301185B7779201.quest_subtitle": "Скрині Sophisticated Storage",
  "quest.51301185B7779201.quest_desc": [
    "Покращ діамантову скриню Sophisticated Storage до незеритової. У рецепті збірки є радіаційний щит і керувальний вузол; щит потребує Desh із місячної експедиції.",
    "Перевір у JEI одинарний або подвійний рецепт і підготуй усі матеріали. Рідний рецепт покращення зберігає контейнерні дані; не замінюй його звичайним рецептом, який просто споживає скриню.",
    "Потримай одну незеритову скриню в інвентарі для умови без вилучення. Подальша місткість і автоматизація залежать від модулів та Controller у главі 37, а не від іншого паралельного мода скринь."
  ],
  "task.513012D7B664FC94.title": "Отримай 1 × Незеритова скриня",
  "quest.5130115694DC485A.title": "Oak Full Drawers 1",
  "quest.5130115694DC485A.quest_subtitle": "Шухляди та контролер",
  "quest.5130115694DC485A.quest_desc": [
    "Односекційна шухляда зберігає великий запас одного типу предмета. Вибери масовий ресурс, поклади зразок і надалі подавай сюди саме його; для різноманітних інструментів зручніша звичайна скриня.",
    "Коли призначення визначене, зафіксуй шухляду Drawer Key. Так після спорожнення вона збереже свій тип і не прийме випадковий інший ресурс із загального потоку."
  ],
  "task.513012A970E866AD.title": "1 × Oak Full Drawers 1 — без вилучення",
  "quest.5130119D041C553B.title": "Oak Full Drawers 2",
  "quest.5130119D041C553B.quest_subtitle": "Шухляди та контролер",
  "quest.5130119D041C553B.quest_desc": [
    "Відведи місце під масовий ресурс. Зафіксована шухляда зберігає тип предмета, а контролер об’єднує доступ; void-поведінку використовуй лише для ресурсу, який готовий втратити."
  ],
  "task.513012ADD735BC1B.title": "1 × Oak Full Drawers 2 — без вилучення",
  "quest.5130117C2D5AA079.title": "Oak Full Drawers 4",
  "quest.5130117C2D5AA079.quest_subtitle": "Шухляди та контролер",
  "quest.5130117C2D5AA079.quest_desc": [
    "Відведи місце під масовий ресурс. Зафіксована шухляда зберігає тип предмета, а контролер об’єднує доступ; void-поведінку використовуй лише для ресурсу, який готовий втратити."
  ],
  "task.51301206D1C2BD45.title": "1 × Oak Full Drawers 4 — без вилучення",
  "quest.513011DE65E3F4EE.title": "Compacting Drawers (3-Tier)",
  "quest.513011DE65E3F4EE.quest_subtitle": "Шухляди та контролер",
  "quest.513011DE65E3F4EE.quest_desc": [
    "Compacting Drawer зберігає сумісні форми одного ресурсу як спільний запас, наприклад самородки, злитки та блоки. Встав відповідний матеріал і перевір, які форми розпізнала шухляда.",
    "Перед автоматизацією поклади невелику партію й спробуй забрати її в іншій підтримуваній формі. Це не універсальний автокрафтер: довільний рецепт машини або багатокомпонентний виріб не стає доступним лише через наявність шухляди."
  ],
  "task.513012F4D68FB647.title": "1 × Compacting Drawers (3-Tier) — без вилучення",
  "quest.513011E12927F035.title": "Drawer Controller",
  "quest.513011E12927F035.quest_subtitle": "Шухляди та контролер",
  "quest.513011E12927F035.quest_desc": [
    "Drawer Controller дає спільну точку доступу до пов’язаної групи шухляд. Спочатку розстав шухляди для потрібних ресурсів і перевір їхнє з’єднання з контролером, потім підключай загальну подачу.",
    "Закріплені зразки в шухлядах допомагають спрямовувати масові предмети у правильні місця. Контролер не додає власний безмежний склад: коли відповідні шухляди заповнені, для зайвого потоку потрібне окреме рішення."
  ],
  "task.513012B3F340C086.title": "1 × Drawer Controller — без вилучення",
  "quest.51301141ECBD49DF.title": "Drawer Controller IO",
  "quest.51301141ECBD49DF.quest_subtitle": "Шухляди та контролер",
  "quest.51301141ECBD49DF.quest_desc": [
    "Відведи місце під масовий ресурс. Зафіксована шухляда зберігає тип предмета, а контролер об’єднує доступ; void-поведінку використовуй лише для ресурсу, який готовий втратити."
  ],
  "task.513012A5D6699222.title": "1 × Drawer Controller IO — без вилучення",
  "quest.513011C12859CEF4.title": "Upgrade Template",
  "quest.513011C12859CEF4.quest_subtitle": "Ключі й покращення шухляд",
  "quest.513011C12859CEF4.quest_desc": [
    "Відведи місце під масовий ресурс. Зафіксована шухляда зберігає тип предмета, а контролер об’єднує доступ; void-поведінку використовуй лише для ресурсу, який готовий втратити."
  ],
  "task.5130124F67744B99.title": "1 × Upgrade Template — без вилучення",
  "quest.51301103E224F47D.title": "Майстерня: Drawer Key",
  "quest.51301103E224F47D.quest_subtitle": "Ключі й покращення шухляд",
  "quest.51301103E224F47D.quest_desc": [
    "Drawer Key фіксує призначення шухляди. Спершу поклади потрібний предмет, потім застосуй ключ: навіть порожня зафіксована шухляда пам’ятатиме свій тип.",
    "Це зручно перед автоматичною подачею змішаних ресурсів. Ключ керує типом вмісту, а не дозволами інших гравців: зафіксована шухляда не стає приватним сейфом."
  ],
  "task.51301234B3490947.title": "1 × Drawer Key — без вилучення",
  "quest.5130110342A53FEB.title": "Майстерня: Quantify Key",
  "quest.5130110342A53FEB.quest_subtitle": "Ключі й покращення шухляд",
  "quest.5130110342A53FEB.quest_desc": [
    "Відведи місце під масовий ресурс. Зафіксована шухляда зберігає тип предмета, а контролер об’єднує доступ; void-поведінку використовуй лише для ресурсу, який готовий втратити."
  ],
  "task.513012FBE48C631A.title": "1 × Quantify Key — без вилучення",
  "quest.51301119B9DEEAF8.title": "Concealment Key",
  "quest.51301119B9DEEAF8.quest_subtitle": "Ключі й покращення шухляд",
  "quest.51301119B9DEEAF8.quest_desc": [
    "Відведи місце під масовий ресурс. Зафіксована шухляда зберігає тип предмета, а контролер об’єднує доступ; void-поведінку використовуй лише для ресурсу, який готовий втратити."
  ],
  "task.513012BFB064C455.title": "1 × Concealment Key — без вилучення",
  "quest.5130117CBCB942CE.title": "Storage Downgrade",
  "quest.5130117CBCB942CE.quest_subtitle": "Ключі й покращення шухляд",
  "quest.5130117CBCB942CE.quest_desc": [
    "Storage Downgrade зменшує базову місткість шухляди до одного стека. Це навмисне обмеження для невеликого буфера чи запасу з чіткою верхньою межею.",
    "Не встановлюй його як чергове поліпшення великого складу. Спочатку звільни зайвий вміст і перевір місткість після зміни; назва upgrade-слота не означає, що кожний предмет у ньому збільшує сховище."
  ],
  "task.5130121BDD7CC88A.title": "1 × Storage Downgrade — без вилучення",
  "quest.513011D24B556B5D.title": "Oak Wooden Pipe",
  "quest.513011D24B556B5D.quest_subtitle": "Класичні труби",
  "quest.513011D24B556B5D.quest_desc": [
    "Збери канал класичної логістики. Перевір тип ресурсу та налаштуй витягування на джерелі; форма труби не замінює правильний фільтр."
  ],
  "task.51301219C76D6984.title": "4 × Oak Wooden Pipe — без вилучення",
  "quest.5130119EFAA043E3.title": "Copper Pipe",
  "quest.5130119EFAA043E3.quest_subtitle": "Класичні труби",
