  ],
  "task.513012FE10C79112.title": "1 × Мека-костюм черевики — без вилучення",
  "quest.5130112F15810A47.title": "Meka-інструмент",
  "quest.5130112F15810A47.quest_subtitle": "Meka-комплект і модулі",
  "quest.5130112F15810A47.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.513012D0ADAF8A31.title": "1 × Meka-інструмент — без вилучення",
  "quest.51301138646C9874.title": "Станція модифікації",
  "quest.51301138646C9874.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301138646C9874.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма.",
    "Модулі: установлений Modification Station відкривається ПКМ без присідання. Налаштування спорядженого костюма — типово клавіша \\; у Керуванні це Mekanism → Module Tweaker."
  ],
  "task.51301240D3158D72.title": "1 × Станція модифікації — без вилучення",
  "quest.513011C521E5B4DD.title": "Основа модуля",
  "quest.513011C521E5B4DD.quest_subtitle": "Meka-комплект і модулі",
  "quest.513011C521E5B4DD.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.5130124F8610318F.title": "1 × Основа модуля — без вилучення",
  "quest.51301132F9C95555.title": "Module Energy Unit",
  "quest.51301132F9C95555.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301132F9C95555.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.51301273FCC1DC96.title": "1 × Module Energy Unit — без вилучення",
  "quest.5130113FB494C115.title": "Колекція: Module Radiation Shielding Unit",
  "quest.5130113FB494C115.quest_subtitle": "Meka-комплект і модулі",
  "quest.5130113FB494C115.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.513012DCB2E562D8.title": "1 × Module Radiation Shielding Unit — без вилучення",
  "quest.513011ED1A3D11E0.title": "Module Jetpack Unit",
  "quest.513011ED1A3D11E0.quest_subtitle": "Meka-комплект і модулі",
  "quest.513011ED1A3D11E0.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.5130129DDC8C1D99.title": "1 × Module Jetpack Unit — без вилучення",
  "quest.51301144D5FB95D4.title": "Module Electrolytic Breathing Unit",
  "quest.51301144D5FB95D4.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301144D5FB95D4.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.51301210ABFC9F3E.title": "1 × Module Electrolytic Breathing Unit — без вилучення",
  "quest.51301155BDC855A3.title": "Module Vision Enhancement Unit",
  "quest.51301155BDC855A3.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301155BDC855A3.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.513012BB9CD609C1.title": "1 × Module Vision Enhancement Unit — без вилучення",
  "quest.513011F1FC51AAE1.title": "Module Magnetic Attraction Unit",
  "quest.513011F1FC51AAE1.quest_subtitle": "Meka-комплект і модулі",
  "quest.513011F1FC51AAE1.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.513012B19C70BA6A.title": "1 × Module Magnetic Attraction Unit — без вилучення",
  "quest.51301125CDBD7A23.title": "Module Silk Touch Unit",
  "quest.51301125CDBD7A23.quest_subtitle": "Meka-комплект і модулі",
  "quest.51301125CDBD7A23.quest_desc": [
    "Модульна система фінального спорядження. Після виготовлення встанови сумісний модуль через Modification Station; квест виявляє предмет, а фактичні налаштування перевіряй у меню костюма."
  ],
  "task.5130123AEB546622.title": "1 × Module Silk Touch Unit — без вилучення",
  "quest.514D11E562C03F82.title": "Перший результат SPS",
  "quest.514D11E562C03F82.quest_subtitle": "SPS та антиматерія",
  "quest.514D11E562C03F82.quest_desc": [
    "Перетвори результат SPS на Antimatter Pellet за його рецептом. Тепер ланцюг має вимірюваний предметний вихід, який потрібен кінцевим компонентам; нарощуй виробництво лише після стабільної подачі полонію та енергії."
  ],
  "task.514D12153F794A37.title": "1 × Частка антиматерії — без вилучення",
  "quest.514D1149705848EC.title": "Антиматерія для ядра EMC",
  "quest.514D1149705848EC.quest_subtitle": "SPS та антиматерія",
  "quest.514D1149705848EC.quest_desc": [
    "EMC Core замикає цей маршрут на кінцевому компоненті кампанії. Звір рецепт із JEI та збережи запаси потрібних матеріалів: завершення предметного завдання не замінює сам крафт і не видає виробничі розблокування за просте отримання речі."
  ],
  "task.514D127093296FE4.title": "1 × Emc Core — без вилучення",
  "quest.5130114BCD92C503.title": "SPS як експериментальний пристрій",
  "quest.5130114BCD92C503.quest_subtitle": "SPS та антиматерія",
  "quest.5130114BCD92C503.quest_desc": [
    "Виконай рідний експеримент SPS зі свинею. Це добровільне пізнє завдання з власним тригером Mekanism."
  ],
  "task.513012FA302EAF5E.title": "Нативна перевірка: SPS як експериментальний пристрій",
  "chapter.513010FE75551C5A.title": "09 · Ender IO: сплави, душі, канали",
  "chapter.513010FE75551C5A.chapter_subtitle": [
    "Крихти й корпус відкривають плавильню; сплави живлять канали, машини та схеми. Автокрафт доступний на рубежі Точного механізму, а лінія душ має власні передумови.",
    "56 квестів · 8 послідовних виробничих секцій.",
    "Читай зверху вниз · наведи на квест, щоб побачити всі зв’язки",
    "Відкрий квест, щоб перевірити всі передумови, зокрема переходи до інших глав. Предметна задача перевіряє речі в інвентарі; опис пояснює складання й пробний запуск."
  ],
  "quest.51301183B8CF29F5.title": "Energetic Alloy → Vibrant Alloy",
  "quest.51301183B8CF29F5.quest_subtitle": "Сплави та кристали",
  "quest.51301183B8CF29F5.quest_desc": [
    "Перероби Energetic Alloy з перлиною Енду та світлокаменем. Vibrant Alloy потрібен старшим кондуїтам, кристалам і пізньому енергетичному буферу; це продовження вже працюючої плавильної лінії."
  ],
  "task.51301299E71F676C.title": "1 × Злиток вібрівного сплаву — без вилучення",
  "quest.513011B5F4763E7A.title": "Крихти для першого шасі",
  "quest.513011B5F4763E7A.quest_subtitle": "Компоненти та перша плавильня",
  "quest.513011B5F4763E7A.quest_desc": [
    "Grains of Infinity потрібні для ранніх компонентів Ender IO. Почни з доступного способу їх отримання за JEI; SAG Mill може давати їх із Cobbled Deepslate пізніше, але він сам потребує компонентів цього старту й не є початковою вимогою."
  ],
  "task.51301236CF32BA87.title": "1 × Крихти нескінченності — без вилучення",
  "quest.513011AC2178359B.title": "Провідний сплав → Energetic Alloy",
  "quest.513011AC2178359B.quest_subtitle": "Сплави та кристали",
  "quest.513011AC2178359B.quest_desc": [
    "Додай до Conductive Alloy золото й редстоун в Alloy Smelter. Energetic Alloy відкриває Double-Layer Capacitor та проміжні кондуїти, а частина запасу йде на Vibrant Alloy."
  ],
  "task.513012EDCD7BF304.title": "1 × Енергійний сплав — без вилучення",
  "quest.513011C98821DCE8.title": "Редстоуновий сплав для сигналів",
  "quest.513011C98821DCE8.quest_subtitle": "Сплави та кристали",
  "quest.513011C98821DCE8.quest_desc": [
    "Мідь і редстоун в Alloy Smelter дають Redstone Alloy. Відкладай його для сигнальних кондуїтів окремо від сплавів енергетичної лінії."
  ],
  "task.5130125004C136D9.title": "1 × Злиток редстоунового сплаву — без вилучення",
  "quest.513011725F799C0A.title": "Залізо + мідь → провідний сплав",
  "quest.513011725F799C0A.quest_subtitle": "Сплави та кристали",
  "quest.513011725F799C0A.quest_desc": [
    "Alloy Smelter поєднує залізо з міддю в Conductive Alloy. Він потрібен базовим кондуїтам і стає входом наступного Energetic Alloy, тому зроби для нього окремий запас."
  ],
  "task.51301233A0BD0F53.title": "1 × Злиток провідного сплаву — без вилучення",
  "quest.51301102C5F5EF51.title": "Пульсівний сплав для предметів",
  "quest.51301102C5F5EF51.quest_subtitle": "Сплави та кристали",
  "quest.51301102C5F5EF51.quest_desc": [
    "Залізо з перлиною Енду утворює Pulsating Alloy. Разом із Conductive Alloy він входить у базовий предметний кондуїт; інша частина запасу йде на Pulsating Crystal."
  ],
  "task.5130120E4BF4EEB6.title": "1 × Злиток пульсівного сплаву — без вилучення",
  "quest.5130111DBA46A20B.title": "Темна сталь і спеціальні машини",
  "quest.5130111DBA46A20B.quest_subtitle": "Сплави та кристали",
  "quest.5130111DBA46A20B.quest_desc": [
    "Dark Steel виплавляється із заліза, обсидіану та вуглецевої сировини за одним із доступних рецептів. Вона потрібна Enchanter і є попередником End Steel; ці напрями можна вести окремо від кондуїтів."
  ],
  "task.51301250DFCF497B.title": "1 × Злиток темної сталі — без вилучення",
  "quest.513011BBFAA4813B.title": "Темна сталь → сталь Енду",
  "quest.513011BBFAA4813B.quest_subtitle": "Сплави та кристали",
  "quest.513011BBFAA4813B.quest_desc": [
    "Додай до Dark Steel камінь Енду й обсидіан у плавильній лінії. End Steel є наступним матеріалом цієї гілки; конкретні споживачі показані в JEI."
  ],
  "task.513012EFFCD5589B.title": "1 × Злиток сталі Енду — без вилучення",
  "quest.513011D9AD5BA43B.title": "Кремній",
  "quest.513011D9AD5BA43B.quest_subtitle": "Компоненти та перша плавильня",
  "quest.513011D9AD5BA43B.quest_desc": [
    "Зроби матеріал або машину Ender IO. Для сплавів використовуй відповідний режим плавильні; накопичені базові компоненти знадобляться і в міжмодових рецептах."
  ],
  "task.513012ABA8596764.title": "1 × Кремній — без вилучення",
  "quest.513011E8D057E271.title": "Конденсатор для роботи машин",
  "quest.513011E8D057E271.quest_subtitle": "Компоненти та перша плавильня",
  "quest.513011E8D057E271.quest_desc": [
    "Basic Capacitor збирається з Grains of Infinity, міді та золотих самородків. Підготуй конденсатори для машин, яким вони потрібні, і перевір відповідний слот у їхньому інтерфейсі. Пізніші конденсатори розвивають цю ж гілку."
  ],
  "task.5130120E7CF8F086.title": "1 × Базовий конденсатор — без вилучення",
  "quest.513011841D3B76CA.title": "Double-Layer: конденсатор наступного рівня",
  "quest.513011841D3B76CA.quest_subtitle": "Машини, буфери й автокрафт",
  "quest.513011841D3B76CA.quest_desc": [
    "Рецепт збірки поєднує Basic Capacitor, Energetic Alloy та компоненти етапу Precision Mechanism. Цей конденсатор доступний до Dimensional Matrix; пізніший Advanced Capacitor Bank окремо потребує Matrix."
  ],
  "task.5130120DA8BECB26.title": "1 × Двошаровий конденсатор — без вилучення",
  "quest.5130118049B3B5BA.title": "Void Chassis для першої машини",
  "quest.5130118049B3B5BA.quest_subtitle": "Компоненти та перша плавильня",
  "quest.5130118049B3B5BA.quest_desc": [
    "У збірці Void Chassis поєднує Grains of Infinity, залізо й Industrial Chassis. З нього починаються Alloy Smelter, SAG Mill та частина автоматизації; залиш запас шасі для окремих робочих вузлів."
  ],
  "task.513012350EF85752.title": "1 × Порожній корпус — без вилучення",
  "quest.5130116AAAF4B959.title": "Кондуїт FE: генератор → споживач",
  "quest.5130116AAAF4B959.quest_subtitle": "Основа каналів і фільтрація",
  "quest.5130116AAAF4B959.quest_desc": [
    "Базовий енергетичний кондуїт використовує Conductive Alloy та Binder. З'єднай джерело, буфер і машину, а потім перевір режими з'єднань. Збережене завдання розпізнає потрібний тип кондуїта, а не довільний предмет із тією самою базовою назвою."
  ],
  "task.51301254BDC11A17.title": "Нативна перевірка: Канал для енергії",
  "quest.5130114AE9005E27.title": "Енергетичний кондуїт: Energetic",
  "quest.5130114AE9005E27.quest_subtitle": "Канали більшої пропускності",
  "quest.5130114AE9005E27.quest_desc": [
    "Це розвиток відповідного базового кондуїта. У JEI доступні прямі рецепти та рецепти оновлення; попередній вузол показує робочу лінію, яку ти розширюєш. Після заміни перевір з'єднання, режими та реальну пропускну здатність."
  ],
  "task.513012E734260CFD.title": "Нативна перевірка: Канал для посиленої енергії",
  "quest.5130119426F8E5C3.title": "Предмети між плавильнею й складом",
  "quest.5130119426F8E5C3.quest_subtitle": "Основа каналів і фільтрація",
  "quest.5130119426F8E5C3.quest_desc": [
    "Базовий предметний кондуїт потребує Conductive та Pulsating Alloys. Налаштуй витягування на джерелі й приймання на призначенні; спочатку перевір один рецепт, потім додай фільтри. Це транспорт для локального Crafter у наступній секції."
  ],
  "task.51301262BC20AF57.title": "Нативна перевірка: Канал для предметів",
  "quest.513011B05E2E9113.title": "Предметний кондуїт: Energetic",
  "quest.513011B05E2E9113.quest_subtitle": "Канали більшої пропускності",
  "quest.513011B05E2E9113.quest_desc": [
    "Це розвиток відповідного базового кондуїта. У JEI доступні прямі рецепти та рецепти оновлення; попередній вузол показує робочу лінію, яку ти розширюєш. Після заміни перевір з'єднання, режими та реальну пропускну здатність."
  ],
  "task.5130127AF40A2854.title": "Нативна перевірка: Канал для швидких предметів",
  "quest.513011E370A685E5.title": "Рідини: окремий канал і фільтр",
  "quest.513011E370A685E5.quest_subtitle": "Основа каналів і фільтрація",
  "quest.513011E370A685E5.quest_desc": [
    "Базовий Fluid Conduit використовує Conductive Alloy, Binder та Clear Glass. Перевір режими з'єднань між резервуаром і споживачем; фільтр збоку допомагає відсікти небажану рідину."
  ],
  "task.5130125FFF5152C3.title": "Нативна перевірка: Канал для рідини",
  "quest.5130110FC0DFEDC3.title": "Рідинний кондуїт під тиском",
  "quest.5130110FC0DFEDC3.quest_subtitle": "Канали більшої пропускності",
  "quest.5130110FC0DFEDC3.quest_desc": [
    "Це розвиток відповідного базового кондуїта. У JEI доступні прямі рецепти та рецепти оновлення; попередній вузол показує робочу лінію, яку ти розширюєш. Після заміни перевір з'єднання, режими та реальну пропускну здатність."
  ],
  "task.513012B721DF45DF.title": "Нативна перевірка: Канал для рідини під тиском",
  "quest.5130115B49AE7E7C.title": "Сигнал керує робочою лінією",
  "quest.5130115B49AE7E7C.quest_subtitle": "Основа каналів і фільтрація",
  "quest.5130115B49AE7E7C.quest_desc": [
    "Redstone Conduit переносить керувальні сигнали через кондуїтну мережу. Налаштуй канал і точки входу та виходу, щоб окремо запускати потрібні вузли, не змінюючи предметні фільтри."
  ],
  "task.513012223212E124.title": "Нативна перевірка: Канал для redstone-сигналів",
  "quest.51301189AE52B1F5.title": "SAG Mill: подрібнення та побічні виходи",
  "quest.51301189AE52B1F5.quest_subtitle": "Машини, буфери й автокрафт",
  "quest.51301189AE52B1F5.quest_desc": [
    "Підведи FE й налаштуй SAG Mill для вибраної сировини. Передбач виведення всіх результатів, включно з побічними; серед доступних рецептів є Cobbled Deepslate з шансом отримати Grains of Infinity. Ця машина розширює вже зібрану компонентну лінію.",
    "Гарантоване повернення витрачених компонентів: 1 × Електромеханічний привід.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Млин SAG» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.51301253901CEB47.title": "1 × Млин НСП — без вилучення",
  "quest.5130111869DF4496.title": "Суміш для оболонки кондуїтів",
  "quest.5130111869DF4496.quest_subtitle": "Основа каналів і фільтрація",
  "quest.5130111869DF4496.quest_desc": [
    "Підготуй Conduit Binder Composite за рецептом і передай його на випал. Металевий сплав визначає можливості кондуїта, а Binder формує його загальну оболонку."
  ],
  "task.513012AD05666AC6.title": "1 × Зв'язувальний композит — без вилучення",
  "quest.513011FD63F841AE.title": "Випалена основа мережі",
  "quest.513011FD63F841AE.quest_subtitle": "Основа каналів і фільтрація",
  "quest.513011FD63F841AE.quest_desc": [
    "Переплав Composite у Conduit Binder й тримай запас біля крафту кондуїтів. Далі гілка розділяється на FE, предмети, рідини та редстоун; кожна має власний склад сплавів."
  ],
  "task.513012F112D11CE0.title": "1 × Зв'язувальний елемент провідників — без вилучення",
  "quest.5130118E25820DD5.title": "Пульсівний кристал",
  "quest.5130118E25820DD5.quest_subtitle": "Сплави та кристали",
  "quest.5130118E25820DD5.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.51301209D9FCED57.title": "1 × Пульсівний кристал — без вилучення",
  "quest.513011FF94962AA3.title": "Вібрівний кристал",
  "quest.513011FF94962AA3.quest_subtitle": "Сплави та кристали",
  "quest.513011FF94962AA3.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.5130123DBBDC43D0.title": "1 × Вібрівний кристал — без вилучення",
  "quest.51301138C137BDAD.title": "Vibrant Crystal + душа Ендермена",
  "quest.51301138C137BDAD.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.51301138C137BDAD.quest_desc": [
    "Soul Binder перетворює Vibrant Crystal на Ender Crystal зі зразком душі Ендермена, досвідом та FE. Цей матеріал відкриває спеціальні обеліски; просте отримання порожньої Soul Vial не завершує рецепт."
  ],
  "task.5130128BC3A5C4DD.title": "1 × Кристал Енду — без вилучення",
  "quest.513011C540A7B224.title": "Базовий фільтр предметів",
  "quest.513011C540A7B224.quest_subtitle": "Основа каналів і фільтрація",
  "quest.513011C540A7B224.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.51301206D5A9F5D4.title": "1 × Базовий фільтр предметів — без вилучення",
  "quest.513011FDA169E434.title": "Розумніший фільтр після Z-Logic",
  "quest.513011FDA169E434.quest_subtitle": "Спеціалізовані вузли",
  "quest.513011FDA169E434.quest_desc": [
    "Advanced Item Filter використовує Z-Logic Controller зі Slice'n'Splice. Тому він стоїть у гілці спеціальних компонентів; базовий фільтр залишається достатнім для першої предметної лінії."
  ],
  "task.51301279A17DCAE3.title": "1 × Вдосконалений фільтр предметів — без вилучення",
  "quest.5130112CBAC535EA.title": "Обмежувальний предметний фільтр",
  "quest.5130112CBAC535EA.quest_subtitle": "Спеціалізовані вузли",
  "quest.5130112CBAC535EA.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.513012A1EF1F3FB7.title": "1 × Обмежувальний предметний фільтр — без вилучення",
  "quest.513011F31A34A8F8.title": "Зонд для провідників",
  "quest.513011F31A34A8F8.quest_subtitle": "Основа каналів і фільтрація",
  "quest.513011F31A34A8F8.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.51301235C4C13133.title": "1 × Зонд для провідників — без вилучення",
  "quest.513011734EE3175F.title": "Базовий фільтр рідини",
  "quest.513011734EE3175F.quest_subtitle": "Основа каналів і фільтрація",
  "quest.513011734EE3175F.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.5130126B603A84FB.title": "1 × Базовий фільтр рідини — без вилучення",
  "quest.5130118E40386623.title": "Basic Chemical Filter",
  "quest.5130118E40386623.quest_subtitle": "Основа каналів і фільтрація",
  "quest.5130118E40386623.quest_desc": [
    "Канал призначений для конкретного ресурсу. Налаштуй вхід, вихід, фільтр і redstone-умову; спочатку перевір одну передачу, перш ніж об’єднувати кілька ліній."
  ],
  "task.5130128F5C1FD6A4.title": "1 × Basic Chemical Filter — без вилучення",
  "quest.51301146B3D81FD6.title": "Енергетичний кондуїт: Vibrant",
  "quest.51301146B3D81FD6.quest_subtitle": "Канали більшої пропускності",
  "quest.51301146B3D81FD6.quest_desc": [
    "Це розвиток відповідного базового кондуїта. У JEI доступні прямі рецепти та рецепти оновлення; попередній вузол показує робочу лінію, яку ти розширюєш. Після заміни перевір з'єднання, режими та реальну пропускну здатність."
  ],
  "task.51301224B2E3A3B2.title": "Нативна перевірка: Канал для енергії Ender",
  "quest.513011107F0255F3.title": "Предметний кондуїт: Vibrant",
  "quest.513011107F0255F3.quest_subtitle": "Канали більшої пропускності",
  "quest.513011107F0255F3.quest_desc": [
    "Це розвиток відповідного базового кондуїта. У JEI доступні прямі рецепти та рецепти оновлення; попередній вузол показує робочу лінію, яку ти розширюєш. Після заміни перевір з'єднання, режими та реальну пропускну здатність."
  ],
  "task.513012EE248E9E10.title": "Нативна перевірка: Канал для предметів Ender",
  "quest.5130111E28B22B76.title": "Ender Fluid Conduit",
  "quest.5130111E28B22B76.quest_subtitle": "Канали більшої пропускності",
  "quest.5130111E28B22B76.quest_desc": [
    "Це розвиток відповідного базового кондуїта. У JEI доступні прямі рецепти та рецепти оновлення; попередній вузол показує робочу лінію, яку ти розширюєш. Після заміни перевір з'єднання, режими та реальну пропускну здатність."
  ],
  "task.5130127DDDBE35C4.title": "Нативна перевірка: Канал для рідини Ender",
  "quest.5130114938E63897.title": "Soularium: початок гілки душ",
  "quest.5130114938E63897.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.5130114938E63897.quest_desc": [
    "Підготуй Soularium у плавильній лінії. Він потрібен Soul Vial, Ensouled Chassis та компонентам спеціальних машин; ця гілка відходить від Alloy Smelter після базової логістики."
  ],
  "task.513012DD1132FF0D.title": "1 × Злиток соуларію — без вилучення",
  "quest.51301110F3A4858C.title": "Soul Vial: інструмент зразка",
  "quest.51301110F3A4858C.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.51301110F3A4858C.quest_desc": [
    "Soul Vial потрібна для захоплення душі придатної істоти. Предметне завдання перевіряє саму порожню посудину; для конкретного рецепта Soul Binder окремо підготуй заповнений зразок потрібного виду."
  ],
  "task.5130124C77FD9A1C.title": "1 × Флакон душ — без вилучення",
  "quest.51301148615D2591.title": "Soul Binder: душа, досвід і FE",
  "quest.51301148615D2591.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.51301148615D2591.quest_desc": [
    "Рецепт Soul Binder тепер стоїть після Slice'n'Splice та Enchanter, які дають його реальні компоненти. Для роботи подавай потрібний Soul Vial, предметний вхід, досвід і енергію за рецептом. Зв'язування Ender Crystal — окрема наступна гілка.",
    "Гарантоване повернення витрачених компонентів: 1 × Блок солярію.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Зв’язувач душ» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012862146455C.title": "1 × Зв'язувач душ — без вилучення",
  "quest.51301167AE8889AA.title": "Powered Spawner: машина та зразок",
  "quest.51301167AE8889AA.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.51301167AE8889AA.quest_desc": [
    "Рецепт збірки споживає Soul Binder, Z-Logic Controller, Vibrant Crystal і Broken Spawner разом з іншими компонентами. Після крафту налаштуй підтримуваний тип спавнера, живлення та збирання результату. Нижче Industrial Foregoing використовує цю машину як компонент Mob Duplicator.",
    "Гарантоване повернення витрачених компонентів: 1 × Блок солярію.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Електричний спавнер» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.51301203F6483C33.title": "1 × Електризований породжувач — без вилучення",
  "quest.5130114A639B43DA.title": "Slice'n'Splice перед Soul Binder",
  "quest.5130114A639B43DA.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.5130114A639B43DA.quest_desc": [
    "Спершу збудуй Slice'n'Splice і виготов Z-Logic Controller з Soularium, голови зомбі, Silicon та редстоуну. Саме цей процесор потрібен рецептам Soul Binder і Powered Spawner, тому машина стоїть перед ними в маршруті."
  ],
  "task.513012E46973509A.title": "1 × Перекрійник — без вилучення",
  "quest.51301140FB4C14AE.title": "Vacuum Chest: збір до кондуїтів",
  "quest.51301140FB4C14AE.quest_subtitle": "Спеціалізовані вузли",
  "quest.51301140FB4C14AE.quest_desc": [
    "Vacuum Chest з'єднує локальне збирання предметів із транспортною мережею. Налаштуй зону роботи та виведення в склад; не залишай повну скриню єдиним виходом активної ферми."
  ],
  "task.51301250B5E2214D.title": "1 × Втягуюча скриня — без вилучення",
  "quest.513011AF7BCC8C7E.title": "Impulse Hopper для порційної подачі",
  "quest.513011AF7BCC8C7E.quest_subtitle": "Машини, буфери й автокрафт",
  "quest.513011AF7BCC8C7E.quest_desc": [
    "Impulse Hopper — окремий вузол керованої предметної подачі. Налаштуй потрібну порцію й поведінку сигналу під конкретну машину. Його предметне завдання доступне на етапі Precision і не замінює перевірку налаштувань у світі."
  ],
  "task.5130125FBEE3EC14.title": "1 × Імпульсна лійка — без вилучення",
  "quest.5130119DF4466A66.title": "Crafter: повторюваний крафт до Matrix",
  "quest.5130119DF4466A66.quest_subtitle": "Машини, буфери й автокрафт",
  "quest.5130119DF4466A66.quest_desc": [
    "Збери Crafter з Void Chassis, Silicon, BuildCraft Auto Workbench та компонентів Control Assembly і Precision Mechanism. Подай FE й інгредієнти, налаштуй рецепт та виведення результату через Item Conduits. Цей вузол також потрібен рецепту AE2 Crafting Unit; Dimensional Matrix для нього не потрібна."
  ],
  "task.5130121CEBF45EAA.title": "1 × Збирач — без вилучення",
  "quest.5130118BFEDE7D48.title": "Обеліск відрази",
  "quest.5130118BFEDE7D48.quest_subtitle": "Спеціалізовані вузли",
  "quest.5130118BFEDE7D48.quest_desc": [
    "Душі, сплави, енергія — список матеріалів такий, наче відділ закупівель перестав ставити зайві запитання.",
    "Побудуй спеціалізований вузол Ender IO. Для операцій із душами перевір допустиму істоту; міміки й захищені боси не повинні ставати фабрикою рідкісної здобичі."
  ],
  "task.5130120E988B21B8.title": "1 × Обеліск відрази — без вилучення",
  "quest.513011F0F034B9F6.title": "Обеліск пригнічення",
  "quest.513011F0F034B9F6.quest_subtitle": "Спеціалізовані вузли",
  "quest.513011F0F034B9F6.quest_desc": [
    "Побудуй спеціалізований вузол Ender IO. Для операцій із душами перевір допустиму істоту; міміки й захищені боси не повинні ставати фабрикою рідкісної здобичі."
  ],
  "task.513012E15BA285CB.title": "1 × Обеліск пригнічення — без вилучення",
  "quest.5130117801127762.title": "ЧАН",
  "quest.5130117801127762.quest_subtitle": "Спеціалізовані вузли",
  "quest.5130117801127762.quest_desc": [
    "Побудуй спеціалізований вузол Ender IO. Для операцій із душами перевір допустиму істоту; міміки й захищені боси не повинні ставати фабрикою рідкісної здобичі."
  ],
  "task.51301223114A3DB9.title": "1 × ЧАН — без вилучення",
  "quest.5130111D0F34D9B7.title": "Enchanter як виробничий компонент",
  "quest.5130111D0F34D9B7.quest_subtitle": "Соуларій, Z-Logic і душі",
  "quest.5130111D0F34D9B7.quest_desc": [
    "Збери Enchanter за рецептом збірки з Dark Steel та потрібних спеціальних компонентів. Окрім власних рецептів зачарування, він входить у крафт Soul Binder; підготуй окремий екземпляр, якщо хочеш залишити станцію на базі."
  ],
  "task.513012EC921A4507.title": "1 × Зачарувальник — без вилучення",
  "quest.513011AA9C81A28D.title": "Мандрівний якір",
  "quest.513011AA9C81A28D.quest_subtitle": "Сонце, батареї та переміщення",
  "quest.513011AA9C81A28D.quest_desc": [
    "Побудуй спеціалізований вузол Ender IO. Для операцій із душами перевір допустиму істоту; міміки й захищені боси не повинні ставати фабрикою рідкісної здобичі."
  ],
  "task.513012078E872C32.title": "1 × Мандрівний якір — без вилучення",
  "quest.5130113D7D320C50.title": "Посох мандрування",
  "quest.5130113D7D320C50.quest_subtitle": "Сонце, батареї та переміщення",
  "quest.5130113D7D320C50.quest_desc": [
    "Побудуй спеціалізований вузол Ender IO. Для операцій із душами перевір допустиму істоту; міміки й захищені боси не повинні ставати фабрикою рідкісної здобичі."
  ],
  "task.513012AEBD67AE09.title": "1 × Посох мандрування — без вилучення",
  "quest.5130111D94D99E2B.title": "Capacitor Bank: локальний запас FE",
  "quest.5130111D94D99E2B.quest_subtitle": "Машини, буфери й автокрафт",
  "quest.5130111D94D99E2B.quest_desc": [
    "Basic Capacitor Bank у збірці використовує Basic Capacitor та Mekanism Basic Energy Cube разом із компонентами точного механізму. Налаштуй його між генератором і Ender IO машинами; це етап Precision, а не вимога Matrix.",
    "Гарантоване повернення витрачених компонентів: 1 × Базовий конденсатор.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Базовий банк конденсаторів» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012C7C20FBC8B.title": "1 × Базова конденсаторна батарея — без вилучення",
  "quest.513011FDD244B182.title": "Більший запас тієї самої мережі",
  "quest.513011FDD244B182.quest_subtitle": "Машини, буфери й автокрафт",
  "quest.513011FDD244B182.quest_desc": [
    "Advanced Capacitor Bank продовжує базовий банк через Double-Layer Capacitor. Обидва рецепти збірки також споживають Quantum Processor та Dimensional Matrix, тому це наступний, третій етап накопичення енергії."
  ],
  "task.513012CA2994B6C3.title": "1 × Вдосконалена конденсаторна батарея — без вилучення",
  "quest.513011BF7BA29A4B.title": "Вібрівна конденсаторна батарея",
  "quest.513011BF7BA29A4B.quest_subtitle": "Сонце, батареї та переміщення",
  "quest.513011BF7BA29A4B.quest_desc": [
    "Підготуй покращення або корпус для наступного рівня. Перевір сумісність з інструментом у підказці та збережи потрібні компоненти для майбутніх машин."
  ],
  "task.5130128D3BA4831D.title": "1 × Вібрівна конденсаторна батарея — без вилучення",
  "quest.513011D09E534066.title": "Енергійний фотоелектричний модуль",
  "quest.513011D09E534066.quest_subtitle": "Сонце, батареї та переміщення",
  "quest.513011D09E534066.quest_desc": [
    "Підготуй покращення або корпус для наступного рівня. Перевір сумісність з інструментом у підказці та збережи потрібні компоненти для майбутніх машин."
  ],
  "task.513012B0304EB458.title": "1 × Енергійний фотоелектричний модуль — без вилучення",
  "quest.5130118ED672EF1E.title": "Пульсівний фотоелектричний модуль",
  "quest.5130118ED672EF1E.quest_subtitle": "Сонце, батареї та переміщення",
  "quest.5130118ED672EF1E.quest_desc": [
    "Підготуй покращення або корпус для наступного рівня. Перевір сумісність з інструментом у підказці та збережи потрібні компоненти для майбутніх машин."
  ],
  "task.5130122209233441.title": "1 × Пульсівний фотоелектричний модуль — без вилучення",
  "quest.513011D5BDA26046.title": "Вібрівний фотоелектричний модуль",
  "quest.513011D5BDA26046.quest_subtitle": "Сонце, батареї та переміщення",
  "quest.513011D5BDA26046.quest_desc": [
    "Підготуй покращення або корпус для наступного рівня. Перевір сумісність з інструментом у підказці та збережи потрібні компоненти для майбутніх машин."
  ],
  "task.513012648D32B0A1.title": "1 × Вібрівний фотоелектричний модуль — без вилучення",
  "quest.513011403518CC36.title": "Бездротовий зарядник",
  "quest.513011403518CC36.quest_subtitle": "Спеціалізовані вузли",
  "quest.513011403518CC36.quest_desc": [
    "Підготуй покращення або корпус для наступного рівня. Перевір сумісність з інструментом у підказці та збережи потрібні компоненти для майбутніх машин."
  ],
  "task.5130125F8520265D.title": "1 × Бездротовий зарядник — без вилучення",
  "chapter.5130108DC86DCC75.title": "10 · Industrial Foregoing без аграрного гринду",
  "chapter.5130108DC86DCC75.chapter_subtitle": [
    "Обери джерело пластику, запусти Dissolution і розділи фабрику на блоки, лазерний видобуток, переробку руди та мобів. Pink Slime й Ether Gas відкривають наступні рамки.",
    "40 квестів · 7 послідовних виробничих секцій.",
    "Читай зверху вниз · наведи на квест, щоб побачити всі зв’язки",
    "Відкрий квест, щоб перевірити всі передумови, зокрема переходи до інших глав. Предметна задача перевіряє речі в інвентарі; опис пояснює складання й пробний запуск."
  ],
  "quest.5130111BE9BBE0D5.title": "Pity Frame: старт кількох ліній",
  "quest.5130111BE9BBE0D5.quest_subtitle": "Латекс або HDPE → пластик",
  "quest.5130111BE9BBE0D5.quest_desc": [
    "Pity Machine Frame відкриває видобуток латексу та базові допоміжні машини. Центральний маршрут веде через пластик і Dissolution Chamber до складніших рамок; бічні вузли забезпечують рідини, блоки та побічні продукти."
  ],
  "task.513012A381ED847F.title": "1 × Pity Machine Frame — без вилучення",
  "quest.513011EEAB3DF77B.title": "Колода → латекс",
  "quest.513011EEAB3DF77B.quest_subtitle": "Латекс або HDPE → пластик",
  "quest.513011EEAB3DF77B.quest_desc": [
    "Постав Fluid Extractor біля придатної колоди й відведи латекс у резервуар або Latex Processing Unit. Передбач заміну використаної деревини; без матеріалу на робочій стороні вся гумова лінія зупиняється."
  ],
  "task.51301224BEF46905.title": "1 × Fluid Extractor — без вилучення",
  "quest.5130111B4AB75BE7.title": "Латекс + вода + FE",
  "quest.5130111B4AB75BE7.quest_subtitle": "Латекс або HDPE → пластик",
  "quest.5130111B4AB75BE7.quest_desc": [
    "Latex Processing Unit споживає латекс, воду та енергію й видає Tiny Dry Rubber. Підведи обидві рідини окремо та виводь твердий результат. Перевір у вікні машини, який саме вхід обмежує роботу."
  ],
  "task.513012514E9D5267.title": "1 × Latex Processing Unit — без вилучення",
  "quest.51301137DA4E3B80.title": "Крихти гуми → випал пластика",
  "quest.51301137DA4E3B80.quest_subtitle": "Латекс або HDPE → пластик",
  "quest.51301137DA4E3B80.quest_desc": [
    "Збери Tiny Dry Rubber у Dry Rubber та переплав її на Plastic. Це завершення латексної гілки. У збірці також є прямий рецепт пластику з Mekanism HDPE Sheet, тому цей гумовий вузол не блокує спільну пластикову лінію."
  ],
  "task.513012D2E39E2B18.title": "1 × Dry Rubber — без вилучення",
  "quest.513011DB5BB9FB5B.title": "Пластик: латекс або HDPE",
  "quest.513011DB5BB9FB5B.quest_subtitle": "Латекс або HDPE → пластик",
  "quest.513011DB5BB9FB5B.quest_desc": [
    "Обери доступне джерело: випал Dry Rubber з латексної лінії або рецепт 1 HDPE Sheet → 3 Plastic. Обидва шляхи живлять ті самі машини та рамки. Предметне завдання приймає пластик незалежно від обраного способу."
  ],
  "task.51301225B2655ED0.title": "1 × Plastic — без вилучення",
  "quest.513011905E9962AB.title": "Simple Frame з латексом",
  "quest.513011905E9962AB.quest_subtitle": "Dissolution і три перші рамки",
  "quest.513011905E9962AB.quest_desc": [
    "У Dissolution Chamber поєднай Pity Frame, пластик та компоненти точного механізму з латексом за рецептом. Simple Frame потрібна Laser Drill і стає основою Advanced Frame, тому організуй повторюване виробництво."
  ],
  "task.513012110A221909.title": "1 × Simple Machine Frame — без вилучення",
  "quest.51301150CDD6664E.title": "Dissolution Chamber до Simple Frame",
  "quest.51301150CDD6664E.quest_subtitle": "Dissolution і три перші рамки",
  "quest.51301150CDD6664E.quest_desc": [
    "Сама Dissolution Chamber виготовляється з Pity Frame та пластику й не потребує Simple Frame. Підведи FE та потрібну рідину, виклади компоненти за рецептом і виводь результат. Саме в цій машині виготовляються наступні рамки."
  ],
  "task.513012850B17F2FE.title": "1 × Dissolution Chamber — без вилучення",
  "quest.51301171CA29CEF3.title": "Advanced Frame: наступний виробничий рівень",
  "quest.51301171CA29CEF3.quest_subtitle": "Dissolution і три перші рамки",
  "quest.51301171CA29CEF3.quest_desc": [
    "Advanced Frame створюється в Dissolution Chamber із Simple Frame, пластику, Pink Slime та компонентів Dimensional Matrix. Ця рамка відкриває лазерні бази, переробку руди й складні ферми; збережи працюючі джерела латексу та слизу."
  ],
  "task.5130120004C85168.title": "1 × Advanced Machine Frame — без вилучення",
  "quest.513011F5C6B3A1A7.title": "Печі як вузол автоматичної лінії",
  "quest.513011F5C6B3A1A7.quest_subtitle": "Блоки, рідини та камінь",
  "quest.513011F5C6B3A1A7.quest_desc": [
    "Resourceful Furnace обробляє придатні рецепти випалу. Організуй предметний вхід, FE та вихід, а запас цієї машини залиш для рецепта Material StoneWork Factory у наступному вузлі."
  ],
  "task.5130120CD5CCDDA2.title": "1 × Resourceful Furnace — без вилучення",
  "quest.5130110526994D7D.title": "StoneWork: одна машина для кам'яної лінії",
  "quest.5130110526994D7D.quest_subtitle": "Блоки, рідини та камінь",
  "quest.5130110526994D7D.quest_desc": [
    "Material StoneWork Factory у збірці споживає Advanced Frame, Resourceful Furnace та Block Breaker. Після крафту налаштуй її операції, воду, лаву, FE та предметний вихід за інтерфейсом. Набір інгредієнтів у квесті не перевіряє готову конфігурацію."
  ],
  "task.51301203679A9B8F.title": "1 × Material StoneWork Factory — без вилучення",
  "quest.513011C5391BB59D.title": "Block Breaker: добування блока",
  "quest.513011C5391BB59D.quest_subtitle": "Блоки, рідини та камінь",
  "quest.513011C5391BB59D.quest_desc": [
    "Block Breaker руйнує придатний блок на робочій стороні та потребує місця для результату. Разом із подачею матеріалу він може стати локальним автоматичним вузлом; сама машина також входить у крафт Material StoneWork Factory."
  ],
  "task.513012A735CAF173.title": "1 × Block Breaker — без вилучення",
  "quest.513011EBEFDD9D81.title": "Block Placer",
  "quest.513011EBEFDD9D81.quest_subtitle": "Блоки, рідини та камінь",
  "quest.513011EBEFDD9D81.quest_desc": [
    "Збери окрему операцію промислової лінії. Машина потребує належного корпусу, енергії та місця під вихід; для лазерів перевір допустимі умови добування в JEI."
  ],
  "task.513012110A8A3291.title": "1 × Block Placer — без вилучення",
  "quest.513011C62D389346.title": "Fluid Placer",
  "quest.513011C62D389346.quest_subtitle": "Блоки, рідини та камінь",
  "quest.513011C62D389346.quest_desc": [
    "Збери окрему операцію промислової лінії. Машина потребує належного корпусу, енергії та місця під вихід; для лазерів перевір допустимі умови добування в JEI."
  ],
  "task.5130121CE80D40DF.title": "1 × Fluid Placer — без вилучення",
  "quest.513011ECEDA27FBB.title": "Fluid Collector",
  "quest.513011ECEDA27FBB.quest_subtitle": "Блоки, рідини та камінь",
  "quest.513011ECEDA27FBB.quest_desc": [
    "У машині кілька входів. Ти послідовно перевірив усі неправильні — теж метод дослідження.",
    "Збери окрему операцію промислової лінії. Машина потребує належного корпусу, енергії та місця під вихід; для лазерів перевір допустимі умови добування в JEI."
  ],
  "task.51301206373743EA.title": "1 × Fluid Collector — без вилучення",
  "quest.513011D00529ECCA.title": "Water Condensator",
  "quest.513011D00529ECCA.quest_subtitle": "Блоки, рідини та камінь",
  "quest.513011D00529ECCA.quest_desc": [
    "Збери окрему операцію промислової лінії. Машина потребує належного корпусу, енергії та місця під вихід; для лазерів перевір допустимі умови добування в JEI."
  ],
  "task.5130121103D93C41.title": "1 × Water Condensator — без вилучення",
  "quest.513011D4E145FBE3.title": "Ore Laser Base: вибір сировини",
  "quest.513011D4E145FBE3.quest_subtitle": "Бур і дві лазерні бази",
  "quest.513011D4E145FBE3.quest_desc": [
    "З'єднай Ore Laser Base з Laser Drills та виведи предмети в склад. Таблиця результатів залежить від налаштувань, глибини, біому та лінзи; перевір бажаний ресурс у JEI перед вибором місця."
  ],
  "task.5130123238C7AF3C.title": "1 × Ore Laser Base — без вилучення",
  "quest.5130110CBA356673.title": "Fluid Laser Base: рідинне добування",
  "quest.5130110CBA356673.quest_subtitle": "Бур і дві лазерні бази",
  "quest.5130110CBA356673.quest_desc": [
    "Fluid Laser Base працює разом із зарядженими Laser Drills і потребує вільного рідинного виходу. Її рецепти залежать від умов місця. Окремий пізній маршрут Ether Gas веде через базу безпосередньо над Wither, як показано в рідному посібнику."
  ],
  "task.5130123ABFFA7450.title": "1 × Fluid Laser Base — без вилучення",
  "quest.51301145D74317DD.title": "Laser Drill: заряд для бази",
  "quest.51301145D74317DD.quest_subtitle": "Бур і дві лазерні бази",
  "quest.51301145D74317DD.quest_desc": [
    "Laser Drill потребує Simple Frame й живить роботу окремої Laser Base. Розмісти бур у правильній позиції за рідною інструкцією, підведи FE та перевір, що база отримує заряд. Сам бур без бази не завершує виробничу систему."
  ],
  "task.513012D2BBB139D1.title": "1 × Laser Drill — без вилучення",
  "quest.513011D0D111A20A.title": "Руда + Liquid Meat → Raw Ore Meat",
  "quest.513011D0D111A20A.quest_subtitle": "Руда → рідка суміш → пил",
  "quest.513011D0D111A20A.quest_desc": [
    "Washing Factory споживає руду та Liquid Meat й починає рідинну переробку. Подай побічний продукт Mob Slaughter Factory в її резервуар, а результат передай до Fermentation Station."
  ],
  "task.513012146DB38CE6.title": "1 × Washing Factory — без вилучення",
  "quest.513011151DE90C52.title": "Ферментація проміжного продукту",
  "quest.513011151DE90C52.quest_subtitle": "Руда → рідка суміш → пил",
  "quest.513011151DE90C52.quest_desc": [
    "Fermentation Station працює з Raw Ore Meat попередньої машини. Налаштуй режим і обсяг партії, дочекайся завершення циклу та передай продукт у Fluid Sieving Machine. Перевір рецепт конкретного ресурсу, щоб не змішувати несумісні партії."
  ],
  "task.51301268DF11EC18.title": "1 × Fermentation Station — без вилучення",
  "quest.513011C168D23426.title": "Рідинне просіювання → рудний пил",
  "quest.513011C168D23426.quest_subtitle": "Руда → рідка суміш → пил",
  "quest.513011C168D23426.quest_desc": [
    "Fluid Sieving Machine використовує ферментований продукт та пісок для отримання рудного пилу. Забезпеч подачу піску, FE й виведення результатів; після цього підключи відповідний випал."
  ],
  "task.51301223D88D548A.title": "1 × Fluid Sieving Machine — без вилучення",
  "quest.51301154F33E4BE9.title": "Mob Imprisonment Tool: зразок",
  "quest.51301154F33E4BE9.quest_subtitle": "Моби, essence і зачарування",
  "quest.51301154F33E4BE9.quest_desc": [
    "Інструмент переносить придатну істоту для підтримуваних операцій. Квест перевіряє порожній предмет; для Mob Duplicator потрібен окремо підготовлений заповнений зразок."
  ],
  "task.5130123BF06D605C.title": "1 × Mob Imprisonment Tool — без вилучення",
  "quest.513011652C2C4B48.title": "Рожевий слиз для рамок",
  "quest.513011652C2C4B48.quest_subtitle": "Dissolution і три перші рамки",
  "quest.513011652C2C4B48.quest_desc": [
    "Mob Slaughter Factory починається з Pity Frame та пластику. Вона дає рідкі побічні продукти, зокрема Pink Slime для Advanced Frame; подбай про роздільне відведення й місткість. Вона доступна до рамки, для якої виробляє реагент."
  ],
  "task.513012FA1B7FB162.title": "1 × Mob Slaughter Factory — без вилучення",
  "quest.5130116264236136.title": "Mob Crusher: лут і Essence",
  "quest.5130116264236136.quest_subtitle": "Моби, essence і зачарування",
  "quest.5130116264236136.quest_desc": [
    "Рецепт збірки використовує Advanced Frame, Absorption Hopper та Mob Masher. Після крафту налаштуй робочу зону, FE й окремі виходи предметів та Essence. Цей досвід потрібен наступній лінії відтворення мобів."
  ],
  "task.51301209BB49065D.title": "1 × Mob Crusher — без вилучення",
  "quest.51301110A6A327AA.title": "Зразок + Essence → Mob Duplicator",
  "quest.51301110A6A327AA.quest_subtitle": "Моби, essence і зачарування",
  "quest.51301110A6A327AA.quest_desc": [
    "Спершу підготуй Powered Spawner з Ender IO: він є компонентом цього рецепта. Для роботи Mob Duplicator потрібні заповнений Mob Imprisonment Tool, Essence та FE. Перевір місце появи істот і підключене збирання результату."
  ],
  "task.5130120F32A426E8.title": "1 × Mob Duplicator — без вилучення",
  "quest.5130118E4A798482.title": "Mob Detector",
  "quest.5130118E4A798482.quest_subtitle": "Моби, essence і зачарування",
  "quest.5130118E4A798482.quest_desc": [
    "Це промислова обробка досвіду, звичайних мобів або зачарувань. Перевір дозволені типи істот; глобальні заборони міміків і босів діють незалежно від квесту."
  ],
  "task.5130127902371A16.title": "1 × Mob Detector — без вилучення",
  "quest.5130117AB9046CD2.title": "Вилучення зачарувань",
  "quest.5130117AB9046CD2.quest_subtitle": "Моби, essence і зачарування",
  "quest.5130117AB9046CD2.quest_desc": [
    "Enchantment Extractor переносить зачарування за своїми рецептами. Підготуй предмети й книги, FE та вільний вихід для всіх результатів. Це окрема гілка обробки здобичі після Advanced Frame.",
    "Гарантоване повернення витрачених компонентів: 1 × Діамант.",
    "Отримайте компенсацію після справжнього виготовлення предмета «Екстрактор зачарувань» вами або вашою командою. Предмет у сховищі чи завершений квест самі по собі не підтверджують крафт."
  ],
  "task.513012C65B3E0C0F.title": "1 × Enchantment Extractor — без вилучення",
  "quest.513011ED4F8D85C3.title": "Нанесення зачарувань",
  "quest.513011ED4F8D85C3.quest_subtitle": "Моби, essence і зачарування",
  "quest.513011ED4F8D85C3.quest_desc": [
    "Enchantment Applicator завершує маршрут книг і спорядження. Подавай придатний предмет, зачаровану книгу та потрібні робочі ресурси за інтерфейсом; Essence із ферми може бути частиною цієї виробничої системи."
  ],
  "task.5130126FF71E88C8.title": "1 × Enchantment Applicator — без вилучення",
  "quest.51301127D84254AF.title": "Ether Gas → Supreme Frame",
  "quest.51301127D84254AF.quest_subtitle": "Ether Gas та масштабування",
  "quest.51301127D84254AF.quest_desc": [
    "Для Supreme Frame потрібні Advanced Frame, пізні матеріали та Ether Gas у Dissolution Chamber. Налагодь окрему лінію Fluid Laser Base над Wither відповідно до рідного посібника, залиш місце для установки й резервуар продукту. Спершу отримай стабільний газ, потім запускай дорогі партії рамок."
  ],
  "task.5130129D8039EED5.title": "1 × Supreme Machine Frame — без вилучення",
  "quest.513011A2D8626B22.title": "Speed Addon Tier 1",
  "quest.513011A2D8626B22.quest_subtitle": "Ether Gas та масштабування",
  "quest.513011A2D8626B22.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.513012CBDF40540D.title": "1 × Speed Addon Tier 1 — без вилучення",
  "quest.513011268D442A18.title": "Speed Addon Tier 2",
  "quest.513011268D442A18.quest_subtitle": "Ether Gas та масштабування",
  "quest.513011268D442A18.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
  "task.5130122296BA8BAD.title": "1 × Speed Addon Tier 2 — без вилучення",
  "quest.513011A48F738CFF.title": "Efficiency Addon Tier 1",
  "quest.513011A48F738CFF.quest_subtitle": "Ether Gas та масштабування",
  "quest.513011A48F738CFF.quest_desc": [
    "Покращення вирішує конкретне обмеження: швидкість, ефективність, площу або автономність. Підвищення рівня потребує запасу живлення та стабільної подачі ресурсів."
  ],
