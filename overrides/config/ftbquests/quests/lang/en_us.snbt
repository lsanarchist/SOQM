  "chapter.514010E6C36ACAC3.title": "32 · Cannibal Villages: Tropics and Depths",
  "chapter.514010E6C36ACAC3.chapter_subtitle": [
    "40 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.514012C5CA3D6210.title": "Visit Aldeia Pequena",
  "quest.5140119CBDA96728.title": "Visit Aldeia Pequena",
  "quest.5140119CBDA96728.quest_desc": [
    "Visit the generated structure Aldeia Pequena (cannibalvillages:aldeia_pequena); an item or a replica does not replace the location check."
  ],
  "task.514012DB208DBC02.title": "Visit Aldeia Grande",
  "quest.5140112284624178.title": "Visit Aldeia Grande",
  "quest.5140112284624178.quest_desc": [
    "Visit the generated structure Aldeia Grande (cannibalvillages:aldeia_grande); an item or a replica does not replace the location check."
  ],
  "task.514012E699D21AD4.title": "Visit Palafita Suspensa",
  "quest.51401100150191E2.title": "Visit Palafita Suspensa",
  "quest.51401100150191E2.quest_desc": [
    "Visit the generated structure Palafita Suspensa (cannibalvillages:palafita_suspensa); an item or a replica does not replace the location check."
  ],
  "task.514012087059988B.title": "Visit Templo Rutia",
  "quest.51401119C6668C96.title": "Visit Templo Rutia",
  "quest.51401119C6668C96.quest_desc": [
    "Visit the generated structure Templo Rutia (cannibalvillages:templo_rutia); an item or a replica does not replace the location check."
