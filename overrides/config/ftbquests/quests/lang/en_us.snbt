  "chapter.5130108DC86DCC75.title": "10 · Industrial Foregoing without Crop Grinding",
  "chapter.5130108DC86DCC75.chapter_subtitle": [
    "Choose a plastic source, start Dissolution and branch into blocks, laser extraction, ore processing and mobs. Pink Slime and Ether Gas unlock the next machine frames.",
    "40 quests · 7 sequential production sections.",
    "Read top to bottom · hover a quest to see all its connections",
    "Open a quest to inspect all prerequisites, including links to other chapters. Item tasks check inventory; the description explains assembly and a test run."
  ],
  "task.513012A381ED847F.title": "Obtain 1 × Pity Machine Frame",
  "quest.5130111BE9BBE0D5.title": "Pity Frame: the start of several lines",
  "quest.5130111BE9BBE0D5.quest_desc": [
    "The Pity Machine Frame starts latex extraction and basic utility machines. The central route goes through plastic and the Dissolution Chamber to higher frames; side stations supply fluids, blocks and by-products."
  ],
  "task.51301224BEF46905.title": "Obtain 1 × Fluid Extractor",
  "quest.513011EEAB3DF77B.title": "Log → latex",
  "quest.513011EEAB3DF77B.quest_desc": [
    "Place the Fluid Extractor beside a suitable log and route latex to a tank or Latex Processing Unit. Replenish the wood as it is consumed; without material on the working side, the rubber line stops."
  ],
  "task.513012514E9D5267.title": "Obtain 1 × Latex Processing Unit",
  "quest.5130111B4AB75BE7.title": "Latex + water + FE",
  "quest.5130111B4AB75BE7.quest_desc": [
    "The Latex Processing Unit consumes latex, water and energy to produce Tiny Dry Rubber. Feed both fluids separately and extract the solid output. Use its interface to identify which input is limiting production."
  ],
  "task.513012D2E39E2B18.title": "Obtain 1 × Dry Rubber",
  "quest.51301137DA4E3B80.title": "Rubber pieces → smelted plastic",
  "quest.51301137DA4E3B80.quest_desc": [
    "Combine Tiny Dry Rubber into Dry Rubber and smelt it into Plastic. This completes the latex branch. The pack also has a direct Plastic recipe from Mekanism HDPE Sheets, so this rubber node does not block the shared plastic line."
  ],
  "task.51301225B2655ED0.title": "Obtain 1 × Plastic",
  "quest.513011DB5BB9FB5B.title": "Plastic: latex or HDPE",
  "quest.513011DB5BB9FB5B.quest_desc": [
    "Choose the available source: smelt Dry Rubber from the latex line, or use the recipe for 1 HDPE Sheet → 3 Plastic. Both paths feed the same machines and frames, and the item objective accepts either source."
  ],
  "task.513012110A221909.title": "Obtain 1 × Simple Machine Frame",
  "quest.513011905E9962AB.title": "Simple Frame with latex",
  "quest.513011905E9962AB.quest_desc": [
    "In the Dissolution Chamber, combine a Pity Frame, plastic and precision components with latex as the recipe specifies. The Simple Frame supplies the Laser Drill and becomes the base of the Advanced Frame, so establish repeatable production."
  ],
  "task.513012850B17F2FE.title": "Obtain 1 × Dissolution Chamber",
  "quest.51301150CDD6664E.title": "Dissolution Chamber before the Simple Frame",
  "quest.51301150CDD6664E.quest_desc": [
    "The Dissolution Chamber itself uses a Pity Frame and plastic, so it does not need a Simple Frame first. Supply FE and the required fluid, arrange the recipe inputs and remove the result. This machine produces the later frames."
  ],
  "task.5130120004C85168.title": "Obtain 1 × Advanced Machine Frame",
  "quest.51301171CA29CEF3.title": "Advanced Frame: the next production tier",
  "quest.51301171CA29CEF3.quest_desc": [
    "The Dissolution Chamber makes an Advanced Frame from a Simple Frame, plastic, Pink Slime and Dimensional Matrix stage components. It unlocks laser bases, ore processing and more complex farms; keep latex and slime production running."
  ],
  "task.5130120CD5CCDDA2.title": "Obtain 1 × Resourceful Furnace",
  "quest.513011F5C6B3A1A7.title": "Furnaces as an automated station",
  "quest.513011F5C6B3A1A7.quest_desc": [
    "The Resourceful Furnace processes supported smelting recipes. Configure its item input, FE and output, and reserve another copy for the Material StoneWork Factory recipe."
  ],
  "task.51301203679A9B8F.title": "Obtain 1 × Material StoneWork Factory",
  "quest.5130110526994D7D.title": "StoneWork: a single stone-processing station",
  "quest.5130110526994D7D.quest_desc": [
    "This pack's Material StoneWork Factory consumes an Advanced Frame, Resourceful Furnace and Block Breaker. Configure its operations, water, lava, FE and item output in the interface. The quest's item check does not inspect a completed configuration."
  ],
  "task.513012A735CAF173.title": "Obtain 1 × Block Breaker",
  "quest.513011C5391BB59D.title": "Block Breaker: harvesting a block",
  "quest.513011C5391BB59D.quest_desc": [
    "The Block Breaker harvests a supported block on its working side and needs room for the result. Pair it with a material supply for a local automated station; the machine is also an ingredient of the Material StoneWork Factory."
  ],
  "task.513012110A8A3291.title": "Obtain 1 × Block Placer",
  "quest.513011EBEFDD9D81.title": "Obtain 1 × Block Placer",
  "quest.513011EBEFDD9D81.quest_desc": [
    "Have in your inventory 1 × Block Placer (industrialforegoing:block_placer). The items are not consumed by this task."
  ],
  "task.5130121CE80D40DF.title": "Obtain 1 × Fluid Placer",
  "quest.513011C62D389346.title": "Obtain 1 × Fluid Placer",
  "quest.513011C62D389346.quest_desc": [
    "Have in your inventory 1 × Fluid Placer (industrialforegoing:fluid_placer). The items are not consumed by this task."
  ],
  "task.51301206373743EA.title": "Obtain 1 × Fluid Collector",
  "quest.513011ECEDA27FBB.title": "Obtain 1 × Fluid Collector",
  "quest.513011ECEDA27FBB.quest_desc": [
    "Have in your inventory 1 × Fluid Collector (industrialforegoing:fluid_collector). The items are not consumed by this task."
  ],
  "task.5130121103D93C41.title": "Obtain 1 × Water Condensator",
  "quest.513011D00529ECCA.title": "Obtain 1 × Water Condensator",
  "quest.513011D00529ECCA.quest_desc": [
    "Have in your inventory 1 × Water Condensator (industrialforegoing:water_condensator). The items are not consumed by this task."
  ],
  "task.5130123238C7AF3C.title": "Obtain 1 × Ore Laser Base",
  "quest.513011D4E145FBE3.title": "Ore Laser Base: choosing resources",
  "quest.513011D4E145FBE3.quest_desc": [
    "Connect the Ore Laser Base to Laser Drills and route items into storage. Outputs depend on settings, depth, biome and lens; inspect the desired resource in JEI before choosing a site."
  ],
  "task.5130123ABFFA7450.title": "Obtain 1 × Fluid Laser Base",
  "quest.5130110CBA356673.title": "Fluid Laser Base: fluid extraction",
  "quest.5130110CBA356673.quest_desc": [
    "The Fluid Laser Base works with charged Laser Drills and needs a clear fluid output. Its recipes depend on local conditions. The later Ether Gas route places the base directly above a Wither, as shown in the native guide."
  ],
  "task.513012D2BBB139D1.title": "Obtain 1 × Laser Drill",
  "quest.51301145D74317DD.title": "Laser Drill: charge for the base",
  "quest.51301145D74317DD.quest_desc": [
    "The Laser Drill uses a Simple Frame and powers the operation of a separate Laser Base. Position the drill as the native guide specifies, connect FE and check that the base receives charge. The drill alone is not a complete production system."
  ],
  "task.513012146DB38CE6.title": "Obtain 1 × Washing Factory",
  "quest.513011D0D111A20A.title": "Ore + Liquid Meat → Raw Ore Meat",
  "quest.513011D0D111A20A.quest_desc": [
    "The Washing Factory consumes ore and Liquid Meat to begin fluid-based ore processing. Feed the Mob Slaughter Factory by-product into its tank and route the output to the Fermentation Station."
  ],
  "task.51301268DF11EC18.title": "Obtain 1 × Fermentation Station",
  "quest.513011151DE90C52.title": "Fermenting the intermediate",
  "quest.513011151DE90C52.quest_desc": [
    "The Fermentation Station handles the previous machine's Raw Ore Meat. Configure its mode and batch threshold, wait for the cycle and send the result to the Fluid Sieving Machine. Check the resource's recipe before mixing batches."
  ],
  "task.51301223D88D548A.title": "Obtain 1 × Fluid Sieving Machine",
  "quest.513011C168D23426.title": "Fluid sieving → ore dust",
  "quest.513011C168D23426.quest_desc": [
    "The Fluid Sieving Machine uses the fermented product and sand to produce ore dust. Supply sand and FE and remove the results, then connect the appropriate smelting step."
  ],
  "task.5130123BF06D605C.title": "Obtain 1 × Mob Imprisonment Tool",
  "quest.51301154F33E4BE9.title": "Mob Imprisonment Tool: a sample",
  "quest.51301154F33E4BE9.quest_desc": [
    "This tool holds a supported creature for compatible operations. The quest checks the empty item; the Mob Duplicator separately needs a prepared filled sample."
  ],
  "task.513012FA1B7FB162.title": "Obtain 1 × Mob Slaughter Factory",
  "quest.513011652C2C4B48.title": "Pink Slime for frames",
  "quest.513011652C2C4B48.quest_desc": [
    "The Mob Slaughter Factory starts from a Pity Frame and plastic. It produces fluid by-products, including Pink Slime for the Advanced Frame; provide separate outputs and capacity. It comes before the frame that consumes its reagent."
  ],
  "task.51301209BB49065D.title": "Obtain 1 × Mob Crusher",
  "quest.5130116264236136.title": "Mob Crusher: loot and Essence",
  "quest.5130116264236136.quest_desc": [
    "The pack's recipe uses an Advanced Frame, Absorption Hopper and Mob Masher. Configure the working area, FE and separate item and Essence outputs. That Essence supplies the following mob duplication line."
  ],
  "task.5130120F32A426E8.title": "Obtain 1 × Mob Duplicator",
  "quest.51301110A6A327AA.title": "Sample + Essence → Mob Duplicator",
  "quest.51301110A6A327AA.quest_desc": [
    "Prepare the Ender IO Powered Spawner first, since this recipe consumes it. The Mob Duplicator then needs a filled Mob Imprisonment Tool, Essence and FE. Check the spawning space and the connected collection system."
  ],
  "task.5130127902371A16.title": "Obtain 1 × Mob Detector",
  "quest.5130118E4A798482.title": "Obtain 1 × Mob Detector",
  "quest.5130118E4A798482.quest_desc": [
    "Have in your inventory 1 × Mob Detector (industrialforegoing:mob_detector). The items are not consumed by this task."
  ],
  "task.513012C65B3E0C0F.title": "Obtain 1 × Enchantment Extractor",
  "quest.5130117AB9046CD2.title": "Extracting enchantments",
  "quest.5130117AB9046CD2.quest_desc": [
    "The Enchantment Extractor transfers enchantments using its supported operations. Prepare items, books, FE and clear outputs for all results. It is a separate loot-processing branch after the Advanced Frame."
  ],
  "task.5130126FF71E88C8.title": "Obtain 1 × Enchantment Applicator",
  "quest.513011ED4F8D85C3.title": "Applying enchantments",
  "quest.513011ED4F8D85C3.quest_desc": [
    "The Enchantment Applicator completes the route from books to equipment. Supply a compatible item, enchanted book and the operating resources shown in its interface; farm Essence can support this system."
  ],
  "task.5130129D8039EED5.title": "Obtain 1 × Supreme Machine Frame",
  "quest.51301127D84254AF.title": "Ether Gas → Supreme Frame",
  "quest.51301127D84254AF.quest_desc": [
    "The Supreme Frame needs an Advanced Frame, late materials and Ether Gas in the Dissolution Chamber. Establish the Fluid Laser Base line above a Wither as the native guide describes, with room for the setup and a product tank. Stabilize gas production before starting expensive frame batches."
  ],
  "task.513012CBDF40540D.title": "Obtain 1 × Speed Addon Tier 1",
  "quest.513011A2D8626B22.title": "Obtain 1 × Speed Addon Tier 1",
  "quest.513011A2D8626B22.quest_desc": [
    "Have in your inventory 1 × Speed Addon Tier 1 (industrialforegoing:speed_addon_tier_1). The items are not consumed by this task."
  ],
  "task.5130122296BA8BAD.title": "Obtain 1 × Speed Addon Tier 2",
  "quest.513011268D442A18.title": "Obtain 1 × Speed Addon Tier 2",
  "quest.513011268D442A18.quest_desc": [
    "Have in your inventory 1 × Speed Addon Tier 2 (industrialforegoing:speed_addon_tier_2). The items are not consumed by this task."
  ],
  "task.513012B729256653.title": "Obtain 1 × Efficiency Addon Tier 1",
  "quest.513011A48F738CFF.title": "Obtain 1 × Efficiency Addon Tier 1",
  "quest.513011A48F738CFF.quest_desc": [
    "Have in your inventory 1 × Efficiency Addon Tier 1 (industrialforegoing:efficiency_addon_tier_1). The items are not consumed by this task."
  ],
  "task.513012AC599F1194.title": "Obtain 1 × Efficiency Addon Tier 2",
  "quest.5130116DDA11F4EE.title": "Obtain 1 × Efficiency Addon Tier 2",
  "quest.5130116DDA11F4EE.quest_desc": [
    "Have in your inventory 1 × Efficiency Addon Tier 2 (industrialforegoing:efficiency_addon_tier_2). The items are not consumed by this task."
  ],
  "task.513012D036ED14D7.title": "Obtain 1 × Processing Addon Tier 1",
  "quest.5130111A5BD14B53.title": "Obtain 1 × Processing Addon Tier 1",
  "quest.5130111A5BD14B53.quest_desc": [
    "Have in your inventory 1 × Processing Addon Tier 1 (industrialforegoing:processing_addon_tier_1). The items are not consumed by this task."
  ],
  "task.513012589DC1B4FB.title": "Obtain 1 × Processing Addon Tier 2",
  "quest.51301109BDC10F3A.title": "Obtain 1 × Processing Addon Tier 2",
  "quest.51301109BDC10F3A.quest_desc": [
    "Have in your inventory 1 × Processing Addon Tier 2 (industrialforegoing:processing_addon_tier_2). The items are not consumed by this task."
  ],
  "task.5130120BA958EC8F.title": "Obtain 1 × Range Addon Tier 2",
  "quest.5130118C29E5449C.title": "Obtain 1 × Range Addon Tier 2",
  "quest.5130118C29E5449C.quest_desc": [
    "Have in your inventory 1 × Range Addon Tier 2 (industrialforegoing:range_addon_tier_2). The items are not consumed by this task."
  ],
  "task.5130128F12F5D212.title": "Obtain 1 × Range Addon Tier 5",
  "quest.5130111D6C11FBB1.title": "Obtain 1 × Range Addon Tier 5",
  "quest.5130111D6C11FBB1.quest_desc": [
    "Have in your inventory 1 × Range Addon Tier 5 (industrialforegoing:range_addon_tier_5). The items are not consumed by this task."
  ],
  "task.51301204F98CB9F1.title": "Obtain 1 × Range Addon Tier 8",
  "quest.513011A514A41277.title": "Obtain 1 × Range Addon Tier 8",
  "quest.513011A514A41277.quest_desc": [
    "Have in your inventory 1 × Range Addon Tier 8 (industrialforegoing:range_addon_tier_8). The items are not consumed by this task."
  ],
  "task.513012A9B7E94207.title": "Obtain 1 × Range Addon Tier 11",
  "quest.513011B20346E7E1.title": "Obtain 1 × Range Addon Tier 11",
  "quest.513011B20346E7E1.quest_desc": [
    "Have in your inventory 1 × Range Addon Tier 11 (industrialforegoing:range_addon_tier_11). The items are not consumed by this task."
  ],
  "task.5130127A21909AC5.title": "Obtain 1 × Infinity Drill",
  "quest.513011162F45B0CF.title": "Infinity Drill after the Supreme Frame",
  "quest.513011162F45B0CF.quest_desc": [
    "The Infinity Drill uses this branch's final frame. Inspect its recipe, charge storage and operating modes. Crafting it is a separate final use of the industrial line rather than a requirement for the earlier machines."
  ],
