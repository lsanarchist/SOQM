  "quest.5130112A30E05613.quest_desc": [
    "Have in your inventory 1 × Seashelf (apothic_enchanting:seashelf). The items are not consumed by this task."
  ],
  "task.5130124084180DBF.title": "Obtain 1 × Infused Seashelf",
  "quest.513011039F2E9728.title": "Obtain 1 × Infused Seashelf",
