  "task.513012586DF695E4.title": "Obtain 1 × Wooden Tie",
  "quest.51301189A2B4AEAF.title": "Obtain 1 × Wooden Tie",
  "quest.51301189A2B4AEAF.quest_desc": [
    "Have in your inventory 1 × Wooden Tie (railcraft:wooden_tie). The items are not consumed by this task."
  ],
  "task.51301241B0A4AE12.title": "Linking Carts",
  "quest.513011F655EF052F.title": "Linking Carts",
  "quest.513011F655EF052F.quest_desc": [
    "To form a train, place two compatible carts close together on a track and sneak-right-click first one, then the other with a Steel Crowbar. The quest checks actual cart linking.",
    "Test the pair on a short straight section before adding more carts. A coupling is not an engine: the train still needs propulsion and a correctly configured track."
  ],
  "task.513012A58E50F59C.title": "Better Forks",
  "quest.5130114C6BBFCCCD.title": "Better Forks",
  "quest.5130114C6BBFCCCD.quest_desc": [
    "Earn the native advancement Better Forks (railcraft:tracks/junctions). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.51301252EE03981D.title": "Dreams on the wheels",
  "quest.513011CCFE17F1FB.title": "Dreams on the wheels",
  "quest.513011CCFE17F1FB.quest_desc": [
    "Earn the native advancement Dreams on the wheels (railcraft:carts/bed_cart). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.513012519D271A47.title": "Obtain 1 × Powered Rolling Machine",
  "quest.5130116FB1CF442C.title": "Obtain 1 × Powered Rolling Machine",
  "quest.5130116FB1CF442C.quest_desc": [
    "The Powered Rolling Machine upgrades manual metal forming into machine production. Its SOQM recipe requires a Precision Mechanism; after placement, supply power and ingredients.",
    "Complete one required recipe before connecting input and output pipes. It supports automation, but an incorrect grid remainder or missing ingredient stops production regardless of stored energy."
  ],
  "task.5130124D674AF00C.title": "Obtain 1 × Locking Track Kit",
  "quest.513011CFD1B179B3.title": "Obtain 1 × Locking Track Kit",
  "quest.513011CFD1B179B3.quest_desc": [
    "A Locking Track holds a cart at a stop while unpowered. A redstone signal releases it; the selected mode decides whether it also receives a boost and in which direction.",
    "Use the Crowbar to cycle holding, boarding and train modes. Test the arrow and mode with one cart: releasing a cart and launching it are different behaviours."
  ],
  "task.513012E4F7B98EAC.title": "Obtain 1 × Coupler Track Kit",
  "quest.513011863D5B3F64.title": "Obtain 1 × Coupler Track Kit",
  "quest.513011863D5B3F64.quest_desc": [
    "A Coupler Track automates joining or separating carts. It needs a redstone signal to act; select the intended mode with the tool before sending carts over it.",
    "Test two empty carts and inspect their coupling first. Do not send a loaded train through until you have confirmed that the track couples rather than separates it."
  ],
  "task.5130121A210487B6.title": "Obtain 1 × Disembarking Track Kit",
  "quest.513011406992DBD8.title": "Obtain 1 × Disembarking Track Kit",
  "quest.513011406992DBD8.quest_desc": [
    "Have in your inventory 1 × Disembarking Track Kit (railcraft:disembarking_track_kit). The items are not consumed by this task."
  ],
  "task.513012004647C1F2.title": "Obtain 1 × Embarking Track Kit",
  "quest.5130116856E9A48A.title": "Obtain 1 × Embarking Track Kit",
  "quest.5130116856E9A48A.quest_desc": [
    "Have in your inventory 1 × Embarking Track Kit (railcraft:embarking_track_kit). The items are not consumed by this task."
  ],
  "task.5130129803C8B65E.title": "Obtain 1 × Dumping Track Kit",
  "quest.5130117DB13773F0.title": "Obtain 1 × Dumping Track Kit",
  "quest.5130117DB13773F0.quest_desc": [
    "Have in your inventory 1 × Dumping Track Kit (railcraft:dumping_track_kit). The items are not consumed by this task."
  ],
  "task.513012879BB225A6.title": "Obtain 1 × Gated Track Kit",
  "quest.5130110A9D04BEBF.title": "Obtain 1 × Gated Track Kit",
  "quest.5130110A9D04BEBF.quest_desc": [
    "Have in your inventory 1 × Gated Track Kit (railcraft:gated_track_kit). The items are not consumed by this task."
  ],
  "task.51301200ECBA41B3.title": "Obtain 1 × One-Way Track Kit",
  "quest.5130118593FC506A.title": "Obtain 1 × One-Way Track Kit",
  "quest.5130118593FC506A.quest_desc": [
    "A One-Way Track enforces direction while powered by redstone. It reverses a cart travelling against its arrow; without a signal it behaves like ordinary track.",
    "Set the arrow with the Crowbar and test both directions. The arrow alone is not a permanent barrier: losing power disables direction enforcement."
  ],
  "task.513012500F0104A3.title": "Obtain 1 × Routing Track Kit",
  "quest.5130115614499BD1.title": "Obtain 1 × Routing Track Kit",
  "quest.5130115614499BD1.quest_desc": [
