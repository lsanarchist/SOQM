  "chapter.514010B73E9F5636.title": "36 · Pufferfish's Skills: Choose Your Growth",
  "chapter.514010B73E9F5636.chapter_subtitle": [
    "12 quests · English objective guide (alpha).",
    "Hexagon: route · square: development · circle: optional",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.5140122E3599406D.title": "Mayhem Skills: Root",
  "quest.514011CC96A3A981.title": "Mayhem Skills: Root",
  "quest.514011CC96A3A981.quest_subtitle": "Stage 0 · Practice",
  "quest.514011CC96A3A981.quest_desc": [
    "Open the Mayhem category in Pufferfish's Skills and unlock its starting node. The four branches share a maximum budget of 14 spendable points."
  ],
  "task.514012133497695D.title": "Mayhem Skills: Guardian",
  "quest.514011464B04DE7A.title": "Mayhem Skills: Guardian",
  "quest.514011464B04DE7A.quest_subtitle": "Stage 0 · Optional branch",
  "quest.514011464B04DE7A.quest_desc": [
    "Unlock the first skill in the Mayhem Guardian branch of Pufferfish's Skills. This is an optional specialization; you do not need all four branches."
  ],
  "task.514012E6327C2B03.title": "Mayhem Skills: Warrior",
  "quest.5140118914510A0A.title": "Mayhem Skills: Warrior",
  "quest.5140118914510A0A.quest_subtitle": "Stage 0 · Optional branch",
  "quest.5140118914510A0A.quest_desc": [
    "Unlock the first skill in the Mayhem Warrior branch of Pufferfish's Skills. This is an optional specialization; you do not need all four branches."
  ],
  "task.51401253ED7D3EC8.title": "Mayhem Skills: Explorer",
