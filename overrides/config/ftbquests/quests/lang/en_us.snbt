  "chapter.5130105668AE29F0.title": "16 · EvilCraft: Blood, Spirits and Weather",
  "chapter.5130105668AE29F0.chapter_subtitle": [
    "45 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.513012F39127555C.title": "Obtain 1 × Origins of Darkness",
  "quest.513011C91AAAFAA7.title": "Obtain 1 × Origins of Darkness",
  "quest.513011C91AAAFAA7.quest_desc": [
    "Have in your inventory 1 × Origins of Darkness (evilcraft:origins_of_darkness). The items are not consumed by this task."
  ],
  "task.513012EF7FE79398.title": "Obtain 1 × Dark Gem",
  "quest.5130115ECA129D7B.title": "Obtain 1 × Dark Gem",
  "quest.5130115ECA129D7B.quest_desc": [
    "Have in your inventory 1 × Dark Gem (evilcraft:dark_gem). The items are not consumed by this task."
  ],
  "task.51301230DC308F38.title": "Obtain 1 × Crushed Dark Gem",
  "quest.513011851FF1F267.title": "Obtain 1 × Crushed Dark Gem",
  "quest.513011851FF1F267.quest_desc": [
    "Have in your inventory 1 × Crushed Dark Gem (evilcraft:dark_gem_crushed). The items are not consumed by this task."
  ],
  "task.513012B0ADA4CD77.title": "Obtain 1 × Darkened Apple",
  "quest.513011C82B7ED775.title": "Obtain 1 × Darkened Apple",
  "quest.513011C82B7ED775.quest_desc": [
    "Have in your inventory 1 × Darkened Apple (evilcraft:darkened_apple). The items are not consumed by this task."
  ],
  "task.513012E2DAD093FB.title": "Obtain 1 × Blood Extractor",
  "quest.513011BE85999FCD.title": "Obtain 1 × Blood Extractor",
  "quest.513011BE85999FCD.quest_desc": [
    "Keep a Blood Extractor in your inventory while killing mobs that yield blood in EvilCraft. Those kills fill it; crafting the extractor alone does not provide the Blood your machines need.",
    "You can also collect blood stains from the ground by using the extractor on a stain while sneaking. Combine extractors, or an extractor and a Dark Tank, in a crafting grid to increase storage capacity."
  ],
  "task.513012E1D83983A0.title": "Obtain 1 × Hardened Blood Shard",
  "quest.513011106E68DB50.title": "Obtain 1 × Hardened Blood Shard",
  "quest.513011106E68DB50.quest_desc": [
    "Blood placed in a dry location eventually becomes Hardened Blood. Break the hardened blood using Flint and Steel to obtain Hardened Blood Shards. A normal pickaxe or your fist turns it back into liquid instead.",
    "If you collect the Hardened Blood block with Silk Touch, smelting it produces nine shards. One Blood Infusion Core needs eight shards, so collect enough for a batch."
  ],
  "task.513012E5A42B9889.title": "Obtain 1 × Blood Infusion Core",
  "quest.513011BB268203F6.title": "Obtain 1 × Blood Infusion Core",
  "quest.513011BB268203F6.quest_desc": [
    "Place a Dark Power Gem in the center of the crafting grid and surround it with eight Hardened Blood Shards. This recipe requires a Dark Power Gem, not an ordinary Dark Gem.",
    "The Blood Infusion Core is a component of the Blood Infuser. Also prepare an Industrial Chassis, Arcane Conduit and Control Assembly to meet the SOQM machine recipe."
  ],
  "task.5130120640D3EC5A.title": "Obtain 1 × Blood Infuser",
  "quest.513011F6BBEDC253.title": "Obtain 1 × Blood Infuser",
  "quest.513011F6BBEDC253.quest_desc": [
    "The Blood Infuser uses Blood to infuse items and fill containers that accept blood. Supply blood to the machine, then insert an item with a Blood Infusion recipe.",
    "If the infuser has blood but will not run, check for a redstone signal: it pauses processing. Higher-tier recipes require Promises of Tenacity; extra blood does not substitute for the required machine tier."
  ],
  "task.513012F67DBD9745.title": "Eternal Closure",
  "quest.513011F5469C1A38.title": "Eternal Closure",
  "quest.513011F5469C1A38.quest_desc": [
    "Earn the native advancement Eternal Closure (evilcraft:closure). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.5130121E335AA4E3.title": "Obtain 1 × Vengeance Essence",
  "quest.513011BB3FBFDB27.title": "Obtain 1 × Vengeance Essence",
  "quest.513011BB3FBFDB27.quest_desc": [
    "Have in your inventory 1 × Vengeance Essence (evilcraft:vengeance_essence). The items are not consumed by this task."
  ],
  "task.5130121BCC4589A9.title": "Obtain 1 × Spectral Glasses",
  "quest.5130117775EC76EE.title": "Obtain 1 × Spectral Glasses",
  "quest.5130117775EC76EE.quest_desc": [
    "Spectral Glasses let you see Vengeance Spirits without attracting their attention. Use them to locate a spirit after killing the mob you want to capture.",
    "The glasses do not pacify a spirit that is already pursuing you. Prepare a Vengeance Focus and an empty Box of Eternal Closure before searching; seeing a spirit does not capture it."
  ],
  "task.513012B7F27273D3.title": "Obtain 1 × Vengeance Focus",
  "quest.513011BFD1508F3E.title": "Obtain 1 × Vengeance Focus",
  "quest.513011BFD1508F3E.quest_desc": [
    "Use a Vengeance Focus to target and freeze a Vengeance Spirit so it can be captured in a Box of Eternal Closure. Bring Spectral Glasses or another way to see spirits while searching.",
    "Choose the spirit of the mob whose drops or spawn egg you need. The Focus is the capture tool; the captured spirit is stored in the box, which is what the machines use."
  ],
  "task.51301270B7BA84F3.title": "Obtain 1 × Box of Eternal Closure",
  "quest.51301120ED3388D8.title": "Obtain 1 × Box of Eternal Closure",
  "quest.51301120ED3388D8.quest_desc": [
    "An empty Box of Eternal Closure is only a container. Prepare it for a Spirit Furnace or Spirit Reanimator by locating the desired mob’s Vengeance Spirit and capturing it with a Vengeance Focus.",
    "This item task also accepts an empty box. Before inserting it into a machine, check which spirit it contains; an empty box cannot supply mob drops."
  ],
  "task.51301272E0AAC94B.title": "Obtain 1 × Spirit Furnace",
  "quest.513011A6B4765CC7.title": "Obtain 1 × Spirit Furnace",
  "quest.513011A6B4765CC7.quest_desc": [
    "Build a hollow shell of Dark Blood Bricks with one Spirit Furnace block in its wall. Its interior must fit the mob whose spirit you are using; a correctly assembled structure shows a red glow.",
    "Supply Blood, insert a Box of Eternal Closure containing a captured spirit and leave room for the drops. The furnace repeatedly produces that mob’s drops at a blood cost while retaining the spirit for future cycles."
  ],
  "task.513012437FA5CDB0.title": "Obtain 1 × Spirit Reanimator",
  "quest.513011C4979876E2.title": "Obtain 1 × Spirit Reanimator",
  "quest.513011C4979876E2.quest_desc": [
    "The Spirit Reanimator combines a captured spirit, Blood and an ordinary Egg to create that mob’s spawn egg. Its SOQM crafting recipe also requires a Quantum Processor and Dimensional Matrix.",
    "Reanimation consumes the spirit: one captured spirit produces one egg. Capture another if you want to keep a reusable drop source in the Spirit Furnace; not every spirit supports egg creation."
  ],
  "task.513012844FF78CC7.title": "Obtain 1 × Necromancer Staff",
  "quest.5130115B8812662A.title": "Obtain 1 × Necromancer Staff",
  "quest.5130115B8812662A.quest_desc": [
    "Have in your inventory 1 × Necromancer Staff (evilcraft:necromancer_staff). The items are not consumed by this task."
  ],
  "task.513012BD7EE5153E.title": "Obtain 1 × Promise of Tenacity I",
  "quest.513011B5B29600A9.title": "Obtain 1 × Promise of Tenacity I",
  "quest.513011B5B29600A9.quest_desc": [
    "Craft a Promise of Tenacity I from a Bowl of Promises, an Iron Promise Acceptor and a Spider Eye. Prepare the bowl through blood infusion; an ordinary empty bowl cannot replace a finished Bowl of Promises.",
    "Install the promise in a compatible machine. Tenacity raises its tier, blood capacity and upgrade capacity, unlocking the corresponding recipes. Promises of Velocity provide the separate speed upgrades."
  ],
  "task.5130128AC24061CA.title": "Obtain 1 × Promise of Tenacity II",
  "quest.51301114D956AFA2.title": "Obtain 1 × Promise of Tenacity II",
  "quest.51301114D956AFA2.quest_desc": [
    "Combine a tier-I-or-higher Bowl of Promises, a Gold Promise Acceptor and an Ender Pearl to make Promise of Tenacity II. The tier-zero bowl accepted by the first promise no longer works here.",
    "Installing Tenacity II grants access to the corresponding machine-tier recipes. Check the required tier of the infusion you want before preparing a large batch of ingredients."
  ],
  "task.5130125703E7BC3A.title": "Obtain 1 × Promise of Tenacity III",
  "quest.513011942BD9B748.title": "Obtain 1 × Promise of Tenacity III",
  "quest.513011942BD9B748.quest_desc": [
    "Promise of Tenacity III requires a tier-II-or-III Bowl of Promises, a Diamond Promise Acceptor and an Eye of Ender. It has its own crafting recipe; several tier-I promises do not replace these ingredients.",
    "After installing the highest Tenacity tier, supply enough Blood for the machine. Promise of Productivity separately reduces blood consumption, while Promise of Velocity increases processing speed."
  ],
  "task.513012A90CA6376C.title": "Obtain 1 × Purifier",
  "quest.513011735E047323.title": "Obtain 1 × Purifier",
  "quest.513011735E047323.quest_desc": [
    "The Purifier removes harmful effects from equipment, including side effects of Blood Chest repairs. Insert the affected item and supply at least a bucket of Blood for that purification.",
    "Enchanting transfer uses a different setup: an enchanted item, a Blook and a full blood supply. A Blook is a blood-infused book; the process transfers one random enchantment and consumes three buckets of Blood."
  ],
  "task.5130124F87281BCD.title": "Player Distorter",
  "quest.51301122EA899791.title": "Player Distorter",
  "quest.51301122EA899791.quest_desc": [
    "Earn the native advancement Player Distorter (evilcraft:player_distorter). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.513012BACB46AE0A.title": "Player Devastator",
  "quest.51301123305026D9.title": "Player Devastator",
  "quest.51301123305026D9.quest_desc": [
    "Earn the native advancement Player Devastator (evilcraft:player_devastator). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.513012BA733CCB79.title": "Obtain 1 × Weather Container",
  "quest.5130111CE1F0B46F.title": "Obtain 1 × Weather Container",
  "quest.5130111CE1F0B46F.quest_desc": [
    "A Weather Container stores a specific weather state. Throw an empty container into the core of a Dark Temple to capture the current weather; do this during rain if you are preparing an Eternal Water Bucket.",
    "A filled container can be used in crafting or thrown and broken to restore its stored weather. Keep it intact for your planned recipe and check which weather it contains."
  ],
  "task.51301262E229B615.title": "Obtain 1 × Environmental Accumulation Core",
  "quest.5130116CCBBB36D8.title": "Obtain 1 × Environmental Accumulation Core",
  "quest.5130116CCBBB36D8.quest_desc": [
    "Have in your inventory 1 × Environmental Accumulation Core (evilcraft:environmental_accumulation_core). The items are not consumed by this task."
  ],
  "task.51301283527F2DAC.title": "Obtain 1 × Sanguinary Environmental Acc.",
  "quest.5130118186C88013.title": "Obtain 1 × Sanguinary Environmental Acc.",
  "quest.5130118186C88013.quest_desc": [
    "Have in your inventory 1 × Sanguinary Environmental Acc. (evilcraft:sanguinary_environmental_accumulator). The items are not consumed by this task."
  ],
  "task.513012690265A19D.title": "Obtain 1 × Biome Extract",
  "quest.5130113109FB623B.title": "Obtain 1 × Biome Extract",
  "quest.5130113109FB623B.quest_desc": [
    "Have in your inventory 1 × Biome Extract (evilcraft:biome_extract). The items are not consumed by this task."
  ],
  "task.513012AC18954F66.title": "Obtain 1 × Eternal Water Bucket",
  "quest.51301131C5916096.title": "Obtain 1 × Eternal Water Bucket",
  "quest.51301131C5916096.quest_desc": [
    "The Eternal Water Bucket recipe requires a rain-filled Weather Container and three Dark Gems. Place the container between two gems with the third gem underneath; the recipe produces four buckets.",
    "An empty container or one holding different weather will not work even if its icon looks similar. Capture rain in a Dark Temple first, then use that filled container in the recipe."
  ],
  "task.5130121541AAAD4B.title": "Obtain 1 × Entangled Chalice",
  "quest.513011350799F98E.title": "Obtain 1 × Entangled Chalice",
  "quest.513011350799F98E.quest_desc": [
    "Have in your inventory 1 × Entangled Chalice (evilcraft:entangled_chalice). The items are not consumed by this task."
  ],
  "task.513012FD771FFE98.title": "Obtain 1 × Blood Pearl of Teleportation",
  "quest.513011EBF2C174B4.title": "Obtain 1 × Blood Pearl of Teleportation",
  "quest.513011EBF2C174B4.quest_desc": [
    "Have in your inventory 1 × Blood Pearl of Teleportation (evilcraft:blood_pearl_of_teleportation). The items are not consumed by this task."
  ],
  "task.51301209514D7CFB.title": "Obtain 1 × Broom",
  "quest.513011E09F578B29.title": "Obtain 1 × Broom",
  "quest.513011E09F578B29.quest_desc": [
    "Have in your inventory 1 × Broom (evilcraft:broom). The items are not consumed by this task."
  ],
  "task.5130124C18C80741.title": "Obtain 1 × Broom Part",
  "quest.5130118678BB21F0.title": "Obtain 1 × Broom Part",
  "quest.5130118678BB21F0.quest_desc": [
    "Have in your inventory 1 × Broom Part (evilcraft:broom_part). The items are not consumed by this task."
  ],
  "task.51301230F65C621D.title": "Obtain 1 × Exalted Crafter",
  "quest.513011CB5D00E40B.title": "Obtain 1 × Exalted Crafter",
  "quest.513011CB5D00E40B.quest_desc": [
    "The Exalted Crafter opens a manual crafting grid from your inventory and provides internal storage. Use it on expeditions to process resources without placing a crafting table.",
    "It is a portable interface for your own crafting actions; it does not execute production orders on its own. Continuous component production at the base still needs a separate autocrafting system."
  ],
  "task.513012BAFCE72DA6.title": "Obtain 1 × Empowered Exalted Crafter",
  "quest.513011A9DC3370F8.title": "Obtain 1 × Empowered Exalted Crafter",
  "quest.513011A9DC3370F8.quest_desc": [
