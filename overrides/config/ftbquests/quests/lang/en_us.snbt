  "task.513012AC74FE651E.title": "Obtain 1 × Ambrosium Shard",
  "quest.513011BE0B81B33E.title": "Obtain 1 × Ambrosium Shard",
  "quest.513011BE0B81B33E.quest_desc": [
    "Ambrosium Shards fuel the Altar. Reserve some of your first stock for enchanting Gravitite Ore so you can obtain the Enchanted Gravitite needed by the Dimensional Matrix.",
    "The shards can also provide lighting or be eaten for a small heal. Divide your stock before a long expedition so those uses do not leave the Altar without fuel."
  ],
  "task.513012A277293496.title": "Obtain 1 × Ambrosium Torch",
  "quest.51301113EB45CA6C.title": "Obtain 1 × Ambrosium Torch",
  "quest.51301113EB45CA6C.quest_desc": [
    "Have in your inventory 1 × Ambrosium Torch (aether:ambrosium_torch). The items are not consumed by this task."
  ],
  "task.513012D746F46A4B.title": "Obtain 1 × Zanite Gemstone",
