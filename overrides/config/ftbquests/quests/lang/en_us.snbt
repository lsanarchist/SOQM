  "chapter.513010ECFFE74169.title": "19 · Twilight Forest Progression",
  "chapter.513010ECFFE74169.chapter_subtitle": [
    "60 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.513012F8D33900C1.title": "Twilight Forest",
  "quest.513011BD18533AD4.title": "Twilight Forest",
  "quest.513011BD18533AD4.quest_desc": [
    "Earn the native advancement Twilight Forest (twilightforest:root). Follow its requirement in the Advancements screen or the mod's guide."
  ],
