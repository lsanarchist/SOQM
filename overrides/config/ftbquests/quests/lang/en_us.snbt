  ],
  "task.5130122EFEF45736.title": "Obtain 4 × Networked Storage Pipe",
  "quest.5130115F8FB3D3A3.title": "Obtain 4 × Networked Storage Pipe",
  "quest.5130115F8FB3D3A3.quest_desc": [
    "Have in your inventory 4 × Networked Storage Pipe (classicpipes:storage_pipe). The items are not consumed by this task."
  ],
  "task.5130128C353D961A.title": "Obtain 4 × Networked Routing Pipe",
  "quest.513011F06AEBF446.title": "Obtain 4 × Networked Routing Pipe",
  "quest.513011F06AEBF446.quest_desc": [
    "Have in your inventory 4 × Networked Routing Pipe (classicpipes:routing_pipe). The items are not consumed by this task."
  ],
  "task.513012F68C8B6E9D.title": "Obtain 1 × Ender Chest",
  "quest.51301104CFA9A015.title": "Obtain 1 × Ender Chest",
  "quest.51301104CFA9A015.quest_desc": [
    "An EnderStorage Ender Chest provides an item channel between distant locations. Set the same three-colour combination on both chests and confirm shared contents with one inexpensive item.",
    "Add extraction at the receiving end for a continuous stream. The shared channel has finite inventory and fills if the second chest is not unloaded. Before sending valuables, also check who else uses that channel."
  ],
  "task.51301213275BD204.title": "Obtain 1 × Ender Tank",
  "quest.5130114BF0614A92.title": "Obtain 1 × Ender Tank",
  "quest.5130114BF0614A92.quest_desc": [
    "An Ender Tank transfers fluid between tanks sharing a colour channel. Configure the pair, insert a small amount of the intended fluid and check it at the other end.",
    "Use fluid pipes and provide extraction at the destination. An occupied channel is not a mixer for independent fluids; give water, fuel and other lines separate channels."
  ],
  "task.5130124EA06CC13F.title": "Obtain 1 × Trash Can",
  "quest.51301111F4AEB3F2.title": "Obtain 1 × Trash Can",
  "quest.51301111F4AEB3F2.quest_desc": [
    "The Trash Can permanently removes unwanted items. Put it at the end of a dedicated waste branch after separating resources you want to keep.",
    "Test the filtering with an inexpensive sample and retain a storage route for useful items. A Trash Can is not an overflow buffer whose contents can be retrieved later."
  ],
  "task.513012B9482BB243.title": "Obtain 1 × Fluid Trash Can",
  "quest.5130113EBB472FCC.title": "Obtain 1 × Fluid Trash Can",
  "quest.5130113EBB472FCC.quest_desc": [
