  "quest.513011520EA4011A.quest_subtitle": "Stage 4 · Mod development",
  "quest.513011520EA4011A.quest_desc": [
    "Have in your inventory 1 × Enchantment Extractor (industrialforegoing:enchantment_extractor). The items are not consumed by this task.",
    "Have in your inventory 1 × Enchantment Library (apothic_enchanting:library). The items are not consumed by this task.",
