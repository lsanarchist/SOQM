  "quest.51301108B9C415A1.quest_desc": [
    "Have in your inventory 1 × Advanced Fluid Tank (mekanism:advanced_fluid_tank). The items are not consumed by this task."
  ],
  "task.5130126A678011EA.title": "Obtain 1 × Elite Fluid Tank",
  "quest.513011EFCFF5F40C.title": "Obtain 1 × Elite Fluid Tank",
  "quest.513011EFCFF5F40C.quest_desc": [
    "Have in your inventory 1 × Elite Fluid Tank (mekanism:elite_fluid_tank). The items are not consumed by this task."
  ],
  "task.51301247E65EEFA7.title": "Obtain 1 × Solar Generator",
  "quest.51301167B744DDDA.title": "Obtain 1 × Solar Generator",
  "quest.51301167B744DDDA.quest_desc": [
    "Have in your inventory 1 × Solar Generator (mekanismgenerators:solar_generator). The items are not consumed by this task."
  ],
  "task.514D12A85AD34F67.title": "Obtain 1 × Chemical Infuser",
  "task.514D126B737F8A8A.title": "Obtain 1 × Chemical Injection Chamber",
  "quest.514D110A613D8197.title": "Hydrogen chloride for injection",
  "quest.514D110A613D8197.quest_desc": [
    "The Chemical Infuser prepares the reagent for the Chemical Injection Chamber. Supply hydrogen chloride for the ore line, then route the output through purification, crushing, enrichment and smelting. Keep the upstream fluid and chemical inputs separate."
  ],
  "task.5130121F5E3B725F.title": "Obtain 1 × Elite Control Circuit",
  "quest.5130113316FAEC33.title": "Obtain 1 × Elite Control Circuit",
  "quest.5130113316FAEC33.quest_desc": [
    "Have in your inventory 1 × Elite Control Circuit (mekanism:elite_control_circuit). The items are not consumed by this task."
  ],
  "task.514D1230C9D2FD28.title": "Obtain 1 × Digital Miner",
  "quest.514D11AB5959BBF5.title": "Digital Miner: filter and output",
  "quest.514D11AB5959BBF5.quest_desc": [
    "Configure the Digital Miner's area and filter, check its FE demand and reserve an output path. Crafting consumes the components listed in JEI; the side advancement for summoning a Robit is not an additional crafting requirement."
  ],
  "task.513012C88FFBC84F.title": "A New Best Friend!",
  "quest.5130114EF06D538C.title": "Robit: summon the helper",
  "quest.5130114EF06D538C.quest_desc": [
    "This native advancement checks a Robit being summoned in the world, beyond holding its item. Use its placement interaction to complete this optional workshop branch."
  ],
  "task.513012D1BF905A59.title": "Just Vibing",
  "quest.513011C9A6E69BED.title": "Just Vibing",
  "quest.513011C9A6E69BED.quest_desc": [
    "Earn the native advancement Just Vibing (mekanism:seismic_vibrations). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.515012A1B31EFB87.title": "1 × Teleporter — not consumed",
  "task.5150128C0968F2B9.title": "9 × Teleporter Frame — not consumed",
  "task.51301212E190FDF4.title": "Speedy Thing Goes In, Speedy Thing Comes Out",
  "quest.513011C1277D6FAE.title": "A working teleporter",
  "quest.513011C1277D6FAE.quest_desc": [
    "One portal uses a Teleporter at the bottom centre and nine Teleporter Frames around a vertical 1×2 opening, forming a 3×4 outline.",
    "This kit builds one endpoint. Two fixed endpoints require a second frame, power and the same frequency; a Portable Teleporter can serve as the other endpoint. The native teleport-use check is retained.",
    "The tasks check each material and quantity without consuming it. Hold the kit before placing it, then complete the separate formation or operation check where this quest has one."
  ],
  "task.513012382205502A.title": "Obtain 1 × Combiner",
  "quest.513011A31908F578.title": "Obtain 1 × Combiner",
  "quest.513011A31908F578.quest_desc": [
    "Have in your inventory 1 × Combiner (mekanism:combiner). The items are not consumed by this task."
  ],
  "task.51301224BC4F62C7.title": "Obtain 1 × Basic Combining Factory",
  "quest.51301187E5D1F22E.title": "Obtain 1 × Basic Combining Factory",
  "quest.51301187E5D1F22E.quest_desc": [
    "Have in your inventory 1 × Basic Combining Factory (mekanism:basic_combining_factory). The items are not consumed by this task."
  ],
  "task.5130122731D5821C.title": "Obtain 1 × Basic Injecting Factory",
  "quest.513011E2F7F7383A.title": "Obtain 1 × Basic Injecting Factory",
  "quest.513011E2F7F7383A.quest_desc": [
    "Have in your inventory 1 × Basic Injecting Factory (mekanism:basic_injecting_factory). The items are not consumed by this task."
  ],
  "task.51301252C3CBE461.title": "Obtain 4 × Ultimate Universal Cable",
  "quest.513011FC2150E9F6.title": "Obtain 4 × Ultimate Universal Cable",
  "quest.513011FC2150E9F6.quest_desc": [
    "Have in your inventory 4 × Ultimate Universal Cable (mekanism:ultimate_universal_cable). The items are not consumed by this task."
  ],
  "task.513012E8585AC0E7.title": "Obtain 4 × Ultimate Logistical Transporter",
  "quest.5130110429A8D512.title": "Obtain 4 × Ultimate Logistical Transporter",
  "quest.5130110429A8D512.quest_desc": [
    "Have in your inventory 4 × Ultimate Logistical Transporter (mekanism:ultimate_logistical_transporter). The items are not consumed by this task."
  ],
  "task.5130124EFD9EDD08.title": "Obtain 1 × Ultimate Energy Cube",
  "quest.513011D2DC7B4947.title": "Obtain 1 × Ultimate Energy Cube",
  "quest.513011D2DC7B4947.quest_desc": [
    "Have in your inventory 1 × Ultimate Energy Cube (mekanism:ultimate_energy_cube). The items are not consumed by this task."
  ],
  "task.51301244631B824E.title": "Obtain 1 × Elite Bin",
  "quest.513011CEBED48ECD.title": "Obtain 1 × Elite Bin",
  "quest.513011CEBED48ECD.quest_desc": [
    "Have in your inventory 1 × Elite Bin (mekanism:elite_bin). The items are not consumed by this task."
  ],
  "task.513012B06A49E124.title": "Obtain 1 × Ultimate Fluid Tank",
  "quest.5130115863865D83.title": "Obtain 1 × Ultimate Fluid Tank",
  "quest.5130115863865D83.quest_desc": [
    "Have in your inventory 1 × Ultimate Fluid Tank (mekanism:ultimate_fluid_tank). The items are not consumed by this task."
  ],
  "task.513012689B7BF418.title": "Obtain 1 × Atomic Disassembler",
  "quest.513011AB8B3C455F.title": "Obtain 1 × Atomic Disassembler",
  "quest.513011AB8B3C455F.quest_desc": [
    "The Atomic Disassembler is an electric multipurpose tool. Charge it in a compatible energy slot and start in its normal mode; faster modes use more energy.",
    "Check the current mode in the tooltip before working on your base. If enabled, Vein Mining targets connected eligible ore and logs rather than every possible structure; select single-block operation for precise work."
  ],
  "task.5130126854C1D0E9.title": "Obtain 1 × Jetpack",
  "quest.5130110E6A8F75F8.title": "Obtain 1 × Jetpack",
  "quest.5130110E6A8F75F8.quest_desc": [
    "The Jetpack uses hydrogen rather than an electrical cable. Produce Hydrogen in the chemical line, fill the pack through a compatible item-filling slot and equip it in the chest slot.",
    "Check fuel and flight mode close to the ground. An empty pack cannot keep your character airborne, so reserve hydrogen for the return trip and landing."
  ],
  "task.5130120082E03BA0.title": "Obtain 1 × Armored Jetpack",
  "quest.51301145216814C2.title": "Obtain 1 × Armored Jetpack",
  "quest.51301145216814C2.quest_desc": [
    "The Armored Jetpack combines a hydrogen jetpack with armour. Check its fuel after upgrading and equip it in the chest slot; armour materials do not replace Hydrogen.",
    "Make a short control test near the base and check its mode in the tooltip. Armour does not make flight free or remove the need to watch fuel before crossing a drop."
  ],
  "task.51301265756BF9D8.title": "Obtain 1 × Scuba Mask",
  "quest.513011A01B082BDB.title": "Obtain 1 × Scuba Mask",
  "quest.513011A01B082BDB.quest_desc": [
    "The Scuba Mask is the head piece of the diving set. Underwater breathing requires it together with an oxygen-filled Scuba Tank; the mask alone does not provide an air reserve.",
    "Wear the mask on your head, the tank in the chest slot, enable the tank and test in shallow water. Check the tank’s Oxygen before diving rather than the charge in an energy cube."
  ],
  "task.513012A7F1E1A986.title": "Obtain 1 × Scuba Tank",
  "quest.51301180C64BE565.title": "Obtain 1 × Scuba Tank",
  "quest.51301180C64BE565.quest_desc": [
    "The Scuba Tank holds Oxygen for use with a Scuba Mask. Fill it from the oxygen chemical line; the hydrogen used by a Jetpack is not a substitute.",
    "Equip both pieces, enable the tank and test breathing in shallow water. The tank without the mask is not a complete set; keep enough oxygen to return to the surface."
  ],
  "task.513012B0DDE39FA3.title": "Obtain 1 × Free Runners",
  "quest.513011083EFED984.title": "Obtain 1 × Free Runners",
  "quest.513011083EFED984.quest_desc": [
    "Free Runners are powered movement gear that can reduce fall damage. Charge them, equip them in the boots slot and test the active mode on a low step.",
    "Protection depends on stored energy and mode. Completing the item quest does not grant permanent immunity to falls; check the pair you are actually wearing before descending from a height."
  ],
  "task.51301211DF72890E.title": "Obtain 1 × Armored Free Runners",
  "quest.513011076C9C7A8F.title": "Obtain 1 × Armored Free Runners",
  "quest.513011076C9C7A8F.quest_desc": [
    "Armored Free Runners add armour to the Free Runners’ functionality. After upgrading, check charge, equip them as boots and confirm the intended mode is enabled.",
    "Armour and energy-dependent movement features are separate properties. Running out of energy means the more expensive material does not guarantee the same fall protection; recharge first."
  ],
  "task.513012D3EAD7A491.title": "Obtain 1 × Electric Bow",
  "quest.513011A34E3014FA.title": "Obtain 1 × Electric Bow",
  "quest.513011A34E3014FA.quest_desc": [
    "Have in your inventory 1 × Electric Bow (mekanism:electric_bow). The items are not consumed by this task."
  ],
  "task.5130121C4B1E2455.title": "Obtain 1 × Flamethrower",
  "quest.51301124380E82AF.title": "Obtain 1 × Flamethrower",
  "quest.51301124380E82AF.quest_desc": [
    "The Flamethrower uses Hydrogen as fuel. Fill it through a compatible chemical slot and check the mode before firing; an FE cable alone cannot refuel it.",
    "Test it away from storage, conveyors and dropped items. Flame mode changes its interaction with targets, and nearby items can be lost; use a separate test area for workshop experiments."
  ],
  "task.5130128BCAB208D9.title": "Obtain 1 × Gas-Burning Generator",
  "quest.51301151F34C43A4.title": "Ethylene returns as FE",
  "quest.51301151F34C43A4.quest_desc": [
    "The Gas-Burning Generator consumes supported chemical fuel. Feed ethylene from the PRC through a buffer and compare generation with the whole production chain's demand. A blocked hydrogen supply or substrate output also interrupts fuel production."
  ],
  "task.514D1287693A94AB.title": "Obtain 1 × Chemical Dissolution Chamber",
  "quest.514D117ECEE7DB61.title": "Dissolution before washing",
  "quest.514D117ECEE7DB61.quest_desc": [
    "The Chemical Dissolution Chamber starts the full chemical route. Feed the supported ore material and sulfuric acid shown in JEI; route dirty slurry to the Chemical Washer using chemical transport."
  ],
  "task.514D12DC5B0D7AAA.title": "Obtain 1 × Chemical Washer",
  "task.514D1251E4D57E0E.title": "Obtain 1 × Chemical Crystallizer",
  "quest.514D115314DFB698.title": "Slurry → crystals → the existing line",
  "quest.514D115314DFB698.quest_desc": [
    "The Chemical Washer uses water to clean slurry, and the Chemical Crystallizer turns it back into items. Feed those crystals through the Chemical Injection Chamber and the existing purification, crushing, enrichment and smelting line."
  ],
  "task.514D120A586B0922.title": "Obtain 32 × Iron Ingot",
  "task.514D12BDB225F47F.title": "Manual check: Complete the Chemical Processing Line",
  "quest.514D113A135370A8.title": "Check the complete output route",
  "quest.514D113A135370A8.quest_desc": [
    "Trace one batch from the Chemical Dissolution Chamber to finished ingots and inspect every by-product output and reagent supply. This objective retains its item check and manual confirmation; confirm it after your own test, since it does not automatically inspect the entire workshop."
  ],
  "task.5130128CDE3780B3.title": "Obtain 1 × Ultimate Control Circuit",
  "quest.513011F824400CB9.title": "Obtain 1 × Ultimate Control Circuit",
  "quest.513011F824400CB9.quest_desc": [
    "Have in your inventory 1 × Ultimate Control Circuit (mekanism:ultimate_control_circuit). The items are not consumed by this task."
  ],
  "task.5130126C025A51B3.title": "Obtain 1 × Ultimate Bin",
  "quest.513011FD8F59F801.title": "Obtain 1 × Ultimate Bin",
  "quest.513011FD8F59F801.quest_desc": [
    "Have in your inventory 1 × Ultimate Bin (mekanism:ultimate_bin). The items are not consumed by this task."
  ],
  "task.5130120D1FDA9C8B.title": "Obtain 1 × Quantum Entangloporter",
  "quest.51301114CBAD1F77.title": "A quantum link between remote lines",
  "quest.51301114CBAD1F77.quest_desc": [
    "The Quantum Entangloporter transfers supported resources over a shared frequency. Configure access, frequency and sides at both ends. This expands logistics; its recipe does not require a Digital Miner."
  ],
  "task.513012FDDB40B4D6.title": "Obtain 1 × QIO Drive Array",
  "quest.5130116A8EF3B812.title": "QIO: a frequency and its storage",
  "quest.5130116A8EF3B812.quest_desc": [
    "The QIO Drive Array holds storage drives on a selected frequency. Install a drive, configure access and use a QIO Dashboard to work with the items. Its recipe does not require a Quantum Entangloporter, so storage has its own branch."
  ],
  "task.51301228B026D0F3.title": "Obtain 1 × QIO Drive",
  "quest.513011835D892AF4.title": "QIO: the first drive",
  "quest.513011835D892AF4.quest_desc": [
    "Install the base drive in the QIO Drive Array and check both item capacity and type capacity. The next three nodes expand the same storage rather than replacing its frequency and access setup."
  ],
  "task.513012BEC17311FC.title": "Obtain 1 × Hyper-Dense QIO Drive",
  "quest.5130112203442BAE.title": "Obtain 1 × Hyper-Dense QIO Drive",
  "quest.5130112203442BAE.quest_desc": [
    "Have in your inventory 1 × Hyper-Dense QIO Drive (mekanism:qio_drive_hyper_dense). The items are not consumed by this task."
  ],
  "task.513012286E384494.title": "Obtain 1 × Time-Dilating QIO Drive",
  "quest.513011C1C75B6080.title": "Obtain 1 × Time-Dilating QIO Drive",
  "quest.513011C1C75B6080.quest_desc": [
    "Have in your inventory 1 × Time-Dilating QIO Drive (mekanism:qio_drive_time_dilating). The items are not consumed by this task."
  ],
  "task.513012A94756104D.title": "Obtain 1 × Supermassive QIO Drive",
  "quest.5130119895187FB1.title": "Obtain 1 × Supermassive QIO Drive",
  "quest.5130119895187FB1.quest_desc": [
    "Have in your inventory 1 × Supermassive QIO Drive (mekanism:qio_drive_supermassive). The items are not consumed by this task."
  ],
