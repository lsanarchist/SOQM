  "task.5140123EE612773C.title": "Recover Your Grave",
  "quest.5140112E15CD6067.title": "Recover Your Grave",
  "quest.5140112E15CD6067.quest_subtitle": "Stage 1 · Optional branch",
  "quest.5140112E15CD6067.quest_desc": [
    "Successfully reclaim your OWN YIGD grave through the mod's normal interaction. Finding a grave, an unsuccessful attempt or another player's grave does not count. This is optional after a death; do not die deliberately for it."
  ],
