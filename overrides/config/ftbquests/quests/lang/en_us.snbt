  "quest.5130116BBA1515FF.quest_desc": [
    "Have in your inventory 1 × Manaweave Cowl (botania:manaweave_helmet). The items are not consumed by this task.",
    "Have in your inventory 1 × Manaweave Robe Top (botania:manaweave_chestplate). The items are not consumed by this task.",
    "Have in your inventory 1 × Manaweave Robe Bottom (botania:manaweave_leggings). The items are not consumed by this task.",
    "Have in your inventory 1 × Manaweave Boots (botania:manaweave_boots). The items are not consumed by this task."
  ],
  "task.51301283DE771DC2.title": "Obtain 1 × Terrasteel Helmet",
  "task.5130122162EC6EB9.title": "Obtain 1 × Terrasteel Chestplate",
  "task.513012A8F72FD0DF.title": "Obtain 1 × Terrasteel Leggings",
  "task.51301288B6493108.title": "Obtain 1 × Terrasteel Boots",
