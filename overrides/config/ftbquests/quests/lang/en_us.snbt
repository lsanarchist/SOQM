  "quest.51401114099D7F18.title": "Skill Points for Antimatter",
  "quest.51401114099D7F18.quest_desc": [
    "Obtain Antimatter Pellet for its one-time two-point Pufferfish's Skills bonus. It is tied to the player and material: moving it repeatedly, relogging or farming normal XP does not grant extra bonuses."
  ],
