  "task.51301299894BB1A3.title": "Obtain 1 × Enchantment Library",
  "task.513012120A1AE5D7.title": "Obtain 1 × Reforging Table",
  "quest.513011520EA4011A.title": "Obtain 1 × Enchantment Extractor + Obtain 1 × Enchantment Library + More",
  "quest.513011520EA4011A.quest_desc": [
    "Have in your inventory 1 × Enchantment Extractor (industrialforegoing:enchantment_extractor). The items are not consumed by this task.",
    "Have in your inventory 1 × Enchantment Library (apothic_enchanting:library). The items are not consumed by this task.",
    "Have in your inventory 1 × Reforging Table (apotheosis:reforging_table). The items are not consumed by this task."
  ],
  "task.513012140C9A4F12.title": "Obtain 1 × Mythic Circuit",
  "quest.513011AEA75E4401.title": "Mythic Circuit",
  "quest.513011AEA75E4401.quest_desc": [
    "The fifth milestone depends on Mortum Chunk, Gaia Ingot, Ultimate Control Circuit and Stellar Alloy: material results from several developed branches.",
    "Two circuits cost 4 Mortum Chunk, 2 Ultimate Control Circuit, 2 Gaia Ingot and 1 Stellar Alloy. Your team must first actually manufacture the circuit. It can then appear in masterwork packs from reward level 5; random rewards cannot replace that first craft.",
    "Next comes EMC Core. Prepare Antimatter Pellet through the SPS in chapter 08 and obtain Calorite Ingot in the space branch. Gaia Ingot is also part of the core recipe."
  ],
  "task.513012CF6AC58AD6.title": "Obtain 4 × Mortum Chunk",
  "task.51301241607AA5AA.title": "Obtain 2 × Gaia Spirit Ingot",
  "task.5130126AB2204EF7.title": "Obtain 2 × Ultimate Control Circuit",
  "task.513012DA6610187D.title": "Obtain 1 × Mythic Circuit",
  "quest.513011530925ED63.title": "Obtain 4 × Mortum Chunk + Obtain 2 × Gaia Spirit Ingot + More",
  "quest.513011530925ED63.quest_desc": [
    "Have in your inventory 4 × Mortum Chunk (divinerpg:mortum_chunk). The items are not consumed by this task.",
    "Have in your inventory 2 × Gaia Spirit Ingot (botania:gaia_ingot). The items are not consumed by this task.",
    "Have in your inventory 2 × Ultimate Control Circuit (mekanism:ultimate_control_circuit). The items are not consumed by this task.",
    "Have in your inventory 1 × Mythic Circuit (kubejs:mythic_circuit). The items are not consumed by this task."
  ],
  "task.513012D5921C6058.title": "Obtain 1 × Fusion Reactor Controller",
  "task.51301291D89A0FB4.title": "Obtain 1 × Supercharged Coil",
  "task.513012430592B54C.title": "Obtain 1 × Ultimate Induction Provider",
  "quest.513011F01C60EF3B.title": "Obtain 1 × Fusion Reactor Controller + Obtain 1 × Supercharged Coil + More",
  "quest.513011F01C60EF3B.quest_desc": [
