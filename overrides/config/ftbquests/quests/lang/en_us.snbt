  "chapter.5130109B1CEC5FBE.title": "04 · Pipes, Oil and Construction Machines",
  "chapter.5130109B1CEC5FBE.chapter_subtitle": [
    "45 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.513012FA6F35CDA5.title": "Obtain 1 × Wood Gear",
  "quest.5130114AA5F094DC.title": "Obtain 1 × Wood Gear",
  "quest.5130114AA5F094DC.quest_desc": [
    "The Wooden Gear begins BuildCraft’s component ladder. Higher gears consume the previous tier, so plan materials for the entire chain required by your next machine.",
    "Make a few basic gears, but do not upgrade every one to the highest tier: simple devices still need lower tiers. Obtaining the gear completes this item quest; it is not a block to install."
  ],
  "task.51301225F3DCDB44.title": "Obtain 1 × Stone Gear",
  "quest.513011FB776B4942.title": "Obtain 1 × Stone Gear",
  "quest.513011FB776B4942.quest_desc": [
    "Have in your inventory 1 × Stone Gear (buildcraftcore:gears/gear_stone). The items are not consumed by this task."
  ],
  "task.513012F6A758F6F9.title": "Obtain 1 × Wrench",
  "quest.5130115FD8A3F016.title": "Obtain 1 × Wrench",
  "quest.5130115FD8A3F016.quest_desc": [
    "The BuildCraft Wrench rotates supported machines and configures directional pipes. On an engine, it selects which consumer the moving output end faces.",
    "Recheck direction after moving an engine or Iron Transport Pipe. Adjacent blocks are not necessarily connected through the intended energy or item output."
  ],
  "task.513012200EB6D284.title": "Obtain 1 × Iron Gear",
  "quest.513011A98374EB5C.title": "Obtain 1 × Iron Gear",
  "quest.513011A98374EB5C.quest_desc": [
    "Have in your inventory 1 × Iron Gear (buildcraftcore:gears/gear_iron). The items are not consumed by this task."
  ],
  "task.513012308E7E643F.title": "Obtain 1 × Gold Gear",
  "quest.5130116038067DBB.title": "Obtain 1 × Gold Gear",
  "quest.5130116038067DBB.quest_desc": [
    "Have in your inventory 1 × Gold Gear (buildcraftcore:gears/gear_gold). The items are not consumed by this task."
  ],
  "task.513012A2C05C70EE.title": "Obtain 1 × Diamond Gear",
  "quest.5130111C5CB00C7E.title": "Obtain 1 × Diamond Gear",
  "quest.5130111C5CB00C7E.quest_desc": [
    "Have in your inventory 1 × Diamond Gear (buildcraftcore:gears/gear_diamond). The items are not consumed by this task."
  ],
  "task.5130129FFF06E167.title": "Obtain 1 × Redstone Engine",
  "quest.513011C8C810039F.title": "Obtain 1 × Redstone Engine",
  "quest.513011C8C810039F.quest_desc": [
    "The Redstone Engine suits small consumers such as extraction through a Wooden Pipe. Place its moving end against the device, rotate it with the wrench if needed, and apply a redstone signal.",
    "It needs no fuel but provides very little power. It cannot feed a Kinesis/Power Pipe network as a normal generator, so use a stronger MJ source for a quarry or lasers."
  ],
  "task.51301274E88CCD41.title": "Obtain 1 × Wood Item",
  "quest.513011999970C751.title": "Obtain 1 × Wood Item",
  "quest.513011999970C751.quest_desc": [
    "A Wooden Transport Pipe actively extracts items from a chest or machine. Connect its solid side to the source and clear sides to the transport line; supply MJ pulses, for example from a Redstone Engine, to extract.",
    "Test the route to a receiver with a few inexpensive items first. Extracted cargo can drop onto the ground when it has nowhere to go; continuous extractor power does not replace a free output."
  ],
  "task.5130121F7A01A039.title": "Obtain 1 × Cobblestone Item",
  "quest.5130119763A54171.title": "Obtain 1 × Cobblestone Item",
  "quest.5130119763A54171.quest_desc": [
    "Have in your inventory 1 × Cobblestone Item (buildcrafttransport:cobblestone_item). The items are not consumed by this task."
  ],
  "task.5130122C53E545E8.title": "Obtain 1 × Stone Item",
  "quest.513011DCEB266BE1.title": "Obtain 1 × Stone Item",
  "quest.513011DCEB266BE1.quest_desc": [
    "A Stone Transport Pipe carries items already inserted into it. A source chest needs an extractor, while machines with automatic output can insert directly.",
    "Stone and Cobblestone Transport Pipes do not connect to one another, which helps keep adjacent lines separate. Ordinary junctions route items randomly; add a Diamond Pipe when you need defined sorting."
  ],
  "task.513012908587DCB0.title": "Obtain 1 × Iron Item",
  "quest.513011B9C9D49A87.title": "Obtain 1 × Iron Item",
  "quest.513011B9C9D49A87.quest_desc": [
    "An Iron Transport Pipe directs cargo toward one chosen output. Items enter through solid sides and leave through the clear side; use the wrench on the side you want as the output.",
    "This controls direction rather than item type. An ordinary redstone signal does not rotate the pipe. Test a small batch after reconfiguration to avoid creating a dead end in the line."
  ],
  "task.51301235AECBF52B.title": "Obtain 1 × Gold Item",
  "quest.513011E5F8EB39CE.title": "Obtain 1 × Gold Item",
  "quest.513011E5F8EB39CE.quest_desc": [
    "Have in your inventory 1 × Gold Item (buildcrafttransport:gold_item). The items are not consumed by this task."
  ],
  "task.5130126DFA5F34E8.title": "Obtain 1 × Diamond Item",
  "quest.5130118B3D1599E2.title": "Obtain 1 × Diamond Item",
  "quest.5130118B3D1599E2.quest_desc": [
    "A Diamond Transport Pipe sorts items through its coloured sides. Open its interface and add a sample to the row matching the desired receiver’s side.",
    "Filtered routes take priority, while an unfiltered side can accept other items. Leave that general outlet intentionally and check receiver capacity: the pipe does not guarantee cargo retention when every route is blocked."
  ],
  "task.513012DA637D5657.title": "Obtain 1 × Obsidian Item",
  "quest.5130113F5BC34CE0.title": "Obtain 1 × Obsidian Item",
  "quest.5130113F5BC34CE0.quest_desc": [
    "Have in your inventory 1 × Obsidian Item (buildcrafttransport:obsidian_item). The items are not consumed by this task."
  ],
  "task.5130126EADF8DC29.title": "Obtain 1 × Clay Item",
  "quest.513011F8B585B2C8.title": "Obtain 1 × Clay Item",
  "quest.513011F8B585B2C8.quest_desc": [
    "A Clay Transport Pipe first tries to insert cargo into adjacent inventories before sending it onward through pipes. It works well as a restocking point along a longer line.",
    "Attach the intended chest and provide a deliberate onward route. Inventory priority is not an item filter; arrange sorting before the Clay Pipe when only particular items should arrive."
  ],
  "task.5130122CA5DFAA48.title": "Obtain 1 × Sandstone Item",
  "quest.5130119D1FB733CC.title": "Obtain 1 × Sandstone Item",
  "quest.5130119D1FB733CC.quest_desc": [
    "Have in your inventory 1 × Sandstone Item (buildcrafttransport:sandstone_item). The items are not consumed by this task."
  ],
  "task.51301233BC716FE2.title": "Obtain 1 × Lapis Item",
  "quest.5130115869CE138E.title": "Obtain 1 × Lapis Item",
  "quest.5130115869CE138E.quest_desc": [
    "Have in your inventory 1 × Lapis Item (buildcrafttransport:lapis_item). The items are not consumed by this task."
  ],
  "task.513012FEE86B4449.title": "Obtain 1 × Emzuli Item",
  "quest.513011A0AB1D9390.title": "Obtain 1 × Emzuli Item",
  "quest.513011A0AB1D9390.quest_desc": [
    "Have in your inventory 1 × Emzuli Item (buildcrafttransport:emzuli_item). The items are not consumed by this task."
  ],
  "task.5130123CFE192DBA.title": "Obtain 1 × Daizuli Item",
  "quest.5130115A8BF8C3F6.title": "Obtain 1 × Daizuli Item",
  "quest.5130115A8BF8C3F6.quest_desc": [
    "Have in your inventory 1 × Daizuli Item (buildcrafttransport:daizuli_item). The items are not consumed by this task."
  ],
  "task.513012AA6ED793EE.title": "Obtain 1 × Wood Fluid",
  "quest.5130116E0F6E97FC.title": "Obtain 1 × Wood Fluid",
  "quest.5130116E0F6E97FC.quest_desc": [
    "A Wooden Fluid Pipe extracts fluid from a tank when supplied with MJ. Attach its solid side to the source, then connect fluid pipes and an empty receiving tank.",
    "This is fluid transport: water containers do not travel through it as item stacks. Keep different fluid lines separate instead of joining them at an accidental junction; start with one source and one receiver."
  ],
  "task.513012A0E88EC22C.title": "Obtain 1 × Stone Fluid",
  "quest.5130119FB8DBD6C5.title": "Obtain 1 × Stone Fluid",
  "quest.5130119FB8DBD6C5.quest_desc": [
    "Have in your inventory 1 × Stone Fluid (buildcrafttransport:stone_fluid). The items are not consumed by this task."
  ],
  "task.5130122BB11D9D97.title": "Obtain 1 × Iron Fluid",
  "quest.513011DC075F3141.title": "Obtain 1 × Iron Fluid",
  "quest.513011DC075F3141.quest_desc": [
    "Have in your inventory 1 × Iron Fluid (buildcrafttransport:iron_fluid). The items are not consumed by this task."
  ],
  "task.5130120442AA0DED.title": "Obtain 1 × Gold Fluid",
  "quest.51301174CFCD2C10.title": "Obtain 1 × Gold Fluid",
  "quest.51301174CFCD2C10.quest_desc": [
    "Have in your inventory 1 × Gold Fluid (buildcrafttransport:gold_fluid). The items are not consumed by this task."
  ],
  "task.5130122BACBC30EA.title": "Obtain 1 × Filler",
  "quest.5130115E57F332AA.title": "Obtain 1 × Filler",
  "quest.5130115E57F332AA.quest_desc": [
    "Have in your inventory 1 × Filler (buildcraftbuilders:filler). The items are not consumed by this task."
  ],
  "task.513012FBF4F036A8.title": "Obtain 1 × Builder",
  "quest.51301186157E64CB.title": "Obtain 1 × Builder",
  "quest.51301186157E64CB.quest_desc": [
    "Have in your inventory 1 × Builder (buildcraftbuilders:builder). The items are not consumed by this task."
  ],
  "task.513012BAA556EB65.title": "Obtain 1 × Blueprint",
  "quest.5130111D410F4BCD.title": "Obtain 1 × Blueprint",
  "quest.5130111D410F4BCD.quest_desc": [
    "Have in your inventory 1 × Blueprint (buildcraftbuilders:blueprint). The items are not consumed by this task."
  ],
  "task.513012182593FBDB.title": "Obtain 1 × Architect Table",
  "quest.513011B3504FA0C8.title": "Obtain 1 × Architect Table",
  "quest.513011B3504FA0C8.quest_desc": [
    "Have in your inventory 1 × Architect Table (buildcraftbuilders:architect). The items are not consumed by this task."
  ],
  "task.5130121E2079E2F4.title": "Obtain 1 × Template",
  "quest.513011C1C22AD699.title": "Obtain 1 × Template",
  "quest.513011C1C22AD699.quest_desc": [
    "Have in your inventory 1 × Template (buildcraftbuilders:template). The items are not consumed by this task."
  ],
  "task.513012D8E422E892.title": "Obtain 1 × Electronic Library",
  "quest.5130112E6226E0BE.title": "Obtain 1 × Electronic Library",
  "quest.5130112E6226E0BE.quest_desc": [
    "Have in your inventory 1 × Electronic Library (buildcraftbuilders:library). The items are not consumed by this task."
  ],
  "task.513012E09D50266F.title": "Obtain 1 × Tank",
  "quest.513011275870D7CE.title": "Obtain 1 × Tank",
  "quest.513011275870D7CE.quest_desc": [
    "Have in your inventory 1 × Tank (buildcraftfactory:tank). The items are not consumed by this task."
  ],
  "task.5130125F78A1C69F.title": "Obtain 1 × Pump",
  "quest.51301168BF025126.title": "Obtain 1 × Pump",
  "quest.51301168BF025126.quest_desc": [
    "The BuildCraft Pump collects fluid below itself and offers it to adjacent tanks or pipes. Place it above the fluid body, supply MJ and provide free receiver capacity.",
    "Its SOQM recipe already requires a Precision Mechanism. A redstone signal pauses the pump. Water remaining in place does not by itself indicate a fault: renewable-source behaviour depends on the pump configuration."
  ],
  "task.5130126DA306FB4D.title": "Obtain 1 × Mining Well",
  "quest.513011BC32A0EF47.title": "Obtain 1 × Mining Well",
  "quest.513011BC32A0EF47.quest_desc": [
    "Have in your inventory 1 × Mining Well (buildcraftfactory:mining_well). The items are not consumed by this task."
  ],
  "task.5130124749877BB2.title": "Obtain 1 × Distiller",
  "quest.51301128435B885E.title": "Obtain 1 × Distiller",
  "quest.51301128435B885E.quest_desc": [
    "Have in your inventory 1 × Distiller (buildcraftfactory:distiller). The items are not consumed by this task."
  ],
  "task.5130124B7DD84947.title": "Obtain 1 × Heat Exchanger",
  "quest.513011D73BA114A4.title": "Obtain 1 × Heat Exchanger",
  "quest.513011D73BA114A4.quest_desc": [
    "Have in your inventory 1 × Heat Exchanger (buildcraftfactory:heat_exchange). The items are not consumed by this task."
  ],
  "task.513012027E7B17FC.title": "Obtain 1 × Auto Workbench",
  "quest.513011B509AE9A20.title": "Obtain 1 × Auto Workbench",
  "quest.513011B509AE9A20.quest_desc": [
    "The Auto Workbench remembers a craft and repeats it using materials in its own inventory. Configure the phantom recipe, then supply real ingredients and arrange result extraction.",
    "This version can work slowly on its own; external MJ speeds it up. Establish reliable inputs first: extra power cannot fix one missing component or a blocked output."
  ],
  "task.51301254B111856D.title": "Obtain 1 × Quarry",
  "quest.513011732D8F780E.title": "Obtain 1 × Quarry",
  "quest.513011732D8F780E.quest_desc": [
    "The Quarry builds a frame and mines the selected area. Connect Land Marks for the intended plot, place the quarry beside them and check the future frame position before starting; invalid markers lead to a default area.",
    "Remove valuables from the frame line because clearing it can destroy obstructions without drops. Supply MJ and a large buffer with item extraction. A full output does not stop mining: refused items drop beside the quarry."
  ],
  "task.513012719F5D764B.title": "Obtain 1 × Laser",
  "quest.5130111A90908B6C.title": "Obtain 1 × Laser",
  "quest.5130111A90908B6C.quest_desc": [
    "A Laser converts MJ into power for compatible BuildCraft tables. Place it within six blocks of an Assembly Table or another supported table and supply MJ to the laser itself.",
    "Its beam appears when a table requests energy for a selected recipe. If it stays idle, check the recipe, ingredients and power first; more lasers help only when the table actually needs additional throughput."
  ],
  "task.5130127AE71D7D9A.title": "Obtain 1 × Assembly Table",
  "quest.513011A7C9201F3C.title": "Obtain 1 × Assembly Table",
  "quest.513011A7C9201F3C.quest_desc": [
    "The Assembly Table makes chipsets and other BuildCraft components using laser power. Insert the ingredients, select the required available recipe, and power a nearby Laser.",
    "Enable only one recipe for the first run. Several selected recipes can alternate and consume shared ingredients, so also provide room for the output in the table or an adjacent receiver."
  ],
  "task.5130125B60087D84.title": "Obtain 1 × Redstone Chipset Red",
  "quest.513011D8A723B6B2.title": "Obtain 1 × Redstone Chipset Red",
  "quest.513011D8A723B6B2.quest_desc": [
    "Have in your inventory 1 × Redstone Chipset Red (buildcraftsilicon:redstone_chipset/red). The items are not consumed by this task."
  ],
