  "task.513012140C9A4F12.title": "Obtain 1 × Mythic Circuit",
  "quest.513011AEA75E4401.title": "Mythic Circuit",
  "quest.513011AEA75E4401.quest_subtitle": "Stage 5 · Main route",
  "quest.513011AEA75E4401.quest_desc": [
    "The fifth milestone depends on Mortum Chunk, Gaia Ingot, Ultimate Control Circuit and Stellar Alloy: material results from several developed branches.",
    "Two circuits cost 4 Mortum Chunk, 2 Ultimate Control Circuit, 2 Gaia Ingot and 1 Stellar Alloy. Late recipes consume this circuit; ordinary random rewards do not supply it.",
    "Next comes EMC Core. Prepare Antimatter Pellet through the SPS in chapter 08 and obtain Calorite Ingot in the space branch. Gaia Ingot is also part of the core recipe."
  ],
  "task.513012CF6AC58AD6.title": "Obtain 4 × Mortum Chunk",
  "task.51301241607AA5AA.title": "Obtain 2 × Gaia Spirit Ingot",
  "task.5130126AB2204EF7.title": "Obtain 2 × Ultimate Control Circuit",
  "task.513012DA6610187D.title": "Obtain 1 × Mythic Circuit",
