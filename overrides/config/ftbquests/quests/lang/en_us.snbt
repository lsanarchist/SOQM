  "quest.513011530925ED63.quest_desc": [
    "Have in your inventory 4 × Mortum Chunk (divinerpg:mortum_chunk). The items are not consumed by this task.",
    "Have in your inventory 2 × Gaia Spirit Ingot (botania:gaia_ingot). The items are not consumed by this task.",
    "Have in your inventory 2 × Ultimate Control Circuit (mekanism:ultimate_control_circuit). The items are not consumed by this task.",
    "Have in your inventory 1 × Mythic Circuit (kubejs:mythic_circuit). The items are not consumed by this task."
  ],
  "task.513012D5921C6058.title": "Obtain 1 × Fusion Reactor Controller",
  "task.51301291D89A0FB4.title": "Obtain 1 × Supercharged Coil",
