  ],
  "task.513012F00322A8E0.title": "Obtain 1 × World Breaker",
  "quest.513011D673A634F6.title": "Obtain 1 × World Breaker",
  "quest.513011D673A634F6.quest_desc": [
    "Have in your inventory 1 × World Breaker (avaritia:infinity_pickaxe). The items are not consumed by this task."
  ],
  "task.513012FCD56E217D.title": "Obtain 1 × Sword of the Cosmos",
  "quest.51301150A4E4DACB.title": "Obtain 1 × Sword of the Cosmos",
  "quest.51301150A4E4DACB.quest_desc": [
    "Have in your inventory 1 × Sword of the Cosmos (avaritia:infinity_sword). The items are not consumed by this task."
  ],
  "task.513012A1B22FD38C.title": "Obtain 1 × Longbow of the Heavens",
  "quest.51301114CA58ED57.title": "Obtain 1 × Longbow of the Heavens",
  "quest.51301114CA58ED57.quest_desc": [
    "Have in your inventory 1 × Longbow of the Heavens (avaritia:infinity_bow). The items are not consumed by this task."
  ],
  "task.5130120C4BADD1F8.title": "Obtain 1 × Crossbow of the Inferno",
  "quest.51301198971E6A0E.title": "Obtain 1 × Crossbow of the Inferno",
  "quest.51301198971E6A0E.quest_desc": [
    "Have in your inventory 1 × Crossbow of the Inferno (avaritia:infinity_crossbow). The items are not consumed by this task."
  ],
  "task.513012AF163FCEAE.title": "Obtain 1 × Infinity Mace",
  "quest.51301148F20F1359.title": "Obtain 1 × Infinity Mace",
  "quest.51301148F20F1359.quest_desc": [
    "Have in your inventory 1 × Infinity Mace (avaritia:infinity_mace). The items are not consumed by this task."
  ],
  "task.513012C231402633.title": "Obtain 1 × Trident of the Sea Abyss",
  "quest.5130113D1C8A846C.title": "Obtain 1 × Trident of the Sea Abyss",
  "quest.5130113D1C8A846C.quest_desc": [
    "Have in your inventory 1 × Trident of the Sea Abyss (avaritia:infinity_trident). The items are not consumed by this task."
  ],
  "task.5130127237C51031.title": "Obtain 1 × Shield of the Earth Core",
  "quest.513011417ED6EDBA.title": "Obtain 1 × Shield of the Earth Core",
  "quest.513011417ED6EDBA.quest_desc": [
    "Have in your inventory 1 × Shield of the Earth Core (avaritia:infinity_shield). The items are not consumed by this task."
  ],
  "task.5130123CF53FC2B5.title": "Obtain 1 × Infinity Elytra",
  "quest.513011562B7C92EA.title": "Obtain 1 × Infinity Elytra",
  "quest.513011562B7C92EA.quest_desc": [
    "Have in your inventory 1 × Infinity Elytra (avaritia:infinity_elytra). The items are not consumed by this task."
  ],
  "task.513012B294B87D1E.title": "Obtain 1 × Infinity Totem",
  "quest.513011DD49D225FB.title": "Obtain 1 × Infinity Totem",
  "quest.513011DD49D225FB.quest_desc": [
    "Have in your inventory 1 × Infinity Totem (avaritia:infinity_totem). The items are not consumed by this task."
  ],
  "task.513012CB84ACCC93.title": "Obtain 1 × Ultimate Stew",
  "quest.513011A57FF0D1B0.title": "Obtain 1 × Ultimate Stew",
  "quest.513011A57FF0D1B0.quest_desc": [
    "SOQM simplifies Ultimate Stew into a production bundle: 4 Golden Carrots, 2 Mana Pearls, 1 Neutron Nugget and 1 Mythic Circuit. Combine them on an Avaritia tier-4 table; ingredient placement is unrestricted.",
    "Take the finished product into your inventory for the quest check before using it. This recipe relies on developed Botania, neutron production and Mythic Circuits without requiring a collection of dozens of separate crops."
  ],
  "task.513012BAEA57B0EB.title": "Obtain 1 × Cosmic Meatballs",
  "quest.513011072188768A.title": "Obtain 1 × Cosmic Meatballs",
  "quest.513011072188768A.quest_desc": [
    "Cosmic Meatballs in this campaign use 4 Cooked Beef, 2 Vibrant Alloy Ingots, 1 Neutron Nugget and 1 Mythic Circuit. This is an Avaritia tier-4 shapeless recipe.",
    "Prepare cooked meat, Ender IO output and late campaign materials. Hold the finished product for the inventory check before using it; the old long list of different raw meats has been replaced."
  ],
