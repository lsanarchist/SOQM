  ],
  "task.513012C50C8C1DFD.title": "Obtain 1 × Golden Parachute",
  "quest.5130119FB3C70221.title": "Obtain 1 × Golden Parachute",
  "quest.5130119FB3C70221.quest_desc": [
    "Craft a Golden Parachute from four Golden Aerclouds in a 2×2 square. It has twenty uses, providing more descents for Aether exploration while still having a finite supply.",
    "Check its remaining uses before a long expedition and keep materials for a replacement. The parachute helps with descent; plan a separate route back up to high islands."
  ],
