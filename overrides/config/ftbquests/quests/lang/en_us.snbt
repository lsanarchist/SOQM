  "task.514D020000000005.title": "Automatic: Put a Modular Pickaxe to Work",
  "quest.514D010000000003.title": "Put a Modular Pickaxe to Work",
  "quest.514D010000000003.quest_subtitle": "Stage 1 · Practice",
  "quest.514D010000000003.quest_desc": [
    "Assemble a valid Modern Foundry pickaxe and use it to successfully break an ordinary Stone block. Its material combination can vary. A stored pickaxe, a hit without breaking and a protected failed attempt do not count. Consult Materials and You for the installed version's assembly and material rules."
  ],
  "task.514D020000000006.title": "Automatic: Complete a Powered Machine Recipe",
  "quest.514D010000000004.title": "Complete a Powered Machine Recipe",
  "quest.514D010000000004.quest_subtitle": "Stage 1 · Practice",
  "quest.514D010000000004.quest_desc": [
    "Power a Mekanism electric machine such as an Energized Smelter, Enrichment Chamber or Crusher and finish at least one actual recipe. Remain within 16 blocks when it finishes. A charged empty machine or blocked output is insufficient."
  ],
  "task.514D020000000007.title": "Obtain 32 × Iron Ingot",
  "task.514D020000000008.title": "Automatic: Smelt 32 Iron Ingots with Power",
  "quest.514D010000000005.title": "Smelt 32 Iron Ingots with Power",
  "quest.514D010000000005.quest_subtitle": "Stage 1 · Practice",
  "quest.514D010000000005.quest_desc": [
    "Have in your inventory 32 × Iron Ingot (minecraft:iron_ingot). The items are not consumed by this task.",
    "Produce a cumulative 32 iron ingots in a Mekanism Energized Smelter. Stay within 16 blocks when operations finish. The team machine counter persists between sessions. The separate item task also requires 32 ingots in your inventory without consumption; inventory presence and machine production are distinct checks."
  ],
  "task.514D020000000009.title": "Manual check: Production without Hand Transfers",
  "quest.514D010000000006.title": "Production without Hand Transfers",
  "quest.514D010000000006.quest_subtitle": "Stage 1 · Practice",
  "quest.514D010000000006.quest_desc": [
    "Manually confirm: feed raw materials from storage into a machine and automatically move its output into other storage. Observe a complete batch producing 32 iron ingots without hand transfers between operations. Compatible transport from any installed mod is allowed. This checkmark does not detect pipes, machines or containers."
  ],
  "task.514D02000000000C.title": "Obtain 1 × Realmite Ingot",
  "quest.514D010000000009.title": "Obtain 1 × Realmite Ingot",
  "quest.514D010000000009.quest_subtitle": "Stage 1 · Mod development",
  "quest.514D010000000009.quest_desc": [
    "Have in your inventory 1 × Realmite Ingot (divinerpg:realmite_ingot). The items are not consumed by this task."
  ],
  "task.514D02000000000D.title": "Defeat 5 × Cave Crawler",
  "quest.514D01000000000A.title": "Defeat 5 × Cave Crawler",
  "quest.514D01000000000A.quest_subtitle": "Stage 1 · Practice",
  "quest.514D01000000000A.quest_desc": [
    "Defeat 5 × Cave Crawler (divinerpg:cave_crawler)."
  ],
  "task.514D02000000000E.title": "Automatic: Mana at the Base",
  "quest.514D01000000000B.title": "Mana at the Base",
  "quest.514D01000000000B.quest_subtitle": "Stage 1 · Practice",
  "quest.514D01000000000B.quest_desc": [
    "Build mana generation, transfer and a normal Botania Revived Mana Pool. Once it contains mana, right-click the pool. The automatic check requires real mana greater than zero; an empty pool or Creative Mana Pool does not qualify."
  ],
  "task.514D02000000000F.title": "Automatic: Ready for Greater Expeditions",
  "quest.514D01000000000C.title": "Ready for Greater Expeditions",
  "quest.514D01000000000C.quest_subtitle": "Stage 1 · Practice",
  "quest.514D01000000000C.quest_desc": [
    "Complete all four introductory routes: automatic production, settlement supply, DivineRPG hunting and first mana. This summary completes from its four dependencies without another manual check. Open Mayhem Cubes away from your base: their pools include dangerous events and structures."
  ],
