  "chapter.513010FE75551C5A.title": "09 · Ender IO: Alloys, Souls and Conduits",
  "chapter.513010FE75551C5A.chapter_subtitle": [
    "Grains and a chassis open the smelter; its alloys feed conduits, machines and circuitry. Autocrafting starts at the Precision Mechanism milestone, while the soul line has its own prerequisites.",
    "56 quests · 8 sequential production sections.",
    "Read top to bottom · hover a quest to see all its connections",
    "Open a quest to inspect all prerequisites, including links to other chapters. Item tasks check inventory; the description explains assembly and a test run."
  ],
  "task.51301299E71F676C.title": "Obtain 1 × Vibrant Alloy Ingot",
  "quest.51301183B8CF29F5.title": "Energetic Alloy → Vibrant Alloy",
  "quest.51301183B8CF29F5.quest_desc": [
    "Process Energetic Alloy with an ender pearl and glowstone. Vibrant Alloy supplies higher conduits, crystals and the later energy buffer, extending the smelting line you already built."
  ],
  "task.51301236CF32BA87.title": "Obtain 1 × Grains of Infinity",
  "quest.513011B5F4763E7A.title": "Grains for the first chassis",
  "quest.513011B5F4763E7A.quest_desc": [
    "Grains of Infinity supply early Ender IO components. Use an available source shown in JEI first. A SAG Mill can later obtain them from Cobbled Deepslate, but it needs these starting components itself and is not a prerequisite for the first grains."
  ],
  "task.513012EDCD7BF304.title": "Obtain 1 × Energetic Alloy Ingot",
  "quest.513011AC2178359B.title": "Conductive Alloy → Energetic Alloy",
  "quest.513011AC2178359B.quest_desc": [
    "Add gold and redstone to Conductive Alloy in the Alloy Smelter. Energetic Alloy supplies the Double-Layer Capacitor and intermediate conduits; reserve some for Vibrant Alloy."
  ],
  "task.5130125004C136D9.title": "Obtain 1 × Redstone Alloy Ingot",
  "quest.513011C98821DCE8.title": "Redstone Alloy for signals",
  "quest.513011C98821DCE8.quest_desc": [
    "Copper and redstone in the Alloy Smelter produce Redstone Alloy. Reserve it for signal conduits separately from the alloys used for power."
  ],
  "task.51301233A0BD0F53.title": "Obtain 1 × Conductive Alloy Ingot",
  "quest.513011725F799C0A.title": "Iron + copper → Conductive Alloy",
  "quest.513011725F799C0A.quest_desc": [
    "The Alloy Smelter combines iron and copper into Conductive Alloy. Basic conduits consume it, and Energetic Alloy uses it as an input, so keep a dedicated stock."
  ],
  "task.5130120E4BF4EEB6.title": "Obtain 1 × Pulsating Alloy Ingot",
  "quest.51301102C5F5EF51.title": "Pulsating Alloy for items",
  "quest.51301102C5F5EF51.quest_desc": [
    "Iron and an ender pearl produce Pulsating Alloy. Together with Conductive Alloy it supplies the basic item conduit; another share becomes Pulsating Crystals."
  ],
  "task.51301250DFCF497B.title": "Obtain 1 × Dark Steel Ingot",
  "quest.5130111DBA46A20B.title": "Dark Steel and specialized machines",
  "quest.5130111DBA46A20B.quest_desc": [
    "Dark Steel uses iron, obsidian and a carbon source in one of the available recipes. It supplies the Enchanter and leads to End Steel; these branches can run separately from conduits."
  ],
  "task.513012EFFCD5589B.title": "Obtain 1 × End Steel Ingot",
  "quest.513011BBFAA4813B.title": "Dark Steel → End Steel",
  "quest.513011BBFAA4813B.quest_desc": [
    "Add end stone and obsidian to Dark Steel in the smelting line. End Steel is the next material in this branch; inspect its consumers in JEI."
  ],
  "task.513012ABA8596764.title": "Obtain 1 × Silicon",
  "quest.513011D9AD5BA43B.title": "Obtain 1 × Silicon",
  "quest.513011D9AD5BA43B.quest_desc": [
    "Have in your inventory 1 × Silicon (enderio:silicon). The items are not consumed by this task."
  ],
  "task.5130120E7CF8F086.title": "Obtain 1 × Basic Capacitor",
  "quest.513011E8D057E271.title": "A capacitor for machine operation",
  "quest.513011E8D057E271.quest_desc": [
    "The Basic Capacitor uses Grains of Infinity, copper and gold nuggets. Prepare capacitors for machines that need them and check the corresponding slot in each interface. Higher capacitors extend this branch later."
  ],
  "task.5130120DA8BECB26.title": "Obtain 1 × Double-Layer Capacitor",
  "quest.513011841D3B76CA.title": "Double-Layer: the next capacitor",
  "quest.513011841D3B76CA.quest_desc": [
    "This pack combines a Basic Capacitor, Energetic Alloy and Precision Mechanism stage components. The capacitor is available before the Dimensional Matrix; the later Advanced Capacitor Bank separately requires the Matrix."
  ],
  "task.513012350EF85752.title": "Obtain 1 × Void Chassis",
  "quest.5130118049B3B5BA.title": "Void Chassis for the first machine",
  "quest.5130118049B3B5BA.quest_desc": [
    "This pack's Void Chassis combines Grains of Infinity, iron and an Industrial Chassis. It starts the Alloy Smelter, SAG Mill and part of the automation route; keep spares for separate stations."
  ],
  "task.51301254BDC11A17.title": "Energy Conduit",
  "quest.5130116AAAF4B959.title": "FE conduit: generator → consumer",
  "quest.5130116AAAF4B959.quest_desc": [
    "The basic energy conduit uses Conductive Alloy and Binder. Connect source, buffer and machine, then check connection modes. The existing objective recognizes this conduit type rather than any item sharing its base name."
  ],
  "task.513012E734260CFD.title": "Enhanced Energy Conduit",
  "quest.5130114AE9005E27.title": "Energy conduit: Energetic",
  "quest.5130114AE9005E27.quest_desc": [
    "This extends the corresponding basic conduit. JEI includes direct crafting and upgrade recipes; the previous node identifies the working line being expanded. After replacement, check connections, modes and actual throughput."
  ],
  "task.51301262BC20AF57.title": "Item Conduit",
  "quest.5130119426F8E5C3.title": "Items between smelter and storage",
  "quest.5130119426F8E5C3.quest_desc": [
    "The basic item conduit needs Conductive and Pulsating Alloys. Configure extraction at the source and insertion at the destination; test one recipe before adding filters. This transport feeds the local Crafter in the next section."
  ],
  "task.5130127AF40A2854.title": "Enhanced Item Conduit",
  "quest.513011B05E2E9113.title": "Item conduit: Energetic",
  "quest.513011B05E2E9113.quest_desc": [
    "This extends the corresponding basic conduit. JEI includes direct crafting and upgrade recipes; the previous node identifies the working line being expanded. After replacement, check connections, modes and actual throughput."
  ],
  "task.5130125FFF5152C3.title": "Fluid Conduit",
  "quest.513011E370A685E5.title": "Fluids: a separate channel and filter",
  "quest.513011E370A685E5.quest_desc": [
    "The basic Fluid Conduit uses Conductive Alloy, Binder and Clear Glass. Check connection modes between tank and consumer; the side filter helps exclude unwanted fluids."
  ],
  "task.513012B721DF45DF.title": "Pressurized Fluid Conduit",
  "quest.5130110FC0DFEDC3.title": "Pressurized fluid conduit",
  "quest.5130110FC0DFEDC3.quest_desc": [
    "This extends the corresponding basic conduit. JEI includes direct crafting and upgrade recipes; the previous node identifies the working line being expanded. After replacement, check connections, modes and actual throughput."
  ],
  "task.513012223212E124.title": "Redstone Conduit",
  "quest.5130115B49AE7E7C.title": "Signals control the production line",
  "quest.5130115B49AE7E7C.quest_desc": [
    "Redstone Conduits carry control signals through the conduit network. Configure the channel and input/output points to control stations independently of their item filters."
  ],
  "task.51301253901CEB47.title": "Obtain 1 × SAG Mill",
  "quest.51301189AE52B1F5.title": "SAG Mill: grinding and by-products",
  "quest.51301189AE52B1F5.quest_desc": [
    "Power and configure the SAG Mill for your chosen feed. Remove every output, including by-products; available recipes include Cobbled Deepslate with a chance of Grains of Infinity. This expands the component line you already established."
  ],
  "task.513012AD05666AC6.title": "Obtain 1 × Conduit Binder Composite",
  "quest.5130111869DF4496.title": "The conduit binder mixture",
  "quest.5130111869DF4496.quest_desc": [
    "Prepare Conduit Binder Composite using its recipe and send it for smelting. The metal alloy determines conduit capabilities, while the Binder supplies the shared casing material."
  ],
  "task.513012F112D11CE0.title": "Obtain 1 × Conduit Binder",
  "quest.513011FD63F841AE.title": "The smelted network material",
  "quest.513011FD63F841AE.quest_desc": [
    "Smelt the Composite into Conduit Binder and keep a stock near conduit crafting. The route now splits into FE, items, fluids and redstone, each with its own alloy requirements."
  ],
  "task.51301209D9FCED57.title": "Obtain 1 × Pulsating Crystal",
  "quest.5130118E25820DD5.title": "Obtain 1 × Pulsating Crystal",
  "quest.5130118E25820DD5.quest_desc": [
    "Have in your inventory 1 × Pulsating Crystal (enderio:pulsating_crystal). The items are not consumed by this task."
  ],
  "task.5130123DBBDC43D0.title": "Obtain 1 × Vibrant Crystal",
  "quest.513011FF94962AA3.title": "Obtain 1 × Vibrant Crystal",
  "quest.513011FF94962AA3.quest_desc": [
    "Have in your inventory 1 × Vibrant Crystal (enderio:vibrant_crystal). The items are not consumed by this task."
  ],
  "task.5130128BC3A5C4DD.title": "Obtain 1 × Ender Crystal",
  "quest.51301138C137BDAD.title": "Vibrant Crystal + an Enderman soul",
  "quest.51301138C137BDAD.quest_desc": [
    "The Soul Binder turns a Vibrant Crystal into an Ender Crystal using an Enderman soul sample, experience and FE. This material leads to specialized obelisks; an empty Soul Vial alone does not satisfy the recipe."
  ],
  "task.51301206D5A9F5D4.title": "Obtain 1 × Basic Item Filter",
  "quest.513011C540A7B224.title": "Obtain 1 × Basic Item Filter",
  "quest.513011C540A7B224.quest_desc": [
    "Have in your inventory 1 × Basic Item Filter (enderio:basic_item_filter). The items are not consumed by this task."
  ],
  "task.51301279A17DCAE3.title": "Obtain 1 × Advanced Item Filter",
  "quest.513011FDA169E434.title": "A smarter filter after Z-Logic",
  "quest.513011FDA169E434.quest_desc": [
    "The Advanced Item Filter uses a Z-Logic Controller from the Slice'n'Splice. It therefore belongs after specialized component production; the basic filter remains available for the first item line."
  ],
  "task.513012A1EF1F3FB7.title": "Obtain 1 × Limited Item Filter",
  "quest.5130112CBAC535EA.title": "Obtain 1 × Limited Item Filter",
  "quest.5130112CBAC535EA.quest_desc": [
    "Have in your inventory 1 × Limited Item Filter (enderio:limited_item_filter). The items are not consumed by this task."
  ],
  "task.51301235C4C13133.title": "Obtain 1 × Conduit Probe",
  "quest.513011F31A34A8F8.title": "Obtain 1 × Conduit Probe",
  "quest.513011F31A34A8F8.quest_desc": [
    "Have in your inventory 1 × Conduit Probe (enderio:conduit_probe). The items are not consumed by this task."
  ],
  "task.5130126B603A84FB.title": "Obtain 1 × Basic Fluid Filter",
  "quest.513011734EE3175F.title": "Obtain 1 × Basic Fluid Filter",
  "quest.513011734EE3175F.quest_desc": [
    "Have in your inventory 1 × Basic Fluid Filter (enderio:basic_fluid_filter). The items are not consumed by this task."
  ],
  "task.5130128F5C1FD6A4.title": "Obtain 1 × Basic Chemical Filter",
  "quest.5130118E40386623.title": "Obtain 1 × Basic Chemical Filter",
  "quest.5130118E40386623.quest_desc": [
    "Have in your inventory 1 × Basic Chemical Filter (enderio:basic_chemical_filter). The items are not consumed by this task."
  ],
  "task.51301224B2E3A3B2.title": "Ender Energy Conduit",
  "quest.51301146B3D81FD6.title": "Energy conduit: Vibrant",
  "quest.51301146B3D81FD6.quest_desc": [
    "This extends the corresponding basic conduit. JEI includes direct crafting and upgrade recipes; the previous node identifies the working line being expanded. After replacement, check connections, modes and actual throughput."
  ],
  "task.513012EE248E9E10.title": "Ender Item Conduit",
  "quest.513011107F0255F3.title": "Item conduit: Vibrant",
  "quest.513011107F0255F3.quest_desc": [
    "This extends the corresponding basic conduit. JEI includes direct crafting and upgrade recipes; the previous node identifies the working line being expanded. After replacement, check connections, modes and actual throughput."
  ],
  "task.5130127DDDBE35C4.title": "Ender Fluid Conduit",
  "quest.5130111E28B22B76.title": "Ender Fluid Conduit",
  "quest.5130111E28B22B76.quest_desc": [
    "This extends the corresponding basic conduit. JEI includes direct crafting and upgrade recipes; the previous node identifies the working line being expanded. After replacement, check connections, modes and actual throughput."
  ],
  "task.513012DD1132FF0D.title": "Obtain 1 × Soularium Ingot",
  "quest.5130114938E63897.title": "Soularium: starting the soul branch",
  "quest.5130114938E63897.quest_desc": [
    "Prepare Soularium in the smelting line. Soul Vials, Ensouled Chassis and specialized machinery use it; this branch grows from the Alloy Smelter after basic logistics."
  ],
  "task.5130124C77FD9A1C.title": "Obtain 1 × Soul Vial",
  "quest.51301110F3A4858C.title": "Soul Vial: the sampling tool",
  "quest.51301110F3A4858C.quest_desc": [
    "A Soul Vial captures the soul of a supported creature. The item objective checks the empty vial; separately prepare a filled sample of the required type for each Soul Binder recipe."
  ],
  "task.513012862146455C.title": "Obtain 1 × Soul Binder",
  "quest.51301148615D2591.title": "Soul Binder: soul, experience and FE",
  "quest.51301148615D2591.quest_desc": [
    "The Soul Binder follows the Slice'n'Splice and Enchanter that supply its actual ingredients. For operation, provide the required Soul Vial, item input, experience and energy. Binding an Ender Crystal is a separate next branch."
  ],
  "task.51301203F6483C33.title": "Obtain 1 × Powered Spawner",
  "quest.51301167AE8889AA.title": "Powered Spawner: machine and sample",
  "quest.51301167AE8889AA.quest_desc": [
    "This pack's recipe consumes a Soul Binder, Z-Logic Controller, Vibrant Crystal and Broken Spawner alongside other components. After crafting, configure a supported spawner type, power and output collection. Industrial Foregoing later uses this machine in the Mob Duplicator."
  ],
  "task.513012E46973509A.title": "Obtain 1 × Slice'N'Splice",
  "quest.5130114A639B43DA.title": "Slice'n'Splice before the Soul Binder",
  "quest.5130114A639B43DA.quest_desc": [
    "Build the Slice'n'Splice first and make a Z-Logic Controller from Soularium, a zombie head, Silicon and redstone. This processor is required by both Soul Binder and Powered Spawner recipes, so its machine comes first."
  ],
  "task.51301250B5E2214D.title": "Obtain 1 × Vacuum Chest",
  "quest.51301140FB4C14AE.title": "Vacuum Chest: collection into conduits",
  "quest.51301140FB4C14AE.quest_desc": [
    "The Vacuum Chest connects local item collection to the transport network. Configure its working area and storage output so an active farm does not rely on a full chest."
  ],
  "task.5130125FBEE3EC14.title": "Obtain 1 × Impulse Hopper",
  "quest.513011AF7BCC8C7E.title": "Impulse Hopper for batch input",
  "quest.513011AF7BCC8C7E.quest_desc": [
    "The Impulse Hopper is a separate station for controlled item input. Configure its batch and signal behavior for the target machine. Its item objective is available at Precision and does not inspect the configuration in the world."
  ],
  "task.5130121CEBF45EAA.title": "Obtain 1 × Crafter",
  "quest.5130119DF4466A66.title": "Crafter: repeated crafting before the Matrix",
  "quest.5130119DF4466A66.quest_desc": [
    "Build the Crafter from a Void Chassis, Silicon, BuildCraft Auto Workbench, Control Assembly and Precision Mechanism components. Supply FE and ingredients, configure the recipe and route outputs through Item Conduits. It also feeds the AE2 Crafting Unit recipe and does not require a Dimensional Matrix."
  ],
  "task.5130120E988B21B8.title": "Obtain 1 × Aversion Obelisk",
  "quest.5130118BFEDE7D48.title": "Obtain 1 × Aversion Obelisk",
  "quest.5130118BFEDE7D48.quest_desc": [
    "Have in your inventory 1 × Aversion Obelisk (enderio:aversion_obelisk). The items are not consumed by this task."
  ],
  "task.513012E15BA285CB.title": "Obtain 1 × Inhibitor Obelisk",
  "quest.513011F0F034B9F6.title": "Obtain 1 × Inhibitor Obelisk",
  "quest.513011F0F034B9F6.quest_desc": [
    "Have in your inventory 1 × Inhibitor Obelisk (enderio:inhibitor_obelisk). The items are not consumed by this task."
  ],
  "task.51301223114A3DB9.title": "Obtain 1 × VAT",
  "quest.5130117801127762.title": "Obtain 1 × VAT",
  "quest.5130117801127762.quest_desc": [
    "Have in your inventory 1 × VAT (enderio:vat). The items are not consumed by this task."
  ],
  "task.513012EC921A4507.title": "Obtain 1 × Enchanter",
  "quest.5130111D0F34D9B7.title": "The Enchanter as a production component",
  "quest.5130111D0F34D9B7.quest_desc": [
    "Build the Enchanter using this pack's Dark Steel and specialized component recipe. It also becomes an ingredient of the Soul Binder, so prepare another copy if you want to keep an enchanting station on the base."
  ],
  "task.513012078E872C32.title": "Obtain 1 × Travel Anchor",
  "quest.513011AA9C81A28D.title": "Obtain 1 × Travel Anchor",
  "quest.513011AA9C81A28D.quest_desc": [
    "Have in your inventory 1 × Travel Anchor (enderio:travel_anchor). The items are not consumed by this task."
  ],
  "task.513012AEBD67AE09.title": "Obtain 1 × Staff of Travelling",
  "quest.5130113D7D320C50.title": "Obtain 1 × Staff of Travelling",
  "quest.5130113D7D320C50.quest_desc": [
    "Have in your inventory 1 × Staff of Travelling (enderio:staff_of_travelling). The items are not consumed by this task."
  ],
  "task.513012C7C20FBC8B.title": "Obtain 1 × Basic Capacitor Bank",
  "quest.5130111D94D99E2B.title": "Capacitor Bank: a local FE reserve",
  "quest.5130111D94D99E2B.quest_desc": [
    "This pack's Basic Capacitor Bank uses a Basic Capacitor and a Mekanism Basic Energy Cube with precision-stage components. Configure it between generation and Ender IO machines; it belongs to Precision rather than requiring the Matrix."
  ],
  "task.513012CA2994B6C3.title": "Obtain 1 × Advanced Capacitor Bank",
  "quest.513011FDD244B182.title": "More storage for the same network",
  "quest.513011FDD244B182.quest_desc": [
    "The Advanced Capacitor Bank extends the basic bank through a Double-Layer Capacitor. Both pack recipes also consume a Quantum Processor and Dimensional Matrix, placing this buffer at the third progression stage."
  ],
  "task.5130128D3BA4831D.title": "Obtain 1 × Vibrant Capacitor Bank",
  "quest.513011BF7BA29A4B.title": "Obtain 1 × Vibrant Capacitor Bank",
  "quest.513011BF7BA29A4B.quest_desc": [
    "Have in your inventory 1 × Vibrant Capacitor Bank (enderio:vibrant_capacitor_bank). The items are not consumed by this task."
  ],
  "task.513012B0304EB458.title": "Obtain 1 × Energetic Photovoltaic Module",
  "quest.513011D09E534066.title": "Obtain 1 × Energetic Photovoltaic Module",
  "quest.513011D09E534066.quest_desc": [
    "Have in your inventory 1 × Energetic Photovoltaic Module (enderio:energetic_photovoltaic_module). The items are not consumed by this task."
  ],
  "task.5130122209233441.title": "Obtain 1 × Pulsating Photovoltaic Module",
  "quest.5130118ED672EF1E.title": "Obtain 1 × Pulsating Photovoltaic Module",
  "quest.5130118ED672EF1E.quest_desc": [
    "Have in your inventory 1 × Pulsating Photovoltaic Module (enderio:pulsating_photovoltaic_module). The items are not consumed by this task."
  ],
  "task.513012648D32B0A1.title": "Obtain 1 × Vibrant Photovoltaic Module",
  "quest.513011D5BDA26046.title": "Obtain 1 × Vibrant Photovoltaic Module",
  "quest.513011D5BDA26046.quest_desc": [
    "Have in your inventory 1 × Vibrant Photovoltaic Module (enderio:vibrant_photovoltaic_module). The items are not consumed by this task."
  ],
  "task.5130125F8520265D.title": "Obtain 1 × Wireless Charger",
  "quest.513011403518CC36.title": "Obtain 1 × Wireless Charger",
  "quest.513011403518CC36.quest_desc": [
    "Have in your inventory 1 × Wireless Charger (enderio:wireless_charger). The items are not consumed by this task."
  ],
  "task.51401233B6860633.title": "Obtain 1 × Alloy Smelter",
  "quest.514011487657F862.title": "Alloy Smelter: the source of the branches",
  "quest.514011487657F862.quest_desc": [
    "Build the Alloy Smelter from a Void Chassis and iron furnaces using this pack's recipe. Supply FE, install its required capacitor and feed one recipe's ingredients. Its output splits into conduits, energy buffers and soul machinery."
  ],
  "image.514104100000023D.title": "09 · Ender IO: Alloys, Souls and Conduits",
  "image.514104100000023E.title": "Read top to bottom · hover a quest to see all its connections",
  "image.5141041000000243.title": "01  Components and the first smelter",
  "image.5141041000000252.title": "02  Alloys and crystals",
  "image.514104100000025A.title": "03  Conduit basics and filtering",
  "image.5141041000000262.title": "04  Machines, buffers and autocrafting",
  "image.5141041000000272.title": "05  Soularium, Z-Logic and souls",
  "image.514104100000027C.title": "06  Specialized endpoints",
  "image.5141041000000284.title": "07  Higher-throughput conduits",
