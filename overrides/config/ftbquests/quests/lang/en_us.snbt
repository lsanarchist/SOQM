  "chapter_group.5141042000000007.title": "Transmutation and the Finale",
  "chapter.514D10BB504C8924.title": "06 · The Mekanism Factory",
  "chapter.514D10BB504C8924.chapter_subtitle": [
    "88 quests · English objective guide (alpha).",
    "Hexagon: route · square: development · circle: optional",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.514D1298117735DA.title": "Obtain 8 × Osmium Ingot",
  "quest.514D118227E562E7.title": "Obtain 8 × Osmium Ingot",
  "quest.514D118227E562E7.quest_subtitle": "Stage 1 · Main route",
  "quest.514D118227E562E7.quest_desc": [
    "Have in your inventory 8 × Osmium Ingot (mekanism:ingot_osmium). The items are not consumed by this task."
  ],
  "task.514D12443397184B.title": "Obtain 1 × Heat Generator",
  "task.514D123CADB1A9FE.title": "Obtain 4 × Basic Universal Cable",
  "quest.514D11B512FA3533.title": "Power the First Machine",
  "quest.514D11B512FA3533.quest_subtitle": "Stage 1 · Main route",
  "quest.514D11B512FA3533.quest_desc": [
    "Connect the Heat Generator output to a machine with Universal Cable. This cable carries energy, not fluids or chemicals.",
    "For a short test, put fuel in the generator and open the machine: its energy buffer should fill. Then choose a sustained supply for your actual load.",
    "If no charge arrives, check connections, energy-side settings and redstone control. A charged empty machine has not completed a recipe."
  ],
  "task.514D120BC0C162BB.title": "Obtain 1 × Metallurgic Infuser",
  "quest.514D11B65A3EE8C0.title": "First Alloy in the Metallurgic Infuser",
  "quest.514D11B65A3EE8C0.quest_subtitle": "Stage 1 · Main route",
  "quest.514D11B65A3EE8C0.quest_desc": [
    "The infuser combines an item with its stored infusion material. Test the Infused Alloy recipe with copper and redstone, then wait for a finished alloy.",
    "In Side Config, separate the ordinary item input, the Extra reagent input and the output. Add filters and output extraction before automating batches.",
    "Infusion material remains in the internal buffer. Use another machine for a different type, or deliberately clear the residue; the wrong infusion material cannot substitute for the right one."
  ],
  "task.514D123B28AB849A.title": "Obtain 8 × Steel Ingot",
  "task.514D1272918DA606.title": "Obtain 8 × Infused Alloy",
  "quest.514D110FDA1C7CF6.title": "Obtain 8 × Steel Ingot + Obtain 8 × Infused Alloy",
  "quest.514D110FDA1C7CF6.quest_subtitle": "Stage 1 · Main route",
  "quest.514D110FDA1C7CF6.quest_desc": [
    "Have in your inventory 8 × Steel Ingot (mekanism:ingot_steel). The items are not consumed by this task.",
    "Have in your inventory 8 × Infused Alloy (mekanism:alloy_infused). The items are not consumed by this task."
  ],
  "task.514D124489CA95EB.title": "Obtain 4 × Basic Control Circuit",
  "task.514D12338DA47ADF.title": "Obtain 2 × Steel Casing",
  "quest.514D11EFB7B6F506.title": "Obtain 4 × Basic Control Circuit + Obtain 2 × Steel Casing",
  "quest.514D11EFB7B6F506.quest_subtitle": "Stage 1 · Main route",
  "quest.514D11EFB7B6F506.quest_desc": [
    "Have in your inventory 4 × Basic Control Circuit (mekanism:basic_control_circuit). The items are not consumed by this task.",
    "Have in your inventory 2 × Steel Casing (mekanism:steel_casing). The items are not consumed by this task."
  ],
  "task.514D126C25DD9231.title": "Obtain 1 × Configurator",
  "quest.514D1147E2CB985B.title": "Obtain 1 × Configurator",
  "quest.514D1147E2CB985B.quest_subtitle": "Stage 1 · Main route",
  "quest.514D1147E2CB985B.quest_desc": [
    "Have in your inventory 1 × Configurator (mekanism:configurator). The items are not consumed by this task."
  ],
  "task.514D124463C7F80D.title": "Obtain 1 × Enrichment Chamber",
  "task.514D12198F623502.title": "Obtain 1 × Energized Smelter",
  "quest.514D1154FFE3DABB.title": "Enrichment before Electric Smelting",
  "quest.514D1154FFE3DABB.quest_subtitle": "Stage 1 · Main route",
  "quest.514D1154FFE3DABB.quest_desc": [
    "Feed a supported raw material into the Enrichment Chamber, then send its product to the Energized Smelter. Check the specific JEI recipe for the actual yield.",
    "Move one small batch manually first. Then connect the first machine’s item output to the second machine’s input and enable the appropriate automatic ejection.",
    "The test succeeds when the finished ingot reaches storage and both outputs clear. A full destination stops the line even when every machine has power."
  ],
  "task.514D12D5C5A62FB5.title": "Obtain 1 × Basic Energy Cube",
  "quest.514D1178A4D44AFB.title": "Obtain 1 × Basic Energy Cube",
  "quest.514D1178A4D44AFB.quest_subtitle": "Stage 1 · Main route",
  "quest.514D1178A4D44AFB.quest_desc": [
    "Have in your inventory 1 × Basic Energy Cube (mekanism:basic_energy_cube). The items are not consumed by this task."
  ],
  "task.514D121815A3555D.title": "Obtain 8 × Basic Logistical Transporter",
  "task.514D12C0523DF70D.title": "Obtain 8 × Basic Mechanical Pipe",
  "task.514D127B4BD9414E.title": "Obtain 8 × Basic Pressurized Tube",
  "quest.514D118EBA5C411D.title": "Items, Fluids and Chemicals",
  "quest.514D118EBA5C411D.quest_subtitle": "Stage 1 · Main route",
  "quest.514D118EBA5C411D.quest_desc": [
    "Logistical Transporters carry items, Mechanical Pipes carry fluids, and Pressurized Tubes carry Mekanism chemicals. Identify the resource type in the recipe before choosing a line.",
    "Use a Configurator to set the connection mode. If the source does not eject automatically, enable extraction at that end and allow the matching input on the destination.",
    "Test each resource with a small batch. These three similar-looking pipes are not interchangeable."
  ],
  "task.514D12C16685AB75.title": "Obtain 4 × Enriched Redstone",
  "task.514D12F0163F5913.title": "Obtain 4 × Enriched Carbon",
