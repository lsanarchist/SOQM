  "task.5140120751ADBA16.title": "Mayhem Skills: Capstone",
  "quest.514011503157F07A.title": "Mayhem Skills: Capstone",
  "quest.514011503157F07A.quest_subtitle": "Stage 3 · Optional branch",
  "quest.514011503157F07A.quest_desc": [
    "Unlock the sixth skill in any ONE of the four Mayhem branches. This is an OR condition; all four final skills are not required."
  ],
  "task.514012AEB64D79CB.title": "Skill Points: Stage 1",
  "quest.514011E9C8CE8643.title": "Skill Points: Stage 1",
  "quest.514011E9C8CE8643.quest_subtitle": "Stage 1 · Practice",
  "quest.514011E9C8CE8643.quest_desc": [
    "Obtain Industrial Chassis for this stage's one-time two-point Pufferfish's Skills bonus. It is tied to the player and material: moving it repeatedly, relogging or farming normal XP does not grant extra bonuses."
  ],
