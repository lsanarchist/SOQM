  "quest.513011E55E071B35.title": "Obtain 1 × Advanced Energy Cube",
  "quest.513011E55E071B35.quest_desc": [
    "Have in your inventory 1 × Advanced Energy Cube (mekanism:advanced_energy_cube). The items are not consumed by this task."
  ],
