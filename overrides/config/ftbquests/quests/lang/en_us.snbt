  "chapter.51301041730B8A2D.title": "13 · RFTools: Building and Custom Worlds",
  "chapter.51301041730B8A2D.chapter_subtitle": [
    "The frame and Crafter Tier 1 support the first autocrafting setup at the Precision Mechanism stage. The Builder, expanded networks and dimensions have their own later branches.",
    "60 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.5130120B16C53923.title": "Obtain 1 × Technology Guide",
  "quest.5130112CBCED844F.title": "Obtain 1 × Technology Guide",
  "quest.5130112CBCED844F.quest_desc": [
    "Have in your inventory 1 × Technology Guide (rftoolsbase:manual). The items are not consumed by this task."
  ],
  "task.513012B02EA2EB0F.title": "Obtain 1 × Smart Wrench",
  "quest.513011CB66DEB469.title": "Obtain 1 × Smart Wrench",
  "quest.513011CB66DEB469.quest_desc": [
    "Have in your inventory 1 × Smart Wrench (rftoolsbase:smartwrench). The items are not consumed by this task."
  ],
  "task.51301285A9BBB5B4.title": "Obtain 1 × Machine Base",
  "quest.5130115973A031FC.title": "Obtain 1 × Machine Base",
  "quest.5130115973A031FC.quest_desc": [
    "Have in your inventory 1 × Machine Base (rftoolsbase:machine_base). The items are not consumed by this task."
  ],
  "task.5130124F3501F74E.title": "Obtain 1 × Machine Frame",
  "quest.5130119AD1F9E96E.title": "Obtain 1 × Machine Frame",
  "quest.5130119AD1F9E96E.quest_desc": [
    "The Machine Frame is a base component for many RFTools machines. In SOQM it already requires a Precision Mechanism, tying it to the main industrial progression.",
    "Choose the next device and prepare its complete recipe. The frame itself is not an operating machine, and a stock of frames cannot replace a Storage Module, Shape Card or other device-specific equipment."
  ],
  "task.51301210D28BA6E5.title": "Obtain 1 × Dimensional Shard",
  "quest.51301102809E201A.title": "Obtain 1 × Dimensional Shard",
  "quest.51301102809E201A.quest_desc": [
    "Have in your inventory 1 × Dimensional Shard (rftoolsbase:dimensionalshard). The items are not consumed by this task."
  ],
  "task.51301207A953A52E.title": "Obtain 1 × Infused Diamond",
  "quest.513011ADFFB9890C.title": "Obtain 1 × Infused Diamond",
  "quest.513011ADFFB9890C.quest_desc": [
    "Have in your inventory 1 × Infused Diamond (rftoolsbase:infused_diamond). The items are not consumed by this task."
  ],
  "task.51301218B76A6AA3.title": "Obtain 1 × Infused Enderpearl",
  "quest.5130117132F1BA9B.title": "Obtain 1 × Infused Enderpearl",
  "quest.5130117132F1BA9B.quest_desc": [
    "Have in your inventory 1 × Infused Enderpearl (rftoolsbase:infused_enderpearl). The items are not consumed by this task."
  ],
  "task.513012C24602451D.title": "Obtain 1 × Modular Storage",
  "quest.513011E14C79560E.title": "Obtain 1 × Modular Storage",
  "quest.513011E14C79560E.quest_desc": [
    "Modular Storage is searchable storage whose capacity is defined by an installed Storage Module. Place the block, open its interface and insert the module into its slot before transferring resources.",
    "Items are stored in the module itself, so keep track of it when moving the storage. Changing the visible inventory size in the GUI does not add capacity; a higher-tier module does."
  ],
  "task.513012C8B0910023.title": "Obtain 1 × Tier 1 Storage Module",
  "quest.5130111A3EA75731.title": "Obtain 1 × Tier 1 Storage Module",
  "quest.5130111A3EA75731.quest_desc": [
    "The first Storage Module is the item-bearing component of Modular Storage. Insert it into the module slot, add a few samples and test search and withdrawal through the block interface.",
    "Higher tiers increase the number of available stacks once this module fills. Move or upgrade the actual module holding your data; a new empty module cannot access the old one’s contents."
  ],
  "task.51301236FD71DE4A.title": "Obtain 1 × Tier 2 Storage Module",
  "quest.513011FD6E526739.title": "Obtain 1 × Tier 2 Storage Module",
  "quest.513011FD6E526739.quest_desc": [
    "Have in your inventory 1 × Tier 2 Storage Module (rftoolsstorage:storage_module1). The items are not consumed by this task."
  ],
  "task.51301237710D061A.title": "Obtain 1 × Tier 3 Storage Module",
  "quest.5130115CD2DAF36E.title": "Obtain 1 × Tier 3 Storage Module",
  "quest.5130115CD2DAF36E.quest_desc": [
    "Have in your inventory 1 × Tier 3 Storage Module (rftoolsstorage:storage_module2). The items are not consumed by this task."
  ],
  "task.513012073F22CA6E.title": "Obtain 1 × Tier 4 Storage Module",
  "quest.5130110C02719C96.title": "Obtain 1 × Tier 4 Storage Module",
  "quest.5130110C02719C96.quest_desc": [
    "Have in your inventory 1 × Tier 4 Storage Module (rftoolsstorage:storage_module3). The items are not consumed by this task."
  ],
  "task.51301221C9F0F668.title": "Obtain 1 × Crafter Tier 1",
  "quest.51301199219AE3FE.title": "Crafter T1: Autocrafting Bridge",
  "quest.51301199219AE3FE.quest_desc": [
    "After Precision Mechanism, craft the RFTools frame and Crafter Tier 1. Dimensional Matrix is not required by this recipe: this crafter is an ingredient of the first Molecular Assembler in the AE2 branch.",
    "The pack recipe combines the frame, Control Assembly, Precision Mechanism, a BuildCraft Auto Workbench and an Ender IO Basic Capacitor. Prepare those components in their chapters, then check the Crafter T1 layout in JEI.",
    "Hold the completed crafter to satisfy the inventory task. For an RFTools production line, supply FE, configure a recipe, leave output space and verify one cycle. For the first AE2 autocrafting setup, use it in the Molecular Assembler recipe; T2/T3 crafters and larger networks can follow later."
  ],
  "task.51301248A37BA6C6.title": "Obtain 1 × Crafter Tier 2",
  "quest.513011B67C063C69.title": "Obtain 1 × Crafter Tier 2",
  "quest.513011B67C063C69.quest_desc": [
    "Have in your inventory 1 × Crafter Tier 2 (rftoolsutility:crafter2). The items are not consumed by this task."
  ],
  "task.5130128B8A738C0F.title": "Obtain 1 × Crafter Tier 3",
  "quest.513011CC15383729.title": "Obtain 1 × Crafter Tier 3",
  "quest.513011CC15383729.quest_desc": [
    "Crafter Tier 3 supports up to eight stored recipes. Configure and test one craft with real materials before adding further operations to the same machine.",
    "Use the GUI’s remember function to reserve input slots so one bulk material cannot occupy space needed by other ingredients. Extract finished products and supply FE; more recipes do not create ingredients or clear a full output."
  ],
  "task.5130122189FD2BB2.title": "Obtain 1 × Matter Transmitter",
  "quest.513011FC1C704211.title": "Obtain 1 × Matter Transmitter",
  "quest.513011FC1C704211.quest_desc": [
    "The Matter Transmitter sends a player, while a Matter Receiver is the destination. Place and power both devices, then install a Dialing Device near the transmitter to select the route.",
    "Connect your transmitter to the intended receiver in the Dialing Device before testing teleportation. Prepare a return route separately; a connection to one receiver does not automatically create a two-way pair."
  ],
  "task.51301236B875D8B6.title": "Obtain 1 × Matter Receiver",
  "quest.51301136600E9A01.title": "Obtain 1 × Matter Receiver",
  "quest.51301136600E9A01.quest_desc": [
    "The Matter Receiver defines the destination for transmitters and a Charged Porter. Place it in an accessible location and establish its own power supply before travelling.",
    "Check the receiver’s name and coordinates in the network and its remote FE reserve. Power at the transmitter alone does not guarantee a working receiver; an underpowered destination can make the trip harmful to your character."
  ],
  "task.5130128155D33FD4.title": "Obtain 1 × Dialing Device",
  "quest.5130110ABDB307BD.title": "Obtain 1 × Dialing Device",
  "quest.5130110ABDB307BD.quest_desc": [
    "The Dialing Device connects a nearby Matter Transmitter to a selected Matter Receiver, including one in another dimension. Select the transmitter in the upper part of the interface and the receiver in the destination list.",
    "Dial keeps the route active; Dial Once disconnects it after one trip. Check the destination name and coordinates before the first test to avoid selecting another base with a similar name."
  ],
  "task.513012636419B2F8.title": "Obtain 1 × Simple Dialer",
  "quest.513011A9EF1774F5.title": "Obtain 1 × Simple Dialer",
  "quest.513011A9EF1774F5.quest_desc": [
    "Have in your inventory 1 × Simple Dialer (rftoolsutility:simple_dialer). The items are not consumed by this task."
  ],
  "task.5130124C8D7CC49D.title": "Obtain 1 × Charged Porter",
  "quest.513011556C0F5A97.title": "Obtain 1 × Charged Porter",
  "quest.513011556C0F5A97.quest_desc": [
    "A Charged Porter is a portable way back to a Matter Receiver. Charge it with FE and right-click the receiver to store that location; the basic porter holds one destination.",
    "Make a short test trip before leaving. Binding does not create or maintain the receiver: removing the target or making it unusable prevents the charged item from guaranteeing a return."
  ],
  "task.5130120EEDAB5786.title": "Obtain 1 × Advanced Charged Porter",
  "quest.5130117C3E433F2B.title": "Obtain 1 × Advanced Charged Porter",
  "quest.5130117C3E433F2B.quest_desc": [
    "Have in your inventory 1 × Advanced Charged Porter (rftoolsutility:advanced_charged_porter). The items are not consumed by this task."
  ],
  "task.5130123A37EC6404.title": "Obtain 1 × Destination Analyzer",
  "quest.5130119ECCA2B161.title": "Obtain 1 × Destination Analyzer",
  "quest.5130119ECCA2B161.quest_desc": [
    "Have in your inventory 1 × Destination Analyzer (rftoolsutility:destination_analyzer). The items are not consumed by this task."
  ],
  "task.5130120C846F37AB.title": "Obtain 1 × Screen",
  "quest.513011CFF060293F.title": "Obtain 1 × Screen",
  "quest.513011CFF060293F.quest_desc": [
    "A Screen displays workshop readings through installed modules. Place it, add a targeted module such as an Energy Module, and provide power through a nearby Screen Controller.",
    "An empty screen does not discover every machine in the base. Bind the module to a specific block first, install it in the screen, and compare its reading with the working device."
  ],
  "task.51301212E75B3D5E.title": "Obtain 1 × Screen Controller",
  "quest.513011D5061AFAB0.title": "Obtain 1 × Screen Controller",
  "quest.513011D5061AFAB0.quest_desc": [
    "The Screen Controller powers nearby screens. Supply FE to the controller and press Scan in its GUI to register installed Screens within range.",
    "Scan again after adding or moving a screen. Controller power and module data are separate requirements: a connected screen still needs a correctly targeted monitoring module."
  ],
  "task.5130120EFEB601C5.title": "Obtain 1 × Screen Link",
  "quest.5130113102728BD5.title": "Obtain 1 × Screen Link",
  "quest.5130113102728BD5.quest_desc": [
    "Have in your inventory 1 × Screen Link (rftoolsutility:screen_link). The items are not consumed by this task."
  ],
  "task.513012B155664A40.title": "Obtain 1 × Energy Screen Module",
  "quest.513011C785AE43D5.title": "Obtain 1 × Energy Screen Module",
  "quest.513011C785AE43D5.quest_desc": [
    "An Energy Module displays an energy store on a Screen. Sneak-right-click the module on the machine to monitor, then install it in the screen.",
    "Open that module’s settings through the Screen GUI and choose a useful display. Compare the reading with the target machine’s interface: it monitors the selected block, not the combined generation of every nearby device."
  ],
  "task.5130120B06156CCB.title": "Obtain 1 × Fluid Screen Module",
  "quest.513011B88AB8D75B.title": "Obtain 1 × Fluid Screen Module",
  "quest.513011B88AB8D75B.quest_desc": [
    "Have in your inventory 1 × Fluid Screen Module (rftoolsutility:fluid_module). The items are not consumed by this task."
  ],
  "task.513012981A415E66.title": "Obtain 1 × Inventory Screen Module",
  "quest.513011EB4178D3E6.title": "Obtain 1 × Inventory Screen Module",
  "quest.513011EB4178D3E6.quest_desc": [
    "Have in your inventory 1 × Inventory Screen Module (rftoolsutility:inventory_module). The items are not consumed by this task."
  ],
  "task.513012AB76DC6F04.title": "Obtain 1 × Builder",
  "quest.5130119AFFF720CF.title": "Obtain 1 × Builder",
  "quest.5130119AFFF720CF.quest_desc": [
    "The Builder performs the operation selected by a Shape Card: construction, quarrying, pumping and other modes. In SOQM it requires a Dimensional Matrix and earlier automation components, so it is not an early substitute for manual mining.",
    "Before powering it, configure the card, dimensions and offset. Test a small area without valuables and provide materials or a receiver for the chosen mode; an area’s shape alone does not decide whether the machine builds or removes blocks."
  ],
  "task.513012D04764F389.title": "Obtain 1 × Shape Card",
  "quest.5130111256FB2CA4.title": "Obtain 1 × Shape Card",
  "quest.5130111256FB2CA4.quest_desc": [
    "Have in your inventory 1 × Shape Card (rftoolsbuilder:shape_card_def). The items are not consumed by this task."
  ],
  "task.5130123A09E007FC.title": "Obtain 1 × Shape Card (Quarry)",
  "quest.5130112BB3F7C4EB.title": "Obtain 1 × Shape Card (Quarry)",
  "quest.5130112BB3F7C4EB.quest_desc": [
    "A Quarry Card makes the Builder mine the configured area. Set the card’s dimensions and position, insert it into the Builder, and provide power and storage for the mined items.",
    "The normal variant replaces mined blocks with the configured filler; Clear variants leave air. Fortune and Silk Touch use separate cards. Check the actual card type before starting so the world is changed in the intended way."
  ],
  "task.513012F43FAD01DA.title": "Obtain 1 × Shape Card (Fortune Quarry)",
  "quest.513011A405EDE3AB.title": "Obtain 1 × Shape Card (Fortune Quarry)",
  "quest.513011A405EDE3AB.quest_desc": [
    "Have in your inventory 1 × Shape Card (Fortune Quarry) (rftoolsbuilder:shape_card_quarry_fortune). The items are not consumed by this task."
  ],
  "task.513012E2A342C17B.title": "Obtain 1 × Shape Card (Silk Quarry)",
  "quest.5130115F443CD91D.title": "Obtain 1 × Shape Card (Silk Quarry)",
  "quest.5130115F443CD91D.quest_desc": [
    "Have in your inventory 1 × Shape Card (Silk Quarry) (rftoolsbuilder:shape_card_quarry_silk). The items are not consumed by this task."
  ],
  "task.5130126E81BD7452.title": "Obtain 1 × Shape Card (Pump)",
  "quest.5130113C85CAFA28.title": "Obtain 1 × Shape Card (Pump)",
  "quest.5130113C85CAFA28.quest_desc": [
    "A Pump Card lets the Builder collect fluids from a selected area. Alongside power, provide a connected fluid tank and check that it accepts the target fluid.",
    "The normal Pump Card fills cleared positions with the configured block; the Clear variant leaves empty space. An item chest alone is not an outlet for this operation, whose result is fluid rather than bucket items."
  ],
  "task.513012700A30E7F5.title": "Obtain 1 × Shape Card (Clearing Pump)",
  "quest.51301131F0B631B0.title": "Obtain 1 × Shape Card (Clearing Pump)",
  "quest.51301131F0B631B0.quest_desc": [
    "Have in your inventory 1 × Shape Card (Clearing Pump) (rftoolsbuilder:shape_card_pump_clear). The items are not consumed by this task."
  ],
  "task.5130125FEBA7AB9E.title": "Obtain 1 × Shape Card (Placing Liquids)",
  "quest.5130114D8A7C963E.title": "Obtain 1 × Shape Card (Placing Liquids)",
  "quest.5130114D8A7C963E.quest_desc": [
    "Have in your inventory 1 × Shape Card (Placing Liquids) (rftoolsbuilder:shape_card_liquid). The items are not consumed by this task."
  ],
  "task.5130128D9E7AC835.title": "Obtain 1 × Shape Card (Void)",
  "quest.51301193720D5D84.title": "Obtain 1 × Shape Card (Void)",
  "quest.51301193720D5D84.quest_desc": [
    "A Void Card tells the Builder to remove blocks without drops. It suits clearing unwanted material, not resource mining.",
    "Set a small test area and verify its offset before supplying power. Use a Quarry Card when you expect ore or construction materials as output: an empty receiver in void mode does not mean mining is broken."
  ],
  "task.51301286A7485957.title": "Obtain 1 × Scanner",
  "quest.5130112E5069EB86.title": "Obtain 1 × Scanner",
  "quest.5130112E5069EB86.quest_desc": [
    "Have in your inventory 1 × Scanner (rftoolsbuilder:scanner). The items are not consumed by this task."
  ],
  "task.51301211742FB8BD.title": "Obtain 1 × Coal Generator",
  "quest.513011CC97DA4C9B.title": "Obtain 1 × Coal Generator",
  "quest.513011CC97DA4C9B.quest_desc": [
    "Have in your inventory 1 × Coal Generator (rftoolspower:coalgenerator). The items are not consumed by this task."
  ],
  "task.513012665E5AB711.title": "Obtain 1 × Powercell (Low)",
  "quest.5130117240292B8E.title": "Obtain 1 × Powercell (Low)",
  "quest.5130117240292B8E.quest_desc": [
    "Have in your inventory 1 × Powercell (Low) (rftoolspower:cell1). The items are not consumed by this task."
  ],
  "task.513012828C420DBB.title": "Obtain 1 × Powercell (Medium)",
  "quest.513011D1C9E27BE4.title": "Obtain 1 × Powercell (Medium)",
  "quest.513011D1C9E27BE4.quest_desc": [
    "Have in your inventory 1 × Powercell (Medium) (rftoolspower:cell2). The items are not consumed by this task."
  ],
  "task.51301272D42A4E4D.title": "Obtain 1 × Powercell (High)",
  "quest.51301100A7D9F653.title": "Obtain 1 × Powercell (High)",
  "quest.51301100A7D9F653.quest_desc": [
    "Have in your inventory 1 × Powercell (High) (rftoolspower:cell3). The items are not consumed by this task."
  ],
  "task.51301237D92DB7EB.title": "Obtain 1 × Dimensional Cell (Simple)",
  "quest.513011609660A466.title": "Obtain 1 × Dimensional Cell (Simple)",
  "quest.513011609660A466.quest_desc": [
    "Have in your inventory 1 × Dimensional Cell (Simple) (rftoolspower:dimensionalcell_simple). The items are not consumed by this task."
  ],
  "task.513012B8DED5DA6C.title": "Obtain 1 × Dimensional Cell",
  "quest.5130115EEDA64954.title": "Obtain 1 × Dimensional Cell",
  "quest.5130115EEDA64954.quest_desc": [
    "A Dimensional Cell stores FE and can share it with remote cells through a Powercell Card. Create or copy the link with the card, then configure the source side as In and the consumer side as Out.",
    "Check charging and discharge in the GUI. This is shared storage, not a generator; drawing remote energy also incurs losses, so generation must cover both the load and transfer."
  ],
  "task.513012484D511600.title": "Obtain 1 × Dimensional Cell (Advanced)",
  "quest.5130119B9A6344A6.title": "Obtain 1 × Dimensional Cell (Advanced)",
  "quest.5130119B9A6344A6.quest_desc": [
    "Have in your inventory 1 × Dimensional Cell (Advanced) (rftoolspower:dimensionalcell_advanced). The items are not consumed by this task."
  ],
  "task.513012745E211DE9.title": "Obtain 1 × Powercell Card",
  "quest.513011ADDC64CE6D.title": "Obtain 1 × Powercell Card",
  "quest.513011ADDC64CE6D.quest_desc": [
    "A Powercell Card carries the link between Dimensional Cells. A new card is unlinked: insert it into a cell to create a link, or use the copy slot for an existing one.",
    "Use the copied link for the second cell. Two independently created cards do not automatically connect their stores; verify the shared energy level after configuration."
  ],
  "task.513012B7C56C91DB.title": "Obtain 1 × Power Monitor",
  "quest.5130119D00218CE6.title": "Obtain 1 × Power Monitor",
  "quest.5130119D00218CE6.quest_desc": [
    "Have in your inventory 1 × Power Monitor (rftoolspower:power_monitor). The items are not consumed by this task."
  ],
  "task.513012EDBD59D51A.title": "Obtain 1 × Dimlet Workbench",
  "quest.513011D1FF814E23.title": "Obtain 1 × Dimlet Workbench",
  "quest.513011D1FF814E23.quest_desc": [
    "The Dimlet Workbench makes specific dimlets from known patterns and components. Place at least one Knowledge Holder next to it, select a known pattern and provide the listed parts.",
    "An empty dimlet does not define a desired biome or material by itself. Recipes can require discovered knowledge, essences and completed Absorbers; inspect the missing-ingredient list for the selected dimlet."
  ],
  "task.513012263490A743.title": "Obtain 1 × Enscriber",
  "quest.5130114A65EF4CF0.title": "Obtain 1 × Enscriber",
  "quest.5130114A65EF4CF0.quest_desc": [
    "The Enscriber writes a future dimension’s description into a Realized Dimension Tab. Insert an Empty Dimension Tab and arrange dimlets specifying terrain, biome or other properties.",
    "Review the resulting description and costs, then move the tab to a Dimension Builder. The Enscriber prepares the specification; it does not create the world or supply its ongoing power."
  ],
  "task.513012EDF4AE60FD.title": "Obtain 1 × Dimension Builder",
  "quest.513011675037BC60.title": "Obtain 1 × Dimension Builder",
  "quest.513011675037BC60.quest_desc": [
    "The Dimension Builder creates a dimension from a Realized Dimension Tab and continues to power it afterward. Insert the completed tab, supply FE and wait for creation to finish.",
    "Prepare sustained generation, an energy reserve and a return route before entering. Turning off the Builder does not make the dimension free to maintain: inadequate power makes it unsafe or unusable. Keep the tab holding that dimension’s data."
  ],
  "task.513012C8946DE0AA.title": "Obtain 1 × Dimension Editor",
  "quest.513011FC6CD40005.title": "Obtain 1 × Dimension Editor",
  "quest.513011FC6CD40005.quest_desc": [
    "Have in your inventory 1 × Dimension Editor (rftoolsdim:dimension_editor). The items are not consumed by this task."
  ],
  "task.513012F9110FCC34.title": "Obtain 1 × Empty Dimension Tab",
  "quest.513011B07AF737A1.title": "Obtain 1 × Empty Dimension Tab",
  "quest.513011B07AF737A1.quest_desc": [
    "Have in your inventory 1 × Empty Dimension Tab (rftoolsdim:empty_dimension_tab). The items are not consumed by this task."
  ],
  "task.513012212AB03E89.title": "Obtain 1 × Realized Dimension Tab",
  "quest.513011D9A7B833F9.title": "Obtain 1 × Realized Dimension Tab",
  "quest.513011D9A7B833F9.quest_desc": [
    "Have in your inventory 1 × Realized Dimension Tab (rftoolsdim:realized_dimension_tab). The items are not consumed by this task."
  ],
  "task.5130124D89B7A8F0.title": "Obtain 1 × Dimension Monitor",
  "quest.5130112B2ECBCBD4.title": "Obtain 1 × Dimension Monitor",
  "quest.5130112B2ECBCBD4.quest_desc": [
    "Have in your inventory 1 × Dimension Monitor (rftoolsdim:dimension_monitor). The items are not consumed by this task."
  ],
  "task.5130128732F8A7A1.title": "Obtain 1 × Activity Probe",
  "quest.513011AD1A5A5D57.title": "Obtain 1 × Activity Probe",
  "quest.513011AD1A5A5D57.quest_desc": [
    "Have in your inventory 1 × Activity Probe (rftoolsdim:activity_probe). The items are not consumed by this task."
  ],
  "task.513012F7D092455C.title": "Obtain 1 × Researcher",
  "quest.5130114D0F8A3E64.title": "Obtain 1 × Researcher",
  "quest.5130114D0F8A3E64.quest_desc": [
    "Have in your inventory 1 × Researcher (rftoolsdim:researcher). The items are not consumed by this task."
  ],
  "task.513012910E602EC7.title": "Obtain 1 × Knowledge Holder",
  "quest.5130116CDD372DD8.title": "Obtain 1 × Knowledge Holder",
  "quest.5130116CDD372DD8.quest_desc": [
    "Have in your inventory 1 × Knowledge Holder (rftoolsdim:knowledge_holder). The items are not consumed by this task."
  ],
  "task.513012C2A630C3AE.title": "Obtain 1 × Biome Absorber",
  "quest.513011555532A97D.title": "Obtain 1 × Biome Absorber",
  "quest.513011555532A97D.quest_desc": [
    "Have in your inventory 1 × Biome Absorber (rftoolsdim:biome_absorber). The items are not consumed by this task."
  ],
  "task.513012E0BE212C09.title": "Obtain 1 × Block Absorber",
  "quest.513011ABB7B23B90.title": "Obtain 1 × Block Absorber",
  "quest.513011ABB7B23B90.quest_desc": [
    "Have in your inventory 1 × Block Absorber (rftoolsdim:block_absorber). The items are not consumed by this task."
  ],
  "task.51301274F5B920C5.title": "Obtain 1 × Fluid Absorber",
  "quest.5130114BB60D0ED7.title": "Obtain 1 × Fluid Absorber",
  "quest.5130114BB60D0ED7.quest_desc": [
    "Have in your inventory 1 × Fluid Absorber (rftoolsdim:fluid_absorber). The items are not consumed by this task."
  ],
