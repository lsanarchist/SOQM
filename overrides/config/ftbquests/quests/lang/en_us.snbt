  "task.5130122890CB2BEE.title": "Obtain 1 × Fluix Dust",
  "quest.513011BBBBE02633.title": "Obtain 1 × Fluix Dust",
  "quest.513011BBBBE02633.quest_subtitle": "Stage 1 · Mod development",
  "quest.513011BBBBE02633.quest_desc": [
    "Have in your inventory 1 × Fluix Dust (ae2:fluix_dust). The items are not consumed by this task."
  ],
  "task.51301235887D38F0.title": "Obtain 1 × Fluix Crystal",
  "quest.513011020C4B1739.title": "First Fluix Crystals",
  "quest.513011020C4B1739.quest_subtitle": "Stage 1 · Mod development",
  "quest.513011020C4B1739.quest_desc": [
    "Drop Charged Certus Quartz, Nether Quartz and redstone together into water, wait for the conversion and collect the Fluix crystals.",
    "Ensure all three ingredients reach the same water block. Produce Fluix Dust from the finished crystals for subsequent recipes."
  ],
  "task.5130122C38517548.title": "Obtain 1 × Silicon",
  "quest.5130114314B68D20.title": "Obtain 1 × Silicon",
  "quest.5130114314B68D20.quest_subtitle": "Stage 1 · Main route",
  "quest.5130114314B68D20.quest_desc": [
    "Have in your inventory 1 × Silicon (ae2:silicon). The items are not consumed by this task."
  ],
  "task.513012AC52523C6E.title": "Obtain 1 × Inscriber Silicon Press",
  "quest.513011310DD7B8C1.title": "Obtain 1 × Inscriber Silicon Press",
  "quest.513011310DD7B8C1.quest_subtitle": "Stage 1 · Main route",
  "quest.513011310DD7B8C1.quest_desc": [
    "Have in your inventory 1 × Inscriber Silicon Press (ae2:silicon_press). The items are not consumed by this task."
  ],
  "task.5130124F6ED7B822.title": "Obtain 1 × Inscriber Logic Press",
  "quest.513011072CC6A803.title": "Obtain 1 × Inscriber Logic Press",
  "quest.513011072CC6A803.quest_subtitle": "Stage 1 · Mod development",
  "quest.513011072CC6A803.quest_desc": [
    "Have in your inventory 1 × Inscriber Logic Press (ae2:logic_processor_press). The items are not consumed by this task."
  ],
  "task.513012EDBC83CD0E.title": "Obtain 1 × Inscriber Engineering Press",
  "quest.513011659DFC96EC.title": "Obtain 1 × Inscriber Engineering Press",
  "quest.513011659DFC96EC.quest_subtitle": "Stage 1 · Mod development",
  "quest.513011659DFC96EC.quest_desc": [
    "Have in your inventory 1 × Inscriber Engineering Press (ae2:engineering_processor_press). The items are not consumed by this task."
  ],
  "task.513012896028E0AA.title": "Obtain 1 × Inscriber Calculation Press",
  "quest.513011D36DC0B032.title": "Obtain 1 × Inscriber Calculation Press",
  "quest.513011D36DC0B032.quest_subtitle": "Stage 1 · Main route",
  "quest.513011D36DC0B032.quest_desc": [
    "Have in your inventory 1 × Inscriber Calculation Press (ae2:calculation_processor_press). The items are not consumed by this task."
  ],
  "task.513012250281BA28.title": "Obtain 1 × Charger",
  "quest.5130110AD7EC7A65.title": "Charger: Charge the Quartz",
  "quest.5130110AD7EC7A65.quest_subtitle": "Stage 1 · Mod development",
  "quest.5130110AD7EC7A65.quest_desc": [
    "Power the Charger, insert a Certus Quartz Crystal and collect the charged crystal after conversion.",
    "The water recipe for Fluix needs Charged Certus Quartz. An ordinary crystal or dust is not a substitute; the Charger is not general-purpose AE2 storage."
  ],
  "task.5130128C9FC78A0D.title": "Obtain 1 × Inscriber",
  "quest.513011CFBA3A9CF5.title": "Inscriber: From Print to Processor",
  "quest.513011CFBA3A9CF5.quest_subtitle": "Stage 1 · Main route",
  "quest.513011CFBA3A9CF5.quest_desc": [
    "Supply FE directly or AE power. For a Calculation Processor, print its circuit with the matching press and print silicon separately; then combine both prints with redstone.",
    "Presses are reusable. Remove the press for final assembly and arrange the printed parts as the recipe shows. Make a small batch before spending processors on the Precision Mechanism.",
    "Non-sided mode simplifies transport. In sided mode, the top and bottom access the outer slots, while the horizontal faces serve the middle input and finished output."
  ],
  "task.5130120E4909DA82.title": "Obtain 1 × Energy Acceptor",
  "quest.513011C6833500D4.title": "Power a Small ME Network",
  "quest.513011C6833500D4.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011C6833500D4.quest_desc": [
    "The Energy Acceptor converts external power into AE. Connect your generator to the acceptor and connect the acceptor to the network’s Fluix cable.",
    "Test with an ME Drive containing a storage cell and a Terminal. If moving a stack makes the network flicker, check sustained power and add an Energy Cell to handle the brief peak."
  ],
  "task.5130121CC1D10C6D.title": "Obtain 1 × Vibration Chamber",
  "quest.5130110F54E2C3D4.title": "Obtain 1 × Vibration Chamber",
  "quest.5130110F54E2C3D4.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130110F54E2C3D4.quest_desc": [
    "Have in your inventory 1 × Vibration Chamber (ae2:vibration_chamber). The items are not consumed by this task."
  ],
  "task.5130129406087EFD.title": "Obtain 1 × Energy Cell",
  "quest.513011F37B07AD68.title": "Energy Cell: Buffer the Peaks",
  "quest.513011F37B07AD68.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011F37B07AD68.quest_desc": [
    "Connect the Energy Cell to the ME network and let it charge. It increases the network’s energy buffer, not item capacity or channel count.",
    "Test a large item transfer in the terminal. If charge keeps falling afterwards, demand exceeds generation; a bigger battery only postpones the shutdown."
  ],
  "task.51301233041C70BC.title": "Obtain 1 × Dense Energy Cell",
  "quest.5130117C8CDC4800.title": "Obtain 1 × Dense Energy Cell",
  "quest.5130117C8CDC4800.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130117C8CDC4800.quest_desc": [
    "Have in your inventory 1 × Dense Energy Cell (ae2:dense_energy_cell). The items are not consumed by this task."
  ],
  "task.513012050E48F8ED.title": "Obtain 1 × Quartz Fiber",
  "quest.513011A5B6C4DF0D.title": "Quartz Fiber: Power without Merging",
  "quest.513011A5B6C4DF0D.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011A5B6C4DF0D.quest_desc": [
    "Quartz Fiber shares power between two ME networks while keeping their channels and storage separate. Use it to supply a small subnetwork beside the main one.",
    "After connecting it, check that both networks have power. The second network’s items should not become visible in the first terminal merely because the fiber is present."
  ],
  "task.513012F76B42AF33.title": "Obtain 4 × Fluix ME Glass Cable",
  "quest.5130117628101229.title": "Fluix Cable and Eight Channels",
  "quest.5130117628101229.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130117628101229.quest_desc": [
    "Connect the Energy Acceptor, ME Drive and Terminal. In standard mode, ordinary cable carries up to eight channels; check each attached device.",
    "A controller-free network also has a total limit of eight channel-using devices. Adding cable does not increase that limit. Smart Cable makes channel usage visible."
  ],
  "task.513012C3C7D4B739.title": "Obtain 4 × Fluix ME Covered Cable",
  "quest.513011613E92ADD0.title": "Obtain 4 × Fluix ME Covered Cable",
  "quest.513011613E92ADD0.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011613E92ADD0.quest_desc": [
    "Have in your inventory 4 × Fluix ME Covered Cable (ae2:fluix_covered_cable). The items are not consumed by this task."
  ],
  "task.5130122CD22290AC.title": "Obtain 4 × Fluix ME Smart Cable",
  "quest.513011EFF7B42EB6.title": "Obtain 4 × Fluix ME Smart Cable",
  "quest.513011EFF7B42EB6.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011EFF7B42EB6.quest_desc": [
    "Have in your inventory 4 × Fluix ME Smart Cable (ae2:fluix_smart_cable). The items are not consumed by this task."
  ],
  "task.513012D2D656EA2A.title": "Obtain 4 × Fluix ME Dense Smart Cable",
  "quest.513011FEDA3CDB61.title": "Dense Cable for the Trunk",
  "quest.513011FEDA3CDB61.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011FEDA3CDB61.quest_desc": [
    "In standard mode, Dense Cable carries up to 32 channels. Branch to devices with ordinary cable, which has its own eight-channel limit.",
    "Dense cable does not increase a controller-free network’s overall limit. Avoid putting an ordinary block or cable in the trunk, because that section can restrict it to eight channels again."
  ],
  "task.5130125DD09D02F1.title": "Obtain 1 × ME Drive",
  "quest.5130117C40A8D2E1.title": "ME Drive: First Digital Storage",
  "quest.5130117C40A8D2E1.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130117C40A8D2E1.quest_desc": [
    "Prepare an Iron Chests gold chest, iron blocks, Engineering Processors, Fluix cables, Control Assembly and Precision Mechanism. Open JEI for the complete current recipe.",
    "Connect the finished Drive to a powered ME network and insert an Item Storage Cell. An empty Drive cannot store items.",
    "Insert and retrieve several different items through the Terminal. If storage fills unexpectedly, check both byte capacity and the cell’s type count; they are separate limits."
  ],
  "task.51301274F95658ED.title": "Obtain 1 × ME Terminal",
  "quest.5130112C9685F877.title": "Terminal: Test Storage Access",
  "quest.5130112C9685F877.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130112C9685F877.quest_desc": [
    "Place the Terminal on a connected ME cable and right-click it. It displays the cells and other storage available to that network.",
    "Insert a simple item, close the screen and retrieve it again. If a cell is installed but the list remains empty, check power, channels and whether the cell stores the right resource type."
  ],
  "task.513012EF0F7A8DC6.title": "Obtain 1 × ME Chest",
  "quest.51301145AC657CE8.title": "Obtain 1 × ME Chest",
  "quest.51301145AC657CE8.quest_subtitle": "Stage 2 · Mod development",
  "quest.51301145AC657CE8.quest_desc": [
    "Have in your inventory 1 × ME Chest (ae2:chest). The items are not consumed by this task."
  ],
  "task.5130123B461D5BCE.title": "Automatic: craft in a live ME terminal",
  "quest.513011AAD4652E6F.title": "First Craft in an ME Terminal",
  "quest.513011AAD4652E6F.quest_subtitle": "Stage 2 · Practice",
  "quest.513011AAD4652E6F.quest_desc": [
    "Connect a Crafting Terminal to a live network with storage. Keep at least one spare item, such as cobblestone, in ME storage, then turn a log into planks in the terminal grid and take the result.",
    "Completion requires a real terminal craft with active power, a channel and nonempty network storage at the time of crafting. Owning the block, an empty network or an ordinary crafting table does not satisfy this check.",
    "This is manual crafting backed by network storage. Request-based autocrafting additionally needs a pattern, Pattern Provider, Molecular Assembler and a CPU with crafting storage."
  ],
  "task.513012209E5D4EC3.title": "Network Engineer",
  "quest.513011D4AD7B73EE.title": "Network Engineer",
  "quest.513011D4AD7B73EE.quest_subtitle": "Stage 3 · Practice",
  "quest.513011D4AD7B73EE.quest_desc": [
    "Earn the native advancement Network Engineer (ae2:main/network2). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.513012E3F3D6DD8A.title": "Trade with an AE2 Engineer",
  "quest.51301121BA7BE430.title": "Trade with an AE2 Engineer",
  "quest.51301121BA7BE430.quest_subtitle": "Stage 3 · Practice",
  "quest.51301121BA7BE430.quest_desc": [
    "Complete a real trade with the AE2 Better Villagers Engineer profession. Assign its correct workstation first; this check distinguishes the actual profession."
  ],
  "task.5130124A1FFEEA7F.title": "Trade with an AE2 Specialist",
  "quest.513011543F29EA68.title": "Trade with an AE2 Specialist",
  "quest.513011543F29EA68.quest_subtitle": "Stage 3 · Practice",
  "quest.513011543F29EA68.quest_desc": [
    "Complete a real trade with the AE2 Better Villagers Specialist profession. Assign its correct workstation first; this check distinguishes the actual profession."
  ],
  "task.5130124BCB48FA8B.title": "Obtain 1 × ME Controller",
  "quest.5130119BD717861F.title": "Controller: Grow beyond Eight Channels",
  "quest.5130119BD717861F.quest_subtitle": "Stage 3 · Mod development",
  "quest.5130119BD717861F.quest_desc": [
    "The Controller unlocks a larger network after Dimensional Matrix. In standard mode, each available face can supply up to 32 channels through suitable cable.",
    "Use Dense Cable for trunks and ordinary cable for device branches. Inspect each route: a shortcut through an ordinary block may become a bottleneck.",
    "Provide enough power and buffering for the growing load. A Controller does not enlarge the storage cells already installed."
  ],
  "task.5130126EEF9EB2CE.title": "Obtain 1 × 1k ME Storage Component",
  "quest.513011F797E11624.title": "1k Component: Start Small",
  "quest.513011F797E11624.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011F797E11624.quest_desc": [
    "The 1k Cell Component is an ingredient for item or fluid cells and for the smallest Crafting Storage. The bare component does not work in a Drive.",
    "Choose the result in JEI: an Item Storage Cell stores items, while 1k Crafting Storage can form a CPU for one small job. Sharing a size name does not make them interchangeable."
  ],
  "task.513012F087EA96B4.title": "Obtain 1 × 4k ME Storage Component",
  "quest.5130114905904323.title": "4k: Scale after the Matrix",
  "quest.5130114905904323.quest_subtitle": "Stage 3 · Mod development",
  "quest.5130114905904323.quest_desc": [
    "The 4k Cell Component requires smaller components and a Dimensional Matrix. This milestone opens larger cells and CPUs; the first small system can use 1k earlier.",
    "Decide whether you need more item storage or more memory for one crafting job. Item Storage Cells and Crafting Storage solve different problems."
  ],
  "task.513012865E85D847.title": "Obtain 1 × 16k ME Storage Component",
  "quest.513011BBCA06FEA6.title": "16k: Scale after the Matrix",
  "quest.513011BBCA06FEA6.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011BBCA06FEA6.quest_desc": [
    "The 16k Cell Component requires smaller components and a Dimensional Matrix. This milestone opens larger cells and CPUs; the first small system can use 1k earlier.",
    "Decide whether you need more item storage or more memory for one crafting job. Item Storage Cells and Crafting Storage solve different problems."
  ],
  "task.5130121BB73A7833.title": "Obtain 1 × 64k ME Storage Component",
  "quest.513011DA15992023.title": "Obtain 1 × 64k ME Storage Component",
  "quest.513011DA15992023.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011DA15992023.quest_desc": [
    "Have in your inventory 1 × 64k ME Storage Component (ae2:cell_component_64k). The items are not consumed by this task."
  ],
  "task.513012955BA7AC47.title": "Obtain 1 × 256k ME Storage Component",
  "quest.5130110B5D09E918.title": "Obtain 1 × 256k ME Storage Component",
  "quest.5130110B5D09E918.quest_subtitle": "Stage 3 · Mod development",
  "quest.5130110B5D09E918.quest_desc": [
    "Have in your inventory 1 × 256k ME Storage Component (ae2:cell_component_256k). The items are not consumed by this task."
  ],
  "task.513012459C09A8DC.title": "Obtain 1 × ME Item Cell Housing",
  "quest.5130119E287D7DB8.title": "Obtain 1 × ME Item Cell Housing",
  "quest.5130119E287D7DB8.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130119E287D7DB8.quest_desc": [
    "Have in your inventory 1 × ME Item Cell Housing (ae2:item_cell_housing). The items are not consumed by this task."
  ],
  "task.5130120B76C2991D.title": "Obtain 1 × ME Fluid Cell Housing",
  "quest.5130114BF00256A0.title": "Obtain 1 × ME Fluid Cell Housing",
  "quest.5130114BF00256A0.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130114BF00256A0.quest_desc": [
    "Have in your inventory 1 × ME Fluid Cell Housing (ae2:fluid_cell_housing). The items are not consumed by this task."
  ],
  "task.513012A97DC4D97E.title": "Obtain 1 × 1k ME Item Storage Cell",
  "quest.5130115B3F92B69A.title": "1k Item Cell: Insert and Test",
  "quest.5130115B3F92B69A.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130115B3F92B69A.quest_desc": [
    "Combine the 1k component with an item-cell housing and insert the completed Item Storage Cell into an ME Drive.",
    "Store several material types through the Terminal. The cell has both byte and type limits; adding more of an existing item differs from introducing another type."
  ],
  "task.5130121783B21A34.title": "Obtain 1 × 4k ME Item Storage Cell",
  "quest.51301182CE3A5863.title": "Obtain 1 × 4k ME Item Storage Cell",
  "quest.51301182CE3A5863.quest_subtitle": "Stage 3 · Mod development",
  "quest.51301182CE3A5863.quest_desc": [
    "Have in your inventory 1 × 4k ME Item Storage Cell (ae2:item_storage_cell_4k). The items are not consumed by this task."
  ],
  "task.513012936B8E9614.title": "Obtain 1 × 16k ME Item Storage Cell",
  "quest.5130113F18CF3F87.title": "Obtain 1 × 16k ME Item Storage Cell",
  "quest.5130113F18CF3F87.quest_subtitle": "Stage 3 · Mod development",
  "quest.5130113F18CF3F87.quest_desc": [
    "Have in your inventory 1 × 16k ME Item Storage Cell (ae2:item_storage_cell_16k). The items are not consumed by this task."
  ],
  "task.513012636E5BC09C.title": "Obtain 1 × 64k ME Item Storage Cell",
  "quest.513011BB9E9B9B54.title": "Obtain 1 × 64k ME Item Storage Cell",
  "quest.513011BB9E9B9B54.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011BB9E9B9B54.quest_desc": [
    "Have in your inventory 1 × 64k ME Item Storage Cell (ae2:item_storage_cell_64k). The items are not consumed by this task."
  ],
  "task.513012187E9499ED.title": "Obtain 1 × 256k ME Item Storage Cell",
  "quest.513011CBF904C144.title": "Obtain 1 × 256k ME Item Storage Cell",
  "quest.513011CBF904C144.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011CBF904C144.quest_desc": [
    "Have in your inventory 1 × 256k ME Item Storage Cell (ae2:item_storage_cell_256k). The items are not consumed by this task."
  ],
  "task.5130120009680380.title": "Obtain 1 × 1k ME Fluid Storage Cell",
  "quest.5130116FD5A290E7.title": "Obtain 1 × 1k ME Fluid Storage Cell",
  "quest.5130116FD5A290E7.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130116FD5A290E7.quest_desc": [
    "Have in your inventory 1 × 1k ME Fluid Storage Cell (ae2:fluid_storage_cell_1k). The items are not consumed by this task."
  ],
  "task.513012AC19A2AEDC.title": "Obtain 1 × Blank Pattern",
  "quest.5130118AC1E7A654.title": "Blank Pattern: Recipe Medium",
  "quest.5130118AC1E7A654.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130118AC1E7A654.quest_desc": [
    "Insert a Blank Pattern into the Pattern Encoding Terminal. Choose Crafting for a crafting-table recipe or Processing for an external machine operation.",
    "A blank pattern does not register a recipe with the network. After encoding, move the resulting pattern into a Pattern Provider next to its executor."
  ],
  "task.513012CF771A827B.title": "Obtain 1 × ME Pattern Encoding Terminal",
  "quest.513011E89C668AA7.title": "Encode the First Pattern",
  "quest.513011E89C668AA7.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011E89C668AA7.quest_desc": [
    "Choose Crafting in the Pattern Encoding Terminal and transfer a simple recipe such as logs into planks. Check the output and quantity, insert a Blank Pattern and encode it.",
    "Place a Pattern Provider beside a Molecular Assembler and put the pattern in the Provider. Connect a CPU too; a single 1k Crafting Storage is enough for the first test.",
    "Store the ingredients in ME and request a small batch through the Terminal. If the recipe is absent, check the pattern slot, power and the Provider’s channel."
  ],
  "task.513012D33E94EEDF.title": "Obtain 1 × Crafting Pattern",
  "quest.5130112A016321B8.title": "Crafting Pattern: Table Recipe",
  "quest.5130112A016321B8.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130112A016321B8.quest_desc": [
    "This pattern describes an ordinary crafting-table recipe. Insert it into a Pattern Provider touching a Molecular Assembler; the assembler can return its result through that adjacent Provider.",
    "Test one operation, then a small batch. A Processing Pattern with matching icons does not turn an arbitrary machine into a crafting table."
  ],
  "task.5130121DDF4D0D47.title": "Obtain 1 × Processing Pattern",
  "quest.513011F60668F4F2.title": "Processing Pattern: External Machine",
  "quest.513011F60668F4F2.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011F60668F4F2.quest_desc": [
    "In Processing mode, specify the operation’s exact item inputs and expected outputs. The Provider must deliver those inputs to the correct machine slots.",
    "Return the product into ME through an Import Bus, Interface or the Provider’s return slots. A chest with a Storage Bus alone does not notify the CPU that processing finished.",
    "Request one simple cycle first. For a Metallurgic Infuser, supply the correct reagent through its Extra input separately; an item pattern does not configure the infusion buffer."
  ],
  "task.51301208301BFEF6.title": "Obtain 1 × ME Pattern Provider",
  "quest.513011562F81FD24.title": "Pattern Provider: Send the Job",
  "quest.513011562F81FD24.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011562F81FD24.quest_desc": [
    "Connect the Provider to ME and place it directly beside a Molecular Assembler or the input of an external machine. Insert the corresponding encoded pattern.",
    "The Provider supplies ingredients when a CPU requests them. Crafting uses an assembler; Processing uses a configured machine and a return path for its product.",
    "If a job waits indefinitely, inspect the machine’s input face, free space and exact returned output. Adding another pattern does not fix a broken route."
  ],
  "task.513012C0F6997271.title": "Obtain 1 × Molecular Assembler",
  "quest.5130112D00658B23.title": "Molecular Assembler: Execute the Recipe",
  "quest.5130112D00658B23.quest_subtitle": "Stage 2 · Mod development",
  "quest.5130112D00658B23.quest_desc": [
    "The assembler executes Crafting Patterns. For basic autocrafting, place it beside a networked Pattern Provider and insert the pattern in the Provider.",
    "Supply power and a CPU with Crafting Storage; a Crafting Unit alone has no job storage. Test a plank recipe before complex cross-mod chains.",
    "The expert recipe retains the complete RFTools Crafter T1, control electronics and Precision Mechanism. Industrial Chassis allows this first setup before Dimensional Matrix."
  ],
  "task.51301235635B8FFB.title": "Obtain 1 × Crafting Unit",
  "quest.513011B5F7F592D8.title": "A Crafting Unit Is Not Yet a CPU",
  "quest.513011B5F7F592D8.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011B5F7F592D8.quest_desc": [
    "A Crafting Unit is a base ingredient and a filler block for CPU shape. It cannot accept jobs by itself: the CPU needs at least one Crafting Storage block.",
    "For the smallest CPU, combine a Unit with a 1k Cell Component and connect the resulting 1k Crafting Storage to ME. Larger CPUs must form a solid rectangular prism without gaps.",
    "The Unit recipe retains the Ender IO Crafter, processors, iron block and Precision Mechanism. Dimensional Matrix is reserved for scaling to larger components."
  ],
  "task.5130129AF1D53B60.title": "Obtain 1 × 1k Crafting Storage",
  "quest.513011DEEBB429E9.title": "First CPU: 1k Crafting Storage",
  "quest.513011DEEBB429E9.quest_subtitle": "Stage 2 · Mod development",
  "quest.513011DEEBB429E9.quest_desc": [
    "A single 1k Crafting Storage is the smallest working CPU. Connect it to the same network as the Pattern Provider and request one simple operation.",
    "Each separate CPU handles one job. Storage limits job size; the external machine’s processing speed is a different constraint.",
    "Start with planks, then test a few connected patterns. Larger batches or simultaneous jobs call for later components and additional CPUs."
  ],
  "task.513012E2C0FDBE9D.title": "Obtain 1 × 4k Crafting Storage",
  "quest.513011E167D89EF9.title": "Obtain 1 × 4k Crafting Storage",
  "quest.513011E167D89EF9.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011E167D89EF9.quest_desc": [
    "Have in your inventory 1 × 4k Crafting Storage (ae2:4k_crafting_storage). The items are not consumed by this task."
  ],
  "task.5130121F900C525C.title": "Obtain 1 × 16k Crafting Storage",
  "quest.51301163BFF719DB.title": "Obtain 1 × 16k Crafting Storage",
  "quest.51301163BFF719DB.quest_subtitle": "Stage 3 · Mod development",
  "quest.51301163BFF719DB.quest_desc": [
    "Have in your inventory 1 × 16k Crafting Storage (ae2:16k_crafting_storage). The items are not consumed by this task."
  ],
  "task.513012DBF9D370BE.title": "Obtain 1 × 64k Crafting Storage",
  "quest.513011CF924A9057.title": "Obtain 1 × 64k Crafting Storage",
  "quest.513011CF924A9057.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011CF924A9057.quest_desc": [
    "Have in your inventory 1 × 64k Crafting Storage (ae2:64k_crafting_storage). The items are not consumed by this task."
  ],
  "task.5130124DD70F8B5F.title": "Obtain 1 × 256k Crafting Storage",
  "quest.51301108632D508B.title": "Obtain 1 × 256k Crafting Storage",
  "quest.51301108632D508B.quest_subtitle": "Stage 3 · Mod development",
  "quest.51301108632D508B.quest_desc": [
    "Have in your inventory 1 × 256k Crafting Storage (ae2:256k_crafting_storage). The items are not consumed by this task."
  ],
  "task.5130121E2CA20420.title": "Obtain 1 × Crafting Co-Processing Unit",
  "quest.51301148D4813782.title": "Obtain 1 × Crafting Co-Processing Unit",
  "quest.51301148D4813782.quest_subtitle": "Stage 3 · Mod development",
  "quest.51301148D4813782.quest_desc": [
    "Have in your inventory 1 × Crafting Co-Processing Unit (ae2:crafting_accelerator). The items are not consumed by this task."
  ],
  "task.51301296BC364FDB.title": "Obtain 1 × Crafting Monitor",
  "quest.5130116D325212F4.title": "Obtain 1 × Crafting Monitor",
  "quest.5130116D325212F4.quest_subtitle": "Stage 3 · Mod development",
  "quest.5130116D325212F4.quest_desc": [
    "Have in your inventory 1 × Crafting Monitor (ae2:crafting_monitor). The items are not consumed by this task."
  ],
  "task.51301209F88A62B8.title": "Obtain 1 × ME Wireless Access Point",
  "quest.5130111C6FFD51A9.title": "Wireless Access Point: Pair a Terminal",
  "quest.5130111C6FFD51A9.quest_subtitle": "Stage 3 · Optional branch",
  "quest.5130111C6FFD51A9.quest_desc": [
    "Connect the Access Point to ME and provide a channel. Insert a wireless terminal into the top-right slot of its interface to pair it with that network.",
    "Charge the terminal and test access nearby. Wireless Boosters change range and power demand; check actual coverage before expanding."
  ],
  "task.51301236CF93AFFB.title": "Obtain 1 × Wireless Receiver",
  "quest.51301150484DEC3C.title": "Wireless Receiver: Radio Component",
  "quest.51301150484DEC3C.quest_subtitle": "Stage 3 · Optional branch",
  "quest.51301150484DEC3C.quest_desc": [
    "The Wireless Receiver is a crafting component for wireless equipment. The item alone does not provide coverage or pair a terminal.",
    "The working network device is a Wireless Access Point on live ME. Pair the completed terminal through the Access Point’s slot and keep the terminal charged."
  ],
  "task.513012A4DF3171D0.title": "Obtain 1 × Wireless Booster",
  "quest.513011399BE50497.title": "Wireless Booster: Extend Coverage",
  "quest.513011399BE50497.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011399BE50497.quest_desc": [
    "Install the Booster in a Wireless Access Point, not a storage cell. It increases the point’s range and energy demand.",
    "Test the desired distance and resulting load. A second access point near a remote workshop may be more convenient than maximizing one point’s range."
  ],
  "task.513012630E92D6FA.title": "Obtain 1 × Wireless Terminal",
  "quest.5130110CD6572A2C.title": "Wireless Item Access",
  "quest.5130110CD6572A2C.quest_subtitle": "Stage 3 · Optional branch",
  "quest.5130110CD6572A2C.quest_desc": [
    "Charge the Wireless Terminal in a Charger. Pair it through the top-right slot of a connected Wireless Access Point.",
    "Open it near the point, retrieve an item and test it farther away. Access requires terminal charge, a live network and access-point coverage at the same time."
  ],
  "task.513012FA8CE841FF.title": "Obtain 1 × Wireless Crafting Terminal",
  "quest.513011C40B19897D.title": "Wireless Crafting Grid",
  "quest.513011C40B19897D.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011C40B19897D.quest_desc": [
    "The Wireless Crafting Terminal adds a manual recipe grid to portable access. Charge it and pair it in a Wireless Access Point just like the ordinary wireless terminal.",
    "Test a simple craft within coverage. The manual grid does not replace CPUs and patterns for automatic crafting requests."
  ],
  "task.513012CB03443786.title": "Obtain 1 × ME Quantum Link Chamber",
  "quest.5130112D86FBD3AF.title": "Quantum Link: Center of a Remote Bridge",
  "quest.5130112D86FBD3AF.quest_subtitle": "Stage 3 · Optional branch",
  "quest.5130112D86FBD3AF.quest_desc": [
    "Place the Quantum Link Chamber in the center of a flat ring of eight Quantum Rings. A working connection requires this structure at both endpoints.",
    "Insert the two singularities from one entangled pair into the center chambers. A lone chamber without its complete ring does not connect to a network."
  ],
  "task.5130126E97134AF5.title": "Obtain 1 × Quantum Entangled Singularity",
  "quest.513011C1618FC593.title": "Paired Quantum Singularities",
  "quest.513011C1618FC593.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011C1618FC593.quest_desc": [
    "An explosive reaction between a Singularity and an Ender Pearl or Ender Dust creates an entangled pair. Use a separate work area where you can recover both results.",
    "Keep each pair together and label it. A Quantum Bridge needs one member of the same pair at each endpoint; unrelated singularities will not link."
  ],
  "task.513012F79F22C925.title": "Obtain 1 × ME P2P Tunnel",
  "quest.513011E0DFFECB6C.title": "ME P2P: Link Input and Output",
  "quest.513011E0DFFECB6C.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011E0DFFECB6C.quest_desc": [
    "ME P2P transports channels across a network that powers the tunnels themselves. Build a pair on one support network; each endpoint also consumes a channel there.",
    "With a Memory Card, shift-right-click the input to create a frequency, then right-click the output to copy it. A pair carries up to 32 channels in standard mode; multiple outputs share them.",
    "Check matching frequencies, power and both endpoint channels. Nesting ME P2P inside another ME P2P does not create unlimited channels."
  ],
  "task.513012854A9B495E.title": "Obtain 1 × Item P2P Tunnel",
  "quest.513011578532ED51.title": "Item P2P: Carry an Item Flow",
  "quest.513011578532ED51.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011578532ED51.quest_desc": [
    "Attune the tunnel to items by right-clicking it with a chest or hopper. Link input and output with a Memory Card: shift-right-click the input, then right-click the output.",
    "Feed the input with a hopper or another active inserter and place storage at the output. The pair remotely connects faces; two passive chests will not transfer items by themselves."
  ],
  "task.51301227812252F0.title": "Obtain 1 × Fluid P2P Tunnel",
  "quest.51301162B4562E25.title": "Fluid P2P: A Separate Fluid Route",
  "quest.51301162B4562E25.quest_subtitle": "Stage 3 · Optional branch",
  "quest.51301162B4562E25.quest_desc": [
    "Attune the tunnel with a bucket or bottle and link the pair with a Memory Card. Push fluid into the input using a pump or extracting pipe, with a tank at the output.",
    "Test a small amount. The tunnel moves fluid between faces; it does not automatically store it in a Fluid Storage Cell, and Mekanism chemicals need compatible transport of their own."
  ],
  "task.513012BE81016256.title": "Obtain 1 × Energy P2P Tunnel",
  "quest.513011285F6711C0.title": "FE P2P: Carry External Power",
  "quest.513011285F6711C0.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011285F6711C0.quest_desc": [
    "Attune the tunnel with an energy-containing item and link the pair with a Memory Card. Connect generation to the input and a consumer to the output while keeping the tunnels on a live ME network.",
    "This carries FE to another machine; it does not replace an Energy Acceptor. Transfer increases the tunnels’ AE demand, so test the power balance under load."
  ],
  "task.5130124BE9174F62.title": "Obtain 1 × Redstone P2P Tunnel",
  "quest.513011DF59EDD6B8.title": "Redstone P2P: Carry a Signal",
  "quest.513011DF59EDD6B8.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011DF59EDD6B8.quest_desc": [
    "Attune the tunnels with a redstone component and pair them with a Memory Card. Feed the input from a lever and place a lamp or other indicator at the output.",
    "Test both lever states. This tunnel carries a redstone signal, not items or FE power."
  ],
  "task.513012370906CFBC.title": "Obtain 1 × ME Formation Plane",
  "quest.513011F21184218C.title": "Formation Plane: Place a Block",
  "quest.513011F21184218C.quest_subtitle": "Stage 3 · Optional branch",
  "quest.513011F21184218C.quest_desc": [
    "The Formation Plane places blocks or drops items in front of its face when they are inserted into its network. Test on a separate subnetwork with one allowed material in its filter.",
    "Insert an item through an Interface or Import Bus and check the target space. Storage priorities affect a shared network; claimed chunks must allow the relevant fake-player placement actions."
  ],
  "task.513012A15026DF55.title": "Obtain 1 × ME Annihilation Plane",
  "quest.51301142E35FA369.title": "Annihilation Plane: Collect a Block",
  "quest.51301142E35FA369.quest_subtitle": "Stage 3 · Optional branch",
  "quest.51301142E35FA369.quest_desc": [
    "The Annihilation Plane breaks the block in front of it or collects items touching its face. It operates only when its network can store the result.",
    "Filter it using a separate subnetwork whose storage accepts the desired drops. The filter applies to the dropped result, so Silk Touch and normal drops produce different conditions.",
    "Test a cheap block, free cell space and fake-player permissions in claimed chunks. This device is not an area-wide item magnet."
  ],
  "task.513012BB891644BA.title": "Network Administrator",
  "quest.51301121F7B8F501.title": "Network Administrator",
  "quest.51301121F7B8F501.quest_subtitle": "Stage 4 · Practice",
  "quest.51301121F7B8F501.quest_desc": [
    "Earn the native advancement Network Administrator (ae2:main/network3). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.513012FF3B2E2CE3.title": "To boldly go",
  "quest.5130116CC5036025.title": "A Room in Spatial Storage",
  "quest.5130116CC5036025.quest_subtitle": "Stage 4 · Optional branch",
  "quest.5130116CC5036025.quest_desc": [
    "After the single-block test, prepare a small room within the Pylons. Check its exact X/Y/Z in the Spatial IO Port, sufficient stored energy and a suitably sized cell.",
    "Perform the store-and-restore cycle from outside the volume. Entering it is a separate step requiring an independent return method; merely owning a spatial cell is insufficient."
  ],
  "task.513012A66B8E78CF.title": "Recursive Networking",
  "quest.5130111631820BC6.title": "Recursive Networking",
  "quest.5130111631820BC6.quest_subtitle": "Stage 4 · Optional branch",
  "quest.5130111631820BC6.quest_desc": [
    "Earn the native advancement Recursive Networking (ae2:main/recursive). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.5130129BA8AEC991.title": "Obtain 1 × ME Quantum Ring",
  "quest.5130112C1D24E77E.title": "Quantum Bridge: Two Loaded Endpoints",
  "quest.5130112C1D24E77E.quest_subtitle": "Stage 4 · Optional branch",
  "quest.5130112C1D24E77E.quest_desc": [
    "At each endpoint, build eight Quantum Rings around a Link Chamber, insert matching singularities and connect cable to a ring next to the center. Corner rings do not connect to cables.",
    "Both endpoints need power and loaded chunks. In standard mode the bridge carries 32 channels in total, even with cables attached to several faces.",
    "Test the bridge between nearby platforms before moving it between bases or dimensions."
  ],
  "task.5130125E7C4A5C2C.title": "Obtain 1 × Spatial IO Port",
  "quest.51301112D49F4FE1.title": "Spatial IO: Start with One Block",
  "quest.51301112D49F4FE1.quest_subtitle": "Stage 4 · Optional branch",
  "quest.51301112D49F4FE1.quest_desc": [
    "Connect the port and Spatial Pylons to one dedicated ME network. Start with a small volume from a Guide diagram and inspect its dimensions and required energy in the port.",
    "Insert a blank Spatial Storage Cell and pulse the port with redstone from outside the volume. Test a cheap block, then repeat with the same cell to bring it back.",
    "The operation swaps the entire volume, including entities. Stand outside during testing. A cell’s dimensions become fixed on first use and cannot be reformatted."
  ],
