  "quest.513011B19833AABF.quest_desc": [
    "Have in your inventory 1 × Infused Hellshelf (apothic_enchanting:infused_hellshelf). The items are not consumed by this task."
  ],
  "task.51301203766DB094.title": "Obtain 1 × Blazing Hellshelf",
