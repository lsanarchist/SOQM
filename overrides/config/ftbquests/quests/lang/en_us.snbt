  "task.514D122B1B1155E6.title": "Obtain 2 × Electric Pump",
  "task.514D126191337D7E.title": "Obtain 8 × Elite Mechanical Pipe",
  "task.514D12FD3660093C.title": "Obtain 1 × Fission Reactor Logic Adapter",
  "task.514D124717B8D25F.title": "Manual check: Cooling before Ignition",
  "quest.514D1144187ECDB7.title": "Cooling before Ignition",
  "quest.514D1144187ECDB7.quest_subtitle": "Stage 4 · Main route",
  "quest.514D1144187ECDB7.quest_desc": [
    "Have in your inventory 2 × Electric Pump (mekanism:electric_pump). The items are not consumed by this task.",
    "Have in your inventory 8 × Elite Mechanical Pipe (mekanism:elite_mechanical_pipe). The items are not consumed by this task.",
    "Have in your inventory 1 × Fission Reactor Logic Adapter (mekanismgenerators:fission_reactor_logic_adapter). The items are not consumed by this task.",
    "Manually confirm while the reactor is OFF: fill the cooling circuit, test coolant input and heated output, and configure an emergency shutdown. Match pumps, pipes and consumers to the intended operating rate. Item detection cannot prove that this system is safe."
  ],
