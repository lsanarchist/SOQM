  ],
  "task.5130123E73604F14.title": "Obtain 1 × Starcaller",
  "quest.5130112919942EFB.title": "Obtain 1 × Starcaller",
  "quest.5130112919942EFB.quest_desc": [
    "Have in your inventory 1 × Starcaller (botania:star_sword). The items are not consumed by this task."
  ],
  "task.513012520431ED43.title": "Obtain 1 × Thundercaller",
  "quest.513011682F5E6E47.title": "Obtain 1 × Thundercaller",
  "quest.513011682F5E6E47.quest_desc": [
    "Have in your inventory 1 × Thundercaller (botania:thunder_sword). The items are not consumed by this task."
  ],
  "task.513012FBB696FBB5.title": "Obtain 1 × Mana Blaster",
  "quest.51301171892A045E.title": "Obtain 1 × Mana Blaster",
  "quest.51301171892A045E.quest_desc": [
    "Have in your inventory 1 × Mana Blaster (botania:mana_gun). The items are not consumed by this task."
  ],
  "task.5130124693E3E919.title": "Obtain 1 × Rod of the Depths",
  "quest.513011A450B42F4E.title": "Obtain 1 × Rod of the Depths",
  "quest.513011A450B42F4E.quest_desc": [
    "Have in your inventory 1 × Rod of the Depths (botania:cobble_rod). The items are not consumed by this task."
  ],
  "task.5130125CC2D95FDF.title": "Obtain 1 × Rod of the Lands",
  "quest.51301170FB317C97.title": "Obtain 1 × Rod of the Lands",
  "quest.51301170FB317C97.quest_desc": [
    "Have in your inventory 1 × Rod of the Lands (botania:dirt_rod). The items are not consumed by this task."
  ],
  "task.515012496DFF28E1.title": "9 × Block of Iron — not consumed",
  "task.515012548A26FEE1.title": "1 × Beacon — not consumed",
  "task.51301235AF147D14.title": "4 × Gaia Pylon — not consumed",
  "quest.513011EC3D07F9A3.title": "Gaia Ritual: Platform Kit",
  "quest.513011EC3D07F9A3.quest_desc": [
    "Gaia ritual platform: nine iron blocks form a 3×3 beacon base. Put the Beacon above its centre and position four Gaia Pylons as shown in the Lexica Botania. Clear the arena and prepare the summoning sacrifice separately.",
    "The tasks check each material and quantity without consuming it. Hold the kit before placing it, then complete the separate formation or operation check where this quest has one.",
    "Gaia Pylons form part of the Ritual of Gaia arena. Build the active-Beacon arrangement shown in the Lexica and leave the surrounding fighting area clear.",
    "The normal summon consumes a Terrasteel Ingot as its offering. Crafting a pylon and completing the arena are separate steps; assemble everything and prepare your equipment first."
  ],
  "task.513012B2C0CF8345.title": "Dead and Seek",
  "quest.5130119F6CDCBAEA.title": "Dead and Seek",
  "quest.5130119F6CDCBAEA.quest_desc": [
    "On a completed arena, sneak-right-click the active Beacon with a Terrasteel Ingot to start the Ritual of Gaia. Collect the Gaia Spirits after victory; they are needed for Gaia Ingots and later the Mythic Circuit.",
    "This quest reads the native victory advancement instead of an inventory item. Beacon buffs are disabled during the ritual, and the number of nearby participants also affects its difficulty."
  ],
  "task.5130123207A25F3E.title": "Obtain 1 × Gaia Spirit Ingot",
  "quest.513011A8AE758F43.title": "Obtain 1 × Gaia Spirit Ingot",
  "quest.513011A8AE758F43.quest_desc": [
    "Craft a Gaia Ingot from one Terrasteel Ingot with four Gaia Spirits arranged around it in a cross. The spirits come from defeating the Guardian of Gaia.",
    "Reserve two Gaia Ingots for a batch of Mythic Circuits. A Gaia Ingot can also summon the stronger Guardian, but that second fight is not required to craft the first Mythic Circuit."
  ],
  "task.513012D0AD82B0F5.title": "At the Mercy of a Dream",
  "quest.513011241BDCE00F.title": "At the Mercy of a Dream",
  "quest.513011241BDCE00F.quest_desc": [
    "To summon the stronger Guardian, use a Gaia Ingot instead of Terrasteel on the same correctly built ritual arena. Prepare healing, equipment durability and room to move before summoning.",
    "The task checks the native hard-mode ritual victory. This is a separate combat challenge after obtaining Gaia Ingots; possessing an ingot alone does not complete it."
  ],
  "task.5130127DE756E4E6.title": "Invader Girl",
  "quest.5130117ABA3F4F64.title": "Invader Girl",
  "quest.5130117ABA3F4F64.quest_desc": [
    "Earn the native advancement Invader Girl (botania:challenge/super_corporea_request). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.5130121F52CB1149.title": "Obtain 1 × Gaia Mana Spreader",
  "quest.513011FA714B4E58.title": "Obtain 1 × Gaia Mana Spreader",
  "quest.513011FA714B4E58.quest_desc": [
    "Have in your inventory 1 × Gaia Mana Spreader (botania:gaia_spreader). The items are not consumed by this task."
  ],
