  "quest.513011F75AC66274.quest_desc": [
    "Have in your inventory 1 × Crystalline Seashelf (apothic_enchanting:crystal_seashelf). The items are not consumed by this task."
  ],
  "task.51301200B8D2E645.title": "Obtain 1 × Heart-Forged Seashelf",
  "quest.513011DC67FC0BDA.title": "Obtain 1 × Heart-Forged Seashelf",
  "quest.513011DC67FC0BDA.quest_desc": [
    "Have in your inventory 1 × Heart-Forged Seashelf (apothic_enchanting:heart_seashelf). The items are not consumed by this task."
  ],
  "task.513012E19BB77CF7.title": "Obtain 1 × Endshelf",
  "quest.5130115DA695C2C1.title": "Obtain 1 × Endshelf",
  "quest.5130115DA695C2C1.quest_desc": [
    "Have in your inventory 1 × Endshelf (apothic_enchanting:endshelf). The items are not consumed by this task."
  ],
  "task.513012CFE7201819.title": "Obtain 1 × Pearlescent Endshelf",
  "quest.5130112BC17998F1.title": "Obtain 1 × Pearlescent Endshelf",
  "quest.5130112BC17998F1.quest_desc": [
    "Have in your inventory 1 × Pearlescent Endshelf (apothic_enchanting:pearl_endshelf). The items are not consumed by this task."
  ],
  "task.513012C4CAD96429.title": "Obtain 1 × Draconic Endshelf",
  "quest.513011A3D94B7550.title": "Obtain 1 × Draconic Endshelf",
  "quest.513011A3D94B7550.quest_desc": [
    "Have in your inventory 1 × Draconic Endshelf (apothic_enchanting:draconic_endshelf). The items are not consumed by this task."
  ],
  "task.5130124B02BC5B78.title": "Obtain 1 × Dormant Deepshelf",
  "quest.513011B8817180E8.title": "Obtain 1 × Dormant Deepshelf",
  "quest.513011B8817180E8.quest_desc": [
    "Have in your inventory 1 × Dormant Deepshelf (apothic_enchanting:dormant_deepshelf). The items are not consumed by this task."
  ],
  "task.513012D2B30A72D3.title": "Obtain 1 × Deepshelf",
  "quest.513011230C7B3A12.title": "Obtain 1 × Deepshelf",
  "quest.513011230C7B3A12.quest_desc": [
    "Have in your inventory 1 × Deepshelf (apothic_enchanting:deepshelf). The items are not consumed by this task."
  ],
  "task.513012732751D356.title": "Obtain 1 × Enchantment Library",
  "quest.513011575F40F062.title": "Obtain 1 × Enchantment Library",
  "quest.513011575F40F062.quest_desc": [
    "The Enchantment Library accepts enchanted books and stores their enchantments as points. Use those points to create output books or add enchantments to a book in the output slot.",
    "For each enchantment, the library remembers the highest level you have inserted. Many level-I books build up points, but do not unlock higher-level extraction until you deposit an example of that higher level.",
    "Check the library’s capacity before bulk insertion, as excess enchantments can be lost. Its SOQM recipe also requires an Arcane Conduit, a Control Assembly and Infused Shelves."
  ],
  "task.513012D2C5312DE0.title": "Obtain 1 × Sigil of Socketing",
  "quest.513011587F62519C.title": "Obtain 1 × Sigil of Socketing",
  "quest.513011587F62519C.quest_desc": [
    "A Sigil of Socketing adds one socket to a compatible item. Prepare a gem for the new socket separately and check its bonus for your specific equipment type.",
    "In SOQM, one craft produces three sigils and consumes a Quantum Processor, a Dimensional Matrix, three Gem-Fused Slates, two Gem Dust, Gunpowder and an Amethyst Shard. Plan which equipment will use the resulting batch."
  ],
  "task.51301206BDF0D279.title": "Obtain 1 × Sigil of Enhancement",
  "quest.513011758EB23EF2.title": "Obtain 1 × Sigil of Enhancement",
  "quest.513011758EB23EF2.quest_desc": [
    "Sigils of Enhancement fuel the Augmenting Table. Put affix equipment in the upper slot, sigils in the lower slot and select the desired affix from the list.",
    "The table can upgrade or reroll a single affix while preserving the rest. Check the selected action and experience cost before confirming: rerolling replaces that affix rather than simply increasing its numerical bonus."
  ],
  "task.5130124ABFD64C5E.title": "Obtain 1 × Sigil of Supremacy",
  "quest.513011DDE81BE33E.title": "Obtain 1 × Sigil of Supremacy",
  "quest.513011DDE81BE33E.quest_desc": [
    "Have in your inventory 1 × Sigil of Supremacy (apotheosis:sigil_of_supremacy). The items are not consumed by this task."
  ],
  "task.513012C2EC39E81A.title": "Obtain 1 × Sigil of Withdrawal",
  "quest.51301141D70F43A0.title": "Obtain 1 × Sigil of Withdrawal",
  "quest.51301141D70F43A0.quest_desc": [
    "Combine socketed equipment with a Sigil of Withdrawal in a Smithing Table. The operation removes every socketed gem and returns both the gems and the equipment.",
    "Prepare a sigil before moving valuable gems into a new loadout. After extraction, choose their new sockets according to compatibility and the bonuses they provide for that equipment."
  ],
  "task.51301263A1AFE983.title": "Obtain 1 × Sigil of Rebirth",
  "quest.513011C769D75E3D.title": "Obtain 1 × Sigil of Rebirth",
  "quest.513011C769D75E3D.quest_desc": [
    "Sigils of Rebirth are consumed by both the Simple Reforging Table and the full Reforging Table. Load them into the lower-right slot, with the desired rarity material in the upper-left slot.",
    "Gem Dust alone will not fuel reforging. Dust serves other operations and recipes, while this station requires the finished sigil. Prepare a batch alongside rarity materials and experience."
  ],
  "task.513012145B6F45BB.title": "Obtain 1 × Sigil of Unnaming",
  "quest.513011C4DCF3129F.title": "Obtain 1 × Sigil of Unnaming",
  "quest.513011C4DCF3129F.quest_desc": [
    "Have in your inventory 1 × Sigil of Unnaming (apotheosis:sigil_of_unnaming). The items are not consumed by this task."
  ],
  "task.5130125B0F7F3704.title": "Obtain 1 × Sigil of Malice",
  "quest.5130112D1DCE5C8D.title": "Obtain 1 × Sigil of Malice",
  "quest.5130112D1DCE5C8D.quest_desc": [
    "Have in your inventory 1 × Sigil of Malice (apotheosis:sigil_of_malice). The items are not consumed by this task."
  ],
  "task.513012CFC1CCE84A.title": "Obtain 1 × Gem-Fused Slate",
  "quest.5130113431CBCC5B.title": "Obtain 1 × Gem-Fused Slate",
  "quest.5130113431CBCC5B.quest_desc": [
    "Have in your inventory 1 × Gem-Fused Slate (apotheosis:gem_fused_slate). The items are not consumed by this task."
  ],
  "task.5130126AE8D440CF.title": "Obtain 1 × Tome of Scrapping",
  "quest.513011BB818F4911.title": "Obtain 1 × Tome of Scrapping",
  "quest.513011BB818F4911.quest_desc": [
    "Combine a Tome of Scrapping with enchanted equipment in an anvil. The equipment is destroyed, and the book receives a randomly selected half of its enchantments, rounded up.",
    "Use it on spare loot. To retain every enchantment, prepare a Tome of Superior Scrapping; to preserve the equipment as well, use a Tome of Extraction."
  ],
  "task.51301281D9669FB6.title": "Obtain 1 × Tome of Superior Scrapping",
  "quest.5130111FDCC2B0DC.title": "Obtain 1 × Tome of Superior Scrapping",
  "quest.5130111FDCC2B0DC.quest_desc": [
    "Create a Tome of Superior Scrapping by infusion-enchanting a regular Tome of Scrapping. The recipe needs at least 45 Eterna and 35 Arcana, with Quanta between 25 and 50.",
    "In an anvil, this tome transfers every enchantment but destroys the equipment. Its upgrade guarantees complete enchantment recovery; preserving the item itself requires the next step, a Tome of Extraction."
  ],
  "task.51301216AA6D7DEE.title": "Obtain 1 × Tome of Extraction",
  "quest.5130113C950B4B1B.title": "Obtain 1 × Tome of Extraction",
  "quest.5130113C950B4B1B.quest_desc": [
    "Create a Tome of Extraction by infusion-enchanting a Tome of Superior Scrapping. Configure the table for at least 60 Eterna and 45 Arcana, with Quanta between 25 and 75; excessively high Quanta also fails the recipe.",
    "Combining it with enchanted equipment in an anvil transfers all enchantments while preserving the item itself. Use it to rebuild the enchantments of valuable gear without losing the equipment."
  ],
  "task.5130123F15412052.title": "Obtain 1 × Tome of Weaponry",
  "quest.513011124C2200C6.title": "Obtain 1 × Tome of Weaponry",
  "quest.513011124C2200C6.quest_desc": [
