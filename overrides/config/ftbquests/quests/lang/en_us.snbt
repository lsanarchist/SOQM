  "chapter.514D1035E3AB6C58.title": "24 · Artifacts, Relics and Your Loadout",
  "chapter.514D1035E3AB6C58.chapter_subtitle": [
    "50 quests · English objective guide (alpha).",
    "Hexagon: route · square: development · circle: optional",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.514D12A4DC53902C.title": "Find a First Accessory",
  "quest.514D119A0E0921E3.title": "Find a First Accessory",
  "quest.514D119A0E0921E3.quest_subtitle": "Stage 1 · Practice",
  "quest.514D119A0E0921E3.quest_desc": [
    "Obtain any ONE item from #qm:quest_accessories/first_accessory. Accepted choices: Angler's Hat, Antidote Vessel, Aqua-Dashers, Bunny Hoppers, Charm of Shrinking, Charm of Sinking, Chorus Totem, Cloud in a Bottle, Cowboy Hat, Cross Necklace, Crystal Heart, Digging Claws, Feral Claws, Fire Gauntlet, Flame Pendant, Flippers, Golden Hook, Helium Flamingo, Kitty Slippers, Lucky Scarf, Night Vision Goggles, Novelty Drinking Hat, Obsidian Skull, Onion Ring, Panic Necklace, Pickaxe Heater, Plastic Drinking Hat, Pocket Piston, Power Glove, Rooted Boots, Running Shoes, Scarf of Invisibility, Shock Pendant, Snorkel, Snowshoes, Steadfast Spikes, Strider Shoes, Superstitious Hat, Thorn Pendant, Umbrella, Universal Attractor, Vampiric Glove, Villager Hat, Warp Drive, Whoopee Cushion, Withered Bracelet, Chef's Hat, Chorus Staff, Clot of Time, Cut Glass Boot, Experience Disperser, Ghostly Mantle, Glitchy Mantle, Hunting Belt, Jellyfish Necklace, Kinetic Belt, Leafy Mantle, Midnight Mantle, Piglin Mask, Reflective Necklace, Rider Flute, Ring of the Seven Deadly Sins, Roller Skate, Shield of Retaliation, Sphere of Self-Sacrifice, Springy Boot."
  ],
  "task.514D12A7B657AB1D.title": "Automatic: Equip an Accessory",
  "quest.514D11407706C5A7.title": "Equip an Accessory",
  "quest.514D11407706C5A7.quest_subtitle": "Stage 1 · Practice",
  "quest.514D11407706C5A7.quest_desc": [
    "Equip an Artifacts accessory or Relics relic in a compatible active Curios slot. Ordinary inventory, cosmetic slots and disabled slots do not count. Open Curios from the inventory button or its key binding in Controls."
  ],
  "task.514D12A87813E335.title": "Automatic: Use a Relic's Ability",
  "quest.514D11BF49B78F90.title": "Use a Relic's Ability",
  "quest.514D11BF49B78F90.quest_subtitle": "Stage 1 · Practice",
  "quest.514D11BF49B78F90.quest_desc": [
    "Equip a suitable relic and perform an action that grants that relic its own ability experience. Artifacts use the Reliquified Artifacts integration. Player XP, opening a menu and pressing a key without a successful action do not count. Hold Left Shift over the relic in your inventory to inspect its own experience sources; active abilities use the Relics ability menu."
  ],
  "task.514D12D73681C680.title": "Automatic: Upgrade a Relic Ability",
  "quest.514D113D5B1DB1C5.title": "Upgrade a Relic Ability",
  "quest.514D113D5B1DB1C5.quest_subtitle": "Stage 2 · Practice",
  "quest.514D113D5B1DB1C5.quest_desc": [
    "Raise one suitable relic to level 1 or higher, spend its ability point on an upgrade, and equip that same item in Curios. The automatic check requires both the relic level and spent ability points on one equipped item; an unspent point or an upgrade on a different item is insufficient."
  ],
  "task.514D1219811BF438.title": "Automatic: An Expedition Loadout",
  "quest.514D11CCD1AF477E.title": "An Expedition Loadout",
  "quest.514D11CCD1AF477E.quest_subtitle": "Stage 2 · Practice",
  "quest.514D11CCD1AF477E.quest_desc": [
    "Complete the main relic cycle: find an accessory, equip it, earn its own experience and upgrade an ability. This summary completes automatically after its upgrade dependency; optional random collections do not block it."
  ],
  "task.514D12E38A697DC2.title": "Find a Movement Accessory",
  "quest.514D1133CC758B98.title": "Find a Movement Accessory",
  "quest.514D1133CC758B98.quest_subtitle": "Stage 2 · Optional branch",
  "quest.514D1133CC758B98.quest_desc": [
