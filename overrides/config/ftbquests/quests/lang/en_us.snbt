  "task.514D1233E0E84475.title": "The Factory Must Grow!",
  "quest.514D114A28816D5D.title": "The Factory Must Grow!",
  "quest.514D114A28816D5D.quest_subtitle": "Stage 2 · Main route",
  "quest.514D114A28816D5D.quest_desc": [
    "Earn the native advancement The Factory Must Grow! (mekanism:factory). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.514D12FE53FC3B26.title": "Obtain 1 × Wind Generator",
  "quest.514D1121D23494BB.title": "Sustained Wind Power",
  "quest.514D1121D23494BB.quest_subtitle": "Stage 2 · Main route",
  "quest.514D1121D23494BB.quest_desc": [
    "Place the Wind Generator high above the base and connect it to the power network. Output depends on height and world conditions; read its actual production in the interface.",
    "Compare generation with consumption while several machines run. An Energy Cube absorbs brief peaks but cannot solve a sustained generation deficit."
  ],
