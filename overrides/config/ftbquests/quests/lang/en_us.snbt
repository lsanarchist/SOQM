  ],
  "task.513012FB3A542D4A.title": "Obtain 1 × Nasa Workbench",
  "quest.51301125F300B5D5.title": "Obtain 1 × Nasa Workbench",
  "quest.51301125F300B5D5.quest_subtitle": "Stage 3 · Mod development",
  "quest.51301125F300B5D5.quest_desc": [
