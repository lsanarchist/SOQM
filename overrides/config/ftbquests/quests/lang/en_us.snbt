  "task.513012E9C8B142C2.title": "Obtain 2 × Fission Reactor Port",
  "task.5130124178D07FDD.title": "Obtain 4 × Radioactive Waste Barrel",
  "task.5130125F0040ED89.title": "Obtain 1 × Geiger Counter",
