  "task.51301292789A327F.title": "Obtain 1 × Cold Aercloud",
  "quest.513011482492F3B8.title": "Obtain 1 × Cold Aercloud",
  "quest.513011482492F3B8.quest_desc": [
    "Have in your inventory 1 × Cold Aercloud (aether:cold_aercloud). The items are not consumed by this task."
  ],
  "task.51301252EEBA47BA.title": "Obtain 1 × Cold Parachute",
  "quest.5130113516A2F6B6.title": "Obtain 1 × Cold Parachute",
  "quest.5130113516A2F6B6.quest_desc": [
    "Craft a Cold Parachute from four Cold Aerclouds in a 2×2 square. It has only one use, so you need a replacement after using it.",
    "Keep it accessible before crossing between Aether islands. Owning the item completes this quest without testing it; learn its use from a low height before relying on it during a long fall."
  ],
  "task.513012D0EFE374A8.title": "Obtain 1 × Golden Aercloud",
  "quest.513011A1E01F01C2.title": "Obtain 1 × Golden Aercloud",
  "quest.513011A1E01F01C2.quest_desc": [
