  "image.51410410000001E2.title": "08 · Fission, Fusion and High Energy",
  "image.51410410000001E3.title": "Read top to bottom · hover a quest to see all its connections",
  "image.51410410000001E8.title": "01  The site and its instruments",
  "image.51410410000001EF.title": "02  Fissile fuel and chemical samples",
  "image.51410410000001F5.title": "03  Casing → cooling → first cycle",
  "image.51410410000001FE.title": "04  Steam, rotor and water recovery",
  "image.514104100000020A.title": "05  Waste products and fusion supplies",
  "image.5141041000000213.title": "06  Matrix: capacity and transfer",
  "image.514104100000021E.title": "07  Fusion preparation and ignition",
  "image.514104100000022B.title": "08  SPS and antimatter",
  "image.5141041000000234.title": "09  Meka equipment and modules",
  "image.51410410000001E9.title": "Prepare the\nnuclear site",
  "image.51410410000001EA.title": "A dedicated\nradioactive waste…",
  "image.51410410000001F0.title": "Fission Reactor",
  "image.51410410000001FF.title": "Cooling and\nshutdown first",
  "image.51410410000001F1.title": "Uranium → chemical\nline → fuel",
