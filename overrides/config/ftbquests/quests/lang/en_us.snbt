  "quest.51301140CF32D47E.quest_desc": [
    "Have in your inventory 1 × Ender Chest (enderstorage:ender_chest). The items are not consumed by this task.",
    "Have in your inventory 1 × Ender Tank (enderstorage:ender_tank). The items are not consumed by this task.",
    "Have in your inventory 1 × Matter Transmitter (rftoolsutility:matter_transmitter). The items are not consumed by this task.",
    "Have in your inventory 1 × Matter Receiver (rftoolsutility:matter_receiver). The items are not consumed by this task."
  ],
  "task.51301288E98506AB.title": "Obtain 1 × Stellar Alloy",
  "quest.5130117F2402AE8A.title": "Stellar Alloy",
  "quest.5130117F2402AE8A.quest_subtitle": "Stage 4 · Main route",
  "quest.5130117F2402AE8A.quest_desc": [
    "The fourth milestone links space and the DivineRPG island worlds. It requires Desh Plate from the lunar branch, Eden Chunk, Elite Control Circuit and Dimensional Matrix.",
    "Four Stellar Alloy require 4 Desh Plate, 2 Dimensional Matrix, 2 Eden Chunk and 1 Elite Control Circuit. Keep part of the batch for the next shared components.",
    "Mythic Circuit needs three routes: DivineRPG world progression through Mortum, Botania's Gaia branch and Mekanism Ultimate Control Circuit. Prepare power and cooling separately from reactor ignition."
  ],
  "task.513012E53BEDC58D.title": "Obtain 4 × Desh Plate",
  "task.5130123C00575C63.title": "Obtain 2 × Eden Chunk",
  "task.513012B1CBB4B0F1.title": "Obtain 1 × Elite Control Circuit",
