  "quest.5130115CF6BAE4BC.quest_desc": [
    "Have in your inventory 1 × Blazing Hellshelf (apothic_enchanting:blazing_hellshelf). The items are not consumed by this task."
  ],
  "task.513012EDFD7D3A39.title": "Obtain 1 × Glowing Hellshelf",
  "quest.513011E4C1593023.title": "Obtain 1 × Glowing Hellshelf",
  "quest.513011E4C1593023.quest_desc": [
    "Have in your inventory 1 × Glowing Hellshelf (apothic_enchanting:glowing_hellshelf). The items are not consumed by this task."
  ],
  "task.513012BDD8B01CA6.title": "Obtain 1 × Seashelf",
