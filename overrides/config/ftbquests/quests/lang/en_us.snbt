  "image.51410410000008C8.title": "Sieve Drops Reach\nME",
  "chapter.514010FEC1F06B22.title": "31 · Mob Grinding Utils: Controlled Farming",
  "chapter.514010FEC1F06B22.chapter_subtitle": [
    "Plan mob transport and loot collection before starting the Masher. Turn stored XP into solid reserves, then build the sample, spawn egg and controlled spawner line.",
    "30 quests · 5 sequential production sections.",
    "Read top to bottom · hover a quest to see all its connections",
    "Open a quest to inspect all prerequisites, including links to other chapters. Item tasks check inventory; the description explains assembly and a test run."
  ],
  "task.51401255076C2CE5.title": "Obtain 1 × Mob Fan",
  "quest.5140113A498D848C.title": "A farm starts with mob movement",
  "quest.5140113A498D848C.quest_desc": [
    "Use a Mob Fan to move mobs from the working area to the processing point. Check direction and control; height, width and reach are separate optional extensions. Reserve space for item and experience collection first."
  ],
  "task.51401270C6F99C8C.title": "Obtain 1 × Mob Fan Height Upgrade",
  "quest.51401143F82415D6.title": "Obtain 1 × Mob Fan Height Upgrade",
  "quest.51401143F82415D6.quest_desc": [
    "Have in your inventory 1 × Mob Fan Height Upgrade (mob_grinding_utils:fan_upgrade_height). The items are not consumed by this task."
  ],
  "task.5140128B1C6F3590.title": "Obtain 1 × Mob Fan Width Upgrade",
  "quest.514011B902E6E31F.title": "Obtain 1 × Mob Fan Width Upgrade",
  "quest.514011B902E6E31F.quest_desc": [
    "Have in your inventory 1 × Mob Fan Width Upgrade (mob_grinding_utils:fan_upgrade_width). The items are not consumed by this task."
  ],
  "task.514012CE12F4D5AC.title": "Obtain 1 × Mob Fan Distance Upgrade",
  "quest.51401177E93E6028.title": "Obtain 1 × Mob Fan Distance Upgrade",
  "quest.51401177E93E6028.quest_desc": [
    "Have in your inventory 1 × Mob Fan Distance Upgrade (mob_grinding_utils:fan_upgrade_speed). The items are not consumed by this task."
  ],
  "task.51401214B8445447.title": "Obtain 4 × Entity Conveyor",
  "quest.5140114A40B0278C.title": "A conveyor for precise movement",
  "quest.5140114A40B0278C.quest_desc": [
    "The Entity Conveyor routes creatures through the intended points of a farm. It is also an ingredient of this pack's XP Solidifier, so the experience branch links back here."
  ],
  "task.514012AEDD1B707C.title": "Obtain 1 × Iron Spikes",
  "quest.5140119DBA41022E.title": "Spikes before the automatic masher",
  "quest.5140119DBA41022E.quest_desc": [
    "Iron Spikes provide a simple mob-damage station and are an actual Mob Masher ingredient. Check movement toward the spikes and collection afterward; the next central step combines the Masher with an established Absorption Hopper."
  ],
  "task.51401231646F3EC5.title": "Obtain 4 × Tinted Glass",
  "quest.5140115AD58E20D1.title": "Obtain 4 × Tinted Glass",
  "quest.5140115AD58E20D1.quest_desc": [
    "Have in your inventory 4 × Tinted Glass (mob_grinding_utils:tinted_glass). The items are not consumed by this task."
  ],
  "task.51401269E973FB5A.title": "Obtain 1 × Absorption Hopper",
  "quest.51401108F86D0EE4.title": "Absorption Hopper: items and experience",
  "quest.51401108F86D0EE4.quest_desc": [
    "Place the Absorption Hopper so its collection area covers the kill point. Route items into storage and liquid experience into a Singularity Tank. These two output forms need separate paths."
  ],
  "task.514012D94E999B77.title": "Obtain 1 × Absorption Radius Upgrade",
  "quest.514011A05286EB62.title": "Obtain 1 × Absorption Radius Upgrade",
  "quest.514011A05286EB62.quest_desc": [
    "Have in your inventory 1 × Absorption Radius Upgrade (mob_grinding_utils:absorption_upgrade). The items are not consumed by this task."
  ],
  "task.5140124BB85D4BEC.title": "Obtain 1 × Singularity Tank",
  "quest.5140117D8C128BA2.title": "A liquid experience buffer",
  "quest.5140117D8C128BA2.quest_desc": [
    "The Singularity Tank buffers collected liquid experience. Leave an output to the XP Solidifier or another consumer. The Jumbo Tank, tap and other filling methods are side options for the same system."
  ],
  "task.51401247DDF9ED21.title": "Obtain 1 × Jumbo Tank",
  "quest.51401167B654E27A.title": "Obtain 1 × Jumbo Tank",
  "quest.51401167B654E27A.quest_desc": [
    "Have in your inventory 1 × Jumbo Tank (mob_grinding_utils:jumbo_tank). The items are not consumed by this task."
  ],
  "task.51401220169B20A3.title": "Obtain 1 × XP Drain Singularity Tank",
  "quest.5140110A47674144.title": "Feed personal experience into the system",
  "quest.5140110A47674144.quest_desc": [
    "The XP Drain Singularity Tank provides a way to transfer player experience into the fluid system. Check its interaction and buffer connection; later steps use liquid experience for moulds and solid products."
  ],
  "task.514012A06B6D8848.title": "Obtain 1 × XP Tap",
  "quest.514011C487B33462.title": "Obtain 1 × XP Tap",
  "quest.514011C487B33462.quest_desc": [
    "Have in your inventory 1 × XP Tap (mob_grinding_utils:xp_tap). The items are not consumed by this task."
  ],
  "task.5140127E5D0D9C36.title": "Obtain 1 × XP Solidifier",
  "quest.51401119C8D41866.title": "XP Solidifier: fluid → items",
  "quest.51401119C8D41866.quest_desc": [
    "This pack's recipe consumes an Entity Conveyor, Singularity Tank and Precision Mechanism components. After crafting, supply liquid experience and the required mould. This quest checks the machine; its output has a separate next objective."
  ],
  "task.5140124325C0C72B.title": "Obtain 1 × XP Mould Blank",
  "quest.514011BFC827D439.title": "A mould blank",
  "quest.514011BFC827D439.quest_desc": [
    "The Blank Mould uses gold nuggets and 1000 mB of liquid experience. Farm collection can supply it; the XP Drain Tank is an optional way to add your own experience. Convert the blank into an XP Jelly Baby Mould for the Solidifier."
  ],
  "task.5140120F9C4DBC7D.title": "Obtain 1 × XP Mould Jelly Baby",
  "quest.51401126DAE556AD.title": "The XP Jelly Baby mould",
  "quest.51401126DAE556AD.quest_desc": [
    "Use the XP Jelly Baby Mould in the corresponding Solidifier process and supply liquid experience. After configuring it, verify the XP Jelly Baby output checked by the next objective."
  ],
  "task.514012D8AAA68547.title": "Obtain 1 × XP Jelly Baby",
  "quest.5140110D45F1DCC2.title": "The first solid experience output",
  "quest.5140110D45F1DCC2.quest_desc": [
    "Obtain an XP Jelly Baby from the prepared mould and liquid experience. The farm now has an item output that can be stored or used to craft a Solid XP Block."
  ],
  "task.514012E422FE631B.title": "Obtain 1 × Solid XP",
  "quest.5140110FD5420835.title": "An XP Block for the later spawner",
  "quest.5140110FD5420835.quest_desc": [
    "Craft a Solid XP Block from the corresponding experience items. This pack uses these blocks in the Entity Spawner, so experience collection and solidification come before its crafting step."
  ],
  "task.514012F3AC6D36CC.title": "Obtain 1 × XP Speed Upgrade",
  "quest.514011E75CFEB0A5.title": "Obtain 1 × XP Speed Upgrade",
  "quest.514011E75CFEB0A5.quest_desc": [
    "Have in your inventory 1 × XP Speed Upgrade (mob_grinding_utils:xp_solidifier_upgrade). The items are not consumed by this task."
  ],
  "task.5140120D6D441974.title": "Obtain 1 × Mob Masher",
  "quest.5140110BC63EC2F8.title": "Mob Masher: processing with collection ready",
  "quest.5140110BC63EC2F8.quest_desc": [
    "Build the Mob Masher from spikes and its other components, configure its control and position the Absorption Hopper by the processing point. Verify item and experience outputs first; the specialized upgrades below are separate options."
  ],
  "task.514012634309CAD1.title": "Obtain 1 × Mob Masher Upgrade Sharpness",
  "quest.514011EA278CD919.title": "Obtain 1 × Mob Masher Upgrade Sharpness",
  "quest.514011EA278CD919.quest_desc": [
    "Have in your inventory 1 × Mob Masher Upgrade Sharpness (mob_grinding_utils:saw_upgrade_sharpness). The items are not consumed by this task."
  ],
  "task.5140126770D71F8C.title": "Obtain 1 × Mob Masher Upgrade Beheading",
  "quest.514011DADE40C3C5.title": "Obtain 1 × Mob Masher Upgrade Beheading",
  "quest.514011DADE40C3C5.quest_desc": [
    "Have in your inventory 1 × Mob Masher Upgrade Beheading (mob_grinding_utils:saw_upgrade_beheading). The items are not consumed by this task."
  ],
  "task.514012B74A0E7266.title": "Obtain 1 × Mob Masher Upgrade Looting",
  "quest.514011F5E3962B3C.title": "Obtain 1 × Mob Masher Upgrade Looting",
  "quest.514011F5E3962B3C.quest_desc": [
    "Have in your inventory 1 × Mob Masher Upgrade Looting (mob_grinding_utils:saw_upgrade_looting). The items are not consumed by this task."
  ],
  "task.5140125A5C06434B.title": "Obtain 1 × Mob Masher Upgrade Fire",
  "quest.5140117BEC911CE9.title": "Obtain 1 × Mob Masher Upgrade Fire",
  "quest.5140117BEC911CE9.quest_desc": [
    "Have in your inventory 1 × Mob Masher Upgrade Fire (mob_grinding_utils:saw_upgrade_fire). The items are not consumed by this task."
  ],
  "task.5140123888ACCDB2.title": "Obtain 1 × Ender Inhibitor Active",
  "quest.51401183581A7EA5.title": "Obtain 1 × Ender Inhibitor Active",
  "quest.51401183581A7EA5.quest_desc": [
    "Have in your inventory 1 × Ender Inhibitor Active (mob_grinding_utils:ender_inhibitor_on). The items are not consumed by this task."
  ],
  "task.5140122CB64C2CA3.title": "Obtain 1 × Entity Spawner",
  "quest.5140113D5477C077.title": "Entity Spawner: complete the farm cycle",
  "quest.5140113D5477C077.quest_desc": [
    "Prepare Solid XP Blocks for the recipe and a sample for the chosen creature first. After crafting the Entity Spawner, configure it through its native interface, reserve spawning space and connect the established movement, processing and collection system. The item objective does not verify the whole farm."
  ],
  "task.514012F29AA10416.title": "Obtain 1 × Mob Swab",
  "quest.514011311770DA6F.title": "Mob Swab: collect a sample",
  "quest.514011311770DA6F.quest_desc": [
    "The quest checks the Mob Swab item. For the next recipe, use it on a supported creature and keep the filled sample; an empty swab cannot replace a Used Mob Swab in the feed recipe."
  ],
  "task.5140128FBDCDE4AD.title": "Obtain 1 × GM Chicken Feed",
  "quest.514011A899D0F63A.title": "Sample + experience → genetic feed",
  "quest.514011A899D0F63A.quest_desc": [
    "GM Chicken Feed combines a Used Mob Swab, seeds and liquid experience. Use the feed's native interaction to prepare the corresponding spawn egg. Creature support depends on its behavior and the pack's existing restrictions."
  ],
  "task.514012D7F831F488.title": "Obtain 1 × Mob Masher Upgrade Arthropods",
  "task.514012A0C7505186.title": "Obtain 1 × Mob Masher Upgrade Smite",
  "quest.5140118011E4720B.title": "Obtain 1 × Mob Masher Upgrade Arthropods + Obtain 1 × Mob Masher Upgrade Smite",
  "quest.5140118011E4720B.quest_desc": [
    "Have in your inventory 1 × Mob Masher Upgrade Arthropods (mob_grinding_utils:saw_upgrade_arthropod). The items are not consumed by this task.",
    "Have in your inventory 1 × Mob Masher Upgrade Smite (mob_grinding_utils:saw_upgrade_smite). The items are not consumed by this task."
  ],
  "task.514012F1D6577045.title": "Obtain 1 × Entity Spawner Height Upgrade",
  "task.51401206AD1E878A.title": "Obtain 1 × Entity Spawner Width Upgrade",
  "quest.514011C36B07CA43.title": "Expand the area after the cycle works",
  "quest.514011C36B07CA43.quest_desc": [
    "Width and Height Upgrades expand the Entity Spawner's corresponding dimensions. Apply them after testing the basic cycle so the spawning area stays within the prepared movement and collection system."
  ],
