  "chapter.5142420000000001.title": "37 · Sophisticated: Backpacks and Storage",
  "chapter.5142420000000001.chapter_subtitle": [
    "25 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.5142421200000001.title": "Obtain 1 × Backpack",
  "quest.5142421100000001.title": "Obtain 1 × Backpack",
  "quest.5142421100000001.quest_desc": [
    "A Sophisticated Backpack is portable inventory for expeditions. Right-click in the air while holding it, put a few items inside and check they persist after closing. Stationary chests and barrels belong to Sophisticated Storage; Sophisticated Core provides shared functionality.",
    "Side slots accept functional upgrades such as pickup, magnet, crafting or smelting. Raising the backpack’s own tier expands its storage capabilities, while a Stack Upgrade changes items per slot; these are different improvements.",
    "Start with a useful function and configure its tab before adding others. The backpack and stationary storage branches can develop independently; the copper backpack is optional and is not required for the iron route."
  ],
  "task.5142421200000002.title": "Obtain 1 × Chest",
  "quest.5142421100000002.title": "Obtain 1 × Chest",
  "quest.5142421100000002.quest_desc": [
    "Have in your inventory 1 × Chest (sophisticatedstorage:chest). The items are not consumed by this task."
  ],
  "task.5142421200000003.title": "Obtain 1 × Barrel",
  "quest.5142421100000003.title": "Obtain 1 × Barrel",
  "quest.5142421100000003.quest_desc": [
    "A Sophisticated Storage Barrel is a stationary container with slots for functional upgrades. Place it, open it with a normal right-click and assign it to a particular resource stream at the base.",
    "Test ordinary storage before adding pickup or a Hopper Upgrade. The container does not extract from a neighbouring machine by itself; use a suitable upgrade, pipe or the machine’s own output."
  ],
  "task.5142421200000004.title": "Obtain 1 × Copper Backpack",
  "quest.5142421100000004.title": "Obtain 1 × Copper Backpack",
  "quest.5142421100000004.quest_desc": [
    "Have in your inventory 1 × Copper Backpack (sophisticatedbackpacks:copper_backpack). The items are not consumed by this task."
  ],
  "task.5142421200000005.title": "Obtain 1 × Iron Backpack",
  "quest.5142421100000005.title": "Obtain 1 × Iron Backpack",
  "quest.5142421100000005.quest_desc": [
    "Have in your inventory 1 × Iron Backpack (sophisticatedbackpacks:iron_backpack). The items are not consumed by this task."
  ],
  "task.5142421200000006.title": "Obtain 1 × Gold Backpack",
  "quest.5142421100000006.title": "Obtain 1 × Gold Backpack",
  "quest.5142421100000006.quest_desc": [
    "Have in your inventory 1 × Gold Backpack (sophisticatedbackpacks:gold_backpack). The items are not consumed by this task."
  ],
  "task.5142421200000007.title": "Obtain 1 × Diamond Backpack",
  "quest.5142421100000007.title": "Obtain 1 × Diamond Backpack",
  "quest.5142421100000007.quest_desc": [
    "Have in your inventory 1 × Diamond Backpack (sophisticatedbackpacks:diamond_backpack). The items are not consumed by this task."
  ],
  "task.5142421200000008.title": "Obtain 1 × Netherite Backpack",
  "quest.5142421100000008.title": "Obtain 1 × Netherite Backpack",
  "quest.5142421100000008.quest_desc": [
    "Have in your inventory 1 × Netherite Backpack (sophisticatedbackpacks:netherite_backpack). The items are not consumed by this task."
  ],
  "task.5142421200000009.title": "Obtain 1 × Basic To Iron Tier Upgrade",
  "quest.5142421100000009.title": "Obtain 1 × Basic To Iron Tier Upgrade",
  "quest.5142421100000009.quest_desc": [
    "Have in your inventory 1 × Basic To Iron Tier Upgrade (sophisticatedstorage:basic_to_iron_tier_upgrade). The items are not consumed by this task."
  ],
  "task.514242120000000A.title": "Obtain 1 × Iron To Gold Tier Upgrade",
  "quest.514242110000000A.title": "Obtain 1 × Iron To Gold Tier Upgrade",
  "quest.514242110000000A.quest_desc": [
    "Have in your inventory 1 × Iron To Gold Tier Upgrade (sophisticatedstorage:iron_to_gold_tier_upgrade). The items are not consumed by this task."
  ],
  "task.514242120000000B.title": "Obtain 1 × Gold To Diamond Tier Upgrade",
  "quest.514242110000000B.title": "Obtain 1 × Gold To Diamond Tier Upgrade",
  "quest.514242110000000B.quest_desc": [
    "The Gold to Diamond Tier Upgrade raises an existing gold storage block to diamond tier. In SOQM this capacity is tied to the Quantum Processor and control components, so diamonds alone do not unlock the recipe.",
    "Obtain the kit for quest credit, then right-click a compatible gold container with it. This upgrades the storage tier rather than occupying a functional upgrade slot; check the retained contents afterward."
  ],
  "task.514242120000000C.title": "Obtain 1 × Diamond To Netherite Tier Upgrade",
  "quest.514242110000000C.title": "Obtain 1 × Diamond To Netherite Tier Upgrade",
  "quest.514242110000000C.quest_desc": [
    "Have in your inventory 1 × Diamond To Netherite Tier Upgrade (sophisticatedstorage:diamond_to_netherite_tier_upgrade). The items are not consumed by this task."
  ],
  "task.514242120000000D.title": "Obtain 1 × Pickup Upgrade",
  "quest.514242110000000D.title": "Obtain 1 × Pickup Upgrade",
  "quest.514242110000000D.quest_desc": [
    "Have in your inventory 1 × Pickup Upgrade (sophisticatedbackpacks:pickup_upgrade). The items are not consumed by this task."
  ],
  "task.514242120000000E.title": "Obtain 1 × Advanced Pickup Upgrade",
  "quest.514242110000000E.title": "Obtain 1 × Advanced Pickup Upgrade",
  "quest.514242110000000E.quest_desc": [
    "Have in your inventory 1 × Advanced Pickup Upgrade (sophisticatedbackpacks:advanced_pickup_upgrade). The items are not consumed by this task."
  ],
  "task.514242120000000F.title": "Obtain 1 × Magnet Upgrade",
  "quest.514242110000000F.title": "Obtain 1 × Magnet Upgrade",
  "quest.514242110000000F.quest_desc": [
    "A Magnet Upgrade attracts available item drops to the backpack. Install it in a side slot, configure its filtering and test a few dropped items before an expedition.",
    "The magnet adds no inventory capacity and can collect drops near your own or another player’s production line. Disable it where items are deliberately left in the world and keep spare backpack capacity."
  ],
  "task.5142421200000010.title": "Obtain 1 × Stack Upgrade Starter Tier",
  "quest.5142421100000010.title": "Obtain 1 × Stack Upgrade Starter Tier",
  "quest.5142421100000010.quest_desc": [
    "Have in your inventory 1 × Stack Upgrade Starter Tier (sophisticatedbackpacks:stack_upgrade_starter_tier). The items are not consumed by this task."
  ],
  "task.5142421200000011.title": "Obtain 1 × Stack Upgrade Tier 1",
  "quest.5142421100000011.title": "Obtain 1 × Stack Upgrade Tier 1",
  "quest.5142421100000011.quest_desc": [
    "Stack Upgrade Tier 1 increases the number of items that fit in one backpack slot. Install it in an upgrade slot and test the new limit with a bulk resource such as cobblestone.",
    "It helps with many copies of the same item but does not create extra separate slots for assorted items. Remove excess contents before taking it out, so the stored stacks fit the lower limit again."
  ],
  "task.5142421200000012.title": "Obtain 1 × Compacting Upgrade",
  "quest.5142421100000012.title": "Obtain 1 × Compacting Upgrade",
  "quest.5142421100000012.quest_desc": [
    "Have in your inventory 1 × Compacting Upgrade (sophisticatedbackpacks:compacting_upgrade). The items are not consumed by this task."
  ],
  "task.5142421200000013.title": "Obtain 1 × Crafting Upgrade",
  "quest.5142421100000013.title": "Obtain 1 × Crafting Upgrade",
  "quest.5142421100000013.quest_desc": [
    "Have in your inventory 1 × Crafting Upgrade (sophisticatedbackpacks:crafting_upgrade). The items are not consumed by this task."
  ],
  "task.5142421200000014.title": "Obtain 1 × Smelting Upgrade",
  "quest.5142421100000014.title": "Obtain 1 × Smelting Upgrade",
  "quest.5142421100000014.quest_desc": [
    "Have in your inventory 1 × Smelting Upgrade (sophisticatedbackpacks:smelting_upgrade). The items are not consumed by this task."
  ],
  "task.5142421200000015.title": "Obtain 1 × Auto Smelting Upgrade",
  "quest.5142421100000015.title": "Obtain 1 × Auto Smelting Upgrade",
  "quest.5142421100000015.quest_desc": [
    "Have in your inventory 1 × Auto Smelting Upgrade (sophisticatedbackpacks:auto_smelting_upgrade). The items are not consumed by this task."
  ],
  "task.5142421200000016.title": "Obtain 1 × Deposit Upgrade",
  "quest.5142421100000016.title": "Obtain 1 × Deposit Upgrade",
  "quest.5142421100000016.quest_desc": [
    "Have in your inventory 1 × Deposit Upgrade (sophisticatedbackpacks:deposit_upgrade). The items are not consumed by this task."
  ],
  "task.5142421200000017.title": "Obtain 1 × Controller",
  "task.514242120000001A.title": "Obtain 1 × Storage Tool",
  "quest.5142421100000017.title": "Obtain 1 × Controller + Obtain 1 × Storage Tool",
  "quest.5142421100000017.quest_desc": [
    "Have in your inventory 1 × Controller (sophisticatedstorage:controller). The items are not consumed by this task.",
    "Have in your inventory 1 × Storage Tool (sophisticatedstorage:storage_tool). The items are not consumed by this task."
  ],
  "task.5142421200000018.title": "Obtain 1 × Hopper Upgrade",
  "quest.5142421100000018.title": "Obtain 1 × Hopper Upgrade",
  "quest.5142421100000018.quest_desc": [
