{
  "file.0000000000000001.title": "Shout Out to Questing Mayhem · Expert · English alpha guide",
  "chapter_group.5141042000000001.title": "Starting Out and Routes",
  "chapter_group.5141042000000002.title": "Materials and Production",
  "chapter_group.5141042000000003.title": "Machines and Power",
  "chapter_group.5141042000000004.title": "Networks and Logistics",
  "chapter_group.5141042000000005.title": "Magic and Equipment",
  "chapter_group.5141042000000006.title": "Dimensions and Settlements",
  "chapter_group.5141042000000007.title": "Transmutation and the Finale",
  "chapter.514D10BB504C8924.title": "06 · The Mekanism Factory",
  "chapter.514D10BB504C8924.chapter_subtitle": [
    "Start with power and metal infusion, then branch into ore chemistry, logistics, mining and QIO. Factories add parallel slots to operations you already understand.",
    "89 quests · 10 sequential production sections.",
    "Read top to bottom · hover a quest to see all its connections",
    "Open a quest to inspect all prerequisites, including links to other chapters. Item tasks check inventory; the description explains assembly and a test run."
  ],
  "task.514D1298117735DA.title": "Obtain 8 × Osmium Ingot",
  "quest.514D118227E562E7.title": "Osmium: starting the machine line",
  "quest.514D118227E562E7.quest_desc": [
    "Osmium supplies the first machines and control components. Prepare a stock, then connect FE power to a Metallurgic Infuser. The central route leads to steel, casings and processing; side branches add capacity and equipment."
  ],
  "task.514D12443397184B.title": "Obtain 1 × Heat Generator",
  "task.514D123CADB1A9FE.title": "Obtain 4 × Basic Universal Cable",
  "quest.514D11B512FA3533.title": "FE: generator → cable → machine",
  "quest.514D11B512FA3533.quest_desc": [
    "Place a Heat Generator, connect a Basic Universal Cable to the machine's power input and check that its internal buffer charges. An Energy Cube in the next branch will bridge interruptions. The objective checks the listed items; assemble the working network in the world."
  ],
  "task.514D120BC0C162BB.title": "Obtain 1 × Metallurgic Infuser",
  "quest.514D11B65A3EE8C0.title": "Infuser: two material lines",
  "quest.514D11B65A3EE8C0.quest_desc": [
    "The Metallurgic Infuser separates the item input from its infusion material. Iron with carbon starts the steel route; iron with redstone produces Infused Alloy. Separate machines for different infusions avoid discarding the remaining material when switching."
  ],
  "task.514D123B28AB849A.title": "Obtain 8 × Steel Ingot",
  "task.514D1272918DA606.title": "Obtain 8 × Infused Alloy",
  "quest.514D110FDA1C7CF6.title": "Steel and alloy for casings",
  "quest.514D110FDA1C7CF6.quest_desc": [
    "Collect ingots from the steel line and Infused Alloy from the redstone line. Keep separate stocks: casings, cables and later circuits will consume both."
  ],
  "task.514D124489CA95EB.title": "Obtain 4 × Basic Control Circuit",
  "task.514D12338DA47ADF.title": "Obtain 2 × Steel Casing",
  "quest.514D11EFB7B6F506.title": "Casings and basic control",
  "quest.514D11EFB7B6F506.quest_desc": [
    "Steel Casings and Basic Control Circuits recur in the early machines. From here, split the workshop into ore processing, power and transport so each line can grow independently."
  ],
  "task.514D126C25DD9231.title": "Obtain 1 × Configurator",
  "quest.514D1147E2CB985B.title": "Configure machine sides",
  "quest.514D1147E2CB985B.quest_desc": [
    "Use the Configurator for connections and transport modes. In each machine's interface, assign input, output and energy sides and enable the required auto-ejection. Begin with a short route between two machines."
  ],
  "task.514D124463C7F80D.title": "Obtain 1 × Enrichment Chamber",
  "task.514D12198F623502.title": "Obtain 1 × Energized Smelter",
  "quest.514D1154FFE3DABB.title": "Ore → enrichment → smelting",
  "quest.514D1154FFE3DABB.quest_desc": [
    "Send a supported feed into the Enrichment Chamber and its output to the Energized Smelter. Check that feed's recipe in JEI: ore blocks, raw ore and other forms have different ratios, so the line does not promise one multiplier for every input."
  ],
  "task.514D12D5C5A62FB5.title": "Obtain 1 × Basic Energy Cube",
  "quest.514D1178A4D44AFB.title": "A buffer between generator and workshop",
  "quest.514D1178A4D44AFB.quest_desc": [
    "Place a Basic Energy Cube between the FE source and consumers and configure its input and output. It adds stored energy rather than generation, so sustained operation still requires an adequate source."
  ],
  "task.514D121815A3555D.title": "Obtain 8 × Basic Logistical Transporter",
  "task.514D12C0523DF70D.title": "Obtain 8 × Basic Mechanical Pipe",
  "task.514D127B4BD9414E.title": "Obtain 8 × Basic Pressurized Tube",
  "quest.514D118EBA5C411D.title": "Three separate flows",
  "quest.514D118EBA5C411D.quest_desc": [
    "Logistical Transporters move items, Mechanical Pipes move fluids, and Pressurized Tubes move chemicals. These are separate systems: water and oxygen need different transport. Verify each flow between one pair of blocks first."
  ],
  "task.514D12C16685AB75.title": "Obtain 4 × Enriched Redstone",
  "task.514D12F0163F5913.title": "Obtain 4 × Enriched Carbon",
  "quest.514D116574C816F4.title": "Concentrated Infuser inputs",
  "quest.514D116574C816F4.quest_desc": [
    "The Enrichment Chamber turns redstone and carbon feedstocks into concentrated Infuser materials. Send them to the infusion input and compare their values in JEI before scaling circuit production."
  ],
  "task.513012C0FDE33AE9.title": "Obtain 1 × Energy Tablet",
  "quest.5130111B9CDAD323.title": "Obtain 1 × Energy Tablet",
  "quest.5130111B9CDAD323.quest_desc": [
    "Have in your inventory 1 × Energy Tablet (mekanism:energy_tablet). The items are not consumed by this task."
  ],
  "task.513012F1393769E2.title": "Obtain 1 × Enriched Iron",
  "quest.513011C1D784F1C8.title": "First carbon infusion",
  "quest.513011C1D784F1C8.quest_desc": [
    "Feed iron and a carbon source into the Metallurgic Infuser to obtain Enriched Iron. This intermediate needs a second infusion before it becomes steel."
  ],
  "task.513012469791ED3D.title": "Obtain 1 × Steel Dust",
  "quest.513011A22D5322FD.title": "Second infusion → steel dust",
  "quest.513011A22D5322FD.quest_desc": [
    "Infuse Enriched Iron with carbon again, then smelt the resulting Steel Dust into an ingot. This completes the initial steel line before the later factories."
  ],
  "task.513012D009A996EC.title": "Obtain 1 × Refined Glowstone Ingot",
  "quest.513011F2453E9C69.title": "Obtain 1 × Refined Glowstone Ingot",
  "quest.513011F2453E9C69.quest_desc": [
    "Have in your inventory 1 × Refined Glowstone Ingot (mekanism:ingot_refined_glowstone). The items are not consumed by this task."
  ],
  "task.514D1233E0E84475.title": "The Factory Must Grow!",
  "quest.514D114A28816D5D.title": "A factory: parallel processing",
  "quest.514D114A28816D5D.quest_desc": [
    "A factory gives one operation parallel processing slots. Upgrade the bottleneck in your line; the following side quests show the specializations. This objective uses Mekanism's native advancement for obtaining a factory or applying a Tier Installer."
  ],
  "task.514D12FE53FC3B26.title": "Obtain 1 × Wind Generator",
  "quest.514D1121D23494BB.title": "Wind for continuous demand",
  "quest.514D1121D23494BB.quest_desc": [
    "Connect a Wind Generator to the energy buffer and watch the FE balance while machines run. Size generation and cable throughput around the workshop's actual load."
  ],
  "task.514D125F4CE8E47E.title": "Obtain 1 × Electrolytic Separator",
  "task.514D1291BA263170.title": "Obtain 1 × Electric Pump",
  "quest.514D118CA784C98D.title": "Water → hydrogen and oxygen",
  "quest.514D118CA784C98D.quest_desc": [
    "The Electric Pump feeds water to the Electrolytic Separator. Route hydrogen and oxygen into separate Pressurized Tubes or chemical tanks; an unwanted full output can stop separation. Oxygen supplies the next purification line."
  ],
  "task.514D1283D5567C5D.title": "Obtain 1 × Purification Chamber",
  "task.514D12B1B528858E.title": "Obtain 1 × Crusher",
  "quest.514D1118901F8AB4.title": "Oxygen adds a purification stage",
  "quest.514D1118901F8AB4.quest_desc": [
    "Feed material and oxygen into the Purification Chamber, then route its output through the Crusher, Enrichment Chamber and Energized Smelter. Keep every output clear and check JEI for the amounts produced from your chosen feed."
  ],
  "task.514D12DB1BE225B7.title": "1 × Thermal Evaporation Controller — not consumed",
  "task.514D12252C003D7F.title": "2 × Thermal Evaporation Valve — not consumed",
  "task.514D126A59C9DD80.title": "33 × Thermal Evaporation Block — not consumed",
  "quest.514D11F90042E7F4.title": "Thermal Evaporation Plant: Complete Kit",
  "quest.514D11F90042E7F4.quest_desc": [
    "Minimum evaporation plant: 4×3×4. The solid floor contains 16 blocks, the middle ring 12 and the top ring 8 with its four corners omitted. Leave the top centre open.",
    "Of these 36 positions, one is the Controller, two are input/output Valves and the remaining 33 are Thermal Evaporation Blocks. Solar generators and an external heater are optional speed upgrades.",
    "The kit builds one plant for water → brine. For continuous lithium production, add a second plant and feed it brine.",
    "The tasks check each material and quantity without consuming it. Hold the kit before placing it, then complete the separate formation or operation check where this quest has one."
  ],
  "task.513012A8296F5CE0.title": "Obtain 1 × Advanced Control Circuit",
  "quest.513011936DDEBB0E.title": "Obtain 1 × Advanced Control Circuit",
  "quest.513011936DDEBB0E.quest_desc": [
    "Have in your inventory 1 × Advanced Control Circuit (mekanism:advanced_control_circuit). The items are not consumed by this task."
  ],
  "task.513012063758285D.title": "In Place Transmitter Upgrades",
  "quest.513011D8991C51E1.title": "In Place Transmitter Upgrades",
  "quest.513011D8991C51E1.quest_desc": [
    "Earn the native advancement In Place Transmitter Upgrades (mekanism:alloy_upgrading). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.51301252C1A99365.title": "Cleaning Gauges",
  "quest.513011E0DB7DE79B.title": "Cleaning Gauges",
  "quest.513011E0DB7DE79B.quest_desc": [
    "Earn the native advancement Cleaning Gauges (mekanism:cleaning_gauges). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.513012B7CC099CF3.title": "Ctrl+C, Ctrl+V",
  "quest.513011D0BECE02CE.title": "Ctrl+C, Ctrl+V",
  "quest.513011D0BECE02CE.quest_desc": [
    "Earn the native advancement Ctrl+C, Ctrl+V (mekanism:configuration_copying). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.51301250B1E128C5.title": "Obtain 1 × Osmium Compressor",
  "quest.5130112244309BDE.title": "Osmium for material compression",
  "quest.5130112244309BDE.quest_desc": [
    "The Osmium Compressor adds osmium to supported materials. This is a separate alloy line, including Refined Glowstone; its factory version scales the same operation."
  ],
  "task.5130121ECF245907.title": "Obtain 1 × Precision Sawmill",
  "quest.513011B3BB1DF1D9.title": "Wood and sawdust",
  "quest.513011B3BB1DF1D9.quest_desc": [
    "The Precision Sawmill processes wood. A log gives planks and has a 25% chance of extra sawdust; a wooden stick always becomes one sawdust. Use sawdust for paper and the Cardboard Box. Substrate and ethylene in the PRC instead require Bio Fuel made by crushing plant material in a Crusher."
  ],
  "task.514A120000000001.title": "Obtain 1 × Cardboard Box",
  "quest.514A110000000001.title": "Cardboard Box: move a block with its contents",
  "quest.514A110000000001.quest_desc": [
    "After the Precision Sawmill, turn its sawdust into a useful tool: four wood dust items in a 2×2 grid make one Cardboard Box. Sawing one wooden stick guarantees one sawdust; a log only has a chance to produce sawdust as a secondary output. Compatible Immersive Engineering wood dust also works in the box recipe.",
    "Right-click a supported block with an empty box to pack its saved data and inventory. Break and collect the boxed block, place it at the destination, then sneak-right-click to restore the block and recover the empty box. For your first trial, move an ordinary chest containing a few items.",
    "A box moves one permitted block, not a whole multiblock structure. SOQM prevents packing AE2 crafting CPU blocks to stop active autocrafting ingredients from being duplicated; finish or cancel their jobs and dismantle them normally. Other Mekanism restrictions still apply.",
    "The objective checks one box in inventory without consuming it; moving the chest is a learning exercise, not an additional automatic condition. This optional branch does not block chemistry, reactors or the main route. Every member claims a personal engineering pack once for this quest."
  ],
  "task.5130128A5F213974.title": "Obtain 1 × Basic Chemical Tank",
  "quest.513011FD1111D1BA.title": "A tank for chemicals",
  "quest.513011FD1111D1BA.quest_desc": [
    "A Basic Chemical Tank buffers hydrogen, oxygen and other chemicals. Use Pressurized Tubes and configure its inputs and outputs; an ordinary Fluid Tank stores a different form."
  ],
  "task.51301204FB969FF2.title": "Obtain 1 × Chemical Oxidizer",
  "quest.513011C1717043EB.title": "Solid feed → chemical output",
  "quest.513011C1717043EB.quest_desc": [
    "The Chemical Oxidizer converts supported solid inputs into chemicals. Connect power, the item feed and a Pressurized Tube to the correct output. This machine also forms part of the later uranium line."
  ],
  "task.513012BE74BAB4F7.title": "Obtain 1 × Basic Fluid Tank",
  "quest.513011933F7B17EE.title": "A fluid buffer",
  "quest.513011933F7B17EE.quest_desc": [
    "The Basic Fluid Tank stores water and other fluids. Place it between pump and consumer to see whether supply keeps up with demand; store chemicals in separate Chemical Tanks."
  ],
  "task.513012D492637D63.title": "Obtain 1 × Rotary Condensentrator",
  "quest.5130113C675F054B.title": "Changing form in the Rotary",
  "quest.5130113C675F054B.quest_desc": [
    "The Rotary Condensentrator converts a supported substance between fluid and chemical forms. Choose the correct mode and use the matching transport on each side. Liquid samples in the nuclear chapter are separate demonstrations of this operation."
  ],
  "task.513012A091605D75.title": "Obtain 1 × Pressurized Reaction Chamber",
  "quest.513011156F29CC4E.title": "PRC: item + fluid + chemical",
  "quest.513011156F29CC4E.quest_desc": [
    "The Pressurized Reaction Chamber has three distinct inputs. Its starter recipe uses 2 Bio Fuel, 10 mB water and 100 mB hydrogen to produce 1 Substrate and 100 mB ethylene. Make Bio Fuel by crushing plant material in a Crusher; sawmill sawdust does not work here. Remove both the chemical and solid outputs or the machine will stop. Later PRC recipes lead to HDPE."
  ],
  "task.5130124ACE1024C5.title": "Obtain 1 × Formulaic Assemblicator",
  "quest.513011740CB95726.title": "Local crafting from a formula",
  "quest.513011740CB95726.quest_desc": [
    "The Formulaic Assemblicator executes a stored Crafting Formula. Supply the required ingredients, FE and a separate output route. Use it as a local station for a repeated crafting recipe."
  ],
  "task.513012C9F9E483BA.title": "Obtain 1 × Logistical Sorter",
  "quest.513011447E582F7D.title": "Sorting before the split",
  "quest.513011447E582F7D.quest_desc": [
    "A Logistical Sorter extracts from the attached inventory and distributes items using filters and colors. Test one input with two destinations before adding more lines so unwanted items do not block machines."
  ],
  "task.5130129D0DF8B1E3.title": "Obtain 1 × Basic Smelting Factory",
  "quest.513011C68B70B3F3.title": "Obtain 1 × Basic Smelting Factory",
  "quest.513011C68B70B3F3.quest_desc": [
    "Have in your inventory 1 × Basic Smelting Factory (mekanism:basic_smelting_factory). The items are not consumed by this task."
  ],
  "task.5130128A09FE85EC.title": "Obtain 1 × Basic Enriching Factory",
  "quest.51301147649F4943.title": "Obtain 1 × Basic Enriching Factory",
  "quest.51301147649F4943.quest_desc": [
    "Have in your inventory 1 × Basic Enriching Factory (mekanism:basic_enriching_factory). The items are not consumed by this task."
  ],
  "task.513012088B2DE577.title": "Obtain 1 × Basic Crushing Factory",
  "quest.5130117ADB85508F.title": "Obtain 1 × Basic Crushing Factory",
  "quest.5130117ADB85508F.quest_desc": [
    "Have in your inventory 1 × Basic Crushing Factory (mekanism:basic_crushing_factory). The items are not consumed by this task."
  ],
  "task.5130122CBF60E453.title": "Obtain 1 × Basic Compressing Factory",
  "quest.513011ADC7A6AF6B.title": "Obtain 1 × Basic Compressing Factory",
  "quest.513011ADC7A6AF6B.quest_desc": [
    "Have in your inventory 1 × Basic Compressing Factory (mekanism:basic_compressing_factory). The items are not consumed by this task."
  ],
  "task.513012709DD505E3.title": "Obtain 1 × Basic Purifying Factory",
  "quest.51301189138B989B.title": "Obtain 1 × Basic Purifying Factory",
  "quest.51301189138B989B.quest_desc": [
    "Have in your inventory 1 × Basic Purifying Factory (mekanism:basic_purifying_factory). The items are not consumed by this task."
  ],
  "task.5130124F6FCB081D.title": "Obtain 1 × Basic Infusing Factory",
  "quest.513011472102F0D8.title": "Obtain 1 × Basic Infusing Factory",
  "quest.513011472102F0D8.quest_desc": [
    "Have in your inventory 1 × Basic Infusing Factory (mekanism:basic_infusing_factory). The items are not consumed by this task."
  ],
  "task.51301213F192B1A6.title": "Obtain 1 × Basic Sawing Factory",
  "quest.513011FCD72A741B.title": "Obtain 1 × Basic Sawing Factory",
  "quest.513011FCD72A741B.quest_desc": [
    "Have in your inventory 1 × Basic Sawing Factory (mekanism:basic_sawing_factory). The items are not consumed by this task."
  ],
  "task.513012B18B801099.title": "Obtain 1 × Advanced Smelting Factory",
  "quest.51301190143553CA.title": "Obtain 1 × Advanced Smelting Factory",
  "quest.51301190143553CA.quest_desc": [
    "Have in your inventory 1 × Advanced Smelting Factory (mekanism:advanced_smelting_factory). The items are not consumed by this task."
  ],
  "task.5130128D20D88D3E.title": "Obtain 4 × Advanced Universal Cable",
  "quest.51301174E90C0139.title": "Obtain 4 × Advanced Universal Cable",
  "quest.51301174E90C0139.quest_desc": [
    "Have in your inventory 4 × Advanced Universal Cable (mekanism:advanced_universal_cable). The items are not consumed by this task."
  ],
  "task.513012FFF9CA1987.title": "Obtain 4 × Elite Universal Cable",
  "quest.513011854F694FFF.title": "Obtain 4 × Elite Universal Cable",
  "quest.513011854F694FFF.quest_desc": [
    "Have in your inventory 4 × Elite Universal Cable (mekanism:elite_universal_cable). The items are not consumed by this task."
  ],
  "task.5130129CE0FFBF5C.title": "Obtain 4 × Advanced Logistical Transporter",
  "quest.5130116E42F14F4E.title": "Obtain 4 × Advanced Logistical Transporter",
  "quest.5130116E42F14F4E.quest_desc": [
    "Have in your inventory 4 × Advanced Logistical Transporter (mekanism:advanced_logistical_transporter). The items are not consumed by this task."
  ],
