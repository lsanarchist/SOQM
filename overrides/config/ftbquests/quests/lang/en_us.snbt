  "chapter.513010224298B082.title": "11 · Storage, Logistics and Useful Devices",
  "chapter.513010224298B082.chapter_subtitle": [
    "45 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.513012FE3E185048.title": "Obtain 1 × Copper Chest",
  "quest.5130115C2448F78F.title": "Obtain 1 × Copper Chest",
  "quest.5130115C2448F78F.quest_desc": [
    "Have in your inventory 1 × Copper Chest (ironchest:copper_chest). The items are not consumed by this task."
  ],
  "task.513012886D0DAE09.title": "Obtain 1 × Iron Chest",
  "quest.5130111C4CD728C6.title": "Obtain 1 × Iron Chest",
  "quest.5130111C4CD728C6.quest_desc": [
    "Have in your inventory 1 × Iron Chest (ironchest:iron_chest). The items are not consumed by this task."
  ],
  "task.5130128B3B305624.title": "Obtain 1 × Gold Chest",
  "quest.513011C482A87300.title": "Obtain 1 × Gold Chest",
  "quest.513011C482A87300.quest_desc": [
    "Have in your inventory 1 × Gold Chest (ironchest:gold_chest). The items are not consumed by this task."
  ],
  "task.513012DB2041EE06.title": "Obtain 1 × Diamond Chest",
  "quest.5130113706F7FC90.title": "Obtain 1 × Diamond Chest",
  "quest.5130113706F7FC90.quest_desc": [
    "Have in your inventory 1 × Diamond Chest (ironchest:diamond_chest). The items are not consumed by this task."
  ],
  "task.51301243DF5E5914.title": "Obtain 1 × Crystal Chest",
  "quest.5130113B8DF6EC22.title": "Obtain 1 × Crystal Chest",
  "quest.5130113B8DF6EC22.quest_desc": [
    "Have in your inventory 1 × Crystal Chest (ironchest:crystal_chest). The items are not consumed by this task."
  ],
  "task.513012D7B664FC94.title": "Obtain 1 × Obsidian Chest",
  "quest.51301185B7779201.title": "Obtain 1 × Obsidian Chest",
  "quest.51301185B7779201.quest_desc": [
    "Have in your inventory 1 × Obsidian Chest (ironchest:obsidian_chest). The items are not consumed by this task."
  ],
  "task.513012A970E866AD.title": "Obtain 1 × Oak Full Drawers 1",
  "quest.5130115694DC485A.title": "Obtain 1 × Oak Full Drawers 1",
  "quest.5130115694DC485A.quest_desc": [
    "A single-compartment drawer holds a large supply of one item type. Choose a bulk resource, insert a sample and route that resource here; an ordinary chest suits assorted tools better.",
    "Once its purpose is set, lock it with a Drawer Key. An emptied locked drawer retains its assigned type instead of taking an unrelated item from a mixed stream."
  ],
  "task.513012ADD735BC1B.title": "Obtain 1 × Oak Full Drawers 2",
  "quest.5130119D041C553B.title": "Obtain 1 × Oak Full Drawers 2",
  "quest.5130119D041C553B.quest_desc": [
    "Have in your inventory 1 × Oak Full Drawers 2 (storagedrawers:oak_full_drawers_2). The items are not consumed by this task."
  ],
  "task.51301206D1C2BD45.title": "Obtain 1 × Oak Full Drawers 4",
  "quest.5130117C2D5AA079.title": "Obtain 1 × Oak Full Drawers 4",
  "quest.5130117C2D5AA079.quest_desc": [
    "Have in your inventory 1 × Oak Full Drawers 4 (storagedrawers:oak_full_drawers_4). The items are not consumed by this task."
  ],
  "task.513012F4D68FB647.title": "Obtain 1 × Compacting Drawers (3-Tier)",
  "quest.513011DE65E3F4EE.title": "Obtain 1 × Compacting Drawers (3-Tier)",
  "quest.513011DE65E3F4EE.quest_desc": [
    "A Compacting Drawer represents compatible forms of one resource as a shared supply, such as nuggets, ingots and blocks. Insert the intended material and inspect which forms it recognises.",
    "Before automation, insert a small batch and withdraw another supported form. This is not a universal autocrafter: arbitrary machine recipes and multi-ingredient products are not unlocked by the drawer."
  ],
  "task.513012B3F340C086.title": "Obtain 1 × Drawer Controller",
  "quest.513011E12927F035.title": "Obtain 1 × Drawer Controller",
  "quest.513011E12927F035.quest_desc": [
    "The Drawer Controller provides a common access point for a connected group of drawers. Assign drawers to the intended resources and check their connection to the controller before adding a shared input.",
    "Locked samples help route bulk items into the right places. The controller does not provide unlimited storage of its own; a full destination drawer still requires a separate overflow plan."
  ],
  "task.513012A5D6699222.title": "Obtain 1 × Drawer Controller IO",
  "quest.51301141ECBD49DF.title": "Obtain 1 × Drawer Controller IO",
  "quest.51301141ECBD49DF.quest_desc": [
    "Have in your inventory 1 × Drawer Controller IO (storagedrawers:controller_io). The items are not consumed by this task."
  ],
  "task.5130124F67744B99.title": "Obtain 1 × Upgrade Template",
  "quest.513011C12859CEF4.title": "Obtain 1 × Upgrade Template",
  "quest.513011C12859CEF4.quest_desc": [
    "Have in your inventory 1 × Upgrade Template (storagedrawers:upgrade_template). The items are not consumed by this task."
  ],
  "task.51301234B3490947.title": "Obtain 1 × Drawer Key",
  "quest.51301103E224F47D.title": "Obtain 1 × Drawer Key",
  "quest.51301103E224F47D.quest_desc": [
    "A Drawer Key locks a drawer’s assignment. Insert the intended item, then apply the key; the locked drawer remembers its type even when empty.",
    "This is useful before feeding a mixed resource stream automatically. The key controls item assignment rather than other players’ permissions: a locked drawer is not a private safe."
  ],
  "task.513012FBE48C631A.title": "Obtain 1 × Quantify Key",
  "quest.5130110342A53FEB.title": "Obtain 1 × Quantify Key",
  "quest.5130110342A53FEB.quest_desc": [
    "Have in your inventory 1 × Quantify Key (storagedrawers:quantify_key). The items are not consumed by this task."
  ],
  "task.513012BFB064C455.title": "Obtain 1 × Concealment Key",
  "quest.51301119B9DEEAF8.title": "Obtain 1 × Concealment Key",
  "quest.51301119B9DEEAF8.quest_desc": [
    "Have in your inventory 1 × Concealment Key (storagedrawers:shroud_key). The items are not consumed by this task."
  ],
  "task.5130121BDD7CC88A.title": "Obtain 1 × Storage Downgrade",
  "quest.5130117CBCB942CE.title": "Obtain 1 × Storage Downgrade",
  "quest.5130117CBCB942CE.quest_desc": [
    "The Storage Downgrade reduces a drawer’s base capacity to one stack. It is an intentional limit for a small buffer or a stock with a defined upper bound.",
    "Do not install it as another expansion for bulk storage. Remove excess contents first and check the resulting capacity; being placed in an upgrade slot does not mean an item increases storage."
  ],
  "task.51301219C76D6984.title": "Obtain 4 × Oak Wooden Pipe",
  "quest.513011D24B556B5D.title": "Obtain 4 × Oak Wooden Pipe",
  "quest.513011D24B556B5D.quest_desc": [
