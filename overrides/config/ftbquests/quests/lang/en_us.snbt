  "chapter.5130103754E07063.title": "20 · Aether: An Expedition in the Sky",
  "chapter.5130103754E07063.chapter_subtitle": [
    "50 quests · English objective guide (alpha).",
    "Short lines: sequence · hover a quest: other prerequisites",
    "Open a quest to inspect all prerequisites. Its map role does not change its completion conditions."
  ],
  "task.513012E534367EAB.title": "Hostile Paradise",
  "quest.5130116E4F360239.title": "Hostile Paradise",
  "quest.5130116E4F360239.quest_desc": [
    "Earn the native advancement Hostile Paradise (aether:enter_aether). Follow its requirement in the Advancements screen or the mod's guide."
  ],
  "task.5130123641C6AC2E.title": "Obtain 1 × Gravitite Ore",
  "quest.5130111A101FFA81.title": "Obtain 1 × Gravitite Ore",
  "quest.5130111A101FFA81.quest_desc": [
    "Gravitite Ore is a rare Aether ore that rises when no block is above it. Watch the space over a vein while mining so you do not lose track of ore that floats upward.",
    "The drop is the Gravitite Ore block itself. Keep it for processing in an Altar: the Dimensional Matrix requires Enchanted Gravitite, which raw ore cannot replace."
  ],
  "task.513012B85856A896.title": "Obtain 1 × Enchanted Gravitite",
  "quest.513011039AD8F208.title": "Obtain 1 × Enchanted Gravitite",
  "quest.513011039AD8F208.quest_desc": [
    "Craft an Altar with one Zanite Gemstone in the center and eight Holystone around it. Fuel it with Ambrosium Shards and insert Gravitite Ore to produce Enchanted Gravitite.",
    "Reserve one enchanted block for a batch of two Dimensional Matrices before spending it on Gravitite equipment. A regular furnace cannot perform the required enchanting process."
  ],
