  "task.513012C5C965528D.title": "Obtain 1 × Space Helmet",
  "task.513012B05F5EE691.title": "Obtain 1 × Space Pants",
  "task.51301289E4FAEE0A.title": "Obtain 1 × Space Boots",
  "quest.5130114FE09DA6CE.title": "Complete Space Equipment",
  "quest.5130114FE09DA6CE.quest_subtitle": "Stage 3 · Main route",
  "quest.5130114FE09DA6CE.quest_desc": [
    "Prepare the Space Helmet, Space Pants and Space Boots before the first landing. Equip them together with the oxygen-filled Space Suit chest piece.",
    "Check all four armor slots before departure. Strong armor from another mod does not automatically provide Ad Astra’s environmental protection."
  ],
  "task.513012C38001BEFC.title": "Obtain 1 × Space Suit",
  "quest.5130115956283BA9.title": "Fill the Suit before the First Moon Trip",
  "quest.5130115956283BA9.quest_subtitle": "Stage 3 · Main route",
  "quest.5130115956283BA9.quest_desc": [
    "Craft the Space Suit and fill it with oxygen in an Oxygen Loader. Equip the complete ordinary space set: the chest piece supplies oxygen but does not replace the other equipment.",
    "Check actual oxygen reserves and carry filled Gas Tanks. This set protects in cold airless environments; hot planets need the next protection tier.",
    "The item task accepts the suit regardless of its fill level. Check oxygen before launch yourself: the completion mark does not measure the reserve."
  ],
  "task.513012649444713C.title": "Obtain 1 × Oxygen Distributor",
  "quest.513011635A57E77B.title": "Obtain 1 × Oxygen Distributor",
  "quest.513011635A57E77B.quest_subtitle": "Stage 4 · Mod development",
  "quest.513011635A57E77B.quest_desc": [
    "Have in your inventory 1 × Oxygen Distributor (ad_astra:oxygen_distributor). The items are not consumed by this task."
  ],
  "task.513012ADDD113E7B.title": "Obtain 1 × Oxygen Bucket",
  "quest.513011984F5B40C8.title": "Oxygen as an Expedition Supply",
  "quest.513011984F5B40C8.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011984F5B40C8.quest_desc": [
    "Fill an oxygen bucket from the Oxygen Loader after it processes water. This checks ground-based oxygen production before the first flight.",
    "For a longer trip, fill the suit and Gas Tanks and inspect their capacities. Owning one bucket does not prove you have enough oxygen for the expedition."
  ],
  "task.513012EE48CF2E35.title": "Obtain 1 × Fuel Bucket",
  "quest.513011A99D6EA3A8.title": "Fuel for Departure and Return",
  "quest.513011A99D6EA3A8.quest_subtitle": "Stage 3 · Mod development",
  "quest.513011A99D6EA3A8.quest_desc": [
    "Process oil into Fuel in a powered Fuel Refinery. The rocket uses refined fuel; a bucket of crude oil is not a substitute.",
    "Shift-right-click the placed rocket and fill its tank according to the gauge. Pack fuel for a return launch and a launch pad separately in its cargo.",
    "Prepare the return trip on Earth. The quest checks an item, not all of the rocket’s supplies."
  ],
