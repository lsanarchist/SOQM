  "quest.514D11FDEEB7D32B.quest_subtitle": "Stage 4 · Main route",
  "quest.514D11FDEEB7D32B.quest_desc": [
    "Earn the native advancement Unfashionable, But Smart (mekanism:radiation_prevention). Follow its requirement in the Advancements screen or the mod's guide.",
